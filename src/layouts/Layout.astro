              </span>. All rights reserved.
            </p>
            <p itemprop="description" style={{ margin: "0.25rem 0 0", fontSize: "0.8rem", opacity: 0.5 }}>
              Free Udemy course deals updated daily — 100% off coupons across 400+ topics.
            </p>
          </div>
          <div style={{
            display: "flex",
            alignItems: "center",
            gap: "0.5rem",
            flexWrap: "wrap"
          }}>
            {["Verified Coupons", "Update Daily", "4.8★ Rating", "24/7 Support"].map((text) => (
              <span style={{
                display: "inline-flex", alignItems: "center", gap: "0.4rem",
                padding: "0.35rem 0.85rem",
                borderRadius: "9999px",
                background: "rgba(212,167,55,0.08)",
                border: "1px solid rgba(212,167,55,0.15)",
                color: "var(--brand)",
                fontSize: "0.75rem",
                fontWeight: 600,
                whiteSpace: "nowrap"
              }}>
                {text}
              </span>
            ))}
          </div>
        </div>
      </div>
    </footer>

    {/* Back to Top Button */}
    <button
      id="backToTop"
      style={{
        position: "fixed",
        bottom: "24px",
        right: "24px",
        width: "44px",
        height: "44px",
        borderRadius: "50%",
        background: "var(--brand)",
        color: "#080b12",
        border: "none",
        cursor: "pointer",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        boxShadow: "0 4px 20px rgba(212,167,55,0.45)",
        transition: "opacity 0.35s ease, transform 0.35s ease",
        zIndex: 1000,
        opacity: 0,
        transform: "translateY(16px) scale(0.9)",
        pointerEvents: "none"
      }}
      aria-label="Back to top"
      onmouseenter="this.style.transform='translateY(0) scale(1.1)';this.style.boxShadow='0 8px 28px rgba(212,167,55,0.65)'"
      onmouseleave="this.style.transform='translateY(0) scale(1)';this.style.boxShadow='0 4px 20px rgba(212,167,55,0.45)'"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8v12"/>
        <path d="M6 14l6-6 6 6"/>
      </svg>
    </button>

    <script>
      // Newsletter form feedback
      const newsletterForm = document.querySelector('footer form');
      if (newsletterForm) {
        newsletterForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const emailInput = newsletterForm.querySelector('input[type="email"]') as HTMLInputElement;
          
          if (emailInput) {
            const email = emailInput.value.trim();
            
            if (email) {
              // Show success message inline
              const successMsg = document.createElement('p');
              successMsg.textContent = 'Thank you for subscribing! We\'ll send you the latest Udemy coupons and deals.';
              successMsg.style.color = 'var(--brand)';
              successMsg.style.fontWeight = '600';
              successMsg.style.marginTop = '1rem';
              successMsg.style.textAlign = 'center';
              
              // Remove any existing success message
              const existingMsg = newsletterForm.querySelector('.success-message');
              if (existingMsg) {
                existingMsg.remove();
              }
              
              // Add success class for styling
              successMsg.className = 'success-message';
              newsletterForm.appendChild(successMsg);
              
              emailInput.value = '';
              
              // Remove message after 5 seconds
              setTimeout(() => {
                successMsg.remove();
              }, 5000);
            } else {
              // Show error message inline
              const errorMsg = document.createElement('p');
              errorMsg.textContent = 'Please enter a valid email address.';
              errorMsg.style.color = '#ef4444';
              errorMsg.style.fontWeight = '600';
              errorMsg.style.marginTop = '1rem';
              errorMsg.style.textAlign = 'center';
              
              // Remove any existing error message
              const existingMsg = newsletterForm.querySelector('.error-message');
              if (existingMsg) {
                existingMsg.remove();
              }
              
              // Add error class for styling
              errorMsg.className = 'error-message';
              newsletterForm.appendChild(errorMsg);
              
              // Remove message after 3 seconds
              setTimeout(() => {
                errorMsg.remove();
              }, 3000);
            }
          }
        });
      }

      // Back to top functionality
      const backToTopBtn = document.getElementById('backToTop');
      window.addEventListener('scroll', () => {
        if (!backToTopBtn) return;
        const show = window.pageYOffset > 400;
        backToTopBtn.style.opacity = show ? '1' : '0';
        backToTopBtn.style.transform = show ? 'translateY(0) scale(1)' : 'translateY(16px) scale(0.9)';
        backToTopBtn.style.pointerEvents = show ? 'auto' : 'none';
      });
      
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }

      // Register Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('SW registered:', registration.scope);
            })
            .catch((error) => {
              console.log('SW registration failed:', error);
            });
        });
      }
    </script>
  </body>
</html>
