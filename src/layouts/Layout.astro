---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
}


const {
  title = "CourseSpeak - Free Udemy Courses & Deals",
  description = "Find verified Udemy deals with 100% off coupons. Updated daily with free courses and discounts.",
  image, // No default - let each page provide its own image
  type = "website",
  canonical,
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://coursespeak.com";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Dynamic copyright year
const currentYear = new Date().getFullYear();
const absoluteImageUrl = image ? (image.startsWith('http') ? image : new URL(image, siteUrl).href) : null;

// Get current path for navigation active states
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Performance & SEO Meta Tags -->
    <meta name="theme-color" content="#1a1a2e" />
    <meta name="msapplication-TileColor" content="#1a1a2e" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CourseSpeak" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    
    <!-- DNS prefetch for external domains -->
    <link rel="dns-prefetch" href="//www.udemy.com" />
    <link rel="dns-prefetch" href="//www.coursera.org" />
    <link rel="dns-prefetch" href="//www.edx.org" />
    
    <!-- Resource hints -->
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />
    
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="HISPISPt9Gk-zER-OUkGcPtm6cyiQ7snnKwzn7aDgTY" />
    <link rel="canonical" href={canonicalURL} />
    {canonicalURL.includes('/deal/') && !canonicalURL.includes('.amp') && (
      <link rel="amphtml" href={canonicalURL.replace('/deal/', '/deal/') + '.amp'} />
    )}

    <title>{title}</title>

    <!-- Comprehensive SEO Meta Tags -->
    <meta name="author" content="CourseSpeak" />
    <meta name="publisher" content="CourseSpeak" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="revisit-after" content="1 days" />
    <meta name="language" content="English" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="keywords" content="udemy courses, online learning, course deals, udemy coupons, free courses, discounted courses, online education, skill development" />
    <meta name="classification" content="Education, Online Learning, Course Deals" />
    <meta name="category" content="Education" />
    <link rel="author" href="https://coursespeak.com" />
    <link rel="publisher" href="https://coursespeak.com" />

    <!-- Search Engine Specific -->
    <meta name="yandex-verification" content="verification-code" />
    <meta name="baidu-site-verification" content="verification-code" />

    <!-- Organization Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "logo": "https://coursespeak.com/logo.svg",
      "description": "Find verified Udemy courses with 100% off coupons. Updated daily with free courses and discounts.",
      "foundingDate": "2023",
      "sameAs": [
        "https://www.facebook.com/CourseSpeakOfficial",
        "https://x.com/courses_peak"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://coursespeak.com/contact"
      }
    }
    </script>

    <!-- Site Sitemap Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "@id": "https://coursespeak.com/sitemap",
      "name": "CourseSpeak Sitemap",
      "description": "Complete navigation structure for CourseSpeak website",
      "url": "https://coursespeak.com/sitemap",
      "potentialAction": {
        "@type": "ReadAction",
        "target": [
          "https://coursespeak.com/",
          "https://coursespeak.com/deals",
          "https://coursespeak.com/categories",
          "https://coursespeak.com/topics",
          "https://coursespeak.com/popular",
          "https://coursespeak.com/about",
          "https://coursespeak.com/contact",
          "https://coursespeak.com/privacy",
          "https://coursespeak.com/terms",
          "https://coursespeak.com/udemy-coupons-guide",
          "https://coursespeak.com/how-to-redeem-coupon"
        ]
      }
    }
    </script>

    <!-- WebSite Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "description": "Find verified Udemy courses with 100% off coupons. Daily updated deals for online learning.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://coursespeak.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@id": "https://coursespeak.com/#organization"
      },
      "inLanguage": "en-US",
      "copyrightHolder": {
        "@id": "https://coursespeak.com/#organization"
      }
    }
    </script>

    <!-- Site Navigation Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "name": "Main Navigation",
      "url": "https://coursespeak.com",
      "potentialAction": [
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/deals",
          "name": "Latest Coupons"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/categories",
          "name": "Categories"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/popular",
          "name": "Popular"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/topics",
          "name": "Topics"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/udemy-coupons-guide",
          "name": "Blog/Guide"
        }
      ]
    }
    </script>

    <!-- Enhanced Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CourseSpeak" />
    <meta property="og:locale" content="en_US" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:width" content="1200" />}
    {absoluteImageUrl && <meta property="og:image:height" content="630" />}
    {absoluteImageUrl && <meta property="og:image:alt" content={title} />}
    {absoluteImageUrl && <meta property="og:image:type" content="image/jpeg" />}

    <!-- Enhanced Twitter Cards -->
    <meta property="twitter:card" content={absoluteImageUrl ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@courses_peak" />
    <meta property="twitter:creator" content="@courses_peak" />
    {absoluteImageUrl && <meta property="twitter:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="twitter:image:alt" content={title} />}

    <!-- Additional Social Sharing Meta Tags -->
    <meta property="article:author" content="CourseSpeak" />
    <meta property="article:publisher" content="https://coursespeak.com" />

    <!-- Optimized Font Loading for Core Web Vitals -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <style>
      /* Basic styles */
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;
      }
      
      /* Optimized social media hover effects */
      .facebook-hover:hover,
      .x-hover:hover,
      .linkedin-hover:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(255, 193, 7, 0.15);
        border-color: var(--brand);
      }

      .facebook-hover:hover span,
      .x-hover:hover span,
      .linkedin-hover:hover span {
        color: var(--brand);
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <header
      class="site-header"
      style={{
        position: "sticky",
        top: 0,
        zIndex: 1000,
        background: "var(--bg)",
        borderBottom: "1px solid var(--border)"
      }}
    >
      <nav
        class="container"
        aria-label="Main navigation"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "12px 16px",
          maxWidth: "1400px",
          margin: "0 auto"
        }}
      >
        <a href="/" class="logo">
          <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
            <div style={{ 
              width: "40px", 
              height: "40px", 
              background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
              borderRadius: "10px",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              position: "relative",
              boxShadow: "0 4px 12px -2px hsla(45, 95%, 58%, 0.3)"
            }}>
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="white"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <div style={{ display: "flex", flexDirection: "column" }}>
              <span
                style={{ 
                  fontSize: "1.6rem", 
                  fontWeight: 800, 
                  lineHeight: "1.2"
                }}
              >
                <span style={{
                  background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
                  WebkitBackgroundClip: "text",
                  WebkitTextFillColor: "transparent",
                  backgroundClip: "text"
                }}>Course</span>
                <span style={{
                  background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
                  WebkitBackgroundClip: "text",
                  WebkitTextFillColor: "transparent",
                  backgroundClip: "text"
                }}>Speak</span>
              </span>
              <span
                style={{ 
                  fontSize: "0.75rem", 
                  color: "var(--muted)",
                  fontWeight: 600,
                  letterSpacing: "0.1em"
                }}
              >FREE UDEMY COURSES</span>
            </div>
          </div>
        </a>
        <div style={{ display: "flex", gap: "16px", alignItems: "center", flex: 1, justifyContent: "space-between" }}>
          {/* Left Navigation Menu */}
          <div style={{ 
            display: "flex", 
            gap: "4px", 
            alignItems: "center",
            background: "var(--card)",
            padding: "4px",
            borderRadius: "12px",
            border: "1px solid var(--border)",
            flexWrap: "nowrap",
            overflow: "auto"
          }}>
            <a
              href="/deals"
              style={{
                color: currentPath === '/deals' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.85rem",
                fontWeight: 600,
                padding: "6px 12px",
                borderRadius: "8px",
                transition: "all 0.3s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                flexShrink: 0,
                background: currentPath === '/deals' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.41zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
              </svg>
              Latest Coupons
            </a>
            
            <a
              href="/categories"
              style={{
                color: currentPath === '/categories' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.85rem",
                fontWeight: 600,
                padding: "6px 12px",
                borderRadius: "8px",
                transition: "all 0.3s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                flexShrink: 0,
                background: currentPath === '/categories' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l-5.5 9h11z"/>
                <circle cx="17.5" cy="17.5" r="4.5"/>
                <path d="M3 13.5h8v8H3z"/>
              </svg>
              Categories
            </a>
            
            <a
              href="/popular"
              style={{
                color: currentPath === '/popular' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.85rem",
                fontWeight: 600,
                padding: "6px 12px",
                borderRadius: "8px",
                transition: "all 0.3s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                flexShrink: 0,
                background: currentPath === '/popular' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              Popular
              <span style={{
                background: "var(--brand)",
                color: "var(--bg)",
                fontSize: "0.6rem",
                padding: "1px 4px",
                borderRadius: "999px",
                fontWeight: 700
              }}>HOT</span>
            </a>
            
            <a
              href="/topics"
              style={{
                color: currentPath === '/topics' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.85rem",
                fontWeight: 600,
                padding: "6px 12px",
                borderRadius: "8px",
                transition: "all 0.3s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                flexShrink: 0,
                background: currentPath === '/topics' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
              </svg>
              Topics
            </a>
            
            <a
              href="/udemy-coupons-guide"
              style={{
                color: currentPath === '/udemy-coupons-guide' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.85rem",
                fontWeight: 600,
                padding: "6px 12px",
                borderRadius: "8px",
                transition: "all 0.3s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                flexShrink: 0,
                background: currentPath === '/udemy-coupons-guide' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
              </svg>
              Blog/Guide
            </a>
          </div>
          
          {/* Center Search Bar */}
          <form action="/search" method="get" style={{ 
            display: "flex", 
            gap: "0",
            background: "var(--card)",
            borderRadius: "8px",
            border: "1px solid var(--border)",
            overflow: "hidden",
            maxWidth: "300px",
            width: "100%",
            flexShrink: 0
          }}>
            <input 
              type="text" 
              name="q" 
              placeholder="Search coupons..." 
              style={{
                background: 'transparent',
                color: 'var(--text)',
                border: 'none',
                padding: '6px 12px',
                fontSize: '0.85rem',
                width: '100%',
                outline: 'none'
              }}
            />
            <button 
              type="submit" 
              style={{
                background: 'var(--brand)',
                color: 'var(--bg)',
                border: 'none',
                padding: '6px 10px',
                fontSize: '0.85rem',
                cursor: 'pointer',
                fontWeight: '600',
                transition: 'all 0.3s ease'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
              </svg>
            </button>
          </form>
        </div>
      </nav>
    </header>

    <main style={{ minHeight: "calc(100vh - 300px)" }}>
      <slot />
    </main>

    <footer
      style={{
        color: "hsl(215, 20%, 65%)",
        padding: "80px 0 40px",
        marginTop: "auto",
        position: "relative",
        overflow: "hidden",
        background: "linear-gradient(135deg, hsl(222, 47%, 7%) 0%, hsl(222, 43%, 10%) 100%)"
      }}
    >
      <div style={{ maxWidth: "1400px", margin: "0 auto", padding: "0 1rem" }}>
        {/* Newsletter Section */}
        <div style={{
          background: "var(--card)",
          padding: "3rem",
          borderRadius: "24px",
          marginBottom: "64px",
          border: "1px solid var(--border)",
          textAlign: "center",
          position: "relative",
          overflow: "hidden"
        }}>
          <div style={{
            position: "absolute",
            top: "-50px",
            right: "-50px",
            width: "150px",
            height: "150px",
            background: "var(--brand)",
            borderRadius: "50%",
            opacity: 0.1
          }}></div>
          <h3 style={{
            color: "#fff",
            fontSize: "2rem",
            fontWeight: 800,
            marginBottom: "1rem",
            background: "linear-gradient(135deg, #FFC107 0%, #FFD54F 100%)",
            WebkitBackgroundClip: "text",
            WebkitTextFillColor: "transparent",
            backgroundClip: "text"
          }}>
            Get Exclusive Udemy Coupons
          </h3>
          <p style={{
            color: "hsl(215, 20%, 65%)",
            marginBottom: "2rem",
            maxWidth: "600px",
            margin: "0 auto 2rem",
            fontSize: "1.1rem",
            lineHeight: 1.6
          }}>
            Subscribe to our newsletter and never miss a deal. Get the latest Udemy coupons delivered to your inbox daily.
          </p>
          <div style={{
            display: "flex",
            gap: "1rem",
            maxWidth: "600px",
            margin: "0 auto",
            flexWrap: "wrap"
          }}>
            <input
              type="email"
              placeholder="Enter your email"
              style={{
                flex: 1,
                minWidth: "250px",
                padding: "1rem 1.5rem",
                borderRadius: "12px",
                border: "2px solid var(--border)",
                background: "var(--input)",
                color: "var(--text)",
                fontSize: "1rem",
                transition: "all 0.3s ease"
              }}
            />
            <button
              style={{
                padding: "1rem 2.5rem",
                borderRadius: "12px",
                background: "linear-gradient(135deg, #FFC107 0%, #FFD54F 100%)",
                color: "var(--bg)",
                border: "none",
                fontSize: "1rem",
                fontWeight: 700,
                cursor: "pointer",
                transition: "all 0.3s ease",
                boxShadow: "0 4px 20px -4px rgba(255, 193, 7, 0.4)"
              }}
            >
              Subscribe
            </button>
          </div>
        </div>

        {/* Footer Links */}
        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))",
          gap: "32px",
          marginBottom: "48px"
        }}>
          <div>
            <h3
              style={{
                background: "linear-gradient(135deg, #FFC107 0%, #FFD54F 100%)",
                WebkitBackgroundClip: "text",
                WebkitTextFillColor: "transparent",
                backgroundClip: "text",
                marginBottom: "16px",
                fontSize: "1.2rem",
                fontWeight: "700"
              }}
            >
              CourseSpeak
            </h3>
            <p style={{ 
              fontSize: "0.9rem", 
              lineHeight: "1.5",
              color: "hsl(215, 20%, 65%)",
              marginBottom: "16px"
            }}>
