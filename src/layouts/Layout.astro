---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** MIME type for og:image (e.g. image/svg+xml for generated covers). */
  ogImageType?: string;
  type?: string;
  canonical?: string;
  /** Robots directive, e.g. "noindex, follow". Defaults to indexable. */
  robots?: string;
}


const {
  title = "CourseSpeak - Free Udemy Courses & Deals",
  description = "Find verified Udemy deals with 100% off coupons. Updated daily with free courses and discounts.",
  image,
  ogImageType,
  type = "website",
  canonical,
  robots,
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://coursespeak.com";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Default og:image for pages that don't supply one (prevents missing social preview).
const useDefaultImage = !image;
const resolvedImage = useDefaultImage ? "/images/og/og-default.png" : image;
const resolvedOgType = (() => {
  if (useDefaultImage) return "image/png";
  if (ogImageType) return ogImageType;
  const clean = resolvedImage.split('?')[0];
  const ext = clean.split('.').pop()?.toLowerCase() || "jpg";
  return ext === "png" ? "image/png" : ext === "webp" ? "image/webp" : ext === "svg" ? "image/svg+xml" : "image/jpeg";
})();
const absoluteImageUrl = resolvedImage ? (resolvedImage.startsWith('http') ? resolvedImage : new URL(resolvedImage, siteUrl).href) : null;

// Get current path for navigation active states
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    {canonicalURL.includes('/deal/') && !canonicalURL.includes('.amp') && (
      <link rel="amphtml" href={canonicalURL.replace(/\/$/, '') + '.amp/'} />
    )}
    
    <!-- Performance & SEO Meta Tags -->
    <meta name="theme-color" content="#080b12" />
    <meta name="msapplication-TileColor" content="#080b12" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CourseSpeak" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    
    <!-- DNS prefetch for external domains -->
    <link rel="dns-prefetch" href="//www.udemy.com" />
    <link rel="dns-prefetch" href="//www.coursera.org" />
    <link rel="dns-prefetch" href="//www.edx.org" />
    
    <!-- Resource hints -->
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="HISPISPt9Gk-zER-OUkGcPtm6cyiQ7snnKwzn7aDgTY" />

    <!-- Comprehensive SEO Meta Tags -->
    <meta name="author" content="Josh Smith" />
    <meta name="publisher" content="CourseSpeak" />
    <meta name="robots" content={robots || "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="googlebot" content={robots || "index, follow"} />
    <meta name="bingbot" content={robots || "index, follow"} />
    <meta name="revisit-after" content="1 days" />
    <meta name="language" content="English" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="classification" content="Education, Online Learning, Course Deals" />
    <meta name="category" content="Education" />
    <link rel="author" href="https://www.linkedin.com/in/anandayuda/" />
    <link rel="publisher" href="https://coursespeak.com" />

    <!-- Organization Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "logo": "https://coursespeak.com/logo.svg",
      "description": "Find verified Udemy courses with 100% off coupons. Updated daily with free courses and discounts.",
      "foundingDate": "2023",
      "sameAs": [
        "https://www.facebook.com/CourseSpeakOfficial",
        "https://x.com/courses_peak",
        "https://www.linkedin.com/company/coursespeak"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://coursespeak.com/contact"
      }
    }
    </script>

    <!-- Site Sitemap Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "@id": "https://coursespeak.com/sitemap",
      "name": "CourseSpeak Sitemap",
      "description": "Complete navigation structure for CourseSpeak website",
      "url": "https://coursespeak.com/sitemap",
      "potentialAction": {
        "@type": "ReadAction",
        "target": [
          "https://coursespeak.com/",
          "https://coursespeak.com/deals",
          "https://coursespeak.com/instructors",
          "https://coursespeak.com/categories",
          "https://coursespeak.com/topics",
          "https://coursespeak.com/popular",
          "https://coursespeak.com/about",
          "https://coursespeak.com/contact",
          "https://coursespeak.com/privacy",
          "https://coursespeak.com/terms",
          "https://coursespeak.com/udemy-coupons-guide",
          "https://coursespeak.com/how-to-redeem-coupon",
          "https://coursespeak.com/blog"
        ]
      }
    }
    </script>

    <!-- WebSite Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "description": "Find verified Udemy courses with 100% off coupons. Daily updated deals for online learning.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://coursespeak.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@id": "https://coursespeak.com/#organization"
      },
      "inLanguage": "en-US",
      "copyrightHolder": {
        "@id": "https://coursespeak.com/#organization"
      }
    }
    </script>

    <!-- Site Navigation Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "name": "Main Navigation",
      "url": "https://coursespeak.com",
      "potentialAction": [
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/deals",
          "name": "Latest Coupons"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/instructors",
          "name": "Instructors"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/categories",
          "name": "Categories"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/topics",
          "name": "Topics"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/udemy-coupons-guide",
          "name": "Coupons Guide"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/blog",
          "name": "Blog"
        }
      ]
    }
    </script>

    <!-- Enhanced Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CourseSpeak" />
    <meta property="og:locale" content="en_US" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:width" content="1200" />}
    {absoluteImageUrl && <meta property="og:image:height" content="630" />}

    {absoluteImageUrl && <meta property="og:image:alt" content={title} />}
    {absoluteImageUrl && <meta property="og:image:type" content={resolvedOgType} />}

    <!-- Enhanced Twitter Cards -->
    <meta property="twitter:card" content={absoluteImageUrl ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@courses_peak" />
    <meta property="twitter:creator" content="@courses_peak" />
    {absoluteImageUrl && <meta property="twitter:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="twitter:image:alt" content={title} />}

    <!-- Additional Social Sharing Meta Tags -->
    <meta property="article:author" content="Josh Smith" />
    <meta property="article:publisher" content="https://coursespeak.com" />

    <!-- Optimized Font Loading for Core Web Vitals -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />



    <script>
      const ADS_CLIENT = "ca-pub-8220442576502761";
      function loadAds() {
        if (document.querySelector("script[data-google-ads]")) return;
        const s = document.createElement("script");
        s.async = true;
        s.dataset.googleAds = "true";
        s.crossOrigin = "anonymous";
        s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + ADS_CLIENT;
        document.head.appendChild(s);
      }
      for (const ev of ["scroll", "pointerdown", "keydown"]) {
        addEventListener(ev, loadAds, { once: true, passive: true });
      }
    </script>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;
      }

      .skip-link {
        position: absolute;
        top: -100px;
        left: 8px;
        z-index: 9999;
        background: var(--brand);
        color: #1a1814;
        padding: 8px 16px;
        border-radius: 0 0 8px 8px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
      }
      .skip-link:focus {
        top: 0;
      }

      .site-header {
        background: linear-gradient(180deg, rgba(212, 167, 55, 0.12) 0%, rgba(212, 167, 55, 0.04) 100%);
        border-bottom: 1px solid rgba(212, 167, 55, 0.35);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
      }
      .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #B8860B 0%, #D4AF37 40%, #E8C547 60%, #D4AF37 100%);
        color: #1a1814;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 0 16px rgba(212,167,55,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
        position: relative;
      }
      .brand-icon::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.12);
        pointer-events: none;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
      }
      .brand-name {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--text);
        line-height: 1.2;
      }
      .brand-tagline {
        font-size: 0.62rem;
        color: var(--muted);
        font-weight: 500;
        letter-spacing: 0.03em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        gap: 2px;
        align-items: center;
        flex: 1;
        justify-content: center;
      }
      .nav-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        border: 1px solid rgba(212,167,55,0.15);
        background: rgba(212,167,55,0.04);
        transition: all 0.25s ease;
        white-space: nowrap;
        position: relative;
      }
      .nav-item::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #B8860B, #D4AF37, #E8C547);
        border-radius: 1px;
        transition: all 0.3s ease;
      }
      .nav-item:hover {
        background: rgba(212, 167, 55, 0.12);
        border-color: rgba(212, 167, 55, 0.3);
      }
      .nav-item:hover::after {
        width: 60%;
      }
      .nav-item.active {
        background: rgba(212, 167, 55, 0.18);
        border-color: rgba(212, 167, 55, 0.4);
      }
      .nav-item.active::after {
        width: 60%;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }
      .search-form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(212,167,55,0.05);
        border: 1px solid rgba(212, 167, 55, 0.25);
        border-radius: 10px;
        padding: 7px 14px;
        width: 190px;
        transition: all 0.3s ease;
        cursor: text;
        backdrop-filter: blur(4px);
        position: relative;
      }
      .search-form:hover {
        border-color: rgba(212, 167, 55, 0.4);
        background: rgba(212, 167, 55, 0.08);
      }
      .search-form:focus-within {
        border-color: rgba(212, 167, 55, 0.6);
        background: rgba(212, 167, 55, 0.12);
        box-shadow: 0 0 28px -6px rgba(212,167,55,0.3);
      }
      .nav-count {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .nav-count::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #D4AF37;
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header role="banner" class="site-header">
      <nav
        itemscope
        itemtype="https://schema.org/SiteNavigationElement"
        class="container"
        aria-label="Main navigation"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "0 1.5rem",
          maxWidth: "1400px",
          margin: "0 auto",
          height: "70px"
        }}
      >
        <a href="/" class="brand" aria-label="CourseSpeak Home">
          <span class="brand-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 48 48" fill="currentColor">
              <path d="M24 5L4 16l20 11 16-8.8V33h4V16L24 5zm0 8.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5-2.5-1.12-2.5-2.5 1.12-2.5 2.5-2.5zM12.5 25.5L24 32l11.5-6.5V28L24 34.5 12.5 28v-2.5z"/>
            </svg>
          </span>
          <div class="brand-text">
            <span class="brand-name">CourseSpeak</span>
            <span class="brand-tagline">Free Udemy Courses Daily</span>
          </div>
        </a>

        <div class="nav-links">
          <a href="/deals" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/deals' }]}
            aria-current={currentPath === '/deals' ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6l4-4z"/><path d="M2 6h20"/><path d="M16 2v4H8V2"/><rect x="8" y="10" width="8" height="6"/></svg>
            <span itemprop="name">Latest Coupons</span>
          </a>
          <a href="/categories" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/categories' || currentPath.startsWith('/categories/') }]}
            aria-current={currentPath === '/categories' || currentPath.startsWith('/categories/') ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            <span itemprop="name">Course Categories</span>
          </a>
          <a href="/instructors" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/instructors' }]}
            aria-current={currentPath === '/instructors' ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span itemprop="name">Top Instructors</span>
          </a>
          <a href="/topics" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/topics' || currentPath.startsWith('/topics/') }]}
            aria-current={currentPath === '/topics' || currentPath.startsWith('/topics/') ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <span itemprop="name">Learning Topics</span>
          </a>
          <a href="/blog" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/blog' || currentPath.startsWith('/blog/') }]}
            aria-current={currentPath === '/blog' || currentPath.startsWith('/blog/') ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span itemprop="name">Top Udemy Coupons</span>
          </a>
        </div>

        <div class="nav-right">
          <form action="/search" method="get" class="search-form" role="search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={{ flexShrink: 0, opacity: 0.9 }}>
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              type="text"
              name="q"
              placeholder="Search courses..."
              style={{
                background: 'transparent',
                color: 'var(--text)',
                border: 'none',
                fontSize: '0.82rem',
                width: '100%',
                outline: 'none',
                padding: 0
              }}
            />
          </form>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    {currentPath !== '/' && !currentPath.startsWith('/deal/') && (
      <nav 
        aria-label="Breadcrumb" 
        class="container" 
        style={{ 
          padding: "12px 0", 
          fontSize: "0.85rem",
          borderBottom: "1px solid var(--border)",
          textAlign: "center"
        }}
      >
        <ol style={{ display: "inline-flex", gap: "8px", listStyle: "none", margin: "0 auto", padding: 0, alignItems: "center", flexWrap: "wrap" }}>
          <li style={{ display: "flex", alignItems: "center" }}>
            <a href="/" style={{ color: "var(--muted)", textDecoration: "none", display: "flex", alignItems: "center", gap: "4px" }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span>Home</span>
            </a>
          </li>
          
          {/* Build breadcrumb based on path */}
          {currentPath === '/deals' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>All Deals</span></li></>
          )}
          
          {currentPath === '/categories' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>Categories</span></li></>
          )}
          
          {currentPath.startsWith('/categories/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><a href="/categories" style={{ color: "var(--muted)", textDecoration: "none" }}>Categories</a></li>
            <li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>{currentPath.split('/')[2]?.replace(/-/g, ' ')?.replace(/\b\w/g, l => l.toUpperCase()) || 'Category'}</span></li></>
          )}
          
          {currentPath === '/topics' && (
