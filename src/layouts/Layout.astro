---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** MIME type for og:image (e.g. image/svg+xml for generated covers). */
  ogImageType?: string;
  type?: string;
  canonical?: string;
}


const {
  title = "CourseSpeak - Free Udemy Courses & Deals",
  description = "Find verified Udemy deals with 100% off coupons. Updated daily with free courses and discounts.",
  image, // No default - let each page provide its own image
  ogImageType = "image/jpeg",
  type = "website",
  canonical,
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://coursespeak.com";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;

const absoluteImageUrl = image ? (image.startsWith('http') ? image : new URL(image, siteUrl).href) : null;

// Get current path for navigation active states
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    {canonicalURL.includes('/deal/') && !canonicalURL.includes('.amp') && (
      <link rel="amphtml" href={canonicalURL.replace(/\/$/, '') + '.amp/'} />
    )}
    
    <!-- Performance & SEO Meta Tags -->
    <meta name="theme-color" content="#1a1a2e" />
    <meta name="msapplication-TileColor" content="#1a1a2e" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CourseSpeak" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    
    <!-- DNS prefetch for external domains -->
    <link rel="dns-prefetch" href="//www.udemy.com" />
    <link rel="dns-prefetch" href="//www.coursera.org" />
    <link rel="dns-prefetch" href="//www.edx.org" />
    
    <!-- Resource hints -->
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="HISPISPt9Gk-zER-OUkGcPtm6cyiQ7snnKwzn7aDgTY" />

    <!-- Comprehensive SEO Meta Tags -->
    <meta name="author" content="Josh Smith" />
    <meta name="publisher" content="CourseSpeak" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="revisit-after" content="1 days" />
    <meta name="language" content="English" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="classification" content="Education, Online Learning, Course Deals" />
    <meta name="category" content="Education" />
    <link rel="author" href="https://www.linkedin.com/in/anandayuda/" />
    <link rel="publisher" href="https://coursespeak.com" />

    <!-- Organization Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "logo": "https://coursespeak.com/logo.svg",
      "description": "Find verified Udemy courses with 100% off coupons. Updated daily with free courses and discounts.",
      "foundingDate": "2023",
      "sameAs": [
        "https://www.facebook.com/CourseSpeakOfficial",
        "https://x.com/courses_peak",
        "https://www.linkedin.com/company/coursespeak"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://coursespeak.com/contact"
      }
    }
    </script>

    <!-- Site Sitemap Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "@id": "https://coursespeak.com/sitemap",
      "name": "CourseSpeak Sitemap",
      "description": "Complete navigation structure for CourseSpeak website",
      "url": "https://coursespeak.com/sitemap",
      "potentialAction": {
        "@type": "ReadAction",
        "target": [
          "https://coursespeak.com/",
          "https://coursespeak.com/deals",
          "https://coursespeak.com/instructors",
          "https://coursespeak.com/categories",
          "https://coursespeak.com/topics",
          "https://coursespeak.com/popular",
          "https://coursespeak.com/about",
          "https://coursespeak.com/contact",
          "https://coursespeak.com/privacy",
          "https://coursespeak.com/terms",
          "https://coursespeak.com/udemy-coupons-guide",
          "https://coursespeak.com/how-to-redeem-coupon",
          "https://coursespeak.com/blog"
        ]
      }
    }
    </script>

    <!-- WebSite Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "description": "Find verified Udemy courses with 100% off coupons. Daily updated deals for online learning.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://coursespeak.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@id": "https://coursespeak.com/#organization"
      },
      "inLanguage": "en-US",
      "copyrightHolder": {
        "@id": "https://coursespeak.com/#organization"
      }
    }
    </script>

    <!-- Site Navigation Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "name": "Main Navigation",
      "url": "https://coursespeak.com",
      "potentialAction": [
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/deals",
          "name": "Latest Coupons"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/instructors",
          "name": "Instructors"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/categories",
          "name": "Categories"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/topics",
          "name": "Topics"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/udemy-coupons-guide",
          "name": "Coupons Guide"
        },
        {
          "@type": "ReadAction",
          "target": "https://coursespeak.com/blog",
          "name": "Blog"
        }
      ]
    }
    </script>

    <!-- Enhanced Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CourseSpeak" />
    <meta property="og:locale" content="en_US" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    {/* width/height omitted — let Facebook auto-detect to avoid mismatch */}

    {absoluteImageUrl && <meta property="og:image:alt" content={title} />}
    {absoluteImageUrl && <meta property="og:image:type" content={ogImageType} />}

    <!-- Enhanced Twitter Cards -->
    <meta property="twitter:card" content={absoluteImageUrl ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@courses_peak" />
    <meta property="twitter:creator" content="@courses_peak" />
    {absoluteImageUrl && <meta property="twitter:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="twitter:image:alt" content={title} />}

    <!-- Additional Social Sharing Meta Tags -->
    <meta property="article:author" content="Josh Smith" />
    <meta property="article:publisher" content="https://coursespeak.com" />

    <!-- Optimized Font Loading for Core Web Vitals -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- ConvertKit Embed Script -->
    <script async src="https://f.convertkit.com/ckjs/ck.5.js"></script>

    <!-- AdSense Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8220442576502761"
     crossorigin="anonymous"></script>

    <style>
      /* Basic styles */
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;
      }
      
      /* Optimized social media hover effects */
      .facebook-hover:hover,
      .x-hover:hover,
      .linkedin-hover:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(255, 193, 7, 0.15);
        border-color: var(--brand);
      }

      .facebook-hover:hover span,
      .x-hover:hover span,
      .linkedin-hover:hover span {
        color: var(--brand);
      }

      /* Navigation link hover effects */
      .nav-link:hover {
        background: rgba(255, 193, 7, 0.08) !important;
        transform: translateY(-1px);
      }

      .nav-link:active {
        transform: translateY(0);
      }

      .skip-link {
        position: absolute;
        top: -100px;
        left: 8px;
        z-index: 9999;
        background: var(--brand);
        color: var(--bg);
        padding: 8px 16px;
        border-radius: 0 0 8px 8px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header
      role="banner"
      class="site-header"
      style={{
        position: "sticky",
        top: 0,
        zIndex: 1000,
        background: "var(--bg)",
        borderBottom: "1px solid var(--border)"
      }}
    >
      <nav
        itemscope
        itemtype="https://schema.org/SiteNavigationElement"
        class="container"
        aria-label="Main navigation"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "10px 16px",
          maxWidth: "1400px",
          margin: "0 auto"
        }}
      >
        {/* Logo on left */}
        <a href="/" class="logo" style={{ flexShrink: 0 }}>
          <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
            <div style={{ 
              width: "40px", 
              height: "40px", 
              background: "linear-gradient(135deg, hsl(45,95%,35%) 0%, hsl(35,90%,45%) 100%)",
              borderRadius: "10px",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              position: "relative",
              boxShadow: "0 4px 12px -2px hsla(45,95%,35%,0.4)"
            }}>
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/>
              </svg>
            </div>
            <div style={{ display: "flex", flexDirection: "column" }}>
              <span
                style={{ 
                  fontSize: "1.6rem", 
                  fontWeight: 800, 
                  lineHeight: "1.2"
                }}
              >
                <span style={{
                  background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
                  WebkitBackgroundClip: "text",
                  WebkitTextFillColor: "transparent",
                  backgroundClip: "text"
                }}>Course</span>
                <span style={{
                  background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
                  WebkitBackgroundClip: "text",
                  WebkitTextFillColor: "transparent",
                  backgroundClip: "text"
                }}>Speak</span>
              </span>
              <span
                style={{ 
                  fontSize: "0.75rem", 
                  color: "var(--muted)",
                  fontWeight: 600,
                  letterSpacing: "0.1em"
                }}
              >FREE UDEMY COURSES</span>
            </div>
          </div>
        </a>

        {/* Navigation: All Links on Left - Search on Right */}
        <div style={{ display: "flex", gap: "4px", alignItems: "center", flex: 1, justifyContent: "space-between", minWidth: 0 }}>
          
          {/* LEFT SIDE: All Menu Links */}
          <div style={{ display: "flex", gap: "4px", alignItems: "center" }}>
            <a
              itemprop="url"
              href="/deals"
              style={{
                color: currentPath === '/deals' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.8rem",
                fontWeight: 600,
                padding: "5px 8px",
                borderRadius: "4px",
                transition: "all 0.2s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                background: currentPath === '/deals' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
              class={currentPath === '/deals' ? 'active' : 'nav-link'}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.41zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
              </svg>
              <span itemprop="name">Latest Coupons</span>
            </a>
            
            <a
              itemprop="url"
              href="/categories"
              style={{
                color: currentPath === '/categories' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.8rem",
                fontWeight: 600,
                padding: "5px 8px",
                borderRadius: "4px",
                transition: "all 0.2s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                background: currentPath === '/categories' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l-5.5 9h11z"/>
                <circle cx="17.5" cy="17.5" r="4.5"/>
                <path d="M3 13.5h8v8H3z"/>
              </svg>
              <span itemprop="name">Course Categories</span>
            </a>
            
            <a
              itemprop="url"
              href="/instructors"
              style={{
                color: currentPath === '/instructors' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.8rem",
                fontWeight: 600,
                padding: "5px 8px",
                borderRadius: "4px",
                transition: "all 0.2s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                background: currentPath === '/instructors' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <span itemprop="name">Top Instructors</span>
            </a>
            
            <a
              itemprop="url"
              href="/topics"
              style={{
                color: currentPath === '/topics' ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.8rem",
                fontWeight: 600,
                padding: "5px 8px",
                borderRadius: "4px",
                transition: "all 0.2s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                background: currentPath === '/topics' ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
              </svg>
              <span itemprop="name">Learning Topics</span>
            </a>
            
            <a
              itemprop="url"
              href="/blog"
              style={{
                color: currentPath === '/blog' || currentPath.startsWith('/blog/') ? 'var(--brand)' : 'var(--text)',
                textDecoration: "none",
                fontSize: "0.8rem",
                fontWeight: 600,
                padding: "5px 8px",
                borderRadius: "4px",
                transition: "all 0.2s ease",
                display: "flex",
                alignItems: "center",
                gap: "4px",
                whiteSpace: "nowrap",
                background: currentPath === '/blog' || currentPath.startsWith('/blog/') ? 'rgba(255, 193, 7, 0.1)' : 'transparent'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                <path d="M14 17H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
              </svg>
              <span itemprop="name">Top Udemy Coupons</span>
            </a>
          </div>

          {/* RIGHT SIDE: Search Bar */}
          <form action="/search" method="get" style={{ 
            display: "flex", 
            gap: "0",
            background: "var(--card)",
            borderRadius: "8px",
            border: "1px solid var(--border)",
            overflow: "hidden",
            width: "280px",
            flexShrink: 0,
            marginRight: "8px"
          }}>
            <input 
              type="text" 
              name="q" 
              placeholder="Search courses..." 
              style={{
                background: 'transparent',
                color: 'var(--text)',
                border: 'none',
                padding: '6px 10px',
                fontSize: '0.8rem',
                width: '100%',
                outline: 'none'
              }}
            />
            <button 
              type="submit" 
              style={{
                background: 'var(--brand)',
                color: 'var(--bg)',
                border: 'none',
                padding: '6px 10px',
                fontSize: '0.8rem',
                cursor: 'pointer',
                fontWeight: '600',
                display: 'flex',
                alignItems: 'center'
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
              </svg>
            </button>
          </form>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    {currentPath !== '/' && !currentPath.startsWith('/deal/') && (
      <nav 
        aria-label="Breadcrumb" 
        class="container" 
        style={{ 
          padding: "12px 0", 
          fontSize: "0.85rem",
          borderBottom: "1px solid var(--border)"
        }}
      >
        <ol style={{ display: "flex", gap: "8px", listStyle: "none", margin: 0, padding: 0, alignItems: "center", flexWrap: "wrap" }}>
          <li style={{ display: "flex", alignItems: "center" }}>
            <a href="/" style={{ color: "var(--muted)", textDecoration: "none", display: "flex", alignItems: "center", gap: "4px" }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span>Home</span>
            </a>
          </li>
          
          {/* Build breadcrumb based on path */}
          {currentPath === '/deals' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>All Deals</span></li></>
          )}
          
          {currentPath === '/categories' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>Categories</span></li></>
          )}
          
          {currentPath.startsWith('/categories/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><a href="/categories" style={{ color: "var(--muted)", textDecoration: "none" }}>Categories</a></li>
            <li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>{currentPath.split('/')[2]?.replace(/-/g, ' ')?.replace(/\b\w/g, l => l.toUpperCase()) || 'Category'}</span></li></>
          )}
          
          {currentPath === '/topics' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><span style={{ color: "var(--text)", fontWeight: 500 }}>Topics</span></li></>
          )}
          
          {currentPath.startsWith('/topics/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li><a href="/topics" style={{ color: "var(--muted)", textDecoration: "none" }}>Topics</a></li>
