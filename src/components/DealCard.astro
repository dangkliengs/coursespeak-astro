---
import { Image } from 'astro:assets';
import { createInstructorSlug, parseInstructors } from '../lib/instructors';
import { slugifyCategory } from '../lib/slug';
import { getInstructorImageByName } from '../lib/instructorProfiles';
import instructorDirectory from '../data/instructorCounts.json';

const { deal, eager = false } = Astro.props;

const instructorsList = deal.instructor ? parseInstructors(deal.instructor) : [];
const instructorProfileSlug = createInstructorSlug(instructorsList[0] ?? deal.instructor);

// ===== Instructor header: foto + nama + flag bahasa =====
const LANG_FLAGS: Record<string, string> = {
  english: "🇺🇸", spanish: "🇪🇸", turkish: "🇹🇷", german: "🇩🇪", french: "🇫🇷",
  portuguese: "🇧🇷", italian: "🇮🇹", arabic: "🇸🇦", indonesian: "🇮🇩", hindi: "🇮🇳",
  japanese: "🇯🇵", korean: "🇰🇷", chinese: "🇨🇳", russian: "🇷🇺", dutch: "🇳🇱",
  polish: "🇵🇱", thai: "🇹🇭", vietnamese: "🇻🇳", ukrainian: "🇺🇦", greek: "🇬🇷",
};
const firstInstructor = instructorsList[0] ?? "";
const instructorImg = firstInstructor ? getInstructorImageByName(firstInstructor) : undefined;
const instructorInitials = firstInstructor.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
const dealLang = String(deal.language || "").trim();
const langFlag = LANG_FLAGS[dealLang.toLowerCase()] || "";
const dirEntry = (instructorDirectory as unknown as Record<string, { name?: string; count?: number }>)[instructorProfileSlug];
const instructorCoursesCount = typeof dirEntry?.count === "number" ? dirEntry.count : undefined;
const insSub = typeof instructorCoursesCount === "number"
  ? `${instructorCoursesCount} course${instructorCoursesCount === 1 ? "" : "s"}`
  : (dealLang || deal.category || deal.provider || "Udemy");

function formatDuration(duration: string) {
  if (!duration) return "";

  return duration
    .replace(/(\d+)h/g, '$1 hours')
    .replace(/(\d+)m/g, '$1 minutes')
    .replace(/\s+/g, ' ');
}

function formatCompact(n: number) {
  if (!isFinite(n)) return "0";
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}

function formatMonthYear(dateString: string) {
  try {
    const d = new Date(dateString);
    if (isNaN(d.getTime())) return "Recently";
    return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
  } catch {
    return "Recently";
  }
}

function genRating(key: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < key.length; i++) {
    h ^= key.charCodeAt(i);
    h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
  }
  const r = (h >>> 0) / 0xffffffff;
  const val = 4.5 + 0.3 * r;
  return Math.round(val * 10) / 10;
}

function genStudents(key: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < key.length; i++) {
    h ^= key.charCodeAt(i);
    h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
  }
  const r = (h >>> 0) / 0xffffffff;
  const min = 1000, max = 80000;
  const val = Math.floor(min + (max - min) * Math.pow(r, 0.6));
  return Math.round(val / 10) * 10;
}

const key = String(deal.id || "");
const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : genRating(key);
const studentsVal = typeof deal.students === "number" && isFinite(deal.students) ? deal.students : genStudents(key);
const studentsShort = formatCompact(studentsVal);
const hasDiscount = op > p && p > 0;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
const updatedLabel = deal.updatedAt ? formatMonthYear(deal.updatedAt) : "Recently";
const durationLabel = deal.duration ? formatDuration(deal.duration) : "—";
const topicHref = deal.subcategory
  ? `/topics/${deal.subcategory.toLowerCase().replace(/c\s*\+\+/g, 'cpp').replace(/#/g, 'sharp').replace(/\+/g, 'plus').replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-')}/`
  : null;
const categoryHref = deal.category ? `/categories/${slugifyCategory(deal.category)}/` : null;
---

<div style={{
  background: "var(--card)",
  borderRadius: "12px",
  border: "1px solid var(--border)",
  overflow: "hidden",
  transition: "all 0.3s ease",
  position: "relative",
  display: "flex",
  flexDirection: "column"
}}>
  {/* Instructor header — foto + nama + jumlah kursus + flag */}
  <div class="deal-ins-header" style={{
    display: "flex",
    alignItems: "center",
    gap: "0.75rem",
    padding: "1rem 1.1rem"
  }}>
    {firstInstructor && (
      <>
        <a
          href={`/instructor/${instructorProfileSlug}`}
          aria-label={firstInstructor}
          tabindex="-1"
          style={{
            width: "48px",
            height: "48px",
            flexShrink: 0,
            borderRadius: "6px",
            overflow: "hidden",
            display: "block",
            background: "var(--card-hover)",
            border: "1px solid var(--border)",
            textDecoration: "none"
          }}
        >
          {instructorImg ? (
            <Image
              src={instructorImg}
              alt={firstInstructor}
              width={48}
              height={48}
              loading="lazy"
              decoding="async"
              inferSize={false}
              style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }}
            />
          ) : (
            <span style={{
              width: "100%", height: "100%",
              display: "flex", alignItems: "center", justifyContent: "center",
              fontWeight: 800, fontSize: "1rem", color: "var(--brand)"
            }} aria-hidden="true">{instructorInitials}</span>
          )}
        </a>
        <div style={{ display: "flex", flexDirection: "column", minWidth: 0, flex: 1 }}>
          {instructorsList.length === 1 ? (
            <a
              href={`/instructor/${instructorProfileSlug}`}
              style={{
                fontSize: "1rem", fontWeight: 700, color: "var(--text)",
                lineHeight: 1.25, textDecoration: "none",
                whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
              }}
            >
              {firstInstructor}
            </a>
          ) : (
            <span style={{
              fontSize: "1rem", fontWeight: 700, color: "var(--text)",
              lineHeight: 1.25,
              whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
            }}>
              {instructorsList.map((n, i) => (
                <Fragment key={n}>
                  {i > 0 && ", "}
                  <a
                    href={`/instructor/${createInstructorSlug(n)}`}
                    style={{ color: "inherit", textDecoration: "none" }}
                  >
                    {n}
                  </a>
                </Fragment>
              ))}
            </span>
          )}
          <span style={{ fontSize: "0.9rem", color: "var(--muted)", marginTop: "1px" }}>{insSub}</span>
        </div>
        {langFlag ? (
          <span title={dealLang} role="img" aria-label={dealLang} style={{ fontSize: "1.6rem", lineHeight: 1, flexShrink: 0 }}>{"\u2009"}{langFlag}</span>
        ) : dealLang ? (
          <span title={dealLang} style={{
            flexShrink: 0, fontSize: "0.7rem", fontWeight: 800, letterSpacing: "0.06em",
            color: "var(--brand)", background: "var(--brand-soft)",
            border: "1px solid rgba(212,167,55,0.35)", padding: "4px 8px", borderRadius: "6px"
          }}>{dealLang.slice(0, 2).toUpperCase()}</span>
        ) : null}
      </>
    )}
  </div>

  {/* Image — bersih: hanya %OFF kanan-atas + Verified kiri-bawah */}

  <div style={{
    height: "200px",
    background: `linear-gradient(135deg, var(--brand-soft) 0%, var(--accent-soft) 100%)`,
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    position: "relative"
  }}>
    {deal.image ? (
      <Image
        src={deal.image}
        alt={title}
        width={400}
        height={225}
        style={{
          width: "100%",
          height: "100%",
          objectFit: "cover"
        }}
        loading="lazy"
        inferSize={false}
      />
    ) : (
      <svg width="60" height="60" viewBox="0 0 24 24" fill="var(--muted)" opacity="0.5">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    )}

    {/* % OFF — kanan atas (data asli coursespeak) */}
    {hasDiscount && discountPct !== null && (
      <div style={{
        position: "absolute",
        top: 0,
        right: "12px",
        background: "#C1272D",
        color: "white",
        padding: "7px 12px",
        fontSize: "0.85rem",
        fontWeight: 800,
        zIndex: 2
      }}>
        {discountPct}% OFF
      </div>
    )}
    {p === 0 && (
      <div style={{
        position: "absolute",
        top: 0,
        right: "12px",
        background: "#C1272D",
        color: "white",
        padding: "7px 12px",
        fontSize: "0.85rem",
        fontWeight: 800,
        zIndex: 2
      }}>
        100% FREE
      </div>
    )}

    {/* Verified — kiri bawah (data asli, dipertahankan agar lengkap) */}
    <div style={{
      position: "absolute",
      bottom: "12px",
      left: "12px",
      background: "rgba(22, 163, 74, 0.95)",
      color: "white",
      padding: "0.25rem 0.6rem",
      borderRadius: "999px",
      fontSize: "0.7rem",
      fontWeight: 700,
      display: "flex",
      alignItems: "center",
      gap: "0.25rem",
      zIndex: 2
    }}>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="white">
        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
      </svg>
      Verified
    </div>
  </div>

  {/* Body center ala referensi */}
  <div style={{ padding: "1.25rem 1.25rem 1.4rem", textAlign: "center", display: "flex", flexDirection: "column", flex: 1 }}>
    {/* Title */}
    <h3 style={{
      fontSize: "1.05rem",
      fontWeight: 800,
      color: "var(--text)",
      margin: "0 0 0.65rem",
      lineHeight: 1.35,
      display: "-webkit-box",
      WebkitLineClamp: 2,
      WebkitBoxOrient: "vertical",
      overflow: "hidden",
      minHeight: "2.8em"
    }}>
      <a href={`/deal/${deal.id}`} style={{ color: "inherit", textDecoration: "none" }}>
        {title}
      </a>
    </h3>

    {/* Description — dipertahankan agar data lengkap (referensi tidak ada, tapi coursespeak butuh) */}
    <p style={{
      color: "var(--muted)",
      fontSize: "0.85rem",
      margin: "0 0 0.7rem",
      lineHeight: 1.5,
      display: "-webkit-box",
      WebkitLineClamp: 2,
      WebkitBoxOrient: "vertical",
      overflow: "hidden"
    }}>
      {deal.description || "Master this in-demand skill with comprehensive training from industry experts."}
    </p>

    {/* Breadcrumb: Category › Subcategory — satu baris center, dua link internal */}
    {(categoryHref || topicHref) && (
      <div style={{ marginBottom: "0.7rem", display: "flex", justifyContent: "center", alignItems: "center", gap: "0.4rem", flexWrap: "wrap" }}>
        {categoryHref && (
          <a href={categoryHref} style={{
            color: "var(--muted)",
            textDecoration: "none",
            fontSize: "0.75rem",
            fontWeight: 700,
            letterSpacing: "0.02em"
          }} title={`Browse ${deal.category} courses`}>
            {deal.category}
          </a>
        )}
        {categoryHref && topicHref && (
          <span aria-hidden="true" style={{ color: "var(--muted)", opacity: 0.6, fontSize: "0.75rem" }}>›</span>
        )}
        {topicHref && (
          <a href={topicHref} style={{
            display: "inline-flex",
            alignItems: "center",
            gap: "0.3rem",
            color: "var(--brand)",
            textDecoration: "none",
            fontSize: "0.75rem",
            fontWeight: 700,
            letterSpacing: "0.02em",
            padding: "0.3rem 0.65rem",
            borderRadius: "999px",
            background: "var(--brand-soft)",
            border: "1px solid rgba(212,167,55,0.3)"
          }} title={`Browse ${deal.subcategory} courses`}>
            {deal.subcategory}
          </a>
        )}
      </div>
    )}

    {/* Rating: 5 bintang + angka rating saja.
        Angka students TIDAK diklaim sebagai reviews di sini —
        students sudah tampil jujur di stats 3 kolom di bawah. */}
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      gap: "0.5rem",
      marginBottom: "0.9rem",
      flexWrap: "wrap"
    }}>
      <span style={{ display: "inline-flex", gap: "3px", alignItems: "center" }} aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--brand)">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
      </span>
      <span
        style={{ color: "var(--muted)", fontSize: "0.9rem", fontWeight: 600 }}
        title={`${r.toFixed(1)} out of 5 · ${studentsVal.toLocaleString("en-US")} students`}
        aria-label={`Rated ${r.toFixed(1)} out of 5`}
      >
        {r.toFixed(1)}
      </span>
    </div>

    {/* Stats 3 kolom: students | content | updated */}
    <div style={{
      display: "grid",
      gridTemplateColumns: "1fr 1fr 1fr",
      borderTop: "1px solid var(--border)",
      borderBottom: "1px solid var(--border)",
      padding: "0.9rem 0"
    }}>
      <div style={{ display: "flex", flexDirection: "column", gap: "2px" }}>
        <span style={{ fontSize: "1.05rem", fontWeight: 800, color: "var(--text)" }} title={`${studentsVal.toLocaleString("en-US")} students`}>{studentsShort}</span>
        <span style={{ fontSize: "0.85rem", color: "var(--muted)" }}>students</span>
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: "2px" }}>
        <span style={{ fontSize: "1.05rem", fontWeight: 800, color: "var(--text)" }}>{durationLabel}</span>
        <span style={{ fontSize: "0.85rem", color: "var(--muted)" }}>content</span>
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: "2px" }}>
        <span style={{ fontSize: "1.05rem", fontWeight: 800, color: "var(--text)" }}>{updatedLabel}</span>
        <span style={{ fontSize: "0.85rem", color: "var(--muted)" }}>updated</span>
      </div>
    </div>

    {/* Price center */}
    <div style={{
      display: "flex",
      alignItems: "baseline",
      justifyContent: "center",
      gap: "0.6rem",
      paddingTop: "1rem",
      marginTop: "auto"
    }}>
      {hasDiscount && (
        <span style={{
          textDecoration: "line-through",
          color: "var(--muted)",
          fontSize: "1rem",
          fontWeight: 600
        }}>
          ${op.toFixed(2)}
        </span>
      )}
      <span style={{
        fontSize: "1.3rem",
        fontWeight: 800,
        color: "var(--text)",
        letterSpacing: "0.02em"
      }}>
        {p === 0 ? "FREE" : `$${p.toFixed(2)}`}
      </span>
    </div>
  </div>
</div>

<style>
  .deal-ins-header a:hover { text-decoration: underline !important; }
</style>
