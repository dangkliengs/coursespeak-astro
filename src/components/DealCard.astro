---
import { Image } from 'astro:assets';
import { createInstructorSlug, parseInstructors } from '../lib/instructors';
import { getInstructorImageByName } from '../lib/instructorProfiles';
import instructorDirectory from '../data/instructorCounts.json';

const { deal, eager = false } = Astro.props;

const instructorsList = deal.instructor ? parseInstructors(deal.instructor) : [];
const instructorProfileSlug = createInstructorSlug(instructorsList[0] ?? deal.instructor);

// ===== Instructor header: foto + nama + flag bahasa =====
const LANG_FLAGS: Record<string, string> = {
  english: "🇺🇸", spanish: "🇪🇸", turkish: "🇹🇷", german: "🇩🇪", french: "🇫🇷",
  portuguese: "🇧🇷", italian: "🇮🇹", arabic: "🇸🇦", indonesian: "🇮🇩", hindi: "🇮🇳",
  japanese: "🇯🇵", korean: "🇰🇷", chinese: "🇨🇳", russian: "🇷🇺", dutch: "🇳🇱",
  polish: "🇵🇱", thai: "🇹🇭", vietnamese: "🇻🇳", ukrainian: "🇺🇦", greek: "🇬🇷",
};
const firstInstructor = instructorsList[0] ?? "";
const instructorImg = firstInstructor ? getInstructorImageByName(firstInstructor) : undefined;
const instructorInitials = firstInstructor.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
const dealLang = String(deal.language || "").trim();
const langFlag = LANG_FLAGS[dealLang.toLowerCase()] || "";
const dirEntry = (instructorDirectory as unknown as Record<string, { name?: string; count?: number }>)[instructorProfileSlug];
const instructorCoursesCount = typeof dirEntry?.count === "number" ? dirEntry.count : undefined;
const insSub = typeof instructorCoursesCount === "number"
  ? `${instructorCoursesCount} course${instructorCoursesCount === 1 ? "" : "s"}`
  : (dealLang || deal.category || deal.provider || "Udemy");

function formatDuration(duration: string) {
  if (!duration) return "";
  
  return duration
    .replace(/(\d+)h/g, '$1 hours')
    .replace(/(\d+)m/g, '$1 minutes')
    .replace(/\s+/g, ' ');
}

function formatRelativeTime(dateString: string) {
  const date = new Date(dateString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffHours / 24);

  if (diffHours < 1) {
    return "Updated recently";
  } else if (diffHours < 24) {
    return `Updated ${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;
  } else {
    return `Updated ${diffDays} day${diffDays === 1 ? '' : 's'} ago`;
  }
}

function genRating(key: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < key.length; i++) {
    h ^= key.charCodeAt(i);
    h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
  }
  const r = (h >>> 0) / 0xffffffff;
  const val = 4.5 + 0.3 * r;
  return Math.round(val * 10) / 10;
}

function genStudents(key: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < key.length; i++) {
    h ^= key.charCodeAt(i);
    h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
  }
  const r = (h >>> 0) / 0xffffffff;
  const min = 1000, max = 80000;
  const val = Math.floor(min + (max - min) * Math.pow(r, 0.6));
  return Math.round(val / 10) * 10;
}

const key = String(deal.id || "");
const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : genRating(key);
const hasDiscount = op > p && p > 0;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
---

<div style={{
  background: "var(--card)",
  borderRadius: "16px",
  border: "1px solid var(--border)",
  overflow: "hidden",
  transition: "all 0.3s ease",
  position: "relative"
}}>
  {/* Instructor header — foto + nama + flag bahasa, di atas */}
  <div class="deal-ins-header" style={{
    display: "flex",
    alignItems: "center",
    gap: "0.75rem",
    padding: "1.1rem 1.25rem 1rem"
  }}>
    {firstInstructor && (
      <>
        <a
          href={`/instructor/${instructorProfileSlug}`}
          aria-label={firstInstructor}
          tabindex="-1"
          style={{
            width: "44px",
            height: "44px",
            flexShrink: 0,
            borderRadius: "10px",
            overflow: "hidden",
            display: "block",
            background: "var(--card-hover)",
            border: "1px solid rgba(212,167,55,0.35)",
            textDecoration: "none"
          }}
        >
          {instructorImg ? (
            <Image
              src={instructorImg}
              alt={firstInstructor}
              width={44}
              height={44}
              loading="lazy"
              decoding="async"
              inferSize={false}
              style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }}
            />
          ) : (
            <span style={{
              width: "100%", height: "100%",
              display: "flex", alignItems: "center", justifyContent: "center",
              fontWeight: 800, fontSize: "0.95rem", color: "var(--brand)"
            }} aria-hidden="true">{instructorInitials}</span>
          )}
        </a>
        <div style={{ display: "flex", flexDirection: "column", minWidth: 0, flex: 1 }}>
          {instructorsList.length === 1 ? (
            <a
              href={`/instructor/${instructorProfileSlug}`}
              style={{
                fontSize: "0.95rem", fontWeight: 800, color: "var(--text)",
                lineHeight: 1.25, textDecoration: "none",
                whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
              }}
            >
              {firstInstructor}
            </a>
          ) : (
            <span style={{
              fontSize: "0.95rem", fontWeight: 800, color: "var(--text)",
              lineHeight: 1.25,
              whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
            }}>
              {instructorsList.map((n, i) => (
                <Fragment key={n}>
                  {i > 0 && ", "}
                  <a
                    href={`/instructor/${createInstructorSlug(n)}`}
                    style={{ color: "inherit", textDecoration: "none" }}
                  >
                    {n}
                  </a>
                </Fragment>
              ))}
            </span>
          )}
          <span style={{ fontSize: "0.8rem", color: "var(--muted)", marginTop: "1px" }}>{insSub}</span>
        </div>
        {langFlag ? (
          <span title={dealLang} role="img" aria-label={dealLang} style={{ fontSize: "1.35rem", lineHeight: 1, flexShrink: 0 }}>{langFlag}</span>
        ) : dealLang ? (
          <span title={dealLang} style={{
            flexShrink: 0, fontSize: "0.7rem", fontWeight: 800, letterSpacing: "0.06em",
            color: "var(--brand)", background: "var(--brand-soft)",
            border: "1px solid rgba(212,167,55,0.35)", padding: "4px 8px", borderRadius: "6px"
          }}>{dealLang.slice(0, 2).toUpperCase()}</span>
        ) : null}
      </>
    )}
  </div>

  {/* Image at top with timestamp badge */}
  <div style={{
    height: "180px",
    background: `linear-gradient(135deg, var(--brand-soft) 0%, var(--accent-soft) 100%)`,
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    position: "relative"
  }}>
    {deal.image ? (
      <Image 
        src={deal.image}
        alt={title}
        width={400}
        height={225}
        style={{
          width: "100%",
          height: "100%",
          objectFit: "cover"
        }}
        loading="lazy"
        inferSize={false}
      />
    ) : (
      <svg width="60" height="60" viewBox="0 0 24 24" fill="var(--muted)" opacity="0.5">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    )}

    {/* Timestamp Badge on Image */}
    <div style={{
      position: "absolute",
      top: "1rem",
      right: "1rem",
      background: "rgba(0, 0, 0, 0.8)",
      color: "white",
      padding: "0.25rem 0.5rem",
      borderRadius: "4px",
      fontSize: "0.7rem",
      fontWeight: 600,
      backdropFilter: "blur(4px)"
    }}>
      {deal.updatedAt ? formatRelativeTime(deal.updatedAt) : "Updated recently"}
    </div>

    {/* FREE Badge if applicable */}
    {p === 0 && (
      <div style={{
        position: "absolute",
        top: "1rem",
        left: "1rem",
        background: "var(--brand)",
        color: "var(--bg)",
        padding: "0.25rem 0.75rem",
        borderRadius: "999px",
        fontSize: "0.75rem",
        fontWeight: 700,
        zIndex: 10
      }}>
        FREE
      </div>
    )}
  </div>

  {/* Content below image */}
  <div style={{ padding: "1.25rem 1.5rem 1.5rem" }}>
    {/* Title */}
    <h3 style={{
      fontSize: "1.1rem",
      fontWeight: 700,
      color: "var(--text)",
      marginBottom: "0.5rem",
      lineHeight: 1.4,
      display: "-webkit-box",
      WebkitLineClamp: 2,
      WebkitBoxOrient: "vertical",
      overflow: "hidden"
    }}>
      <a href={`/deal/${deal.id}`} style={{
        color: "inherit",
        textDecoration: "none"
      }}>
        {title}
      </a>
    </h3>

    {/* Description */}
    <p style={{
      color: "var(--muted)",
      fontSize: "0.9rem",
      marginBottom: "1rem",
      lineHeight: 1.5,
      display: "-webkit-box",
      WebkitLineClamp: 3,
      WebkitBoxOrient: "vertical",
      overflow: "hidden"
    }}>
      {deal.description || "Master this in-demand skill with comprehensive training from industry experts."}
    </p>

    {/* Rating, Students & Subcategory - Single Row */}
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      marginBottom: "1rem"
    }}>
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.5rem"
      }}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--brand)">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span style={{
          color: "var(--muted)",
          fontSize: "0.85rem",
          fontWeight: 600
        }} title={`${r.toFixed(1)} out of 5 stars from ${typeof deal.students === "number" && isFinite(deal.students) ? deal.students : genStudents(key)}+ students`}>
          {r.toFixed(1)} ({typeof deal.students === "number" && isFinite(deal.students) ? deal.students : genStudents(key)}+ students)
        </span>
      </div>

      {deal.subcategory && (
        <a href={`/topics/${deal.subcategory.toLowerCase().replace(/c\s*\+\+/g, 'cpp').replace(/#/g, 'sharp').replace(/\+/g, 'plus').replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-')}/`} style={{
          display: "flex",
          alignItems: "center",
          gap: "0.25rem",
          color: "var(--brand)",
          textDecoration: "none",
          fontSize: "0.8rem",
          fontWeight: 600,
          padding: "0.25rem 0.5rem",
          borderRadius: "4px",
          background: "var(--card-hover)",
          transition: "all 0.3s ease"
        }} title={`Browse ${deal.subcategory} courses`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
          </svg>
          {deal.subcategory}
        </a>
      )}
    </div>

    {/* Price, Discount & Verified */}
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      marginBottom: "1rem"
    }}>
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.5rem"
      }}>
        <span style={{
          fontSize: "1.2rem",
          fontWeight: 700,
          color: "var(--brand)"
        }}>
          {p === 0 ? "FREE" : `$${p.toFixed(2)}`}
        </span>
        {hasDiscount && (
          <>
            <span style={{
              textDecoration: "line-through",
              color: "var(--muted)",
              fontSize: "0.9rem"
            }}>
              ${op.toFixed(2)}
            </span>
            <span style={{
              background: "var(--destructive)",
              color: "white",
              padding: "0.25rem 0.5rem",
              borderRadius: "4px",
              fontSize: "0.75rem",
              fontWeight: 700
            }}>
              {discountPct}% OFF
            </span>
          </>
        )}
      </div>

      {/* Verified Badge inline with price */}
      <div style={{
        color: "hsl(120, 60%, 55%)",
        fontSize: "0.7rem",
        fontWeight: 700,
        display: "flex",
        alignItems: "center",
        gap: "0.25rem"
      }}>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="hsl(120, 60%, 55%)">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
        Verified
      </div>
    </div>

    {/* Duration */}
    {deal.duration && (
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.35rem",
        marginBottom: "1rem"
      }}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span style={{
          color: "var(--muted)",
          fontSize: "0.8rem",
          fontWeight: 500
        }}>
          Course Duration: {formatDuration(deal.duration)}
        </span>
      </div>
    )}

    {/* Button */}
    <a
      href={deal.url || `/deal/${deal.id}`}
      target="_blank"
      rel="noopener noreferrer"
      style={{
        display: "block",
        width: "100%",
        padding: "0.75rem 1.5rem",
        background: "var(--brand)",
        color: "var(--bg)",
        textDecoration: "none",
        borderRadius: "8px",
        textAlign: "center",
        fontWeight: 600,
        fontSize: "0.9rem",
        transition: "all 0.3s ease",
        border: "none",
        cursor: "pointer"
      }}
    >
      {p === 0 ? "Enroll for Free" : "Get Coupon"}
    </a>
  </div>
</div>

<style>
  .deal-ins-header a:hover { text-decoration: underline !important; }
</style>
