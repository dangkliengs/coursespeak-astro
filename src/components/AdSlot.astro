---
interface Props {
  /** Ad unit slot id. Falls back to PUBLIC_ADSENSE_AD_SLOT env. */
  slot?: string;
  /** AdSense publisher id. Falls back to PUBLIC_ADSENSE_CLIENT env. */
  publisher?: string;
  /** Extra class for the wrapper. */
  className?: string;
}

const {
  slot,
  publisher = import.meta.env.PUBLIC_ADSENSE_CLIENT || "ca-pub-8220442576502761",
  className = "",
} = Astro.props;

// Real CourseSpeak display ad unit (from the live site's slot 2951964915).
// Override via PUBLIC_ADSENSE_AD_SLOT env if you create a new unit.
const adSlot =
  slot ?? import.meta.env.PUBLIC_ADSENSE_AD_SLOT ?? "2951964915";
const show = Boolean(adSlot);
---

{show && (
  <aside class:list={["ad-slot", className]} aria-label="Advertisement">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={publisher}
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style is:global>
  .ad-slot {
    margin: 2rem 0;
    text-align: center;
  }
  .ad-slot .adsbygoogle {
    width: 100%;
    min-height: 90px;
  }
</style>
