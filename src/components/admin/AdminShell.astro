---
import AdminProtection from "../AdminProtection.astro";
import AdminAuthGate from "../AdminAuthGate";

interface Props {
  title: string;
  badge?: string;
  desc?: string;
  parent?: string;
  parentHref?: string;
}
const { title, badge, desc, parent, parentHref = "/admin" } = Astro.props;

const path = Astro.url.pathname;
const isDashboard = path === "/admin";
const isDeals = path.startsWith("/admin/deals");
const isInstructors = path.startsWith("/admin/instructors");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — CourseSpeak Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark" />
    <style is:global>
      /* ============ Admin dark theme ============ */
      .adm{
        --adm-bg:#0b0e14;
        --adm-surface:#11151c;
        --adm-surface-2:#1c212b;
        --adm-border:#1e242e;
        --adm-border-soft:#232b36;
        --adm-text:#EDE9DC;
        --adm-muted:#868d9b;
        --adm-faint:#5a6472;
        --adm-accent:#D4AF37;
        --adm-accent-strong:#D4AF37;
        --adm-accent-dim:rgba(212,167,55,0.12);
        --adm-accent-border:rgba(212,167,55,0.30);
        --adm-danger:#f07178;
        --adm-ok:#aad94c;
        --adm-ok-dim:rgba(170,217,76,0.12);
        --adm-ok-border:rgba(170,217,76,0.35);
        min-height:100vh;background:var(--adm-bg);color:var(--adm-text);
        font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
        -webkit-font-smoothing:antialiased;display:flex;color-scheme:dark;
      }
      .adm *{box-sizing:border-box;}
      .adm a{text-decoration:none;}
      .adm ::placeholder{color:var(--adm-faint);opacity:1;}
      .adm input[type="checkbox"],.adm input[type="radio"]{accent-color:var(--adm-accent-strong);width:15px;height:15px;}
      .adm input[type="datetime-local"]::-webkit-calendar-picker-indicator{filter:invert(.7);cursor:pointer;}

      /* ================= Sidebar ================= */
      .adm-sidebar{width:74px;flex-shrink:0;background:#0b0e14;border-right:1px solid var(--adm-border);position:sticky;top:0;height:100vh;display:flex;flex-direction:column;z-index:60;}
      /* Sidebar permanen mode ikon + tooltip (tanpa animasi) */
      .adm-sidebar .adm-brand{padding-left:.5rem;padding-right:.5rem;justify-content:center;}
      .adm-sidebar .adm-brand-text,
      .adm-sidebar .adm-nav-section,
      .adm-sidebar .adm-nav-label{display:none;}
      .adm-sidebar .adm-nav{padding-left:.55rem;padding-right:.55rem;}
      .adm-sidebar .adm-nav-item{justify-content:center;padding:.65rem;}
      .adm-sidebar .adm-sidebar-foot .adm-nav-item{justify-content:center;}
      .adm-brand{display:flex;align-items:center;gap:.8rem;padding:1.25rem 1.25rem 1rem;}
      .adm-brand-logo{width:40px;height:40px;border-radius:.7rem;background:#D4AF37;color:#0b0e14;font-weight:800;font-size:1.15rem;display:grid;place-items:center;box-shadow:0 6px 18px rgba(212,167,55,.25);flex-shrink:0;}
      .adm-brand-name{font-weight:800;font-size:1rem;color:var(--adm-text);line-height:1.1;}
      .adm-brand-sub{font-size:.72rem;color:var(--adm-faint);font-weight:600;letter-spacing:.04em;text-transform:uppercase;}
      .adm-nav{flex:1;overflow-y:auto;padding:.5rem .9rem 1rem;scrollbar-width:thin;scrollbar-color:#1e242e transparent;}
      .adm-nav-section{font-size:.7rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--adm-faint);padding:.9rem .75rem .45rem;}
      .adm-nav-item{display:flex;align-items:center;gap:.7rem;padding:.62rem .8rem;border-radius:.6rem;color:var(--adm-muted);font-weight:600;font-size:.9rem;margin-bottom:2px;transition:background .15s,color .15s;position:relative;border:1px solid transparent;}
      .adm-nav-item:hover{background:var(--adm-surface-2);color:var(--adm-text);}
      .adm-nav-item.active{background:var(--adm-accent-dim);color:var(--adm-accent);font-weight:700;border-color:var(--adm-accent-border);}
      .adm-nav-item.active::before{content:"";position:absolute;left:-9px;top:50%;transform:translateY(-50%);width:3px;height:20px;border-radius:2px;background:var(--adm-accent);}
      .adm-nav-item svg{width:18px;height:18px;flex-shrink:0;opacity:1;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
      .adm-sidebar-foot{padding:.9rem;border-top:1px solid var(--adm-border-soft);}

      /* ================= Topbar ================= */
      .adm-main-col{flex:1;min-width:0;display:flex;flex-direction:column;}
      .adm-topbar{position:sticky;top:0;z-index:40;display:flex;align-items:center;gap:1rem;padding:.95rem 1.5rem;background:rgba(11,14,20,0.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--adm-border);}
      .adm-burger{display:none;width:38px;height:38px;border:1px solid var(--adm-border);border-radius:.6rem;background:var(--adm-surface);color:var(--adm-muted);cursor:pointer;place-items:center;flex-shrink:0;font-family:inherit;}
      .adm-burger:hover{color:var(--adm-accent);border-color:var(--adm-accent-border);}
      .adm-burger svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
      .adm-topbar-left{display:flex;align-items:center;gap:.75rem;min-width:0;flex-wrap:wrap;}
      .adm-crumb{display:inline-flex;align-items:center;gap:.35rem;color:var(--adm-muted);font-weight:600;font-size:.82rem;padding:.35rem .75rem;border-radius:.5rem;background:var(--adm-surface-2);border:1px solid var(--adm-border);white-space:nowrap;}
      .adm-crumb:hover{color:var(--adm-accent);border-color:var(--adm-accent-border);}
      .adm-title{margin:0;font-size:1.4rem;font-weight:800;color:var(--adm-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .adm-desc{width:100%;color:var(--adm-muted);font-size:.85rem;margin:0;padding-left:.1rem;}
      .adm-badge{font-size:.78rem;color:var(--adm-muted);background:var(--adm-surface-2);border:1px solid var(--adm-border);padding:.25rem .7rem;border-radius:999px;white-space:nowrap;}
      .adm-topbar-right{display:flex;align-items:center;gap:.6rem;flex-shrink:0;margin-left:auto;flex-wrap:wrap;}
      .adm-overlay{display:none;}

      /* ================= Content ================= */
      .adm-content{width:100%;max-width:1340px;margin:0 auto;padding:1.75rem 1.5rem 4rem;}

      /* ================= Cards & forms ================= */
      .adm-card{background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:1rem;box-shadow:0 12px 32px rgba(0,0,0,0.35);padding:1.5rem;margin-bottom:1.5rem;}
      .adm-grid{display:grid;gap:1.25rem;}
      .adm-grid-2{grid-template-columns:repeat(auto-fit,minmax(220px,1fr));}
      .adm-label{display:block;color:var(--adm-text);font-weight:700;font-size:.9rem;margin-bottom:.45rem;}
      .adm-hint{display:block;color:var(--adm-muted);font-size:.78rem;margin-top:.3rem;line-height:1.4;}
      .adm-input,.adm-select,.adm-textarea{width:100%;padding:.75rem .9rem;background:#0b0e14;border:1px solid var(--adm-border);border-radius:.65rem;color:var(--adm-text);font-size:.95rem;outline:none;box-shadow:none;transition:border-color .15s,box-shadow .15s;font-family:inherit;color-scheme:dark;}
      .adm-input:focus,.adm-select:focus,.adm-textarea:focus{border-color:var(--adm-accent);box-shadow:0 0 0 3px rgba(212,167,55,0.15);}
      .adm-select option{background:#11151c;color:var(--adm-text);}
      .adm-input[readonly],.adm-input:disabled{background:#1c212b;color:var(--adm-muted);cursor:not-allowed;border-color:var(--adm-border);}
      .adm-textarea{resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem;line-height:1.5;}
      .adm-input.code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}
      .adm-form-foot{display:flex;gap:1rem;justify-content:flex-end;align-items:center;padding-top:1rem;border-top:1px solid var(--adm-border);}
      .adm-form-status{color:var(--adm-muted);font-size:.85rem;}
      .adm-btn{display:inline-flex;align-items:center;gap:.45rem;padding:.65rem 1.25rem;border-radius:.6rem;font-weight:700;font-size:.88rem;cursor:pointer;border:1px solid transparent;color:inherit;transition:background .15s,color .15s,border-color .15s;font-family:inherit;line-height:1;}
      .adm-btn:disabled{opacity:.55;cursor:not-allowed;}
      .adm-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
      .adm-btn-primary{background:#D4AF37;color:#0b0e14;}
      .adm-btn-primary:hover:not(:disabled){background:#b8942e;color:#0b0e14;}
      .adm-btn-outline{background:transparent;color:var(--adm-muted);border-color:var(--adm-border-soft);}
      .adm-btn-outline:hover{color:var(--adm-text);border-color:var(--adm-muted);}
      .adm-btn-ghost{background:transparent;color:var(--adm-accent);border-color:var(--adm-accent-border);}
      .adm-btn-ghost:hover{background:var(--adm-accent-dim);}
      .adm-btn-danger{background:transparent;color:var(--adm-danger);border-color:rgba(240,113,120,.35);}
      .adm-btn-danger:hover{background:rgba(240,113,120,.10);}
      .adm-btn-sm{padding:.4rem .75rem;font-size:.8rem;border-radius:.45rem;}

      /* ================= Stats ================= */
      .adm-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:1rem;margin-bottom:1.5rem;}
      .adm-stat{display:flex;align-items:center;gap:1rem;background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:1rem;padding:1.15rem 1.25rem;box-shadow:0 12px 28px rgba(0,0,0,0.30);}
      .adm-stat-ic{width:46px;height:46px;border-radius:.85rem;display:grid;place-items:center;flex-shrink:0;background:var(--adm-accent-dim);color:var(--adm-accent);border:1px solid var(--adm-accent-border);}
      .adm-stat-ic svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
      .adm-stat-body{min-width:0;}
      .adm-stat-num{font-size:1.55rem;font-weight:800;color:var(--adm-text);line-height:1.05;}
      .adm-stat-lbl{font-size:.78rem;color:var(--adm-muted);font-weight:600;margin-top:.2rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

      /* ================= Table ================= */
      .adm-table{width:100%;border-collapse:collapse;color:var(--adm-text);}
      .adm-table th{font-size:.74rem;text-transform:uppercase;letter-spacing:.06em;color:var(--adm-faint);text-align:left;padding:.75rem 1rem;border-bottom:1px solid var(--adm-border);white-space:nowrap;font-weight:800;background:transparent;}
      .adm-table td{padding:.8rem 1rem;font-size:.9rem;border-bottom:1px solid var(--adm-border-soft);vertical-align:middle;}
      .adm-table tbody tr{transition:background .12s;}
      .adm-table tbody tr:hover{background:#1c212b;}
      .adm-table-wrap{overflow-x:auto;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;border:1px solid var(--adm-border);border-radius:.9rem;background:var(--adm-surface);scrollbar-width:thin;scrollbar-color:#1e242e transparent;}
      .adm-table th:last-child,.adm-table td:last-child{position:sticky;right:0;background:var(--adm-surface);z-index:2;border-left:1px solid var(--adm-border-soft);}
      .adm-table tbody tr:hover td:last-child{background:#1c212b;}
      .adm-chip{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;background:var(--adm-surface-2);border:1px solid var(--adm-border);color:var(--adm-muted);padding:.2rem .5rem;border-radius:.35rem;display:inline-block;}
      .adm-price{color:var(--adm-accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:700;white-space:nowrap;}
      .adm-price s{color:var(--adm-faint);font-weight:400;margin-left:.4rem;}
      .adm-actions{display:flex;gap:.45rem;flex-wrap:wrap;}
      .adm-note{font-size:.82rem;color:var(--adm-muted);background:var(--adm-surface-2);border:1px solid var(--adm-border);border-radius:.7rem;padding:.8rem 1rem;line-height:1.5;}
      .adm-subhead{font-size:1.05rem;font-weight:800;color:var(--adm-text);margin:0 0 .4rem;display:flex;align-items:center;gap:.6rem;}
      .adm-subhead .bar{width:4px;height:17px;border-radius:2px;background:var(--adm-accent);display:inline-block;}

      /* ================= Shared list helpers ================= */
      .adm-toolbar{display:flex;gap:.75rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;}
      .adm-toolbar .adm-input{max-width:380px;}
      .adm-count{color:var(--adm-muted);font-size:.85rem;margin-left:auto;white-space:nowrap;}
      .adm-link{color:var(--adm-text);text-decoration:none;font-weight:700;display:block;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
      .adm-link:hover{color:var(--adm-accent);}
      .adm-link+.adm-chip{margin-top:.3rem;display:inline-block;}
      .adm-sub{font-size:.78rem;color:var(--adm-muted);margin-top:.15rem;}
      .adm-muted{color:var(--adm-muted);font-size:.82rem;white-space:nowrap;}
      .adm-coupon{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.8rem;color:var(--adm-accent);background:var(--adm-accent-dim);border:1px solid var(--adm-accent-border);border-radius:.35rem;padding:.15rem .45rem;cursor:pointer;white-space:nowrap;transition:all .15s;}
      .adm-coupon:hover{background:rgba(212,167,55,.18);}
      .adm-coupon.copied{background:rgba(212,167,55,.28);border-color:var(--adm-accent);}
      .adm-course{display:flex;align-items:center;gap:.8rem;min-width:0;}
      .adm-thumb{width:52px;height:36px;border-radius:.4rem;object-fit:cover;border:1px solid var(--adm-border);background:var(--adm-surface-2);flex-shrink:0;color:var(--adm-faint);}
      .adm-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;border:1px solid var(--adm-border);background:var(--adm-surface-2);color:var(--adm-text);flex-shrink:0;display:grid;place-items:center;font-weight:700;font-size:.7rem;}
      .adm-pagination{display:flex;align-items:center;justify-content:center;gap:.4rem;flex-wrap:wrap;margin-top:1rem;}
      .adm-pg-btn{padding:.45rem .85rem;border-radius:.5rem;border:1px solid var(--adm-border);background:var(--adm-surface-2);color:var(--adm-muted);font-weight:700;font-size:.85rem;cursor:pointer;font-family:inherit;transition:all .15s;}
      .adm-pg-btn:hover:not(:disabled){border-color:var(--adm-accent-border);color:var(--adm-accent);}
      .adm-pg-btn:disabled{opacity:.4;cursor:not-allowed;}
      .adm-pg-btn.current{background:#D4AF37;border-color:#D4AF37;color:#0b0e14;}
      .adm-pg-info{color:var(--adm-muted);font-size:.85rem;margin-right:.5rem;}
      .adm-img-input{font-size:.8rem;padding:.5rem .7rem;}

      @media (max-width:920px){
        .adm-sidebar{position:fixed;left:0;top:0;height:100%;transform:translateX(-105%);box-shadow:0 20px 60px rgba(0,0,0,.55);}
        .adm-nav-open .adm-sidebar{transform:translateX(0);}
        .adm-overlay{display:block;position:fixed;inset:0;background:rgba(3,6,10,.65);z-index:55;opacity:0;pointer-events:none;}
        .adm-nav-open .adm-overlay{opacity:1;pointer-events:auto;}
        .adm-burger{display:grid;}
        .adm-topbar{flex-wrap:wrap;}
      }
      @media (max-width:640px){
        .adm-content{padding:1.25rem 1rem 3rem;}
        .adm-title{font-size:1.2rem;}
        .adm-crumb{padding:.3rem .6rem;}
      }
    </style>
  </head>
  <body>
    <AdminProtection>
      <AdminAuthGate>
        <div class="adm">
          <aside class="adm-sidebar">
            <div class="adm-brand">
              <div class="adm-brand-logo">S</div>
              <div class="adm-brand-text">
                <div class="adm-brand-name">CourseSpeak</div>
                <div class="adm-brand-sub">Admin Panel</div>
              </div>
            </div>
            <nav class="adm-nav">
              <div class="adm-nav-section">Manage</div>
              <a class="adm-nav-item" class:list={[{ active: isDashboard }]} href="/admin" title="Dashboard — ringkasan admin">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="adm-nav-label">Dashboard</span>
              </a>
              <a class="adm-nav-item" class:list={[{ active: isDeals }]} href="/admin/deals" title="Deals — kelola kupon course">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                <span class="adm-nav-label">Deals</span>
              </a>
              <a class="adm-nav-item" class:list={[{ active: isInstructors }]} href="/admin/instructors" title="Instructors — kelola foto instructor">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="adm-nav-label">Instructors</span>
              </a>
            </nav>
            <div class="adm-sidebar-foot">
              <a class="adm-nav-item" href="/" target="_blank" rel="noopener" title="View Site — buka situs di tab baru">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span class="adm-nav-label">View Site</span>
              </a>
            </div>
          </aside>

          <div class="adm-main-col">
            <div class="adm-overlay" id="admOverlay"></div>
            <header class="adm-topbar">
              <button class="adm-burger" id="admBurger" type="button" aria-label="Toggle navigation">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
              </button>
              <div class="adm-topbar-left">
                {parent && <a class="adm-crumb" href={parentHref}>← {parent}</a>}
                <h1 class="adm-title">{title}</h1>
                {badge && <span class="adm-badge">{badge}</span>}
                {desc && <p class="adm-desc">{desc}</p>}
              </div>
              <div class="adm-topbar-right">
                <slot name="actions" />
              </div>
            </header>
            <main class="adm-content">
              <slot />
            </main>
          </div>
        </div>
      </AdminAuthGate>
    </AdminProtection>
  </body>
</html>

<script>
  const burger = document.getElementById("admBurger");
  const overlay = document.getElementById("admOverlay");
  function setNav(open: boolean) {
    document.body.classList.toggle("adm-nav-open", open);
  }
  burger?.addEventListener("click", () => setNav(!document.body.classList.contains("adm-nav-open")));
  overlay?.addEventListener("click", () => setNav(false));
  document.querySelectorAll<HTMLAnchorElement>(".adm-nav-item").forEach((a) =>
    a.addEventListener("click", () => setNav(false))
  );
</script>
