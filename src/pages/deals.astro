---
import Layout from "../layouts/Layout.astro";
import DealCard from "../components/DealCard.astro";
import { readDeals, isDealAddedToday } from "../lib/store";

const allDeals = await readDeals();

// Get language filter from query params
const languageFilter = Astro.url.searchParams.get('language');

// Filter deals by language if provided
const filteredDeals = languageFilter
  ? allDeals.filter((d: any) => d.language === languageFilter)
  : allDeals;

const PAGE_SIZE = 12;

// Get current page from URL params
const currentPage = Math.max(1, parseInt(Astro.params.page || '1', 10));

// Pagination calculation (use filtered deals)
const totalPages = Math.ceil(filteredDeals.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = filteredDeals.slice(startIndex, endIndex);

// Pagination URLs (include language filter if active)
const siteUrl = "https://coursespeak.com";
const baseDealsPath = "/deals";
const langQuery = languageFilter ? `?language=${encodeURIComponent(languageFilter)}` : '';
const baseDealsUrl = `${siteUrl}${baseDealsPath}${langQuery}`;
const currentUrl = currentPage === 1 ? baseDealsUrl : `${siteUrl}${baseDealsPath}/${currentPage}${langQuery}`;
const prevUrl = currentPage > 1
  ? (currentPage === 2 ? `${baseDealsPath}${langQuery}` : `${baseDealsPath}/${currentPage - 1}${langQuery}`)
  : null;
const nextUrl = currentPage < totalPages ? `${baseDealsPath}/${currentPage + 1}${langQuery}` : null;
const prevUrlAbs = prevUrl ? `${siteUrl}${prevUrl}` : null;
const nextUrlAbs = nextUrl ? `${siteUrl}${nextUrl}` : null;

// Dynamic SEO (WIB/Asia-Jakarta)
const TIMEZONE = 'Asia/Jakarta';
const currentDate = new Date();
const currentMonth = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, month: 'long' });
const currentYear  = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, year: 'numeric' });
const todayWIB     = currentDate.toLocaleDateString('en-CA', { timeZone: TIMEZONE });

// Real stats from data
const displayDeals = filteredDeals;
const totalDeals = displayDeals.length;
const avgSavings = (() => {
  const valid = displayDeals.filter((d: any) => d.originalPrice && d.price !== undefined && d.originalPrice > 0);
  if (valid.length === 0) return 90;
  const total = valid.reduce((sum: number, d: any) =>
    sum + ((d.originalPrice - (d.price ?? 0)) / d.originalPrice) * 100, 0);
  return Math.round(total / valid.length);
})();

const maxSavings = (() => {
  const valid = displayDeals.filter((d: any) => d.originalPrice && d.price !== undefined && d.originalPrice > 0 && d.originalPrice > d.price);
  if (valid.length === 0) return 90;
  const max = valid.reduce((m: number, d: any) =>
    Math.max(m, ((d.originalPrice - (d.price ?? 0)) / d.originalPrice) * 100), 0);
  return Math.round(max);
})();

const todayAdded = allDeals.filter(isDealAddedToday).length;

const catsSet = new Set<string>();
allDeals.forEach((d: any) => { if (d.category) catsSet.add(d.category); });
const categories = Array.from(catsSet).sort();

const latestUpdate = allDeals.reduce((latest: number, d: any) => {
  const t = new Date(d.updatedAt || d.createdAt || 0).getTime();
  return t > latest ? t : latest;
}, 0);
const diffMs = currentDate.getTime() - latestUpdate;
const diffMin = Math.floor(diffMs / 60000);
let lastVerified;
if (diffMin < 1) lastVerified = 'Just now';
else if (diffMin < 60) lastVerified = `${diffMin}m ago`;
else {
  const diffHr = Math.floor(diffMin / 60);
  lastVerified = diffHr < 24 ? `${diffHr}h ago` : `${Math.floor(diffHr / 24)}d ago`;
}

const totalCoupons = allDeals.length;

function slugifyCategory(cat: string): string {
  return cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

// Page-aware title & description
const pageTitle = currentPage === 1
  ? (languageFilter
    ? `${languageFilter} Udemy Coupons ${currentMonth} ${currentYear} | ${totalDeals}+ Discounted Courses`
    : `Udemy promo codes, coupons, and deals for ${currentMonth} ${currentYear}`)
  : `Udemy Coupon Codes — Page ${currentPage} of ${totalPages} | CourseSpeak`;

const pageDescription = currentPage === 1
  ? (languageFilter
    ? `Browse ${totalDeals} verified ${languageFilter} Udemy promo codes, coupons, and deals for ${currentMonth} ${currentYear}. Save up to ${maxSavings}% on programming, web development, data science and more. Updated daily.`
    : `Browse ${totalDeals}+ verified Udemy promo codes, coupons, and deals for ${currentMonth} ${currentYear}. Save up to ${maxSavings}% on premium courses in programming, web development, data science and more. Updated daily.`)
  : `Page ${currentPage} of Udemy promo codes, coupons, and deals. Browse more verified discounted courses on CourseSpeak.`;

// FAQ data — identical between schema and visible HTML (Google requirement)
const faqs = [
  {
    q: "Are Udemy deals on CourseSpeak legitimate?",
    a: "Yes! All deals on CourseSpeak are verified and sourced directly from Udemy or authorized partners. We regularly check and update our listings to ensure every coupon is active and working."
  },
  {
    q: "Are CourseSpeak coupon codes really free?",
    a: "The coupon codes themselves are completely free to use. They give you access to heavily discounted Udemy courses, typically 87–95% off the regular price, rather than completely free courses."
  },
  {
    q: "How often are new Udemy coupons added?",
    a: "We update our coupon database daily with new Udemy courses. New discounted courses are added every single day — check back regularly for the latest offers."
  },
  {
    q: "Is CourseSpeak free to use?",
    a: "Yes, CourseSpeak is completely free. We don't charge anything to access deals, coupons, or course information. Our mission is to help learners access premium education at an affordable price."
  },
  {
    q: "Do Udemy courses obtained through coupon codes include certificates?",
    a: "Yes! Courses enrolled through our coupon codes include full Udemy course benefits — completion certificates, lifetime access, and all course materials — same as paid enrollment."
  },
  {
    q: "How do I redeem a Udemy coupon from CourseSpeak?",
    a: "Click on any deal on this page. You will be redirected to the official Udemy course page with the discount automatically applied. Click 'Enroll Now' and complete checkout to enroll at the discounted price."
  },
  {
    q: "Can I access Udemy courses offline?",
    a: "Yes! Udemy courses enrolled through our coupons support offline learning via the Udemy mobile app. Download course materials and watch videos anytime, anywhere without internet connection."
  },
  {
    q: "How long are the coupon codes valid?",
    a: "Most coupon codes are limited-time offers. Some expire within a few days while others last a few weeks. We flag expired deals as soon as we detect them, so every code listed on CourseSpeak is active at the time of publishing. To avoid missing out, enroll as soon as you find a course you like."
  }
];

// FIX 3: Build page number list without >= operator or key prop
// Uses pre-computed array of {type, value} objects
type PageItem = { type: 'page'; value: number } | { type: 'ellipsis'; id: string };
const pageItems: PageItem[] = [];
const window = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - window && p <= currentPage + window;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}

// JSON-LD — no duplication of Organization/WebSite from Layout.astro
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Udemy Deals & Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": siteUrl },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "dateModified": todayWIB,
      "inLanguage": "en-US",
      "about": {
        "@type": "Thing",
        "name": "Udemy Coupon Codes",
        "description": "Discounted Udemy course coupon codes for online learning"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Learners worldwide seeking discounted online courses",
        "geographicArea": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": `Udemy Deals & Coupon Codes — ${currentMonth} ${currentYear}`,
        "description": `${totalDeals}+ verified Udemy course deals with coupon codes`,
        "numberOfItems": allDeals.length,
        "itemListElement": currentItems.map((deal: any, index: number) => ({
          "@type": "ListItem",
          "position": startIndex + index + 1,
          "item": {
            "@type": "Course",
            "name": deal.title,
            "description": deal.description || `Get ${deal.title} at up to ${maxSavings}% off with a verified coupon code on CourseSpeak.`,
            "url": `${siteUrl}/deal/${deal.id}`,
            "image": deal.image,
            "inLanguage": deal.language || "en-US",
            "provider": {
              "@type": "Organization",
              "name": deal.provider || "Udemy",
              "url": "https://www.udemy.com",
              "areaServed": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
            },
            "offers": {
              "@type": "Offer",
              "price": String(deal.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock",
              "priceValidUntil": deal.expiresAt || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toLocaleDateString('en-CA', { timeZone: TIMEZONE }),
              "seller": { "@type": "Organization", "name": "CourseSpeak", "url": siteUrl },
              "areaServed": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
            },
            ...(deal.rating ? {
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": deal.rating.toString(),
                "bestRating": "5",
                "worstRating": "1",
                "ratingCount": Math.max(1, Math.round(deal.students ?? 1000))
              }
            } : {})
          }
        }))
      }
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }] : [])
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
>
  <Fragment slot="head">
    {prevUrlAbs && <link rel="prev" href={prevUrlAbs} />}
    {nextUrlAbs && <link rel="next" href={nextUrlAbs} />}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO — page 1 only ── */}
    {currentPage === 1 && (
      <section style={{ padding: "4rem 1rem 3rem", textAlign: "center", position: "relative", overflow: "hidden" }}>
        <div style={{ position: "absolute", top: "20%", left: "5%", width: "280px", height: "280px", background: "var(--brand)", filter: "blur(120px)", opacity: 0.07, borderRadius: "50%", pointerEvents: "none" }} />
        <div style={{ position: "absolute", bottom: "10%", right: "5%", width: "240px", height: "240px", background: "hsl(0, 84%, 60%)", filter: "blur(100px)", opacity: 0.07, borderRadius: "50%", pointerEvents: "none" }} />
        <div style={{ position: "relative", zIndex: 1, maxWidth: "900px", margin: "0 auto" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "var(--brand-soft)", padding: "0.5rem 1rem", borderRadius: "9999px", marginBottom: "1.5rem", fontSize: "0.875rem", color: "var(--brand)", fontWeight: 600 }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Updated Daily — {currentMonth} {currentYear}
          </div>
          <h1 style={{ fontSize: "clamp(2rem, 5vw, 3.5rem)", fontWeight: 800, lineHeight: 1.1, maxWidth: "900px", margin: "0 auto 1.5rem" }}>
            <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Udemy Promo Codes, Coupons & Deals</span>
            <br />
            <span style={{ background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>for {currentMonth} {currentYear}</span>
          </h1>
          <p style={{ fontSize: "clamp(1rem, 2.5vw, 1.25rem)", color: "var(--muted)", maxWidth: "650px", margin: "0 auto 2.5rem", lineHeight: 1.7 }}>
            Browse <strong style={{ color: "var(--text)" }}>{totalDeals}+ verified Udemy promo codes, coupons, and deals</strong> for <strong style={{ color: "var(--text)" }}>premium courses</strong>. Save up to <strong style={{ color: "var(--brand)" }}>{maxSavings}%</strong> on programming, web development, data science, and marketing — updated daily.
          </p>
        </div>
      </section>
    )}

    {/* Page 2+ header */}
    {currentPage > 1 && (
      <div style={{ background: "var(--card)", borderBottom: "1px solid var(--border)", padding: "1.5rem 0", textAlign: "center" }}>
        <div class="container">
          <h1 style={{ fontSize: "1.5rem", fontWeight: 700, color: "var(--text)", margin: "0 0 0.25rem" }}>
            {languageFilter ? `${languageFilter} Udemy Coupons — Page ${currentPage}` : `Udemy Promo Codes, Coupons & Deals — Page ${currentPage}`}
          </h1>
          <p style={{ color: "var(--muted)", margin: 0, fontSize: "0.9rem" }}>
            Showing {startIndex + 1}–{Math.min(endIndex, filteredDeals.length)} of {filteredDeals.length} verified courses
          </p>
        </div>
      </div>
    )}

    {/* ── STATS GRID ── */}
    <section style={{ paddingBottom: "2rem", marginTop: currentPage === 1 ? "-1rem" : "0" }}>
      <div class="container">
        <div class="stat-grid" style={{ gridTemplateColumns: "repeat(4,1fr)", maxWidth: "850px" }}>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              {todayAdded}
            </div>
            <div class="stat-label">Added Today</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {totalCoupons}
            </div>
            <div class="stat-label">Total Coupons</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              {categories.length}
            </div>
            <div class="stat-label">Categories</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {lastVerified}
            </div>
            <div class="stat-label">Verified</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── CATEGORIES ── */}
    <section style={{ background: "var(--card)", borderTop: "1px solid var(--border)", padding: "3rem 1.5rem 2rem", textAlign: "center" }}>
      <div class="container" style={{ maxWidth: "1280px" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Browse by Topic
        </div>
        <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.35rem" }}>
          Course Categories
        </h2>
        <p style={{ fontSize: "0.85rem", color: "var(--muted)", margin: "0 auto 1rem", maxWidth: "550px", lineHeight: 1.6 }}>
          Find Udemy coupon codes in {categories.length} categories — from programming and data science to design, marketing, and more.
        </p>
        <div style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem", justifyContent: "center" }}>
          <a href="/deals" style={{ fontSize: "0.78rem", fontWeight: 600, color: "white", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--brand)", background: "var(--brand)" }}>All</a>
          {categories.slice(0, 15).map((cat: string) => (
            <a href={`/categories/${slugifyCategory(cat)}`} style={{ fontSize: "0.78rem", fontWeight: 600, color: "var(--muted)", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--border)", background: "var(--bg)" }}>{cat}</a>
          ))}
        </div>
      </div>
    </section>

    {/* ── DEALS GRID ── */}
    <section style={{ padding: "3rem 1.5rem 4rem", maxWidth: "1280px", margin: "0 auto" }}>
        <div style={{ textAlign: "center", marginBottom: "1.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Latest Deals
          </div>
          <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.3rem" }}>
            Latest Udemy Promo Codes, Coupons & Deals {currentMonth} {currentYear}
          </h2>
          <p style={{ fontSize: "0.9rem", color: "var(--muted)", maxWidth: "650px", margin: "0 auto", lineHeight: 1.6 }}>
            Browse {totalDeals} verified Udemy promo codes, coupons, and deals with discounts up to {maxSavings}%. Find {languageFilter ? `${languageFilter} ` : ''}courses in programming, web development, data science, and more — all updated {currentMonth} {currentYear}.
            {currentPage > 1 ? ` (Page ${currentPage} of ${totalPages})` : ''}
          </p>
        </div>
        {languageFilter && (
          <div style={{ marginBottom: "1rem" }}>
            <a href="/deals" style={{
              display: "inline-flex", alignItems: "center", gap: "0.4rem",
              padding: "0.3rem 0.75rem", background: "var(--card)",
              border: "1px solid var(--border)", borderRadius: "6px",
              color: "var(--muted)", textDecoration: "none",
              fontSize: "0.8rem", fontWeight: 600
            }}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
              </svg>
              Clear Filter
            </a>
          </div>
        )}
        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(3, 1fr)",
          gap: "1.25rem"
        }}>
          {currentItems.map((deal: any) => (
            <DealCard deal={deal} />
          ))}
        </div>

        {/* ── PAGINATION ── */}
        {totalPages > 1 && (
          <nav aria-label="Pagination" style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: "0.75rem", padding: "1.5rem 0", marginTop: "1.5rem", borderTop: "1px solid var(--border)" }}>
            {prevUrl ? (
              <a href={prevUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>← Prev</a>
            ) : (
              <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--muted)", opacity: 0.4, padding: "0.4rem 0.85rem" }}>← Prev</span>
            )}
            <div style={{ display: "flex", alignItems: "center", gap: "4px" }}>
              {pageItems.map((item) => {
                if (item.type === 'ellipsis') {
                  return <span style={{ fontSize: "0.85rem", color: "var(--muted)", width: "34px", textAlign: "center" }}>...</span>;
                }
                const p = item.value;
                const isActive = p === currentPage;
                const href = p === 1 ? `${baseDealsPath}${langQuery}` : `${baseDealsPath}/${p}${langQuery}`;
                return isActive
                  ? <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "white", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--brand)", background: "var(--brand)" }}>{p}</span>
                  : <a href={href} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--text)", textDecoration: "none", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--border)" }}>{p}</a>;
              })}
            </div>
            {nextUrl ? (
              <a href={nextUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>Next →</a>
            ) : (
              <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--muted)", opacity: 0.4, padding: "0.4rem 0.85rem" }}>Next →</span>
            )}
          </nav>
        )}

    </section>

    {/* ── HOW COURSEPEAK VERIFIES — SEO (page 1 only) ── */}
    {currentPage === 1 && (
      <section style={{ padding: "4rem 1rem", background: "linear-gradient(135deg, rgba(212,167,55,0.03) 0%, transparent 100%)" }}>
        <div class="container" style={{ maxWidth: "1280px" }}>
          <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
