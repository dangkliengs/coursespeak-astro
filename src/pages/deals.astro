---
import Layout from "../layouts/Layout.astro";
import DealCard from "../components/DealCard.astro";
import { readDeals } from "../lib/store";

const allDeals = await readDeals();

const PAGE_SIZE = 12;

// Get current page from URL params - try Astro.params
const currentPage = parseInt(Astro.params.page || '1', 10);

// Debug values
console.log('URL:', Astro.url.href);
console.log('Astro.params:', Astro.params);
console.log('Current page:', currentPage);

// Simple pagination calculation
const totalPages = Math.ceil(allDeals.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = allDeals.slice(startIndex, endIndex);

console.log('Total deals:', allDeals.length);
console.log('Total pages:', totalPages);
console.log('Start index:', startIndex);
console.log('End index:', endIndex);
console.log('Current items length:', currentItems.length);

// SEO Meta Tags with Auto Date and Statistics
const currentDate = new Date();
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

// Calculate statistics for better SEO
const totalDeals = allDeals.length;
const freeDeals = allDeals.filter(deal => deal.price === 0 || deal.price === null).length;
const avgSavings = Math.round(allDeals.reduce((sum, deal) => {
  if (deal.originalPrice && deal.price) {
    return sum + ((deal.originalPrice - deal.price) / deal.originalPrice) * 100;
  }
  return sum;
}, 0) / allDeals.length);

const pageTitle = `Udemy Deals | ${totalDeals}+ Free Courses, 100% Off Coupons`;
const pageDescription = `${totalDeals}+ verified Udemy deals with ${freeDeals}+ free courses. Save up to ${avgSavings}% on premium courses. Updated daily.`;

// Enhanced JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://coursespeak.com/deals",
      "url": "https://coursespeak.com/deals",
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@id": "https://coursespeak.com"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://coursespeak.com/logo.svg"
      },
      "datePublished": "2023-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://coursespeak.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Udemy Deals",
            "item": "https://coursespeak.com/deals"
          }
        ]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Udemy Course Deals",
        "description": "Comprehensive collection of discounted and free Udemy courses",
        "numberOfItems": allDeals.length,
        "itemListElement": currentItems.slice(0, 12).map((deal, index) => ({
          "@type": "Course",
          "position": index + 1,
          "name": deal.title,
          "description": deal.description || `Learn ${deal.title} with expert instruction and save ${(deal.originalPrice && deal.price) ? Math.round(((deal.originalPrice - deal.price) / deal.originalPrice) * 100) : '90'}%`,
          "url": `https://coursespeak.com/deal/${deal.id}`,
          "provider": {
            "@type": "Organization",
            "name": deal.provider || "Udemy",
            "url": "https://www.udemy.com"
          },
          "offers": {
            "@type": "Offer",
            "price": String(deal.price || "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
            "validThrough": deal.updatedAt || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),
            "seller": {
              "@type": "Organization",
              "name": "CourseSpeak",
              "url": "https://coursespeak.com"
            }
          },
          "aggregateRating": deal.rating ? {
            "@type": "AggregateRating",
            "ratingValue": deal.rating,
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": Math.max(1, Math.round(deal.students ?? 1000))
          } : undefined,
          "educationalLevel": "Beginner to Advanced",
          "inLanguage": "en",
          "coursePrerequisites": "None required",
          "learningOutcome": deal.description || "Gain valuable skills and knowledge"
        }))
      }
    },
    {
      "@type": "Dataset",
      "name": "CourseSpeak Udemy Deals Dataset",
      "description": "Comprehensive dataset of verified Udemy course deals and discount coupons",
      "url": "https://coursespeak.com/deals",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "provider": {
        "@id": "https://coursespeak.com/#organization"
      },
      "datePublished": "2023-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "variableMeasured": [
        {
          "@type": "PropertyValue",
          "name": "Total Deals",
          "value": totalDeals
        },
        {
          "@type": "PropertyValue",
          "name": "Free Courses",
          "value": freeDeals
        },
        {
          "@type": "PropertyValue",
          "name": "Average Savings",
          "value": `${avgSavings}%`
        }
      ]
    },
    {
      "@type": "Organization",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "logo": "https://coursespeak.com/logo.png",
      "description": "Find the best online course deals and coupons. Daily updated discounts for Udemy, Coursera, and more.",
      "sameAs": [
        "https://x.com/courses_peak",
        "https://facebook.com/coursespeak"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://coursespeak.com/contact"
      }
    },
    {
      "@type": "WebSite",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "description": "Transform your learning journey with exclusive free course coupons. 100K+ students accessing premium courses completely free.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://coursespeak.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "EducationalOrganization",
      "name": "CourseSpeak Learning Platform",
      "description": "Free access to premium online courses from top providers like Udemy, Coursera, and edX.",
      "url": "https://coursespeak.com",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Online Course Deals",
        "itemListElement": currentItems.slice(0, 5).map((deal, index) => ({
          "@type": "Course",
          "name": deal.title,
          "provider": {
            "@type": "Organization",
            "name": deal.provider || "Udemy"
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are these Udemy deals legitimate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All deals on CourseSpeak are verified and sourced directly from Udemy or authorized partners. We regularly check and update our deals to ensure they're active and legitimate."
          }
        },
        {
          "@type": "Question",
          "name": "How long do these deals last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deal durations vary by course. Some are available for a limited time (24-72 hours), while others may be valid for several days. We recommend claiming deals as soon as you find them to avoid missing out."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to pay anything?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most deals on CourseSpeak are 100% free - you pay $0 for the course. Some deals may offer significant discounts (90-95% off) rather than completely free access. Always check the final price before enrolling."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get a certificate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Even with free courses, you typically receive a certificate of completion. However, certificate availability varies by course and instructor. Check the course details for certificate information."
          }
        },
        {
          "@type": "Question",
          "name": "How do I redeem a deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply click on any course deal, and you'll be redirected to the official Udemy page with the discount automatically applied. Click 'Enroll Now' and complete the checkout process - no payment required for free courses."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <div class="hero-gradient" style={{ minHeight: "100vh", color: "var(--text)" }}>
        <main>
            {/* Hero Section */}
            <section
                class="hero-gradient"
                style={{
                    position: "relative",
                    padding: "8rem 1rem 4rem",
                    textAlign: "center",
                    overflow: "hidden",
                }}
            >
                <div class="container" style={{ position: "relative", zIndex: 10 }}>
                    <div style={{
                        display: "inline-flex",
                        alignItems: "center",
                        gap: "0.5rem",
                        background: "var(--brand-soft)",
                        padding: "0.5rem 1rem",
                        borderRadius: "9999px",
                        marginBottom: "2rem",
                        fontSize: "0.9rem",
                        color: "var(--brand)",
                        fontWeight: 600
                    }}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                        Udemy Deals {currentMonth} {currentYear}
                    </div>

                    <h1
                        style={{
                            fontSize: "clamp(2.5rem, 5vw, 4rem)",
                            fontWeight: 800,
                            lineHeight: 1.1,
                            marginBottom: "1.5rem",
                            maxWidth: "1200px",
                            margin: "0 auto 1.5rem"
                        }}
                    >
                        <span style={{
                            background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
                            WebkitBackgroundClip: "text",
                            WebkitTextFillColor: "transparent",
                            backgroundClip: "text"
                        }}>
                            Premium Courses,
                        </span>
                        <br/>
                        <span style={{
                            background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
                            WebkitBackgroundClip: "text",
                            WebkitTextFillColor: "transparent",
                            backgroundClip: "text"
                        }}>
                            Unbeatable Prices
                        </span>
                    </h1>
                    <p
                        style={{
                            fontSize: "clamp(1.1rem, 2.5vw, 1.4rem)",
                            color: "var(--muted)",
                            maxWidth: "700px",
                            margin: "0 auto 3rem",
                            lineHeight: 1.6,
                            fontWeight: 400
                        }}
                    >
                        Access {totalDeals}+ verified Udemy courses with {freeDeals}+ completely free options. Save up to {avgSavings}% on premium education from industry experts.
                    </p>

                    {/* Statistics Badges */}
                    <div style={{
                        display: "flex",
                        justifyContent: "center",
                        gap: "1rem",
                        flexWrap: "wrap",
                        marginBottom: "3rem"
                    }}>
                        <div style={{
                            display: "flex",
                            alignItems: "center",
                            gap: "0.5rem",
                            background: "var(--card)",
                            padding: "0.75rem 1.5rem",
                            borderRadius: "12px",
                            border: "1px solid var(--border)"
                        }}>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style={{ color: "var(--brand)" }}>
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            <span style={{ fontWeight: 600, color: "var(--text)" }}>{totalDeals}+ Courses</span>
                        </div>
                        <div style={{
                            display: "flex",
                            alignItems: "center",
                            gap: "0.5rem",
                            background: "var(--card)",
                            padding: "0.75rem 1.5rem",
                            borderRadius: "12px",
                            border: "1px solid var(--border)"
                        }}>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style={{ color: "hsl(35, 90%, 68%)" }}>
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            <span style={{ fontWeight: 600, color: "var(--text)" }}>{freeDeals}+ Free</span>
                        </div>
                        <div style={{
                            display: "flex",
                            alignItems: "center",
                            gap: "0.5rem",
                            background: "var(--card)",
                            padding: "0.75rem 1.5rem",
                            borderRadius: "12px",
                            border: "1px solid var(--border)"
                        }}>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style={{ color: "hsl(180, 50%, 40%)" }}>
                                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/>
                            </svg>
                            <span style={{ fontWeight: 600, color: "var(--text)" }}>Save {avgSavings}%</span>
                        </div>
                    </div>
                </div>

                {/* Decorative elements */}
                <div style={{
                    position: "absolute",
                    top: "20%",
                    left: "10%",
                    width: "300px",
                    height: "300px",
                    background: "var(--brand)",
                    filter: "blur(120px)",
                    opacity: 0.1,
                    borderRadius: "50%",
                }}></div>
                <div style={{
                    position: "absolute",
                    bottom: "10%",
                    right: "10%",
                    width: "250px",
                    height: "250px",
                    background: "hsl(0, 84%, 60%)",
                    filter: "blur(100px)",
                    opacity: 0.1,
                    borderRadius: "50%",
                }}></div>
            </section>

            {/* Deals Overview */}
            <section class="card-gradient" style={{ padding: "4rem 1rem" }}>
                <div class="container">
                    <div style={{
                        textAlign: "center",
                        marginBottom: "3rem"
                    }}>
                        <h2 style={{
                            fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
                            fontWeight: 800,
                            color: "var(--text)",
                            marginBottom: "1rem"
                        }}>
                            Massive Savings on Premium Education
                        </h2>
                        <p style={{
                            color: "var(--muted)",
                            fontSize: "1.1rem",
                            maxWidth: "600px",
                            margin: "0 auto",
                            lineHeight: 1.6
                        }}>
                            Access world-class courses from top instructors at unbeatable prices. Transform your career with expert knowledge.
                        </p>
                    </div>

                    <div style={{
                        display: "grid",
                        gridTemplateColumns: "repeat(auto-fit, minmax(250px, 1fr))",
                        gap: "2rem",
                        marginBottom: "4rem"
                    }}>
                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "var(--brand)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "var(--brand)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {totalDeals}+
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Active Deals
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                Updated daily
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(35, 90%, 68%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(35, 90%, 68%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {freeDeals}+
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                100% Free
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                No payment required
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(180, 50%, 40%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(180, 50%, 40%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {avgSavings}%
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Avg Savings
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                On premium courses
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(0, 84%, 60%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(0, 84%, 60%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                24/7
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Access Anytime
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                Learn at your pace
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            {/* Deals Grid Section */}
            <section class="hero-gradient" style={{ padding: "4rem 1rem" }}>
                <div class="container" style={{ maxWidth: "1400px" }}>
                    {/* Deals Header */}
                    <div style={{
                        textAlign: "center",
                        marginBottom: "3rem"
                    }}>
                        <h2 style={{
                            fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
                            fontWeight: 800,
                            color: "var(--text)",
                            marginBottom: "1rem"
                        }}>
                            Latest Udemy Deals & Coupons
                        </h2>
                        <p style={{
                            color: "var(--muted)",
                            fontSize: "1.1rem",
                            maxWidth: "600px",
                            margin: "0 auto",
                            lineHeight: 1.6
                        }}>
                            Browse our curated selection of premium courses. Click any deal to get instant access with automatic discount application.
                        </p>
                    </div>

                    {/* Deals Grid */}
        <div style={{ 
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(350px, 1fr))",
            gap: "2rem",
            marginBottom: "3rem"
        }}>
            {currentItems.map((deal) => (
                <DealCard deal={deal} />
            ))}
        </div>
            
                    {/* Modern Pagination */}
                    <div style={{
                        textAlign: "center",
                        marginTop: "4rem",
                        padding: "3rem",
                        background: "var(--card)",
                        borderRadius: "24px",
                        border: "1px solid var(--border)",
                        position: "relative",
                        overflow: "hidden"
                    }}>
                        <div style={{
                            position: "absolute",
                            top: "-50px",
                            right: "-50px",
                            width: "150px",
                            height: "150px",
                            background: "var(--brand)",
                            borderRadius: "50%",
                            opacity: 0.1
                        }}></div>
                        <div style={{
                            position: "absolute",
                            bottom: "-50px",
                            left: "-50px",
                            width: "120px",
                            height: "120px",
                            background: "hsl(35, 90%, 68%)",
                            borderRadius: "50%",
                            opacity: 0.1
                        }}></div>

                        <div style={{
                            display: "flex",
                            justifyContent: "center",
                            gap: "1rem",
                            marginBottom: "1.5rem",
                            position: "relative",
                            zIndex: 1
                        }}>
                            {currentPage > 1 && (
                                <a href={`/deals/${currentPage - 1}`} style={{
                                    display: "inline-flex",
                                    alignItems: "center",
                                    gap: "0.5rem",
                                    padding: "1rem 2rem",
                                    background: "var(--card)",
