---
import Layout from "../layouts/Layout.astro";
import DealCard from "../components/DealCard.astro";
import { readDeals } from "../lib/store";

const allDeals = await readDeals();

// Get language filter from query params
const languageFilter = Astro.url.searchParams.get('language');

// Filter deals by language if provided
const filteredDeals = languageFilter
  ? allDeals.filter((d: any) => d.language === languageFilter)
  : allDeals;

const PAGE_SIZE = 12;

// Get current page from URL params
const currentPage = Math.max(1, parseInt(Astro.params.page || '1', 10));

// Pagination calculation (use filtered deals)
const totalPages = Math.ceil(filteredDeals.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = filteredDeals.slice(startIndex, endIndex);

// Pagination URLs (include language filter if active)
const siteUrl = "https://coursespeak.com";
const baseDealsUrl = languageFilter ? `${siteUrl}/deals?language=${encodeURIComponent(languageFilter)}` : `${siteUrl}/deals`;
const currentUrl = currentPage === 1 ? baseDealsUrl : `${baseDealsUrl}/${currentPage}${languageFilter ? `?language=${encodeURIComponent(languageFilter)}` : ''}`;
const prevUrl = currentPage > 1
  ? (currentPage === 2 ? baseDealsUrl : `${baseDealsUrl}/${currentPage - 1}${languageFilter ? `?language=${encodeURIComponent(languageFilter)}` : ''}`)
  : null;
const nextUrl = currentPage < totalPages ? `${baseDealsUrl}/${currentPage + 1}${languageFilter ? `?language=${encodeURIComponent(languageFilter)}` : ''}` : null;

// Dynamic SEO (WIB/Asia-Jakarta)
const TIMEZONE = 'Asia/Jakarta';
const currentDate = new Date();
const currentMonth = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, month: 'long' });
const currentYear  = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, year: 'numeric' });
const todayWIB     = currentDate.toLocaleDateString('en-CA', { timeZone: TIMEZONE });

// Real stats from data (use filtered deals if filter is active)
const displayDeals = filteredDeals;
const totalDeals = displayDeals.length;
const avgSavings = (() => {
  const valid = displayDeals.filter((d: any) => d.originalPrice && d.price !== undefined && d.originalPrice > 0);
  if (valid.length === 0) return 90;
  const total = valid.reduce((sum: number, d: any) =>
    sum + ((d.originalPrice - (d.price ?? 0)) / d.originalPrice) * 100, 0);
  return Math.round(total / valid.length);
})();

// Page-aware title & description
const pageTitle = currentPage === 1
  ? (languageFilter
    ? `${languageFilter} Udemy Coupons ${currentMonth} ${currentYear} | ${totalDeals}+ Deals`
    : `Free Udemy Coupons ${currentMonth} ${currentYear} | ${totalDeals}+ 100% Off Courses Deals`)
  : `Udemy Deals — Page ${currentPage} of ${totalPages} | CourseSpeak`;

const pageDescription = currentPage === 1
  ? (languageFilter
    ? `Browse ${totalDeals} verified ${languageFilter} Udemy coupons with free courses. Save up to ${avgSavings}% on programming, web development, data science and more.`
    : `Browse ${totalDeals}+ verified Udemy coupons with free courses. Save up to ${avgSavings}% on programming, web development, data science and more. Updated daily.`)
  : `Page ${currentPage} of Udemy deals. Browse more verified free courses and 100% off coupons on CourseSpeak.`;

// FAQ data — identical between schema and visible HTML (Google requirement)
const faqs = [
  {
    q: "Are Udemy deals on CourseSpeak legitimate?",
    a: "Yes! All deals on CourseSpeak are verified and sourced directly from Udemy or authorized partners. We regularly check and update our listings to ensure every coupon is active and working."
  },
  {
    q: "How often are new Udemy coupons added?",
    a: "We update our coupon database daily with new Udemy courses. New free courses and discounts are added every single day — check back regularly for the latest offers."
  },
  {
    q: "Is CourseSpeak free to use?",
    a: "Yes, CourseSpeak is completely free. We don't charge anything to access deals, coupons, or course information. Our mission is to help learners access premium education for free."
  },
  {
    q: "Do free Udemy courses include certificates?",
    a: "Yes! Free courses obtained through our coupons include full Udemy course benefits — completion certificates, lifetime access, and all course materials — same as paid enrollment."
  },
  {
    q: "How do I redeem a Udemy coupon from CourseSpeak?",
    a: "Click on any deal on this page. You will be redirected to the official Udemy course page with the discount automatically applied. Click 'Enroll Now' and complete checkout — no payment required for 100% off coupons."
  },
  {
    q: "Can I access Udemy courses offline?",
    a: "Yes! Udemy courses enrolled through our coupons support offline learning via the Udemy mobile app. Download course materials and watch videos anytime, anywhere without internet connection."
  }
];

// FIX 3: Build page number list without >= operator or key prop
// Uses pre-computed array of {type, value} objects
type PageItem = { type: 'page'; value: number } | { type: 'ellipsis'; id: string };
const pageItems: PageItem[] = [];
const window = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - window && p <= currentPage + window;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}

// JSON-LD — no duplication of Organization/WebSite from Layout.astro
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Udemy Deals & Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": siteUrl },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "dateModified": todayWIB,
      "inLanguage": "en-US",
      "about": {
        "@type": "Thing",
        "name": "Udemy Coupons",
        "description": "Free and discounted Udemy course coupons for online learning"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Learners worldwide seeking free and discounted online courses",
        "geographicArea": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": `Udemy Deals & Free Coupons — ${currentMonth} ${currentYear}`,
        "description": `${totalDeals}+ verified Udemy course deals with free coupons`,
        "numberOfItems": allDeals.length,
        "itemListElement": currentItems.map((deal: any, index: number) => ({
          "@type": "ListItem",
          "position": startIndex + index + 1,
          "item": {
            "@type": "Course",
            "name": deal.title,
            "description": deal.description || `Get ${deal.title} free with a verified 100% off coupon on CourseSpeak.`,
            "url": `${siteUrl}/deal/${deal.id}`,
            "image": deal.image,
            "inLanguage": deal.language || "en-US",
            "provider": {
              "@type": "Organization",
              "name": deal.provider || "Udemy",
              "url": "https://www.udemy.com",
              "areaServed": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
            },
            "offers": {
              "@type": "Offer",
              "price": String(deal.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock",
              "priceValidUntil": deal.expiresAt || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toLocaleDateString('en-CA', { timeZone: TIMEZONE }),
              "seller": { "@type": "Organization", "name": "CourseSpeak", "url": siteUrl },
              "areaServed": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
            },
            ...(deal.rating ? {
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": deal.rating.toString(),
                "bestRating": "5",
                "worstRating": "1",
                "ratingCount": Math.max(1, Math.round(deal.students ?? 1000))
              }
            } : {})
          }
        }))
      }
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }] : [])
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO — page 1 only ── */}
    {currentPage === 1 && (
      <section
        class="hero-gradient"
        style={{ position: "relative", padding: "5rem 1rem 4rem", textAlign: "center", overflow: "hidden" }}
      >
        <div class="container" style={{ position: "relative", zIndex: 10 }}>
          <div style={{
            display: "inline-flex", alignItems: "center", gap: "0.5rem",
            background: "var(--brand-soft)", padding: "0.5rem 1rem",
            borderRadius: "9999px", marginBottom: "1.5rem",
            fontSize: "0.875rem", color: "var(--brand)", fontWeight: 600
          }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Updated Daily — {currentMonth} {currentYear}
          </div>

          <h1 style={{
            fontSize: "clamp(2rem, 5vw, 3.5rem)", fontWeight: 800,
            lineHeight: 1.1, maxWidth: "900px", margin: "0 auto 1.5rem"
          }}>
            <span style={{
              background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
              WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text"
            }}>Free Udemy Coupons</span>
            <br />
            <span style={{
              background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
              WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text"
            }}>100% Off — {currentMonth} {currentYear}</span>
          </h1>

          <p style={{
            fontSize: "clamp(1rem, 2.5vw, 1.25rem)", color: "var(--muted)",
            maxWidth: "650px", margin: "0 auto 2.5rem", lineHeight: 1.7
          }}>
            Browse <strong style={{ color: "var(--text)" }}>{totalDeals}+ verified Udemy deals</strong> with{" "}
            <strong style={{ color: "var(--text)" }}>free courses</strong>. Save up to{" "}
            <strong style={{ color: "var(--brand)" }}>{avgSavings}%</strong> on programming, web development,
            data science, and marketing — updated daily.
          </p>

          <div style={{ display: "flex", justifyContent: "center", gap: "1rem", flexWrap: "wrap" }}>
            {[
              { label: `${totalDeals}+ Courses`, path: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z", color: "var(--brand)" },
              { label: `Free Courses`, path: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z", color: "hsl(120, 70%, 45%)" },
              { label: `Save ${avgSavings}%`, path: "M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z", color: "hsl(35, 90%, 68%)" },
              { label: "Verified Daily", path: "M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z", color: "hsl(210, 100%, 60%)" }
            ].map(stat => (
              <div style={{
                display: "flex", alignItems: "center", gap: "0.5rem",
                background: "var(--card)", padding: "0.625rem 1.25rem",
                borderRadius: "10px", border: "1px solid var(--border)",
                fontSize: "0.875rem", fontWeight: 600, color: "var(--text)"
              }}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill={stat.color}>
                  <path d={stat.path} />
                </svg>
                {stat.label}
              </div>
            ))}
          </div>
        </div>

        <div style={{ position: "absolute", top: "20%", left: "5%", width: "280px", height: "280px", background: "var(--brand)", filter: "blur(120px)", opacity: 0.07, borderRadius: "50%", pointerEvents: "none" }} />
        <div style={{ position: "absolute", bottom: "10%", right: "5%", width: "240px", height: "240px", background: "hsl(0, 84%, 60%)", filter: "blur(100px)", opacity: 0.07, borderRadius: "50%", pointerEvents: "none" }} />
      </section>
    )}

    {/* Page 2+ header */}
    {currentPage > 1 && (
      <div style={{ background: "var(--card)", borderBottom: "1px solid var(--border)", padding: "1.5rem 0", textAlign: "center" }}>
        <div class="container">
          <h1 style={{ fontSize: "1.5rem", fontWeight: 700, color: "var(--text)", margin: "0 0 0.25rem" }}>
            {languageFilter ? `${languageFilter} Udemy Deals — Page ${currentPage}` : `Udemy Deals & Free Coupons — Page ${currentPage}`}
          </h1>
          <p style={{ color: "var(--muted)", margin: 0, fontSize: "0.9rem" }}>
            Showing {startIndex + 1}–{Math.min(endIndex, filteredDeals.length)} of {filteredDeals.length} verified courses
          </p>
        </div>
      </div>
    )}

    {/* ── DEALS GRID ── */}
    <section style={{ padding: "3rem 1rem 4rem" }}>
      <div class="container" style={{ maxWidth: "1400px" }}>

        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "2rem", flexWrap: "wrap", gap: "1rem" }}>
          <div>
            <h2 style={{ fontSize: "1.5rem", fontWeight: 700, color: "var(--text)", margin: "0 0 0.25rem" }}>
              <span style={{ color: "var(--brand)" }}>{languageFilter ? `${languageFilter}` : "Latest"}</span> Udemy Coupons & Deals
            </h2>
            <p style={{ color: "var(--muted)", margin: 0, fontSize: "0.9rem" }}>
              Showing {startIndex + 1}–{Math.min(endIndex, filteredDeals.length)} of {filteredDeals.length} courses
              {currentPage > 1 ? ` — Page ${currentPage}` : ""}
            </p>
          </div>
          {languageFilter && (
            <a href="/deals" style={{
              display: "inline-flex", alignItems: "center", gap: "0.4rem",
              padding: "0.5rem 1rem", background: "var(--card)",
              border: "1px solid var(--border)", borderRadius: "8px",
              color: "var(--text)", textDecoration: "none",
              fontSize: "0.875rem", fontWeight: 600
            }}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
              </svg>
              Clear Filter
            </a>
          )}
          <a href="/categories" style={{
            display: "inline-flex", alignItems: "center", gap: "0.4rem",
            padding: "0.5rem 1rem", background: "var(--card)",
            border: "1px solid var(--border)", borderRadius: "8px",
            color: "var(--text)", textDecoration: "none",
            fontSize: "0.875rem", fontWeight: 600
          }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
            </svg>
            Browse by Category
          </a>
        </div>

        {/* Deals grid — no key prop needed in Astro */}
        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fill, minmax(320px, 1fr))",
          gap: "1.5rem",
          marginBottom: "3rem"
        }}>
          {currentItems.map((deal: any) => (
            <DealCard deal={deal} />
          ))}
        </div>

        {/* ── PAGINATION ── */}
        {totalPages > 1 && (
          <nav aria-label="Deal pages pagination" style={{ marginTop: "2rem" }}>
            <div style={{
              display: "flex", justifyContent: "center",
              alignItems: "center", gap: "0.75rem", flexWrap: "wrap"
            }}>

              {/* Previous button */}
              {prevUrl ? (
                <a href={prevUrl} rel="prev" style={{
                  display: "inline-flex", alignItems: "center", gap: "0.4rem",
                  padding: "0.75rem 1.5rem", background: "var(--card)",
                  border: "2px solid var(--brand)", borderRadius: "10px",
                  color: "var(--brand)", textDecoration: "none",
                  fontSize: "0.95rem", fontWeight: 600
                }}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                  </svg>
                  Previous
                </a>
              ) : (
                <span style={{ padding: "0.75rem 1.5rem", opacity: 0.3, fontSize: "0.95rem", fontWeight: 600 }}>Previous</span>
              )}

              {/* FIX 3: Page numbers — pre-built array, no key prop, no >= operator */}
              {pageItems.map((item) => {
                if (item.type === 'ellipsis') {
                  return <span style={{ color: "var(--muted)", padding: "0 0.25rem" }}>…</span>;
                }
                const p = item.value;
                const isActive = p === currentPage;
                const href = p === 1 ? baseDealsUrl : `${baseDealsUrl}/${p}`;
                return (
                  <a
                    href={href}
                    aria-current={isActive ? "page" : undefined}
                    style={{
                      display: "inline-flex", alignItems: "center", justifyContent: "center",
                      width: "40px", height: "40px", borderRadius: "8px",
                      textDecoration: "none", fontSize: "0.9rem", fontWeight: 600,
                      background: isActive ? "var(--brand)" : "var(--card)",
                      color: isActive ? "var(--bg)" : "var(--text)",
                      border: isActive ? "2px solid var(--brand)" : "1px solid var(--border)"
                    }}
                  >
                    {p}
                  </a>
                );
              })}

              {/* Next button */}
              {nextUrl ? (
                <a href={nextUrl} rel="next" style={{
                  display: "inline-flex", alignItems: "center", gap: "0.4rem",
                  padding: "0.75rem 1.5rem", background: "var(--card)",
                  border: "2px solid var(--brand)", borderRadius: "10px",
                  color: "var(--brand)", textDecoration: "none",
                  fontSize: "0.95rem", fontWeight: 600
                }}>
                  Next
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                  </svg>
                </a>
              ) : (
                <span style={{ padding: "0.75rem 1.5rem", opacity: 0.3, fontSize: "0.95rem", fontWeight: 600 }}>Next</span>
              )}
            </div>

            <p style={{ textAlign: "center", color: "var(--muted)", fontSize: "0.85rem", marginTop: "1rem" }}>
              Page {currentPage} of {totalPages} — {allDeals.length} total courses
            </p>
          </nav>
        )}

      </div>
    </section>

    {/* ── ABOUT UDEMY COUPONS — SEO Content (page 1 only) ── */}
    {currentPage === 1 && (
      <section style={{ padding: "4rem 1rem", background: "var(--card)" }}>
        <div class="container" style={{ maxWidth: "1400px" }}>
          <div style={{ textAlign: "center", marginBottom: "3rem" }}>
            <h2 style={{ fontSize: "clamp(1.5rem, 4vw, 2rem)", fontWeight: 800, color: "var(--text)", marginBottom: "0.75rem" }}>
              About Udemy Coupons & Free Courses
            </h2>
            <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "700px", margin: "0 auto", lineHeight: 1.6 }}>
              Everything you need to know about finding and using verified Udemy coupon codes for online learning
            </p>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))", gap: "1.5rem" }}>
            <div style={{ background: "var(--bg)", padding: "2rem", borderRadius: "12px", border: "1px solid var(--border)" }}>
              <h3 style={{ fontSize: "1.25rem", fontWeight: 700, color: "var(--text)", marginBottom: "1rem", display: "flex", alignItems: "center", gap: "0.5rem" }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--brand)">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                What Are Udemy Coupons?
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.7, margin: 0 }}>
                Udemy coupons are promotional codes that allow you to access premium courses at significantly reduced prices or completely free. CourseSpeak curates and verifies these coupons daily, ensuring you get access to legitimate deals from instructors and Udemy itself. These coupons can offer discounts ranging from 50% to 100% off, making professional education accessible to learners worldwide.
              </p>
            </div>

            <div style={{ background: "var(--bg)", padding: "2rem", borderRadius: "12px", border: "1px solid var(--border)" }}>
              <h3 style={{ fontSize: "1.25rem", fontWeight: 700, color: "var(--text)", marginBottom: "1rem", display: "flex", alignItems: "center", gap: "0.5rem" }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(120, 70%, 45%)">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                How to Use Udemy Coupon Codes
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.7, margin: 0 }}>
                Using Udemy coupons from CourseSpeak is simple. Click on any deal on this page, and you will be redirected to the official Udemy course page with the discount automatically applied. For 100% off coupons, simply click "Enroll Now" and complete checkout without any payment. For percentage discounts, the reduced price will be shown at checkout. All coupons include full course benefits: lifetime access, completion certificates, and all course materials.
              </p>
            </div>

            <div style={{ background: "var(--bg)", padding: "2rem", borderRadius: "12px", border: "1px solid var(--border)" }}>
              <h3 style={{ fontSize: "1.25rem", fontWeight: 700, color: "var(--text)", marginBottom: "1rem", display: "flex", alignItems: "center", gap: "0.5rem" }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(210, 100%, 60%)">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                </svg>
                Why Choose CourseSpeak for Udemy Deals?
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.7, margin: 0 }}>
