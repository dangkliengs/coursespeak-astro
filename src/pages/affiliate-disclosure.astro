---
import Layout from "../layouts/Layout.astro";

const canonicalUrl = "https://coursespeak.com/affiliate-disclosure";
const pageTitle = "Affiliate Disclosure — Transparent Partnerships & Earnings | CourseSpeak";
const pageDescription = "CourseSpeak's affiliate disclosure: we earn commissions when you purchase courses through our links. Full transparency on our partnerships, pricing, and editorial independence.";
const lastModified = new Date().toISOString().split('T')[0];
const monthYear = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const faqs = [
  {
    q: "Does using CourseSpeak cost me extra money?",
    a: "No, using CourseSpeak does not cost you anything extra. When you click on our affiliate links and make a purchase, you pay the same price (or often less with our exclusive discounts) as if you went directly to the platform."
  },
  {
    q: "How does CourseSpeak make money?",
    a: "We earn small commissions from qualifying purchases made through our affiliate links. This helps us maintain and improve CourseSpeak at no cost to you. Our affiliate relationships do not influence which courses we recommend."
  },
  {
    q: "Are your course recommendations unbiased?",
    a: "Yes, absolutely. Our editorial independence is paramount. We only recommend courses and platforms we genuinely believe offer value to our users. We feature courses based on quality, relevance, and value—not commission rates."
  },
  {
    q: "Which platforms does CourseSpeak partner with?",
    a: "We partner with major online learning platforms including Udemy, Coursera, edX, Pluralsight, Skillshare, LinkedIn Learning, Udacity, and Codecademy. All partnerships are clearly disclosed on this page."
  },
  {
    q: "Do I need to create an account to use CourseSpeak?",
    a: "No, you do not need to create an account to browse and access our free course coupons. You only need a free account on the respective platform (like Udemy) to enroll in courses."
  }
];
---

<Layout title={pageTitle} description={pageDescription} type="article" canonical={canonicalUrl}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription,
        "isPartOf": { "@id": "https://coursespeak.com" },
        "datePublished": "2024-01-01",
        "dateModified": lastModified,
        "inLanguage": "en-US",
        "about": { "@type": "Thing", "name": "Affiliate Disclosure" }
      },
      {
        "@type": "Person",
        "@id": "https://coursespeak.com/#author",
        "name": "Josh Smith",
        "sameAs": ["https://x.com/courses_peak"]
      },
      {
        "@type": "Organization",
        "@id": "https://coursespeak.com/#organization",
        "name": "CourseSpeak",
        "url": "https://coursespeak.com",
        "logo": "https://coursespeak.com/logo.svg",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "contact@coursespeak.com"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": { "@type": "Answer", "text": faq.a }
        }))
      }
    ]
  })} />
  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO ── */}
    <section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          Transparency First — Updated {monthYear}
        </div>
        <h1 style={{ fontSize: "clamp(1.8rem, 4.5vw, 2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Affiliate Disclosure</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "650px", margin: "0 auto 1.5rem", lineHeight: 1.6 }}>
          CourseSpeak is an affiliate marketing platform. We earn commissions when you purchase courses through our links, but this does not affect our recommendations or pricing.
        </p>
        <div style={{ display: "flex", justifyContent: "center", alignItems: "center", gap: "1rem", flexWrap: "wrap", fontSize: "0.8rem", color: "var(--muted)" }}>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            By <strong style={{ color: "var(--text)" }}>Josh Smith</strong>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
            Updated <time datetime={lastModified}>{new Date(lastModified).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            5 min read
          </span>
        </div>
      </div>
    </section>

    {/* ── ARTICLE BODY ── */}
    <article style={{ padding: "2rem 1rem 4rem" }}>
      <div class="article-body" style={{ maxWidth: "900px", margin: "0 auto" }}>

        <p>
          <strong>Last Updated:</strong> {monthYear}. CourseSpeak is a participant in various affiliate advertising programs designed to provide a means for sites to earn advertising fees by advertising and linking to partner platforms.
        </p>

        {/* ── What This Means for You ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="what-this-means" class="section-heading">What This Means for You</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <ul style="margin:0; padding-left:1.25rem;">
              <li style="margin-bottom:0.75rem;"><strong style="color:var(--text);">No Extra Cost:</strong> When you click on our coupon links and make a purchase, you pay the same price (or often less with our exclusive discounts) as if you went directly to the platform.</li>
              <li style="margin-bottom:0.75rem;"><strong style="color:var(--text);">We Earn Commissions:</strong> We may earn a small commission from qualifying purchases made through our affiliate links. This helps us maintain and improve CourseSpeak at no cost to you.</li>
              <li style="margin-bottom:0.75rem;"><strong style="color:var(--text);">Unbiased Recommendations:</strong> Our editorial independence is paramount. We only recommend courses and platforms we genuinely believe offer value to our users.</li>
              <li style="margin-bottom:0;"><strong style="color:var(--text);">Transparent Pricing:</strong> All prices, discounts, and coupon codes displayed on CourseSpeak are accurate and verified at the time of publication.</li>
            </ul>
          </div>
        </section>

        {/* ── Affiliate Partners ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="partners" class="section-heading">Our Affiliate Partners</h2>
          <p>CourseSpeak participates in affiliate programs with the following platforms:</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:1rem; margin:1.25rem 0;">
            {[
              { name: "Udemy", url: "https://www.udemy.com" },
              { name: "Coursera", url: "https://www.coursera.org" },
              { name: "edX", url: "https://www.edx.org" },
              { name: "Pluralsight", url: "https://www.pluralsight.com" },
              { name: "Skillshare", url: "https://www.skillshare.com" },
              { name: "LinkedIn Learning", url: "https://www.linkedin.com/learning" },
              { name: "Udacity", url: "https://www.udacity.com" },
              { name: "Codecademy", url: "https://www.codecademy.com" },
            ].map(p => (
              <a href={p.url} target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:0.65rem; padding:0.85rem 1rem; background:var(--card); border:1px solid var(--border); border-radius:10px; text-decoration:none; color:var(--text); font-size:0.9rem; font-weight:600;">
                <div style="width:34px; height:34px; background:var(--brand); border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--bg); font-size:0.75rem; font-weight:800;">{p.name.charAt(0)}</div>
                {p.name}
              </a>
            ))}
          </div>
        </section>

        {/* ── Our Commitment ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="commitment" class="section-heading">Our Commitment to You</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">We are committed to maintaining the highest standards of integrity and transparency. Our affiliate relationships do not influence:</p>
            <ul style="margin:0; padding-left:1.25rem;">
              <li style="margin-bottom:0.75rem;"><strong style="color:var(--text);">Course Selection:</strong> We feature courses based on quality, relevance, and value—not commission rates.</li>
              <li style="margin-bottom:0.75rem;"><strong style="color:var(--text);">Review Process:</strong> Our editorial team independently evaluates and verifies all coupons before publication.</li>
              <li style="margin-bottom:0;"><strong style="color:var(--text);">User Experience:</strong> We prioritize your learning journey and provide honest, helpful information to help you make informed decisions.</li>
            </ul>
          </div>
        </section>

        {/* ── Contact ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="contact" class="section-heading">Questions or Concerns?</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:1rem;">If you have any questions about our affiliate relationships or this disclosure, please contact us.</p>
            <a href="/contact" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.4rem; background:var(--brand); color:var(--bg); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem;">
              Contact Us
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </section>

        {/* ── FAQ ── */}
        <section aria-labelledby="faq-heading" style="margin-bottom:2rem;">
          <h2 id="faq" class="section-heading">Frequently Asked Questions</h2>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            {faqs.map(faq => (
              <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.25rem 1.5rem;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text); margin:0 0 0.5rem; display:flex; align-items:center; gap:0.5rem;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  {faq.q}
                </h3>
                <p style="font-size:0.85rem; color:var(--muted); line-height:1.7; margin:0;">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        {/* ── CTA ── */}
        <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center; margin-top:2rem;">
          <h2 style="font-size:1.3rem; font-weight:800; color:var(--text); margin-bottom:0.5rem;">
            Browse Free Udemy Coupons
          </h2>
          <p style="color:var(--muted); font-size:0.9rem; margin-bottom:1.5rem; max-width:440px; margin-left:auto; margin-right:auto; line-height:1.6;">
            Verified 100% off Udemy coupons — updated daily across 100+ topics. No account required.
          </p>
          <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
            <a href="/deals" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.6rem; background:var(--brand); color:var(--bg); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem;">
              Browse Free Deals
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
            <a href="/udemy-coupons-guide" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.6rem; color:var(--text); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem; border:2px solid var(--border);">
              Udemy Coupons Guide
            </a>
          </div>
        </div>

      </div>
    </article>

  </div>

  <style>
    .section-heading {
      font-size: clamp(1.15rem, 2.5vw, 1.45rem);
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--border);
    }
    .article-body { font-size: 0.95rem; line-height: 1.75; color: var(--muted); }
    .article-body p { margin-bottom: 1rem; }
    .article-body p:last-child { margin-bottom: 0; }
    .article-body strong { color: var(--text); }
    .article-body a { color: var(--brand); text-decoration: underline; }
    .article-body ul { margin-bottom: 1rem; color: var(--muted); }
    .article-body ul li { margin-bottom: 0.35rem; }
    .article-body ul li:last-child { margin-bottom: 0; }
  </style>
</Layout>
