---
import Layout from '../layouts/Layout.astro';
import DealCard from '../components/DealCard.astro';
import { readDeals } from '../lib/store';

const q = Astro.url.searchParams.get('q') ?? '';
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10));
const PAGE_SIZE = 12;

const allDeals = await readDeals();
const query = q.trim().toLowerCase();

const filteredDeals = allDeals.filter((deal) =>
  String(deal.title || "").toLowerCase().includes(query) ||
  String(deal.description || "").toLowerCase().includes(query) ||
  String(deal.category || "").toLowerCase().includes(query) ||
  String(deal.instructor || "").toLowerCase().includes(query) ||
  String(deal.subcategory || "").toLowerCase().includes(query)
);

const totalPages = Math.ceil(filteredDeals.length / PAGE_SIZE);
const currentPage = Math.min(page, totalPages || 1);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const currentItems = filteredDeals.slice(startIndex, startIndex + PAGE_SIZE);

const siteUrl = "https://coursespeak.com";
const currentUrl = `${siteUrl}/search?q=${encodeURIComponent(q)}`;
const langQuery = q ? `&q=${encodeURIComponent(q)}` : '';
const prevUrl = currentPage > 1 ? (currentPage === 2 ? `/search${langQuery}` : `/search?page=${currentPage - 1}${langQuery}`) : null;
const nextUrl = currentPage < totalPages ? `/search?page=${currentPage + 1}${langQuery}` : null;

const currentMonth = new Date().toLocaleDateString('en-US', { month: 'long' });
const currentYear = new Date().getFullYear();

const pageTitle = query
  ? `"${q}" — Udemy Courses with Verified Coupons | CourseSpeak`
  : `Search Udemy Courses — Verified Coupons & Deals | CourseSpeak`;

const pageDescription = query
  ? `Found ${filteredDeals.length} verified Udemy courses matching "${q}" with exclusive coupons. Browse deals taught by expert instructors — up to 100% off.`
  : `Search verified Udemy course coupons and deals. Browse discounts across programming, web development, data science, marketing, and more. Updated daily.`;

---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
  robots={query ? "noindex, follow" : undefined}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SearchResultsPage",
    "@id": `${currentUrl}#search-results`,
    "url": currentUrl,
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": siteUrl },
    "about": query ? { "@type": "Thing", "name": q } : { "@type": "Thing", "name": "Udemy Coupons" },
    "mainEntity": {
      "@type": "ItemList",
      "name": `Search results for "${q || "Udemy courses"}"`,
      "numberOfItems": filteredDeals.length,
      "itemListElement": currentItems.map((deal, index) => ({
        "@type": "ListItem",
        "position": startIndex + index + 1,
        "item": {
          "@type": "Course",
          "name": deal.title,
          "description": deal.description || `Get ${deal.title} at up to 100% off with a verified coupon code on CourseSpeak.`,
          "url": `${siteUrl}/deal/${deal.id}`,
          "image": deal.image,
          "inLanguage": deal.language || "en-US",
          "provider": {
            "@type": "Organization",
            "name": deal.provider || "Udemy",
            "url": "https://www.udemy.com"
          },
          "offers": {
            "@type": "Offer",
            "price": String(deal.price ?? "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
            "priceValidUntil": deal.expiresAt || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),
            "seller": { "@type": "Organization", "name": "CourseSpeak", "url": siteUrl }
          },
          ...(deal.rating ? {
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": deal.rating.toString(),
              "bestRating": "5",
              "worstRating": "1",
              "ratingCount": Math.max(1, Math.round(deal.students ?? 1000))
            }
          } : {})
        }
      }))
    }
  })} />

  <!-- Hero -->
  <section class="search-hero">
    <div class="hero-grid-bg"></div>
    <div class="container hero-inner">
      <div class="hero-badge">
        <span class="badge-pulse"></span>
        Live Deals — Updated Daily
      </div>
      <h1 id="search-title" class="hero-title">
        {query ? `"${q}"` : 'Search Udemy Courses'}
      </h1>
      {query ? (
        <p class="hero-desc">
          Found <strong>{filteredDeals.length}</strong> verified Udemy courses matching <strong>"{q}"</strong> with exclusive coupons.
        </p>
      ) : (
        <p class="hero-desc">
          Find verified Udemy coupon codes and deals across programming, web development, data science, marketing, and more — updated daily.
        </p>
      )}
    </div>
  </section>

  <!-- Results section -->
  <section class="results-section">
    <div class="container">
      {filteredDeals.length === 0 && (
        <div class="no-results-wrap">
          <div class="no-results-card">
            <div class="no-results-icon">🔍</div>
            <h2 class="no-results-heading">No Courses Found</h2>
            <p class="no-results-body">
              We couldn't find any courses with verified coupons for {query ? `<strong>"{q}"</strong>` : 'that search'}.
              Try <strong>free courses</strong>, <strong>discount codes</strong>, or browse popular categories below.
            </p>
            <div class="no-results-actions">
              <a href="/search?q=free" class="action-btn action-green">🎁 Free Courses</a>
              <a href="/search?q=coupon" class="action-btn action-amber">💰 Discount Codes</a>
            </div>
            <div class="category-grid">
              <a href="/categories/development" class="cat-btn">💻 Development</a>
              <a href="/categories/business" class="cat-btn cat-green">💼 Business</a>
              <a href="/categories/design" class="cat-btn cat-amber">🎨 Design</a>
              <a href="/categories/it-and-software" class="cat-btn cat-blue">💾 IT & Software</a>
            </div>
          </div>
        </div>
      )}

      {filteredDeals.length > 0 && (
        <>
          <div class="results-header" style="margin-bottom: 1.5rem;">
            <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              {query ? `Search results for "${q}"` : 'Latest Deals'}
            </div>
            <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0.35rem 0 0.3rem" }}>
              {query ? `"${q}" — Udemy Courses with Verified Coupons` : `Latest Udemy Promo Codes, Coupons & Deals ${currentMonth} ${currentYear}`}
            </h2>
            <p style={{ fontSize: "0.9rem", color: "var(--muted)", maxWidth: "650px", margin: "0", lineHeight: 1.6 }}>
              Browse {filteredDeals.length} verified Udemy courses {query ? `matching "${q}"` : ''} with exclusive coupons — up to 100% off. Updated {currentMonth} {currentYear}.
            </p>
          </div>

          <div class="results-grid">
            {currentItems.map((deal) => (
              <DealCard deal={deal} />
            ))}
          </div>

          {totalPages > 1 && (
            <nav aria-label="Pagination" class="pagination">
              {prevUrl ? (
                <a href={prevUrl} class="page-btn page-btn-ghost">← Prev</a>
              ) : (
                <span class="page-btn page-btn-ghost" aria-disabled="true">← Prev</span>
              )}
              <div class="page-numbers">
                {(() => {
                  const items = [];
                  const window = 2;
                  let lastAdded = 0;
                  for (let p = 1; p <= totalPages; p++) {
                    const inWindow = p >= currentPage - window && p <= currentPage + window;
                    if (p === 1 || p === totalPages || inWindow) {
                      if (lastAdded > 0 && p - lastAdded > 1) {
                        items.push(<span class="page-ellipsis">…</span>);
                      }
                      items.push(
                        p === currentPage
                          ? <span class="page-btn page-active">{p}</span>
                          : <a href={`/search?page=${p}${langQuery}`} class="page-btn page-btn-ghost">{p}</a>
                      );
                      lastAdded = p;
                    }
                  }
                  return items;
                })()}
              </div>
              {nextUrl ? (
                <a href={nextUrl} class="page-btn page-btn-primary">Next →</a>
              ) : (
                <span class="page-btn page-btn-primary" aria-disabled="true">Next →</span>
              )}
              <span class="page-info">Page {currentPage} of {totalPages} · {filteredDeals.length} results</span>
            </nav>
          )}
        </>
      )}
    </div>
  </section>

  {query === '' && (
    <section class="search-cta" style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "3rem 1.5rem", marginTop: "3rem" }}>
      <div class="container" style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ textAlign: "center", marginBottom: "2rem" }}>
          <h2 style={{ fontSize: "clamp(1.5rem, 4vw, 2rem)", fontWeight: 800, color: "var(--text)", marginBottom: "0.75rem" }}>Browse All Udemy Coupons</h2>
          <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "600px", margin: "0 auto", lineHeight: 1.6 }}>
            Explore verified Udemy coupon codes across all categories — programming, web development, data science, design, marketing, and more.
          </p>
        </div>
        <div style={{ display: "flex", gap: "1rem", justifyContent: "center", flexWrap: "wrap" }}>
          <a href="/deals" style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", padding: "0.85rem 1.5rem", background: "var(--brand)", color: "#080b12", fontWeight: 700, fontSize: "0.95rem", textDecoration: "none", borderRadius: "8px" }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h18v2H3V3zm0 4h18v2H3V7zm0 4h18v2H3v-2zM3 13h18v-2H3v2zm0 4h18v-2H3v2z"/></svg>
            All Deals
          </a>
          <a href="/categories" style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", padding: "0.85rem 1.5rem", background: "var(--card-hover)", border: "1px solid var(--border)", color: "var(--text)", fontWeight: 600, fontSize: "0.95rem", textDecoration: "none", borderRadius: "8px" }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Categories
          </a>
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  :root {
    --bg-dark: #0f0e0c;
    --bg-card: #1a1814;
    --border: rgba(255,255,255,0.07);
    --green: #D4AF37;
    --green-dark: #B8860B;
    --amber: #C5A028;
    --blue: #D4AF37;
    --red: #8a2a26;
    --text-primary: #f5f0e8;
    --text-secondary: #a09888;
    --text-muted: #6b6050;
    --radius-card: 1.25rem;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== HERO ===== */
  .search-hero {
    background: linear-gradient(160deg, var(--card) 0%, var(--bg) 60%);
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(212,167,55,0.1);
    border: 1px solid rgba(212,167,55,0.25);
    color: var(--green);
    padding: 0.4rem 1.1rem;
    border-radius: 2rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
  }

  .badge-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ===== RESULTS ===== */
  .results-section {
    background: var(--bg-dark);
    padding: 3rem 0 6rem;
    min-height: 60vh;
  }

  /* No results */
  .no-results-wrap {
    display: flex;
    justify-content: center;
    padding: 3rem 0;
  }

  .no-results-card {
    max-width: 620px;
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 3rem 2.5rem;
    text-align: center;
  }

  .no-results-icon { font-size: 3rem; margin-bottom: 1rem; }

  .no-results-heading {
    color: var(--text-primary);
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }

  .no-results-body {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 2rem;
  }

  .no-results-body strong { color: var(--amber); }

  .no-results-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .action-btn {
    display: inline-block;
    padding: 0.85rem 2rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: filter 0.2s;
  }

  .action-btn:hover { filter: brightness(1.1); }

  .action-green {
    background: var(--green);
    color: #0a1a0f;
  }

  .action-amber {
    background: var(--amber);
    color: #1c0f00;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cat-btn {
    display: block;
    padding: 0.85rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .cat-btn:hover { background: rgba(255,255,255,0.09); color: var(--text-primary); }
  .cat-green { border-color: rgba(212,167,55,0.2); color: #E8C547; }
  .cat-amber { border-color: rgba(197,160,40,0.2); color: #C5A028; }
  .cat-blue  { border-color: rgba(212,167,55,0.2); color: var(--blue); }

  /* Results grid */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .page-btn {
    padding: 0.65rem 1.5rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: 1px solid;
    text-decoration: none;
    display: inline-block;
  }

  .page-btn:disabled,
  .page-btn[aria-disabled="true"] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .page-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text-secondary);
  }

  .page-btn-ghost:not(:disabled):not([aria-disabled="true"]):hover {
    background: rgba(255,255,255,0.05);
    color: var(--text-primary);
  }

  .page-btn-primary {
    background: var(--green);
    border-color: var(--green-dark);
    color: #0a1a0f;
  }

  .page-btn-primary:not(:disabled):not([aria-disabled="true"]):hover {
    background: var(--green-dark);
  }

  .page-active {
    background: var(--green);
    border-color: var(--green-dark);
    color: #0a1a0f;
    cursor: default;
  }

  .page-ellipsis {
    padding: 0.65rem 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .page-info {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    min-width: 140px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .results-grid { grid-template-columns: 1fr; }
    .no-results-card { padding: 2rem 1.25rem; }
    .pagination { gap: 0.5rem; padding: 1rem 1rem; }
    .page-numbers { display: none; }
  }
</style>