---
import Layout from '../layouts/Layout.astro';
import { readDeals } from '../lib/store';
import type { Deal } from '../types/deal.d';
import { parseInstructors, createInstructorSlug } from '../lib/instructors';
import { getInstructorImageByName } from '../lib/instructorProfiles';

// ─────────────────────────────────────────────
// TYPES
// ─────────────────────────────────────────────
interface Instructor {
  name: string;
  courses: Deal[];
  totalStudents: number;
  avgRating: number;
  avgDiscount: number;
  categories: string[];
  totalReviews: number;
  provider: string;
  courseCount: number;
}

// ─────────────────────────────────────────────
// DATA AGGREGATION
// ─────────────────────────────────────────────
const deals: Deal[] = await readDeals();
const instructorMap = new Map<string, Instructor>();

// ... parseInstructors removed (using import)

deals.forEach((deal: Deal) => {
  if (!deal.instructor) return;
  
  // Split comma-separated instructors
  const instructorNames = parseInstructors(deal.instructor);
  
  // Add course to each individual instructor
  instructorNames.forEach((instructorName) => {
    if (!instructorMap.has(instructorName)) {
      instructorMap.set(instructorName, {
        name: instructorName,
        courses: [],
        totalStudents: 0,
        avgRating: 0,
        avgDiscount: 0,
        categories: [],
        totalReviews: 0,
        provider: deal.provider || 'Udemy',
        courseCount: 0,
      });
    }

    const inst = instructorMap.get(instructorName)!;
    inst.courses.push(deal);
    inst.totalStudents += deal.students || 0;
    if (deal.rating) {
      const count = inst.courses.length;
      inst.avgRating = (inst.avgRating * (count - 1) + deal.rating) / count;
      inst.totalReviews += deal.students || 0;
    }
    if (deal.originalPrice && (deal.price ?? 0) < deal.originalPrice) {
      const disc = Math.round(100 - ((deal.price ?? 0) / deal.originalPrice) * 100);
      const count = inst.courses.length;
      inst.avgDiscount = (inst.avgDiscount * (count - 1) + disc) / count;
    }
    if (deal.category && !inst.categories.includes(deal.category)) {
      inst.categories.push(deal.category);
    }
  });
});

const instructors: Instructor[] = Array.from(instructorMap.values())
  .map((inst) => ({
    ...inst,
    courseCount: inst.courses.length,
    avgRating: Number(inst.avgRating.toFixed(1)),
    avgDiscount: Math.round(inst.avgDiscount),
  }))
  .sort((a, b) => b.totalStudents - a.totalStudents);

// ─────────────────────────────────────────────
// INSTRUCTOR IMAGES (registry foto instructor)
// ─────────────────────────────────────────────
const instructorImages = new Map<string, string>();
for (const inst of instructors) {
  const img = getInstructorImageByName(inst.name);
  if (img) instructorImages.set(createInstructorSlug(inst.name), img);
}

// ─────────────────────────────────────────────
// FRESH FEED for hero
// ─────────────────────────────────────────────
function timeAgo(iso: string | undefined): string {
  if (!iso) return 'new';
  const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.round(hrs / 24);
  return days <= 1 ? 'today' : `${days}d ago`;
}

const heroFeed = deals.slice(0, 3).map((d) => {
  const pct =
    d.originalPrice && (d.price ?? 0) < d.originalPrice
      ? Math.round(100 - ((d.price ?? 0) / (d.originalPrice ?? 1)) * 100)
      : 0;
  return {
    href: `/deal/${d.id}`,
    time: timeAgo(d.updatedAt ?? d.createdAt),
    cat: d.category || 'Course',
    title: d.title,
    save: (d.price ?? 0) === 0 ? 'FREE' : `−${pct}%`,
  };
});

// ─────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────
function getInitials(name: string): string {
  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}

// ─────────────────────────────────────────────
// AGGREGATED STATS
// ─────────────────────────────────────────────
// One row per deal in deals.json — do not sum per-instructor counts (co-teachers double-count)
const dealCount = deals.length;
const allCategories = Array.from(new Set(instructors.flatMap((i) => i.categories))).sort();

// ─────────────────────────────────────────────
// DATE
// ─────────────────────────────────────────────
const now = new Date();
const monthNames = [
  'January','February','March','April','May','June',
  'July','August','September','October','November','December',
];
const currentMonth = monthNames[now.getMonth()];
const currentYear  = now.getFullYear();

// ─────────────────────────────────────────────
// SEO
// ─────────────────────────────────────────────
const siteUrl      = 'https://coursespeak.com';
const canonicalUrl = `${siteUrl}/instructors`;
const title        = `Top Udemy Instructors with Free Coupons ${currentMonth} ${currentYear} | CourseSpeak`;
const description  = `Browse ${instructors.length} expert Udemy instructors offering ${dealCount}+ verified courses. Get free & discounted coupons updated daily — ${currentMonth} ${currentYear}.`;

// ─────────────────────────────────────────────
// FAQs — identical between schema and HTML (Google requirement)
// ─────────────────────────────────────────────
const faqs = [
  {
    q: 'Who are the top Udemy instructors with free coupons?',
    a: `CourseSpeak features ${instructors.length} verified Udemy instructors who regularly share free and discounted coupons. Top instructors include those in development, data science, design, and business — all with high student ratings and active coupons updated daily.`,
  },
  {
    q: 'How do I get a free course from a Udemy instructor?',
    a: 'Click "View All Courses" on any instructor card to see their latest verified deals. Click the coupon link — it redirects to Udemy with the discount automatically applied. For 100% off coupons, you can enroll completely free with no payment required.',
  },
  {
    q: 'Are instructor coupons on CourseSpeak verified?',
    a: 'Yes. Every coupon listed is verified before publishing. We check validity daily and remove expired codes automatically so you never encounter a broken deal.',
  },
  {
    q: 'How often do Udemy instructors release new coupons?',
    a: 'Most active instructors release new coupons daily or weekly, especially for new course editions or promotions. CourseSpeak monitors all major Udemy instructors and updates listings within hours of new coupon releases.',
  },
  {
    q: 'Do free Udemy courses from these instructors include certificates?',
    a: 'Yes. All Udemy courses obtained through coupons include official completion certificates, lifetime access, and all course materials including future updates — same as paid enrollment.',
  },
  {
    q: 'Can I filter instructors by category or rating?',
    a: 'Yes! Use the category and rating filters above the instructor grid to find instructors in specific topics like development, design, business, or data science. You can also sort by students, courses, rating, or name to find the perfect instructor for your learning goals.',
  },
];

const avgDiscountOverall = deals.length
  ? Math.round(
      deals.reduce(
        (s, d) =>
          s +
          (d.originalPrice
            ? Math.round(100 - ((d.price ?? 0) / d.originalPrice) * 100)
            : 0),
        0
      ) / deals.length
    )
  : 0;

// ─────────────────────────────────────────────
// STRUCTURED DATA
// ─────────────────────────────────────────────
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Udemy Deals', item: `${siteUrl}/deals` },
        { '@type': 'ListItem', position: 3, name: 'Instructors & Coupons', item: canonicalUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      dateModified: now.toISOString().split('T')[0],
      inLanguage: 'en-US',
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      about: {
        '@type': 'Thing',
        'name': 'Udemy Instructors with Free Coupons',
        'description': 'Browse expert Udemy instructors offering verified discount coupons and free courses'
      },
      audience: {
        '@type': 'Audience',
        'audienceType': 'Learners worldwide seeking free and discounted courses from top Udemy instructors',
        'geographicArea': ['United States', 'United Kingdom', 'India', 'Canada', 'Australia', 'Germany', 'France', 'Brazil', 'Japan', 'Global']
      },
      mainEntity: {
        '@type': 'ItemList',
        name: `Top Udemy Instructors — ${currentMonth} ${currentYear}`,
        numberOfItems: instructors.length,
        itemListElement: instructors.slice(0, 20).map((inst, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Person',
            name: inst.name,
            ...(instructorImages.get(createInstructorSlug(inst.name))
              ? { image: instructorImages.get(createInstructorSlug(inst.name)) }
              : {}),
            jobTitle: 'Udemy Instructor',
            worksFor: { '@type': 'Organization', name: inst.provider },
            knowsAbout: inst.categories,
            description: `Expert Udemy instructor in ${inst.categories.join(', ')} with ${inst.courseCount} courses and ${inst.totalStudents.toLocaleString()} students.`,
            areaServed: ['United States', 'United Kingdom', 'India', 'Canada', 'Australia', 'Germany', 'France', 'Brazil', 'Japan', 'Global'],
            ...(inst.avgRating
              ? {
                  aggregateRating: {
                    '@type': 'AggregateRating',
                    ratingValue: inst.avgRating,
                    reviewCount: inst.totalReviews,
                    bestRating: 5,
                    worstRating: 1,
                  },
                }
              : {}),
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonicalUrl}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div style={{ minHeight: '100vh', color: 'var(--text)' }}>

    {/* ── HERO (headline + stats + feed) ── */}
    <section class="il-hero">
      <div class="container il-grid">
        <div class="il-copy">
          <p class="il-eyebrow">
            <span class="il-blink" aria-hidden="true"></span>
            Verified instructor directory · {dealCount.toLocaleString()} coupons
          </p>
          <h1 class="il-title">Top Udemy <span>Instructors</span></h1>
          <p class="il-sub">
            Instructors ranked by <strong>{dealCount.toLocaleString()}+ verified coupon deals</strong> shared
            with learners — every code manually checked before listing, updated {currentMonth} {currentYear}.
          </p>
          <div class="il-stats">
            <div class="il-stat">
              <div class="il-stat-num"><span data-il-count={instructors.length}>0</span></div>
              <div class="il-stat-lab">instructors</div>
            </div>
            <div class="il-stat">
              <div class="il-stat-num"><span data-il-count={dealCount}>0</span>+</div>
              <div class="il-stat-lab">coupons tracked</div>
            </div>
            <div class="il-stat">
              <div class="il-stat-num"><span data-il-count={avgDiscountOverall}>0</span>%</div>
              <div class="il-stat-lab">avg discount</div>
            </div>
          </div>
          <div class="il-toolbar">
            <a class="il-btn" href="#leaderboard">View the leaderboard</a>
            <a class="il-btn ghost" href="/categories">Browse by category</a>
            <a class="il-btn ghost" href="/deals">Today's new deals</a>
          </div>
        </div>
        <div class="il-feed">
          <div class="il-feed-head"><span>Freshly verified</span><a href="/deals">Today's batch →</a></div>
          <div class="il-feed-body">
            {heroFeed.map((d) => (
              <a class="il-feed-line" href={d.href}>
                <span class="il-feed-time">{d.time}</span>
                <span class="il-feed-ok">✓</span>
                <span class="il-feed-cat">{d.cat}</span>
                <span class="il-feed-title">{d.title}</span>
                <span class="il-feed-save">{d.save}</span>
              </a>
            ))}
          </div>
          <div class="il-feed-foot">{instructors.length} instructors ranked · <b>{dealCount.toLocaleString()} coupons</b></div>
        </div>
      </div>
    </section>

    {/* ── GEO AI PERSONALISATION BANNER ── */}
    <div
      id="geo-banner"
      style={{ display: 'none', background: 'var(--card)', borderBottom: '1px solid var(--border)', padding: '0.85rem 1rem' }}
    >
      <div class="container" style={{ display: 'flex', alignItems: 'center', gap: '0.75rem', flexWrap: 'wrap' }}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--brand)" style={{ flexShrink: 0 }}>
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span id="geo-text" style={{ fontSize: '0.88rem', color: 'var(--text)', fontWeight: 500 }}></span>
        <a id="geo-link" href="#leaderboard" style={{ marginLeft: 'auto', fontSize: '0.82rem', color: 'var(--brand)', fontWeight: 700, textDecoration: 'none', whiteSpace: 'nowrap' }}>
          Browse now →
        </a>
      </div>
    </div>

    {/* ── DIRECTORY SECTION ── */}
    <section style={{ padding: '3rem 1rem 4rem' }}>
      <div class="container" style={{ maxWidth: '1400px' }}>

        {/* Header row — mirrors /deals layout */}
        <div style={{
          display: 'flex', justifyContent: 'space-between', alignItems: 'flex-end',
          marginBottom: '2rem', flexWrap: 'wrap', gap: '1rem',
        }}>
          <div>
            <h2 style={{ fontSize: '1.5rem', fontWeight: 700, color: 'var(--text)', margin: '0 0 0.25rem' }}>
              <span style={{ color: 'var(--brand)' }}>Browse</span> Instructors & Coupons
            </h2>
            <p id="resultCount" style={{ color: 'var(--muted)', margin: 0, fontSize: '0.9rem' }}>
              {instructors.length} instructors found
            </p>
          </div>

          {/* Filters — compact, right-aligned like /deals category link */}
          <div style={{ display: 'flex', gap: '0.75rem', flexWrap: 'wrap', alignItems: 'flex-end' }}>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '0.3rem' }}>
              <label class="filter-label" for="categoryFilter">Category</label>
              <select id="categoryFilter" class="filter-select">
                <option value="">All Categories</option>
                {allCategories.map((cat) => <option value={cat}>{cat}</option>)}
              </select>
            </div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '0.3rem' }}>
              <label class="filter-label" for="ratingFilter">Min Rating</label>
              <select id="ratingFilter" class="filter-select">
                <option value="">Any Rating</option>
                <option value="4.5">4.5+ Stars</option>
                <option value="4.0">4.0+ Stars</option>
                <option value="3.5">3.5+ Stars</option>
              </select>
            </div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '0.3rem' }}>
              <label class="filter-label" for="sortBy">Sort By</label>
              <select id="sortBy" class="filter-select">
                <option value="students">Most Students</option>
                <option value="courses">Most Courses</option>
                <option value="rating">Highest Rated</option>
                <option value="name">Name A–Z</option>
              </select>
            </div>
            <a href="/categories" style={{
              display: 'inline-flex', alignItems: 'center', gap: '0.4rem',
              padding: '0.5rem 1rem', background: 'var(--card)',
              border: '1px solid var(--border)', borderRadius: '8px',
              color: 'var(--text)', textDecoration: 'none',
              fontSize: '0.875rem', fontWeight: 600,
            }}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
              </svg>
              Browse by Category
            </a>
          </div>
        </div>

        {/* ── LEADERBOARD ── */}
        <h2 class="il-sec-title" id="leaderboard" style={{ scrollMarginTop: '5rem' }}>
          Top Instructors with Verified Coupons <span class="il-tag">{instructors.length} ranked</span>
        </h2>
        <p class="il-sec-desc" style={{ marginBottom: '1rem' }}>Sorted by students — every code manually checked before listing.</p>

        <div class="il-table-wrap" id="leaderboardWrap">
          <table class="il-table">
            <thead>
              <tr>
                <th class="il-th-rank">#</th>
                <th class="il-th-name">Instructor</th>
                <th class="il-th-num">Courses</th>
                <th class="il-th-num">Avg Disc</th>
                <th class="il-th-num">Students</th>
                <th class="il-th-num">Rating</th>
              </tr>
            </thead>
            <tbody id="leaderboardBody">
              {instructors.map((instructor, index) => {
                const slug = createInstructorSlug(instructor.name);
                const instructorImg = instructorImages.get(slug);
                const medal = index === 0 ? '#D4AF37' : index === 1 ? '#94a3b8' : index === 2 ? '#cd7f32' : null;
                const students = instructor.totalStudents > 1000
                  ? (instructor.totalStudents / 1000).toFixed(1) + 'k'
                  : String(instructor.totalStudents);
                return (
                  <tr
                    class="il-row"
                    data-categories={instructor.categories.join(',')}
                    data-rating={instructor.avgRating}
                    data-students={instructor.totalStudents}
                    data-courses={instructor.courseCount}
                    data-name={instructor.name.toLowerCase()}
                  >
                    <td class="il-rank">
                      {medal ? (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill={medal} aria-label={`Rank ${index + 1}`}>
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      ) : (
                        <span class="il-rank-num">{index + 1}</span>
                      )}
                    </td>
                    <td class="il-name-cell">
                      {instructorImg ? (
                        <span class="il-avatar"><img src={instructorImg} alt={instructor.name} loading="lazy" width="36" height="36" /></span>
                      ) : (
                        <span class="il-avatar il-avatar-fb">{getInitials(instructor.name)}</span>
                      )}
                      <span class="il-name-info">
                        <a href={`/instructor/${slug}`} class="il-name-link">{instructor.name}</a>
                        <span class="il-name-meta">{instructor.categories.slice(0, 2).join(', ') || instructor.provider}</span>
                      </span>
                    </td>
                    <td class="il-num">{instructor.courseCount}</td>
                    <td class="il-num">{instructor.avgDiscount}%</td>
                    <td class="il-num">{students}</td>
                    <td class="il-num"><span class="il-rating">★ {instructor.avgRating}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {/* No results state */}
        <div id="noResults" style={{ display: 'none', textAlign: 'center', padding: '4rem 1rem' }}>
          <div style={{
            background: 'var(--card)', borderRadius: '14px',
            border: '1px solid var(--border)', padding: '3rem 2rem',
            maxWidth: '480px', margin: '0 auto',
          }}>
            <div style={{ fontSize: '2.5rem', marginBottom: '1rem' }}>🔍</div>
            <h3 style={{ color: 'var(--text)', fontSize: '1.3rem', margin: '0 0 0.5rem' }}>No instructors match your filters</h3>
            <p style={{ color: 'var(--muted)', margin: 0 }}>Try adjusting the category or rating filter.</p>
          </div>
        </div>

      </div>
    </section>

    {/* ── FAQ — synced with schema, full width grid layout ── */}
    <section class="card-gradient" style={{ padding: '4rem 1rem' }}>
      <div class="container" style={{ maxWidth: '1400px' }}>
        <div style={{ textAlign: 'center', marginBottom: '3rem' }}>
          <h2 style={{ fontSize: 'clamp(1.5rem, 4vw, 2rem)', fontWeight: 800, color: 'var(--text)', marginBottom: '0.75rem' }}>
            Frequently Asked Questions About Udemy Instructors
          </h2>
          <p style={{ color: 'var(--muted)', fontSize: '1rem', maxWidth: '700px', margin: '0 auto', lineHeight: 1.6 }}>
            Get answers to common questions about finding, filtering, and enrolling in courses from top Udemy instructors with verified coupons
          </p>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(400px, 1fr))', gap: '1.5rem' }}>
          {faqs.map((faq) => (
            <div style={{
              background: 'var(--card)', borderRadius: '14px',
              border: '1px solid var(--border)', overflow: 'hidden',
            }}>
              <div style={{ padding: '1.25rem 1.5rem' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 700, color: 'var(--text)', marginBottom: '0.75rem' }}>
                  {faq.q}
                </h3>
                <p style={{ color: 'var(--muted)', lineHeight: 1.7, margin: 0, fontSize: '0.95rem' }}>
                  {faq.a}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── ABOUT INSTRUCTORS — SEO Content (6 items) ── */}
    <section style={{ padding: '4rem 1rem', background: 'var(--card)' }}>
      <div class="container" style={{ maxWidth: '1400px' }}>
        <div style={{ textAlign: 'center', marginBottom: '3rem' }}>
          <h2 style={{ fontSize: 'clamp(1.5rem, 4vw, 2rem)', fontWeight: 800, color: 'var(--text)', marginBottom: '0.75rem' }}>
            About Udemy Instructors & Free Coupons
          </h2>
          <p style={{ color: 'var(--muted)', fontSize: '1rem', maxWidth: '700px', margin: '0 auto', lineHeight: 1.6 }}>
            Everything you need to know about finding and using verified coupon codes from top Udemy instructors worldwide
          </p>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))', gap: '1.5rem' }}>
          <div style={{ background: 'var(--bg)', padding: '2rem', borderRadius: '12px', border: '1px solid var(--border)' }}>
            <h3 style={{ fontSize: '1.25rem', fontWeight: 700, color: 'var(--text)', marginBottom: '1rem', display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--brand)">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              Who Are Top Udemy Instructors?
            </h3>
            <p style={{ color: 'var(--muted)', lineHeight: 1.7, margin: 0 }}>
              CourseSpeak features {instructors.length} verified Udemy instructors with proven track records. These instructors have taught millions of students worldwide and maintain high ratings across their courses. From programming and data science to design and business, our instructors cover all major learning topics with expertise and practical experience.
            </p>
          </div>

          <div style={{ background: 'var(--bg)', padding: '2rem', borderRadius: '12px', border: '1px solid var(--border)' }}>
            <h3 style={{ fontSize: '1.25rem', fontWeight: 700, color: 'var(--text)', marginBottom: '1rem', display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(120, 70%, 45%)">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              How to Get Free Courses
            </h3>
            <p style={{ color: 'var(--muted)', lineHeight: 1.7, margin: 0 }}>
