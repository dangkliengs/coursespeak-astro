---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-hub.css";
import allDeals from "../data/deals.json";
import { linuxVouchers, voucherPrice, linuxVoucherCount, LF_AFFILIATE_BASE } from "../data/vouchers";

const ckadUrl = `${LF_AFFILIATE_BASE}?u=https%3A%2F%2Fwww.udemy.com%2Fcertification-vouchers%2Fcertified-kubernetes-application-developer-ckad%2F`;
const allVouchersUrl = `${LF_AFFILIATE_BASE}?u=https%3A%2F%2Fwww.udemy.com%2Fall-certification-vouchers%2F`;

const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-linux-foundation-exam-vouchers";
const pageTitle = `Linux Foundation Exam Vouchers ${currentYear}: CKA, CKS & CNPE Save 30%`;
const pageDescription = `CKA, CKS and CNPE Linux Foundation exam vouchers on Udemy in ${currentYear}: $311.50 vs $445 direct, two exam attempts, 6-month redemption and 12-month exam window. CKAD compared too.`;
const pageKeywords = "Linux Foundation exam vouchers, CKA voucher, CKS voucher, CNPE voucher, CKAD voucher, Udemy Kubernetes voucher, Kubernetes certification discount";

const sources = [
  { label: "Linux Foundation CKA", url: "https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" },
  { label: "Linux Foundation CKS", url: "https://training.linuxfoundation.org/certification/certified-kubernetes-security-specialist/" },
  { label: "Linux Foundation CNPE", url: "https://training.linuxfoundation.org/certification/certified-cloud-native-platform-engineer-cnpe/" },
  { label: "Udemy voucher catalogue", url: allVouchersUrl },
];

const cka = linuxVouchers[0];
const cks = linuxVouchers[1];
const cnpe = linuxVouchers[2];

const faqs = [
  { q: "Which Linux Foundation exam vouchers can I buy on Udemy?", cat: "catalog", a: "Four: CKA, CKAD, CKS and CNPE. All four are official Linux Foundation vouchers sold by Udemy and cost $311.50 — 30% off the $445 list price. This guide covers the three role tracks in depth (CKA administrator, CKS security, CNPE platform engineering). CKAD is the developer-focused exam. Other Linux Foundation certifications such as LFCS are bought directly." },
  { q: "How much do Linux Foundation exam vouchers cost on Udemy?", cat: "price", a: "$311.50 each in the US, against $445 direct — a $133.50 saving, or 30%. The price is the same for all four vouchers, including CKAD. Regional pricing varies; confirm the live price at checkout." },
  { q: "Do the vouchers include two exam attempts?", cat: "rules", a: "Yes. Both the Udemy voucher and Linux Foundation registration include two attempts. There is no retake add-on to buy and no code to claim. If you fail both attempts, you must buy a new voucher." },
  { q: "How long do I have to use the voucher?", cat: "rules", a: "Udemy vouchers must be redeemed within 6 months of purchase, then the exam must be taken within 12 months of redemption — up to 18 months total, but the 6-month redemption deadline is the one people miss. Direct Linux Foundation purchases give 12 months to schedule and take the exam." },
  { q: "Is the Udemy voucher the same exam as buying direct?", cat: "trust", a: "Yes. The certification, exam content and PSI delivery are identical. Udemy is the seller; the Linux Foundation owns the certification and PSI proctors the exam. You redeem the code in the Linux Foundation My Portal, then schedule through PSI." },
  { q: "How do I redeem a Linux Foundation voucher?", cat: "booking", a: "Buy on Udemy, open My Learning → Certifications, copy the code, sign in to the Linux Foundation My Portal, redeem it, then follow the link to PSI to choose a date. The exam is online and remotely proctored." },
  { q: "Can I use an Udemy coupon on a Linux Foundation voucher?", cat: "price", a: "No. Coupons never apply to exam vouchers. They do apply to prep courses. The voucher price is already 30% below the Linux Foundation list price." },
  { q: "Does CKS require CKA?", cat: "choice", a: "Yes. CKS candidates must have taken and passed CKA before attempting CKS. You can buy the CKS voucher first, but do not book the exam until your CKA pass is confirmed — the redemption clock keeps running." },
  { q: "Which should I take first: CKA, CKAD, CKS or CNPE?", cat: "choice", a: "Most people start with CKA: no prerequisites, most widely recognized, and required before CKS. If you build applications rather than administer clusters, CKAD is the better first exam. Take CKS after CKA for security roles. CNPE assumes hands-on platform experience." },
  { q: "Is CNPE worth it?", cat: "choice", a: "CNPE is the newest of the four and targets senior platform engineering roles — platform architect, principal platform engineer. It covers GitOps, platform APIs, observability and policy. It is less established than CKA/CKS, so check local job posts first." },
  { q: "What is the exam format?", cat: "exam", a: "The three exams in this guide are two-hour, performance-based exams delivered online by PSI. CKA and CKS run on Kubernetes v1.37 as of this check. CNPE uses a Linux-based remote desktop with terminal and web interfaces. CKAD uses the same two-hour performance-based format. There are no multiple-choice questions." },
  { q: "How long is the certification valid?", cat: "exam", a: "Two years from the date you pass. To recertify, pass the current exam again before expiry. The voucher is separate from certification validity — it only buys exam attempts." },
  { q: "Can I reschedule or cancel the exam?", cat: "booking", a: "The Linux Foundation and PSI set the rules; check the candidate handbook before booking. The voucher expiry does not move when you reschedule, and vouchers are non-refundable. Book a date you can keep." },
  { q: "Are Linux Foundation vouchers refundable or transferable?", cat: "rules", a: "No. Non-refundable, non-transferable, valid only for the specified exam and only in the country of purchase. The name on your Linux Foundation account must match your government ID." },
  { q: "Do I get the Killer.sh exam simulator?", cat: "exam", a: "Linux Foundation registration includes two Killer.sh simulator attempts with 36 hours of access each. Udemy's page advertises the two exam attempts, so confirm simulator access in your portal after redeeming." },
  { q: "Is the Udemy voucher cheaper than a Linux Foundation sale?", cat: "price", a: "Not always. During a 40%-off Linux Foundation sale the $445 exam drops to $267 — $44.50 below the Udemy price. Compare the live price before buying. The $625 and $645 LF bundles include a subscription or course, not just the exam." },
  { q: "Can I take the exam from home?", cat: "booking", a: "Yes. Exams are online and remotely proctored through PSI. You need a quiet room, stable connection, webcam, microphone and government ID. Run the PSI system test before exam day." },
  { q: "Why does this guide cover three vouchers in depth?", cat: "catalog", a: "Udemy lists four. This guide focuses on the three role tracks — administrator (CKA), security (CKS) and platform engineering (CNPE). CKAD is the developer-focused exam and is the better fit if you build applications on Kubernetes." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      image: "https://coursespeak.com/images/og/og-linux-foundation-vouchers.png",
      isPartOf: { "@id": "https://coursespeak.com/#website" },
      publisher: { "@id": "https://coursespeak.com/#organization" },
      inLanguage: "en-US",
      datePublished: "2026-11-20",
      dateModified: lastModified,
      author: { "@id": "https://coursespeak.com/#author" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      keywords: pageKeywords,
      about: [
        { "@type": "Organization", name: "Linux Foundation", sameAs: ["https://training.linuxfoundation.org/certification/"] },
        { "@type": "Organization", name: "Cloud Native Computing Foundation", sameAs: ["https://www.cncf.io/"] },
        { "@type": "Thing", name: "Kubernetes certification exam vouchers", sameAs: ["https://www.udemy.com/all-certification-vouchers/"] },
      ],
      citation: sources.map((s) => s.url),
      speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", ".hb-sub", "#faq"] },
    },
    { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "Linux Foundation", item: canonicalUrl }] },
    { "@type": "ItemList", "@id": `${canonicalUrl}#vouchers`, name: `Linux Foundation Exam Vouchers ${currentYear}`, numberOfItems: linuxVouchers.length + 1, itemListElement: [...linuxVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })), { "@type": "ListItem", position: 4, url: ckadUrl, name: "Linux Foundation Certified Kubernetes Application Developer (CKAD) Exam Voucher" }] },
    { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#how-to-buy`,
      name: `How to buy and redeem a Linux Foundation voucher in ${currentYear}`,
      description: "Choose CKA, CKS or CNPE, buy on Udemy, redeem in the Linux Foundation My Portal, and schedule through PSI.",
      totalTime: "PT10M",
      estimatedCost: { "@type": "MonetaryAmount", value: "311.50", currency: "USD" },
      step: [
        { "@type": "HowToStep", position: 1, name: "Choose the exam", text: "CKA for administrators, CKS after CKA for security, CNPE for platform engineers. CKAD is the developer alternative.", url: `${canonicalUrl}#decision` },
        { "@type": "HowToStep", position: 2, name: "Compare the price", text: "$311.50 vs $445 direct — 30% off, with two exam attempts included.", url: `${canonicalUrl}#prices` },
        { "@type": "HowToStep", position: 3, name: "Buy on Udemy", text: "Coupons do not apply to vouchers. The voucher is non-refundable and country-locked.", url: `${canonicalUrl}#vouchers` },
        { "@type": "HowToStep", position: 4, name: "Redeem in My Portal", text: "Copy the code from My Learning → Certifications and redeem it in the Linux Foundation My Portal within 6 months.", url: `${canonicalUrl}#steps` },
        { "@type": "HowToStep", position: 5, name: "Schedule with PSI", text: "Choose an online proctored date through PSI and take the exam within 12 months of redemption.", url: `${canonicalUrl}#steps` },
      ],
    },
    { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about", knowsAbout: ["Kubernetes certification", "CKA", "CKS", "CNPE", "Linux Foundation exam vouchers"] },
  ],
};

const getDeal = (id: string) => {
  const deal = allDeals.find((d) => String(d.id) === id);
  return deal && Date.parse(String(deal.expiresAt)) > Date.now() ? deal : null;
};
const coursePickIds = [
  { id: "388", topic: "/topics/kubernetes", why: "Kubernetes hands-on mastery" },
  { id: "384", topic: "/topics/docker", why: "Docker + Kubernetes foundations" },
  { id: "7369", topic: "/topics/kubernetes", why: "CKS security specialist prep" },
  { id: "7224", topic: "/topics/devops", why: "AWS EKS DevOps & microservices" },
  { id: "1568", topic: "/topics/devops", why: "Terraform on EKS, SRE demos" },
  { id: "7360", topic: "/topics/azure-kubernetes-service-aks", why: "AKS with Azure DevOps & Terraform" },
];
const coursePicks = coursePickIds.map((pick) => ({ ...pick, deal: getDeal(pick.id) })).filter((pick) => pick.deal !== null);
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} publishedTime="2026-11-20" modifiedTime={lastModified} canonical={canonicalUrl} type="article" image="/images/og/og-linux-foundation-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hb-hero">
  <div class="hb-hero-inner">
    <div>
      <span class="hb-eyebrow"><span class="hb-dot"></span> Linux Foundation voucher command center · checked <time datetime={lastModified}>{updatedLong}</time></span>
      <h1 class="hb-title">Linux Foundation <span>Exam Vouchers {currentYear}</span></h1>
      <p class="hb-sub">
        <strong>CKA, CKS and CNPE</strong> at <strong>$311.50</strong> instead of $445 — a flat <strong>30% saving</strong> with two exam attempts.
        CKA first, CKS after CKA, CNPE for platform engineers. Every rule, price and redemption step checked in one place.
      </p>
      <div class="hb-metrics">
        <div class="hb-metric"><b>{linuxVoucherCount}</b><span>vouchers compared</span></div>
        <div class="hb-metric"><b>$311.50</b><span>each, 30% off</span></div>
        <div class="hb-metric"><b>2</b><span>exam attempts included</span></div>
      </div>
      <div class="hb-actions">
        <a href={cka.url} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Get CKA voucher →</a>
        <a href={allVouchersUrl} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-ghost">Browse all vouchers →</a>
        <a href="#quick-answer" class="hb-btn-quiet">Read the 60-second answer ↓</a>
      </div>
      <p class="hb-meta">
        By <a href="/about#author">Josh Smith</a>, Founder &amp; Editor · Reviewed <time datetime={lastModified}>{updatedLong}</time> ·
        Sources: <a href="https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" target="_blank" rel="noopener noreferrer">CKA</a>,
        <a href="https://training.linuxfoundation.org/certification/certified-kubernetes-security-specialist/" target="_blank" rel="noopener noreferrer">CKS</a>,
        <a href="https://training.linuxfoundation.org/certification/certified-cloud-native-platform-engineer-cnpe/" target="_blank" rel="noopener noreferrer">CNPE</a> and
        <a href={allVouchersUrl} target="_blank" rel="sponsored noopener noreferrer">Udemy catalogue</a>.
        Sponsored — we may earn a commission at no extra cost. <a href="/affiliate-disclosure">Disclosure</a>
      </p>
    </div>
    <aside class="hb-ticker" aria-label="Top Linux Foundation vouchers">
      <div class="hb-ticker-head"><b>Top LF vouchers</b><span><span class="hb-dot"></span> Checked</span></div>
      {linuxVouchers.map((vv) => (
        <a class="hb-ticker-row" href={vv.url} target="_blank" rel="sponsored noopener noreferrer" style={{ textDecoration: "none" }}>
          <span class="hb-ticker-name" style={{ color: "var(--brand)" }}>{vv.code}</span>
          <span class="hb-ticker-note">{vv.category}</span>
          <span class="hb-ticker-price"><b>{voucherPrice(vv)}</b><span>Udemy</span></span>
        </a>
      ))}
      <div class="hb-ticker-foot">CKAD is also available at $311.50 — link in the decision desk below.</div>
    </aside>
  </div>
</section>

<div class="hb-rail">
  <div class="hb-rail-inner">
    <a href="#quick-answer">01 Quick answer</a>
    <a href="#decision">02 Pick your cert</a>
    <a href="#vouchers">03 Vouchers</a>
    <a href="#prices">04 Prices</a>
    <a href="#courses">05 Prep courses</a>
    <a href="#exams">06 Exam details</a>
    <a href="#compare">07 Udemy vs direct</a>
    <a href="#steps">08 Redeem</a>
    <a href="#worth">09 Is it worth it</a>
    <a href="#evidence">10 Evidence</a>
    <a href="#faq">11 FAQ</a>
  </div>
  <div class="hb-progress" id="hb-progress"></div>
</div>

<section class="hb-section" id="quick-answer">
  <div class="hb-answer">
    <span class="hb-answer-label">Answer first · fact-checked {updatedLong}</span>
    <h2>Linux Foundation vouchers: the 60-second answer</h2>
    <p>
      Udemy sells <strong>three featured Linux Foundation vouchers</strong> — CKA, CKS and CNPE — at <strong>$311.50 each</strong>,
      against the <strong>$445</strong> list price. That is a <strong>30% saving</strong> and two exam attempts are included.
      CKA is the entry point with no prerequisites. CKS requires CKA to be passed first. CNPE targets senior platform engineers.
      A fourth voucher, CKAD, is available for Kubernetes application developers at the same price. Vouchers are exam-specific and non-refundable.
    </p>
    <ul>
      <li><strong>Kubernetes admin:</strong> CKA first — most recognized, no prerequisites, required before CKS.</li>
      <li><strong>Security:</strong> pass CKA, then book CKS. Do not sit CKS before your CKA pass is confirmed.</li>
      <li><strong>Platform engineering:</strong> CNPE covers GitOps, platform APIs, observability and policy.</li>
      <li><strong>Developer:</strong> CKAD is the application-developer alternative at $311.50.</li>
      <li><strong>Clocks:</strong> redeem within 6 months of purchase, then take the exam within 12 months of redemption.</li>
    </ul>
    <div class="hb-chips">
      {sources.map((s) => (
        <a class="hb-chip" href={s.url} target="_blank" rel={s.url === allVouchersUrl ? "sponsored noopener noreferrer" : "noopener noreferrer"}>{s.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<section class="hb-section alt" id="decision">
  <div class="hb-section-inner">
    <span class="hb-kicker">Decision desk</span>
    <h2 class="hb-h2">Which Linux Foundation exam fits your role?</h2>
    <p class="hb-lead">Pick your situation. The recommendation updates instantly with the right exam and voucher link.</p>
    <div class="hb-decision" style={{ marginTop: "1.4rem" }}>
      <div class="hb-options" id="hb-decision-form">
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="cka" data-title="Start with CKA" data-text="CKA is the flagship Kubernetes administrator exam: no prerequisites, two hours, performance-based, $311.50 with two attempts. It is the required first step before CKS." data-label="Get the CKA voucher →" data-link={cka.url} />
          <span><b>I administer Kubernetes clusters</b><small>CKA first — no prerequisites, required before CKS.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="cks" data-title="Go CKS after CKA" data-text="CKS is an advanced Kubernetes security exam. You must have passed CKA before attempting it. Buy the voucher only when your CKA result is confirmed, because the 6-month redemption clock starts immediately." data-label="Get the CKS voucher →" data-link={cks.url} />
          <span><b>I work in Kubernetes security</b><small>CKS requires a passed CKA — check the timing first.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="cnpe" data-title="Go CNPE" data-text="CNPE is the senior platform-engineering exam: GitOps, platform APIs, self-service, observability and policy. No formal prerequisite, but it assumes hands-on platform work." data-label="Get the CNPE voucher →" data-link={cnpe.url} />
          <span><b>I build internal developer platforms</b><small>CNPE at $311.50, two attempts included.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="ckad" data-title="Go CKAD" data-text="CKAD is the developer-focused Kubernetes exam: designing and building cloud-native applications rather than administering clusters. Same $311.50 price and two-hour performance-based format." data-label="Get the CKAD voucher →" data-link={ckadUrl} />
          <span><b>I write applications for Kubernetes</b><small>CKAD is the developer alternative to CKA.</small></span>
        </label>
      </div>
      <div class="hb-result" id="hb-result">
        <h3 id="hb-result-title">Your best exam</h3>
        <p id="hb-result-text">Choose a statement on the left. We'll match it to the current exam and voucher link.</p>
        <p style={{ marginTop: "0.8rem" }}><a id="hb-result-link" href="#vouchers">Compare the 3 vouchers →</a></p>
        <p style={{ marginTop: "0.7rem" }}><a href={cka.url} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary" style={{ fontSize: "0.8rem", padding: "0.6rem 1rem" }}>Get the voucher →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="hb-section" id="vouchers">
  <div class="hb-section-head-row">
    <div class="hb-head">
      <span class="hb-kicker">Full set</span>
      <h2 class="hb-h2">The three role-track vouchers on Udemy</h2>
      <p class="hb-lead">Each voucher is exam-specific: a CKA voucher cannot book CKS or CNPE. All three cost $311.50 and include two attempts.</p>
    </div>
    <a href={allVouchersUrl} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse vouchers →</a>
  </div>
  <div class="hb-courses">
    {linuxVouchers.map((vv) => (
      <div class="hb-course">
        <img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" />
        <div class="hb-course-body">
          <div class="hb-course-provider">{vv.code} · {vv.category} · {vv.badge}</div>
          <h4 class="hb-course-title">{vv.title}</h4>
          <div class="hb-course-meta">{vv.blurb}</div>
          {vv.note && <div class="hb-course-meta" style={{ color: "#fbbf24" }}>{vv.note}</div>}
          <div class="hb-course-price">{voucherPrice(vv)}</div>
          <div class="hb-course-actions">
            <a class="hb-course-cta" href={vv.url} target="_blank" rel="sponsored noopener noreferrer">Get voucher →</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="hb-answer" style={{ marginTop: "1.2rem" }}>
    <h2 style={{ fontSize: "1.05rem", marginTop: 0 }}>What about CKAD?</h2>
    <p style={{ marginBottom: 0 }}>Udemy lists a fourth Linux Foundation voucher: CKAD (Certified Kubernetes Application Developer) at the same $311.50 with two attempts. It is the developer-focused exam. Use the <a href={ckadUrl} target="_blank" rel="sponsored noopener noreferrer" style={{ color: "var(--brand)", fontWeight: 700 }}>CKAD voucher link</a> if you build applications on Kubernetes rather than administer clusters. Other LF certifications, including LFCS, are bought directly from the Linux Foundation.</p>
  </div>
</section>

<section class="hb-section alt" id="prices">
  <div class="hb-section-inner">
    <span class="hb-kicker">Price intelligence</span>
    <h2 class="hb-h2">What you save, and when direct wins</h2>
    <p class="hb-lead">The voucher price is a flat 30% below the Linux Foundation list price. The exam and attempts are identical — only the redemption window differs.</p>
    <div class="hb-ladder" style={{ margin: "1.6rem 0 0.8rem" }}>
      {[
        { label: "CKA voucher vs list", retail: 445, udemy: 311.5, save: "$133.50 saved" },
        { label: "CKS voucher vs list", retail: 445, udemy: 311.5, save: "$133.50 saved" },
        { label: "CNPE voucher vs list", retail: 445, udemy: 311.5, save: "$133.50 saved" },
        { label: "40%-off LF sale", retail: 445, udemy: 267, save: "$44.50 below Udemy" },
      ].map((row) => (
        <div class="hb-ladder-row">
          <div class="hb-ladder-label">{row.label}</div>
          <div class="hb-track">
            <div class="hb-track-retail" style={{ width: "100%" }}></div>
            <div class="hb-track-voucher" style={{ width: `${Math.round((row.udemy / row.retail) * 100)}%` }}></div>
          </div>
          <div class="hb-ladder-save">{row.save}</div>
        </div>
      ))}
      <div class="hb-ladder-legend"><span><i style={{ background: "rgba(255,255,255,.16)" }}></i>Linux Foundation list</span><span><i style={{ background: "#d4af37" }}></i>Lower price</span></div>
    </div>
    <div class="hb-table-wrap">
      <table class="hb-table">
        <caption>US prices checked <time datetime={lastModified}>{updatedLong}</time>. Sources: <a href="https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" target="_blank" rel="noopener noreferrer">Linux Foundation</a> and <a href={allVouchersUrl} target="_blank" rel="sponsored noopener noreferrer">Udemy catalogue</a>. Regional pricing varies.</caption>
        <thead><tr><th scope="col">Voucher</th><th scope="col">LF list</th><th scope="col">Udemy</th><th scope="col">You save</th><th scope="col">Attempts</th><th scope="col">Window</th></tr></thead>
        <tbody>
