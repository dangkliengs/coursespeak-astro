---
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-v2.css";
import {
  microsoftVouchers,
  microsoftCatalog,
  microsoftFamilyOrder,
  microsoftFamilyBlurbs,
  ALL_VOUCHERS_URL,
  voucherPrice,
} from "../data/vouchers";
const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-microsoft-exam-vouchers";
const pageTitle = `Udemy Microsoft Exam Vouchers ${currentYear}: 50 Pages, 33 Exams`;
const pageDescription = `All 50 live Udemy Microsoft voucher pages in ${currentYear}, audited: 33 current exams, 1 retiring and 16 retired pages flagged. AZ-900, AZ-104, AZ-305 prices and the 2026 exam reset.`;

const quickPicks = [
  { voucher: microsoftVouchers[0], label: "Azure fundamentals · entry" },
  { voucher: microsoftVouchers[2], label: "Azure administrator · core" },
  { voucher: microsoftVouchers[7], label: "Azure solutions architect" },
];

const msTotal = microsoftCatalog.length;
const msCurrent = microsoftCatalog.filter((x) => x.status === "current").length;
const msRetiring = microsoftCatalog.filter((x) => x.status === "retiring").length;
const msRetired = microsoftCatalog.filter((x) => x.status === "retired").length;

const familyGroups = microsoftFamilyOrder
  .map((family) => ({ family, entries: microsoftCatalog.filter((x) => x.family === family) }))
  .filter((g) => g.entries.length > 0);

function statusStyle(status: string) {
  if (status === "current") return { background: "rgba(34,197,94,0.14)", color: "#15803d" };
  if (status === "retiring") return { background: "rgba(217,119,6,0.14)", color: "#b45309" };
  return { background: "rgba(192,57,43,0.14)", color: "#c0392b" };
}
function statusLabel(status: string) {
  if (status === "current") return "Current";
  if (status === "retiring") return "Retiring";
  return "Retired";
}

const faqs = [
  { q: "How many Microsoft vouchers are on Udemy?", a: "Udemy has 50 live Microsoft voucher pages as of November 3, 2026. Only 33 of those map to current exams. One more, MS-102, is still bookable until November 30, 2026. The remaining 16 are retired or legacy pages that Udemy has not removed, including AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335, MB-700 and 62-193." },
  { q: "Which Microsoft exams can I actually book today?", a: "Thirty-three current exams: Fundamentals (AZ-900, DP-900, SC-900, PL-900, GH-900); Azure (AZ-104, AZ-305, AZ-400, AZ-700, AZ-120, AZ-140); Data and AI (DP-300, DP-420, DP-600, DP-700); Security (SC-200, SC-300, SC-401, SC-100); Microsoft 365 (MD-102, MS-700, MS-721); Power Platform (PL-300); Dynamics 365 (MB-230, MB-310, MB-330, MB-500, MB-800, MB-820); and GitHub (GH-100, GH-200, GH-300, GH-500). MS-102 is the one retiring exam still bookable." },
  { q: "How much do Microsoft vouchers cost on Udemy?", a: "Fundamentals exams list at $99 and cost about $89.10 on Udemy. Associate, Expert and Specialty exams list at $165 and cost about $148.50. These are US list prices observed on November 3, 2026. Local currency and regional pricing vary, so confirm the live price at checkout." },
  { q: "Is Retake Assurance included in the Microsoft voucher price?", a: "No. Retake Assurance is an optional add-on that must be bought with the original voucher. It is available on select exams only, not every Microsoft voucher page — AZ-104, MD-102, SC-200 and DP-300 showed it at review, while AZ-900 and DP-900 did not. It covers one extra attempt on the same voucher code and is not refunded if you pass first time." },
  { q: "Which Microsoft exams retired in 2026?", a: "Fifteen role-based exams retired between June 1 and October 30, 2026: AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335 and MB-700. The legacy Microsoft Certified Educator exam 62-193 is also retired. MS-102 retires on November 30, 2026." },
  { q: "Can I use an old voucher for the replacement exam?", a: "No. Microsoft vouchers are exam-specific. An AI-900 voucher cannot book AI-901, an AZ-500 voucher cannot book SC-500, and an AZ-800 or AZ-801 voucher cannot book AZ-802. If you already hold a voucher for a retiring exam, sit that exam before the last date. If you have not bought yet, do not buy the old page." },
  { q: "What replaces AZ-500?", a: "SC-500 replaces AZ-500, which retired on August 31, 2026. SC-500 is aimed at security engineering rather than Azure administration. Udemy did not have an SC-500 voucher page at review, so you may need to book direct with Microsoft or wait for Udemy to list it." },
  { q: "What replaces AI-102?", a: "AI-103, the Azure AI Apps and Agents Developer Associate, replaces AI-102. AI-102 retired on June 30, 2026, and AI-103 launched on June 19, 2026. Udemy still sells the AI-102 page but did not have an AI-103 voucher page at review. Do not buy the AI-102 voucher for AI-103." },
  { q: "What replaces AZ-800 and AZ-801?", a: "AZ-802 replaces both exams. AZ-800 and AZ-801 retired on September 30, 2026, and AZ-802 consolidates them into one exam for the renamed Windows Server Administrator Associate certification. Udemy did not have an AZ-802 voucher page at review." },
  { q: "What happens to MS-102 after November 30, 2026?", a: "MS-102 retires on November 30, 2026. If you sit and pass before that date, the certification stays on your transcript. AB-650 is the replacement path, but it is an Associate-level exam, not a like-for-like Expert swap. Buy the MS-102 voucher only if you can book and sit the exam before the retirement date." },
  { q: "Why are retired Microsoft voucher pages still live on Udemy?", a: "Udemy keeps the pages live, but that does not mean the exam is bookable. Microsoft controls the exam catalogue and Pearson VUE refuses bookings for retired exams. The page is a legacy listing, not a current recommendation. Always check the exam code against Microsoft Learn before paying." },
  { q: "Which Microsoft voucher should I buy first?", a: "Choose the fundamentals exam that matches your target role: AZ-900 for Azure and cloud, DP-900 for data, SC-900 for security, PL-900 for Power Platform, or GH-900 for GitHub. Then move to a role-based exam: AZ-104 for Azure administration, SC-200 for security operations, DP-700 for data engineering, PL-300 for Power BI, or MD-102 for endpoint management." },
  { q: "AZ-900 vs DP-900 vs AI-900 — which fundamental first?", a: "AZ-900 for general cloud and administrator roles, DP-900 for data and analytics roles. AI-900 is no longer an option: it retired on June 30, 2026 and was replaced by AI-901. AI-900 prep courses still teach useful fundamentals, but do not buy the AI-900 voucher. All fundamentals exams need about 2–4 weeks of study and have no prerequisites." },
  { q: "Is AI-900 still valid?", a: "No. AI-900 retired on June 30, 2026. AI-901 is the current replacement, and Udemy did not have an AI-901 voucher page at review. A passed AI-900 certification stays on your transcript, but you cannot book the exam any more." },
  { q: "How do I schedule a Microsoft exam with a voucher?", a: "Sign in to Microsoft Learn, open Profile → Credentials → Certifications, and choose the exam to schedule with Pearson VUE. Pick an online OnVUE slot or a test centre, then paste the voucher code from My learning → Certifications at the payment step. The voucher is valid only in the country of purchase, and the name on your Microsoft profile must match your photo ID." },
  { q: "Can I reschedule or cancel a Microsoft exam?", a: "Microsoft's standard policy requires you to reschedule or cancel at least 24 hours before the appointment, or the fee or voucher may be forfeited. Some Microsoft bundle and event voucher terms use a stricter 72-hour rule. Read the terms attached to your voucher, and never no-show — a no-show can forfeit the voucher entirely." },
  { q: "Can I get a refund on an Udemy Microsoft voucher?", a: "No. Udemy Microsoft vouchers and Retake Assurance are non-refundable and non-transferable. Cancelling an exam appointment affects the appointment under Microsoft and Pearson VUE policy, not the voucher purchase. Confirm the exam code is current before paying." },
  { q: "Do Microsoft vouchers and certifications expire?", a: "Udemy Microsoft vouchers are valid for at least nine months, and the expiry date cannot be extended. Microsoft Fundamentals certifications do not expire. Associate and Expert certifications are valid for one year and can be renewed through a free online assessment before they lapse. The exam retirement date can shorten a voucher's useful life." },
  { q: "Can I use an Udemy coupon on a Microsoft voucher?", a: "No. Udemy coupons and promo codes never apply to exam vouchers, though Udemy credits can sometimes be applied at checkout. Coupons do apply to the prep courses, which is where the real saving stacks: a discounted course plus a discounted voucher beats full-price training plus a retail exam fee." },
  { q: "Are Udemy Microsoft vouchers legitimate?", a: "Yes. Udemy is the seller; Microsoft owns the certification and Pearson VUE delivers the exam. The code appears in My learning → Certifications and is redeemed in the Microsoft/Pearson VUE checkout. Buy from the official Udemy listing, avoid codes sold by direct message or bank transfer, and verify the exam code is current before paying." },
];

const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl, name: pageTitle, description: pageDescription, image: "https://coursespeak.com/images/og/og-microsoft-vouchers.png", isPartOf: { "@id": "https://coursespeak.com/#website" }, inLanguage: "en-US", datePublished: "2025-01-01", dateModified: lastModified, author: { "@id": "https://coursespeak.com/#author" }, breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` } },
  { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "Microsoft", item: canonicalUrl }] },
  { "@type": "ItemList", name: `Microsoft Exam Vouchers ${currentYear}`, numberOfItems: microsoftCatalog.length, itemListElement: microsoftCatalog.map((e, i) => ({ "@type": "ListItem", position: i + 1, url: e.url, name: `${e.name} (${e.code})` })) },
  { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about" },
]};
---
<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} type="article" image="/images/og/og-microsoft-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .voucher-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
  .voucher-card:hover{transform:translateY(-3px);border-color:var(--brand)}
  .voucher-card img{width:100%;height:140px;object-fit:cover;background:#fff}
  .compare-table{width:100%;border-collapse:collapse;font-size:.86rem;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .compare-table th,.compare-table td{padding:.7rem .9rem;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
  .compare-table thead th{background:var(--bg-secondary);font-weight:700}
  .compare-table tbody tr:last-child td{border-bottom:0}
  .table-wrap{overflow-x:auto;border-radius:12px}
  .catalog-table{font-size:.82rem}
  .catalog-table td:nth-child(5){min-width:210px}
  .status-pill{display:inline-block;padding:.2rem .5rem;border-radius:999px;font-size:.7rem;font-weight:800;letter-spacing:.03em;text-transform:uppercase}
  .legend{display:flex;gap:.5rem;flex-wrap:wrap;margin:.75rem 0 1.5rem}
  .toc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem 1rem;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem}
  .toc a{color:var(--muted);text-decoration:none;font-size:.86rem;line-height:1.5}
  .toc a:hover{color:var(--brand)}
  .callout{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--brand);border-radius:0 12px 12px 0;padding:1rem 1.15rem}
  .choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .choice-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.2rem 1.3rem}
  .choice-card h3{margin:0 0 .35rem;font-size:1.02rem}
  .choice-card p{margin:.4rem 0;color:var(--muted);font-size:.86rem;line-height:1.6}
  .choice-card .price{color:var(--brand);font-weight:800;font-size:1.15rem}
  .related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
  .related-grid a{display:block;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:.85rem 1rem;text-decoration:none}
  .related-grid strong{display:block;color:var(--text);font-size:.9rem}
  .related-grid span{display:block;color:var(--muted);font-size:.8rem;margin-top:.2rem}
  @media(max-width:768px){.grid-3,.choice-grid,.related-grid,.toc{grid-template-columns:1fr!important}.compare-table{min-width:760px}}
</style>

<section class="vp-hero">
  <div class="container vp-hero-grid">
    <div>
      <div class="vp-eyebrow">Microsoft Vouchers · Audited {updatedLong}</div>
      <h1>
        <span class="vp-gradient">Udemy Microsoft Exam Vouchers {currentYear}</span>
        <span class="vp-title-sub">50 live pages, 33 current exams</span>
      </h1>
      <p class="vp-lede">
        Udemy has <strong>50 live Microsoft voucher pages</strong>, but only <strong>33 match current exams</strong>.
        MS-102 is bookable until November 30, 2026; 16 pages are retired or legacy. Vouchers cost
        <strong>$89.10 for Fundamentals</strong> and <strong>$148.50 for Associate, Expert and Specialty</strong> — about 10% below Microsoft list.
      </p>
      <div class="vp-chips">
        <span class="vp-chip"><strong>33</strong> current exams</span>
        <span class="vp-chip">From <strong>$89.10</strong></span>
        <span class="vp-chip">16 retired pages flagged</span>
        <span class="vp-chip">Exam-specific vouchers</span>
      </div>
      <div class="vp-hero-actions">
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary btn-lg" style={{ borderRadius: "999px" }}>Browse All 50 Pages →</a>
        <a href="#featured" class="btn btn-ghost btn-lg" style={{ borderRadius: "999px" }}>See Top 8 Vouchers</a>
      </div>
      <p class="vp-meta">
        By <a href="/about#author">Josh Smith</a>, Founder & Editor · Reviewed {updatedLong} ·
        Sources: <a href="https://learn.microsoft.com/en-us/credentials/support/retired-certification-exams" target="_blank" rel="noopener noreferrer">Microsoft retired exams</a> and <a href="https://www.udemy.com/all-certification-vouchers/" target="_blank" rel="noopener noreferrer">Udemy voucher catalogue</a>
      </p>
      <p class="vp-disclosure">Sponsored — CourseSpeak may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a></p>
    </div>
    <aside class="vp-hero-card" aria-label="Top Microsoft vouchers">
      <div class="vp-hero-card-head">
        <div>
          <span class="vp-kicker">Top picks</span>
          <strong>Most-booked Microsoft exams</strong>
        </div>
        <span class="vp-live">Prices live</span>
      </div>
      {quickPicks.map((p) => (
        <a class="vp-quick-row" href={p.voucher.url} target="_blank" rel="sponsored noopener noreferrer">
          <span class="vp-quick-info"><strong>{p.voucher.code}</strong><span>{p.label}</span></span>
          <span class="vp-quick-price"><strong>{voucherPrice(p.voucher)}</strong><span>Udemy</span></span>
        </a>
      ))}
      <div class="vp-hero-card-foot">
        <span>Microsoft list vs Udemy checked {updatedLong}</span>
        <a href="#featured">Top 8 →</a>
      </div>
    </aside>
  </div>
</section>

<section id="featured" class="vp-listing">
  <div class="container" style={{ maxWidth: "1180px" }}>
    <div class="vp-section-head">
      <div>
        <span class="section-title">Best eight</span>
        <h2>8 Microsoft vouchers worth buying first</h2>
        <p>The highest-demand current exams across Azure, data, security, endpoint and DevOps — Fundamentals at $89.10, role-based exams at $148.50. All eight are bookable today; the full 50-page catalogue follows below.</p>
      </div>
      <a class="vp-head-link" href="#catalog">All 50 pages ↓</a>
    </div>
    <div class="vp-voucher-grid">
      {microsoftVouchers.map((vv) => (
        <a class="vp-voucher-card" href={vv.url} target="_blank" rel="sponsored noopener noreferrer">
          <div class="vp-voucher-media"><img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" /></div>
          <div class="vp-voucher-body">
            <span class="vp-voucher-code">{vv.code}{vv.badge ? ` · ${vv.badge}` : ""}</span>
            <div class="vp-voucher-title">{vv.title}</div>
            <p class="vp-voucher-blurb">{vv.blurb}</p>
            {vv.note && <p class="vp-voucher-note">{vv.note}</p>}
            <div class="vp-voucher-footer">
              <span class="vp-voucher-price">{voucherPrice(vv)}<span>Udemy</span></span>
              <span class="vp-voucher-cta">Get voucher →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="callout" style={{ marginTop: "1.2rem" }}>
      <h3 style={{ margin: "0 0 0.4rem", fontSize: "1rem" }}>Why these eight?</h3>
      <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}>They cover the main Microsoft career paths and are the exams employers ask about most: AZ-900 and DP-900 for fundamentals, AZ-104 for Azure administration, MD-102 for endpoints, SC-200 for security operations, DP-300 for Azure SQL, AZ-400 for DevOps and AZ-305 for architecture. The other 42 live pages are in the catalogue below — including 16 you should avoid.</p>
    </div>
  </div>
</section>

<section style={{ padding: "0 1rem 2rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <div class="callout" style={{ marginBottom: "1rem" }}>
      <h2 style={{ margin: "0 0 0.5rem", fontSize: "1.1rem" }}>Quick answer: which Microsoft voucher do you need?</h2>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>First Microsoft cert:</strong> AZ-900 for Azure or DP-900 for data — about $89.10 each, no prerequisites, 2–4 weeks of study.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Best Azure job value:</strong> AZ-104 at about $148.50. It is the core administrator cert and the prerequisite most Azure job posts expect.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Security and data:</strong> SC-200 for SOC analysts, SC-300 for identity, DP-700 for data engineering, DP-600 for Fabric analytics, PL-300 for Power BI.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Do not buy:</strong> AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335, MB-700 or 62-193. Those exams are retired.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Need a retake:</strong> add Retake Assurance at purchase on select exams. It covers one extra attempt on the same voucher code and cannot be added later.</p>
    </div>
    <nav class="vp-anchor-bar" aria-label="On this page">
      <a href="#featured">1. Top 8 vouchers</a>
      <a href="#prices">2. Voucher prices</a>
      <a href="#retirements">3. 2026 exam reset</a>
      <a href="#catalog">4. All 50 pages</a>
      <a href="#which">5. Which voucher</a>
      <a href="#redeem">6. Buy & redeem</a>
      <a href="#retake">7. Retake Assurance</a>
      <a href="#compare">8. Udemy vs direct</a>
      <a href="#legit">9. Legitimacy</a>
      <a href="#worth">10. Is it worth it?</a>
      <a href="#study">11. How to prepare</a>
      <a href="#faq">12. FAQ</a>
    </nav>
  </div>
</section>

<section id="prices" style={{ padding: "1rem 1rem 2.5rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <span class="section-title">Prices</span>
    <h2 class="section-heading">How much do Udemy Microsoft vouchers cost?</h2>
    <p style={{ color: "var(--muted)", fontSize: "0.95rem", lineHeight: 1.75, maxWidth: "840px", margin: "0.75rem 0 1.25rem" }}>
      Microsoft prices exams by level, not by individual certification. Udemy resells one prepaid attempt at about 10% below the US list price.
      The important distinction is between <strong style={{ color: "var(--text)" }}>voucher-only</strong> (one attempt) and the
      <strong style={{ color: "var(--text)" }}>+ Retake Assurance bundle</strong> (two attempts on select exams). They are separate products, and the bundle is not a discount on a single exam.
    </p>
    <div class="table-wrap"><table class="compare-table">
      <thead><tr><th>Level</th><th>Microsoft list (1 attempt)</th><th>Udemy voucher-only</th><th>Retake Assurance</th><th>Typical exams</th></tr></thead>
      <tbody>
        <tr><td><strong>Fundamentals</strong></td><td>$99</td><td><strong>$89.10</strong></td><td>Not offered on every page — check before buying</td><td>AZ-900, DP-900, SC-900, PL-900, GH-900</td></tr>
        <tr><td><strong>Associate</strong></td><td>$165</td><td><strong>$148.50</strong></td><td>Available on select exams: AZ-104, MD-102, SC-200 and DP-300 showed it at review</td><td>AZ-104, SC-200, DP-300, MD-102, MS-700, PL-300, MB-310, GH-300</td></tr>
        <tr><td><strong>Expert</strong></td><td>$165</td><td><strong>$148.50</strong></td><td>Available on select exams — AZ-305 showed it, AZ-400 did not at review</td><td>AZ-305, AZ-400, SC-100</td></tr>
        <tr><td><strong>Specialty</strong></td><td>$165</td><td><strong>$148.50</strong></td><td>Check the individual voucher page</td><td>AZ-120, AZ-140, DP-420</td></tr>
      </tbody>
    </table></div>
    <p style={{ color: "var(--muted)", fontSize: "0.8rem", margin: "0.7rem 0 1.25rem", lineHeight: 1.6 }}>
      Snapshot: November 3, 2026, USD, before tax. Microsoft list prices vary by country; Udemy rotates regional pricing and campaigns.
      Retake Assurance is not a standard inclusion, and its availability can change — confirm the option on the live voucher page before paying.
    </p>

    <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(260px,1fr))", gap: "1rem" }}>
      <div class="callout">
        <h3 style={{ margin: "0 0 0.4rem", fontSize: "0.95rem" }}>Voucher-only is the honest comparison</h3>
        <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.86rem", lineHeight: 1.7 }}>One attempt for $89.10 or $148.50. If you are scoring above 85% on two timed practice exams, this is the cheapest path. The 10% saving is modest, so compare the live price with Microsoft's fee in your country.</p>
      </div>
      <div class="callout" style={{ borderLeftColor: "#d97706" }}>
        <h3 style={{ margin: "0 0 0.4rem", fontSize: "0.95rem" }}>The bundle is insurance, not a discount</h3>
        <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.86rem", lineHeight: 1.7 }}>It only wins if you actually need the retake. On a $165 Associate exam, one extra attempt at the bundle price is cheaper than paying the full fee twice. If you pass first time, the premium is not refunded.</p>
      </div>
    </div>
    <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.75, margin: "1.25rem 0 0" }}>
      Udemy coupons never apply to vouchers. Udemy credits can sometimes be applied at checkout, but the sticker price is the price.
      Do not buy a discounted voucher for a retired exam — it cannot be redeemed, and vouchers are non-refundable.
    </p>
  </div>
