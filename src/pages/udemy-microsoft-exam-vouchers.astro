---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-hub.css";
import allDeals from "../data/deals.json";
import {
  microsoftVouchers,
  microsoftCatalog,
  microsoftFamilyOrder,
  microsoftFamilyBlurbs,
  ALL_VOUCHERS_URL,
  voucherPrice,
} from "../data/vouchers";

const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-microsoft-exam-vouchers";
const pageTitle = `Microsoft Exam Vouchers ${currentYear}: 50 Pages, 33 Current Exams`;
const pageDescription = `All 50 live Udemy Microsoft voucher pages in ${currentYear}, audited: 33 current exams, 1 retiring and 16 retired pages flagged. AZ-900, AZ-104, AZ-305 prices and the 2026 exam reset.`;
const pageKeywords = "Microsoft exam vouchers, Udemy Microsoft vouchers, AZ-900, AZ-104, AZ-305, SC-200, DP-700, MS-102 retirement, Retake Assurance";

const sources = [
  { label: "Microsoft retired certification exams", url: "https://learn.microsoft.com/en-us/credentials/support/retired-certification-exams" },
  { label: "Microsoft certification catalogue", url: "https://learn.microsoft.com/en-us/credentials/certifications/" },
  { label: "Udemy voucher catalogue", url: ALL_VOUCHERS_URL },
];

const msTotal = microsoftCatalog.length;
const msCurrent = microsoftCatalog.filter((x) => x.status === "current").length;
const msRetiring = microsoftCatalog.filter((x) => x.status === "retiring").length;
const msRetired = microsoftCatalog.filter((x) => x.status === "retired").length;
const familyGroups = microsoftFamilyOrder
  .map((family) => ({ family, entries: microsoftCatalog.filter((x) => x.family === family) }))
  .filter((g) => g.entries.length > 0);
const statusClass = (status: string) => status === "current" ? "hb-status-current" : status === "retiring" ? "hb-status-retiring" : "hb-status-retired";
const statusLabel = (status: string) => status === "current" ? "Current" : status === "retiring" ? "Retiring" : "Retired";

const faqs = [
  { q: "How many Microsoft vouchers are on Udemy?", cat: "catalog", a: "Udemy has 50 live Microsoft voucher pages as of November 3, 2026. Only 33 map to current exams. MS-102 is bookable until November 30, 2026. The remaining 16 are retired or legacy pages Udemy has not removed, including AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335, MB-700 and 62-193." },
  { q: "Which Microsoft exams can I actually book today?", cat: "catalog", a: "Thirty-three current exams: Fundamentals (AZ-900, DP-900, SC-900, PL-900, GH-900); Azure (AZ-104, AZ-305, AZ-400, AZ-700, AZ-120, AZ-140); Data and AI (DP-300, DP-420, DP-600, DP-700); Security (SC-200, SC-300, SC-401, SC-100); Microsoft 365 (MD-102, MS-700, MS-721); Power Platform (PL-300); Dynamics 365 (MB-230, MB-310, MB-330, MB-500, MB-800, MB-820); and GitHub (GH-100, GH-200, GH-300, GH-500). MS-102 is the one retiring exam still bookable." },
  { q: "How much do Microsoft vouchers cost on Udemy?", cat: "price", a: "Fundamentals exams list at $99 and cost about $89.10 on Udemy. Associate, Expert and Specialty exams list at $165 and cost about $148.50. US list prices observed November 3, 2026. Local currency and regional pricing vary, so confirm the live price at checkout." },
  { q: "Is Retake Assurance included in the Microsoft voucher price?", cat: "retake", a: "No. Retake Assurance is an optional add-on that must be bought with the original voucher. It is available on select exams only — AZ-104, MD-102, SC-200 and DP-300 showed it at review, while AZ-900 and DP-900 did not. It covers one extra attempt on the same voucher code and is not refunded if you pass first time." },
  { q: "Which Microsoft exams retired in 2026?", cat: "changes", a: "Fifteen role-based exams retired between June 1 and October 30, 2026: AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335 and MB-700. Legacy educator exam 62-193 is also retired. MS-102 retires November 30, 2026." },
  { q: "Can I use an old voucher for the replacement exam?", cat: "changes", a: "No. Microsoft vouchers are exam-specific. An AI-900 voucher cannot book AI-901, AZ-500 cannot book SC-500, and AZ-800/AZ-801 cannot book AZ-802. If you already hold a voucher for a retiring exam, sit it before the last date. Otherwise do not buy the old page." },
  { q: "What replaces AZ-500?", cat: "changes", a: "SC-500 replaces AZ-500, retired August 31, 2026. SC-500 is aimed at security engineering rather than Azure administration. Udemy had no SC-500 voucher page at review, so book direct with Microsoft or wait for the listing." },
  { q: "What replaces AI-102?", cat: "changes", a: "AI-103 replaces AI-102. AI-102 retired June 30, 2026, and AI-103 launched June 19, 2026. Udemy still sells the AI-102 page but had no AI-103 voucher page at review. Do not buy AI-102 for AI-103." },
  { q: "What replaces AZ-800 and AZ-801?", cat: "changes", a: "AZ-802 replaces both. AZ-800 and AZ-801 retired September 30, 2026, and AZ-802 consolidates them for the renamed Windows Server Administrator Associate. Udemy had no AZ-802 voucher page at review." },
  { q: "What happens to MS-102 after November 30, 2026?", cat: "changes", a: "MS-102 retires November 30, 2026. Pass before then and the certification stays on your transcript. AB-650 is the replacement path but is Associate-level, not a like-for-like Expert swap. Buy MS-102 only if you can sit before the date." },
  { q: "Why are retired Microsoft voucher pages still live on Udemy?", cat: "catalog", a: "Udemy keeps the pages live, but that does not mean the exam is bookable. Microsoft controls the catalogue and Pearson VUE refuses bookings for retired exams. The page is a legacy listing, not a recommendation. Check the code on Microsoft Learn before paying." },
  { q: "Which Microsoft voucher should I buy first?", cat: "choice", a: "Choose a fundamentals exam matching your target role: AZ-900 for Azure, DP-900 for data, SC-900 for security, PL-900 for Power Platform, or GH-900 for GitHub. Then move to a role-based exam: AZ-104, SC-200, DP-700, PL-300 or MD-102." },
  { q: "AZ-900 vs DP-900 vs AI-900 — which fundamental first?", cat: "choice", a: "AZ-900 for general cloud and admin roles, DP-900 for data and analytics. AI-900 is no longer an option — it retired June 30, 2026 and was replaced by AI-901. All fundamentals exams need about 2–4 weeks and have no prerequisites." },
  { q: "Is AI-900 still valid?", cat: "changes", a: "No. AI-900 retired June 30, 2026. AI-901 is the current replacement, and Udemy had no AI-901 voucher page at review. A passed AI-900 certification stays on your transcript, but you cannot book the exam anymore." },
  { q: "How do I schedule a Microsoft exam with a voucher?", cat: "booking", a: "Sign in to Microsoft Learn, open Profile → Credentials → Certifications, and choose the exam to schedule with Pearson VUE. Pick an online OnVUE slot or a test centre, then paste the voucher code from My learning → Certifications at payment. Vouchers are valid only in the country of purchase." },
  { q: "Can I reschedule or cancel a Microsoft exam?", cat: "booking", a: "Microsoft's standard policy requires rescheduling or cancelling at least 24 hours before the appointment, or the fee or voucher may be forfeited. Some bundle and event vouchers use a stricter 72-hour rule. A no-show can forfeit the voucher entirely." },
  { q: "Can I get a refund on an Udemy Microsoft voucher?", cat: "booking", a: "No. Udemy Microsoft vouchers and Retake Assurance are non-refundable and non-transferable. Cancelling an appointment affects the appointment under Microsoft and Pearson VUE policy, not the voucher purchase. Confirm the exam code is current before paying." },
  { q: "Do Microsoft vouchers and certifications expire?", cat: "rules", a: "Udemy Microsoft vouchers are valid at least nine months and cannot be extended. Fundamentals certifications do not expire. Associate and Expert certifications are valid one year and can be renewed through a free online assessment. Exam retirement can shorten a voucher's useful life." },
  { q: "Can I use an Udemy coupon on a Microsoft voucher?", cat: "price", a: "No. Udemy coupons and promo codes never apply to vouchers, though credits can sometimes be applied at checkout. Coupons do apply to prep courses — a discounted course plus a discounted voucher beats full-price training plus a retail exam fee." },
  { q: "Are Udemy Microsoft vouchers legitimate?", cat: "trust", a: "Yes. Udemy is the seller; Microsoft owns the certification and Pearson VUE delivers the exam. The code appears in My learning → Certifications and is redeemed in the Microsoft/Pearson VUE checkout. Avoid codes sold by direct message or bank transfer, and verify the exam code is current." },
  { q: "Does AZ-400 require an Associate certification?", cat: "rules", a: "AZ-400 is an Expert exam and assumes Associate-level Azure knowledge. AZ-104 is the natural prerequisite in practice. A voucher buys the exam attempt only — it does not verify prerequisites or include training." },
  { q: "Can I use a voucher for a replacement exam that has no Udemy page?", cat: "changes", a: "No. If AI-901, AI-103, SC-500, AZ-802, AB-410 or AB-650 is the exam you need and Udemy has no voucher page, book direct with Microsoft. An old-code voucher cannot be redirected to the replacement." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      image: "https://coursespeak.com/images/og/og-microsoft-vouchers.png",
      isPartOf: { "@id": "https://coursespeak.com/#website" },
      publisher: { "@id": "https://coursespeak.com/#organization" },
      inLanguage: "en-US",
      datePublished: "2025-01-01",
      dateModified: lastModified,
      author: { "@id": "https://coursespeak.com/#author" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      keywords: pageKeywords,
      about: [
        { "@type": "Organization", name: "Microsoft", sameAs: ["https://learn.microsoft.com/en-us/credentials/"] },
        { "@type": "Organization", name: "Pearson VUE", sameAs: ["https://www.pearsonvue.com/"] },
        { "@type": "Thing", name: "Microsoft certification exam vouchers", sameAs: ["https://www.udemy.com/all-certification-vouchers/"] },
      ],
      citation: sources.map((s) => s.url),
      speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", ".hb-sub", "#faq"] },
    },
    { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "Microsoft", item: canonicalUrl }] },
    { "@type": "ItemList", "@id": `${canonicalUrl}#vouchers`, name: `Microsoft Exam Vouchers ${currentYear}`, numberOfItems: microsoftCatalog.length, itemListElement: microsoftCatalog.map((e, i) => ({ "@type": "ListItem", position: i + 1, url: e.url, name: `${e.name} (${e.code})` })) },
    { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#how-to-buy`,
      name: `How to buy and redeem a Microsoft voucher in ${currentYear}`,
      description: "Confirm the exam code is current, buy the voucher with optional Retake Assurance, copy the code from My learning, and schedule through Pearson VUE.",
      totalTime: "PT10M",
      estimatedCost: { "@type": "MonetaryAmount", value: "89.10", currency: "USD" },
      step: [
        { "@type": "HowToStep", position: 1, name: "Confirm the exam code", text: "Check the 50-page catalogue: 33 current, 1 retiring (MS-102), 16 retired. Do not buy a retired page.", url: `${canonicalUrl}#catalog` },
        { "@type": "HowToStep", position: 2, name: "Compare the live price", text: "$89.10 for Fundamentals, $148.50 for Associate/Expert/Specialty, roughly 10% below Microsoft list.", url: `${canonicalUrl}#prices` },
        { "@type": "HowToStep", position: 3, name: "Add Retake Assurance if offered", text: "Available on select exams only and must be bought with the original voucher.", url: `${canonicalUrl}#retake` },
        { "@type": "HowToStep", position: 4, name: "Copy the code", text: "Find the code in My learning → Certifications. Keep the expiry date.", url: `${canonicalUrl}#steps` },
        { "@type": "HowToStep", position: 5, name: "Schedule through Pearson VUE", text: "Use Microsoft Learn → Credentials, choose OnVUE or a test centre, and paste the code at payment.", url: `${canonicalUrl}#steps` },
      ],
    },
    { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about", knowsAbout: ["Microsoft certification", "Azure certification", "Microsoft Security", "Microsoft Fabric", "Udemy exam vouchers"] },
  ],
};

const getDeal = (id: string) => {
  const deal = allDeals.find((d) => String(d.id) === id);
  return deal && Date.parse(String(deal.expiresAt)) > Date.now() ? deal : null;
};
const coursePickIds = [
  { id: "5316", topic: "/topics/microsoft-azure-fundamentals", why: "AZ-900 fundamentals prep" },
  { id: "5319", topic: "/topics/it-certifications", why: "AZ-104 administrator prep" },
  { id: "7085", topic: "/topics/microsoft-sentinel", why: "SC-200 security operations prep" },
  { id: "5788", topic: "/topics/microsoft-fabric", why: "DP-700 data engineering prep" },
  { id: "5494", topic: "/topics/microsoft-intune", why: "MD-102 endpoint prep" },
  { id: "5767", topic: "/topics/microsoft-power-platform", why: "PL-300 Power BI prep" },
];
const coursePicks = coursePickIds.map((pick) => ({ ...pick, deal: getDeal(pick.id) })).filter((pick) => pick.deal !== null);
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} publishedTime="2025-01-01" modifiedTime={lastModified} canonical={canonicalUrl} type="article" image="/images/og/og-microsoft-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hb-hero">
  <div class="hb-hero-inner">
    <div>
      <span class="hb-eyebrow"><span class="hb-dot"></span> Microsoft voucher command center · audited <time datetime={lastModified}>{updatedLong}</time></span>
      <h1 class="hb-title">Microsoft Exam <span>Vouchers {currentYear}</span></h1>
      <p class="hb-sub">
        All <strong>50 live Microsoft voucher pages</strong>, audited: <strong>{msCurrent} current exams</strong>, <strong>{msRetiring} retiring</strong> and
        <strong>{msRetired} retired pages flagged</strong>. Plus prices, the 2026 exam reset, retake rules and matching prep courses.
      </p>
      <div class="hb-metrics">
        <div class="hb-metric"><b>{msTotal}</b><span>live voucher pages</span></div>
        <div class="hb-metric"><b>{msCurrent}</b><span>current exams</span></div>
        <div class="hb-metric"><b>{msRetired}</b><span>retired pages flagged</span></div>
      </div>
      <div class="hb-actions">
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse all 50 pages →</a>
        <a href={microsoftVouchers[0].url} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-ghost">Get AZ-900 voucher →</a>
        <a href="#quick-answer" class="hb-btn-quiet">Read the 60-second answer ↓</a>
      </div>
      <p class="hb-meta">
        By <a href="/about#author">Josh Smith</a>, Founder &amp; Editor · Reviewed <time datetime={lastModified}>{updatedLong}</time> ·
        Sources: <a href="https://learn.microsoft.com/en-us/credentials/support/retired-certification-exams" target="_blank" rel="noopener noreferrer">Microsoft retirements</a>,
        <a href="https://learn.microsoft.com/en-us/credentials/certifications/" target="_blank" rel="noopener noreferrer">certification catalogue</a> and
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer">Udemy voucher catalogue</a>.
        Sponsored — we may earn a commission at no extra cost. <a href="/affiliate-disclosure">Disclosure</a>
      </p>
    </div>
    <aside class="hb-ticker" aria-label="Top Microsoft vouchers">
      <div class="hb-ticker-head"><b>Most-booked vouchers</b><span><span class="hb-dot"></span> Checked</span></div>
      {microsoftVouchers.slice(0, 4).map((vv) => (
        <a class="hb-ticker-row" href={vv.url} target="_blank" rel="sponsored noopener noreferrer" style={{ textDecoration: "none" }}>
          <span class="hb-ticker-name" style={{ color: "var(--brand)" }}>{vv.code}</span>
          <span class="hb-ticker-note">{vv.category} · current exam</span>
          <span class="hb-ticker-price"><b>{voucherPrice(vv)}</b><span>Udemy</span></span>
        </a>
      ))}
      <div class="hb-ticker-foot">50 pages audited {updatedLong}. 16 retired pages flagged — do not buy those.</div>
    </aside>
  </div>
</section>

<div class="hb-rail">
  <div class="hb-rail-inner">
    <a href="#quick-answer">01 Quick answer</a>
    <a href="#decision">02 Pick your path</a>
    <a href="#featured">03 Top 8 vouchers</a>
    <a href="#prices">04 Prices</a>
    <a href="#courses">05 Prep courses</a>
    <a href="#retirements">06 2026 reset</a>
    <a href="#catalog">07 All 50 pages</a>
    <a href="#which">08 Which cert</a>
    <a href="#retake">09 Retake</a>
    <a href="#steps">10 How to buy</a>
    <a href="#evidence">11 Evidence</a>
    <a href="#faq">12 FAQ</a>
  </div>
  <div class="hb-progress" id="hb-progress"></div>
</div>

<section class="hb-section" id="quick-answer">
  <div class="hb-answer">
    <span class="hb-answer-label">Answer first · fact-checked {updatedLong}</span>
    <h2>Microsoft vouchers: the 60-second answer</h2>
    <p>
      Udemy has <strong>{msTotal} live Microsoft voucher pages</strong>, but only <strong>{msCurrent} map to current exams</strong>.
      MS-102 is bookable until November 30, 2026; <strong>{msRetired} pages are retired or legacy</strong>. Vouchers cost about
      <strong>$89.10 for Fundamentals</strong> and <strong>$148.50 for Associate, Expert and Specialty</strong> — roughly 10% below Microsoft list.
      Vouchers are exam-specific, non-refundable, country-locked and valid at least nine months. Udemy coupons never apply to vouchers — only to prep courses.
    </p>
    <ul>
      <li><strong>First cert:</strong> AZ-900 for cloud or DP-900 for data. No prerequisites, 2–4 weeks of study.</li>
      <li><strong>Best Azure job value:</strong> AZ-104 at about $148.50, the administrator cert most Azure posts expect.</li>
      <li><strong>Do not buy:</strong> AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200/400/500/600, MB-240/280/335/700 and 62-193 — those exams are retired.</li>
      <li><strong>Replacement exams:</strong> AI-901, AI-103, SC-500, AZ-802 and AB-650 have no Udemy voucher page yet — book direct with Microsoft.</li>
    </ul>
    <div class="hb-chips">
      {sources.map((s) => (
        <a class="hb-chip" href={s.url} target="_blank" rel={s.url === ALL_VOUCHERS_URL ? "sponsored noopener noreferrer" : "noopener noreferrer"}>{s.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<section class="hb-section alt" id="decision">
  <div class="hb-section-inner">
    <span class="hb-kicker">Decision desk</span>
    <h2 class="hb-h2">Which Microsoft path fits your role?</h2>
    <p class="hb-lead">Pick your situation. We'll match it to a current exam code and a direct voucher link.</p>
    <div class="hb-decision" style={{ marginTop: "1.4rem" }}>
      <div class="hb-options" id="hb-decision-form">
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="fundamentals" data-title="Start with AZ-900" data-text="AZ-900 is the broad Azure fundamentals exam: no prerequisites, about $89.10, 2–4 weeks of study. DP-900 is the data alternative. Do not buy the retired AI-900 page." data-label="Get the AZ-900 voucher →" data-link={microsoftVouchers[0].url} />
          <span><b>I need my first Microsoft cert</b><small>AZ-900 or DP-900 at $89.10. AI-900 is retired.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="azure" data-title="Start with AZ-104" data-text="AZ-104 is the core Azure Administrator Associate exam at about $148.50, and the credential most Azure job posts expect. Retake Assurance is available on this page." data-label="Get the AZ-104 voucher →" data-link={microsoftVouchers[2].url} />
          <span><b>I build or run Azure infrastructure</b><small>AZ-104 is the job-getter; AZ-305 comes after.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="security" data-title="Start with SC-200" data-text="SC-200 prepares SOC analysts for Microsoft Sentinel and Defender XDR, at about $148.50. SC-300 covers identity and SC-401 information security. AZ-500 is retired — SC-500 has no Udemy page yet." data-label="Get the SC-200 voucher →" data-link={microsoftVouchers[4].url} />
          <span><b>I work in security or a SOC</b><small>SC-200, SC-300 and SC-401 are current. AZ-500 is not.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="data" data-title="Start with DP-300" data-text="DP-300 covers Azure SQL administration at about $148.50. For data engineering use DP-700, and for Fabric analytics DP-600. DP-100 is retired; AI-300 has no Udemy page yet." data-label="Get the DP-300 voucher →" data-link={microsoftVouchers[5].url} />
          <span><b>I work with data or databases</b><small>DP-300, DP-600 and DP-700 are current. DP-100 is retired.</small></span>
        </label>
      </div>
      <div class="hb-result" id="hb-result">
        <h3 id="hb-result-title">Your best starting point</h3>
        <p id="hb-result-text">Choose a statement on the left. We'll match it to the right current exam code and voucher link.</p>
        <p style={{ marginTop: "0.8rem" }}><a id="hb-result-link" href="#featured">Compare the top 8 vouchers →</a></p>
        <p style={{ marginTop: "0.7rem" }}><a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary" style={{ fontSize: "0.8rem", padding: "0.6rem 1rem" }}>Get the voucher →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="hb-section" id="featured">
  <div class="hb-section-head-row">
    <div class="hb-head">
      <span class="hb-kicker">Best eight</span>
      <h2 class="hb-h2">8 Microsoft vouchers worth buying first</h2>
      <p class="hb-lead">The highest-demand current exams across Azure, data, security, endpoint and DevOps. All eight are bookable today; all 50 pages follow in the catalogue.</p>
    </div>
    <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse vouchers →</a>
  </div>
  <div class="hb-courses">
    {microsoftVouchers.map((vv) => (
      <div class="hb-course">
        <img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" />
        <div class="hb-course-body">
          <div class="hb-course-provider">{vv.code} · {vv.category}</div>
          <h4 class="hb-course-title">{vv.title}</h4>
          <div class="hb-course-meta">{vv.blurb}</div>
          {vv.note && <div class="hb-course-meta" style={{ color: "#fbbf24" }}>{vv.note}</div>}
          <div class="hb-course-price">{voucherPrice(vv)}</div>
          <div class="hb-course-actions">
            <a class="hb-course-cta" href={vv.url} target="_blank" rel="sponsored noopener noreferrer">Get voucher →</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="hb-answer" style={{ marginTop: "1.2rem" }}>
    <p style={{ margin: 0 }}><strong>Why these eight?</strong> They cover the main Microsoft career paths and the exams employers ask about most: AZ-900/DP-900 fundamentals, AZ-104 Azure admin, MD-102 endpoint, SC-200 security, DP-300 Azure SQL, AZ-400 DevOps and AZ-305 architecture. The other 42 live pages are in the catalogue — including 16 you should avoid.</p>
  </div>
</section>

<section class="hb-section alt" id="prices">
  <div class="hb-section-inner">
    <span class="hb-kicker">Price intelligence</span>
    <h2 class="hb-h2">Voucher-only vs Retake Assurance</h2>
    <p class="hb-lead">Microsoft prices exams by level. One voucher buys one attempt; Retake Assurance is an optional add-on on select exams only.</p>
    <div class="hb-ladder" style={{ margin: "1.6rem 0 0.8rem" }}>
