                                        <div style={{ display: "flex", alignItems: "center", gap: "1rem", marginBottom: "1.5rem", position: "relative", zIndex: 1 }}>
                                            <div style={{
                                                width: "50px",
                                                height: "50px",
                                                borderRadius: "14px",
                                                background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
                                                display: "flex",
                                                alignItems: "center",
                                                justifyContent: "center",
                                                color: "white",
                                                fontWeight: "bold",
                                                fontSize: "1.3rem",
                                                boxShadow: "0 4px 12px rgba(0,0,0,0.1)"
                                            }}>
                                                {c.name.charAt(0)}
                                            </div>
                                            <div style={{ flex: 1 }}>
                                                <h3 style={{
                                                    margin: 0,
                                                    color: "var(--text)",
                                                    fontSize: "1.2rem",
                                                    fontWeight: "700",
                                                    marginBottom: "0.25rem"
                                                }}>
                                                    {c.name}
                                                </h3>
                                                <p style={{
                                                    margin: 0,
                                                    color: "var(--muted)",
                                                    fontSize: "0.95rem"
                                                }}>
                                                    {c.count} courses available
                                                </p>
                                            </div>
                                        </div>

                                        {c.subs.size > 0 && (
                                            <div style={{ position: "relative", zIndex: 1 }}>
                                                <p style={{
                                                    color: "var(--muted)",
                                                    fontSize: "0.85rem",
                                                    marginBottom: "0.75rem",
                                                    fontWeight: 600
                                                }}>
                                                    Popular Topics:
                                                </p>
                                                <div style={{ display: "flex", gap: "0.5rem", flexWrap: "wrap" }}>
                                                    {Array.from(c.subs.entries())
                                                        .sort((a, b) => b[1] - a[1])
                                                        .slice(0, 3)
                                                        .map(([sub, n]) => (
                                                            <span
                                                                style={{
                                                                    padding: "0.4rem 0.8rem",
                                                                    borderRadius: "20px",
                                                                    fontSize: "0.8rem",
                                                                    backgroundColor: "hsl(45, 100%, 96%)",
                                                                    border: "1px solid hsl(45, 100%, 85%)",
                                                                    color: "hsl(35, 90%, 30%)",
                                                                    fontWeight: "500"
                                                                }}
                                                                title={`${sub} (${n} courses)`}
                                                            >
                                                                {sub}
                                                            </span>
                                                        ))}
                                                    {c.subs.size > 3 && (
                                                        <span style={{
                                                            fontSize: "0.8rem",
                                                            color: "var(--muted)",
                                                            padding: "0.4rem 0.8rem",
                                                            fontWeight: "500"
                                                        }}>
                                                            +{c.subs.size - 3} more
                                                        </span>
                                                    )}
                                                </div>
                                            </div>
                                        )}
                                    </a>
                                </div>
                            ))}
                        </div>
                    )}

                    {/* Call to Action */}
