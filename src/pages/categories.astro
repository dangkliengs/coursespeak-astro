                        <p style={{
                            color: "var(--muted)",
                            fontSize: "1.1rem",
                            maxWidth: "600px",
                            margin: "0 auto",
                            lineHeight: 1.6
                        }}>
                            Click on any category below to explore curated Udemy coupons and deals in that topic area
                        </p>
                    </div>

                    {list.length === 0 ? (
                        <div style={{
                            background: "var(--card)",
                            padding: "3rem",
                            borderRadius: "24px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            position: "relative",
                            overflow: "hidden"
                        }}>
                            <div style={{
                                position: "absolute",
                                top: "-50px",
                                right: "-50px",
                                width: "150px",
                                height: "150px",
                                background: "hsl(0, 84%, 60%)",
                                borderRadius: "50%",
                                opacity: 0.1
                            }}></div>
                            <h3 style={{ color: "var(--text)", marginBottom: "1rem", fontSize: "1.5rem", fontWeight: 700 }}>
                                No Categories Found
                            </h3>
                            <p style={{ color: "var(--muted)", marginBottom: "2rem", lineHeight: "1.6" }}>
                                We loaded {deals.length} deals but couldn't organize them into categories. Please try refreshing or check back later.
                            </p>
                            <a href="/deals" style={{
                                display: "inline-flex",
                                alignItems: "center",
                                gap: "0.5rem",
                                padding: "1rem 2rem",
                                background: "var(--brand)",
                                color: "var(--bg)",
                                textDecoration: "none",
                                borderRadius: "12px",
                                fontSize: "1.1rem",
                                fontWeight: 600,
                                transition: "all 0.3s ease"
                            }}>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                </svg>
                                Browse All Deals
                            </a>
                        </div>
                    ) : (
                        <div style={{
                            display: "grid",
                            gridTemplateColumns: "repeat(auto-fill, minmax(320px, 1fr))",
                            gap: "2rem"
                        }}>
                            {list.map((c) => (
                                <div style={{
                                    background: "var(--card)",
                                    border: "1px solid var(--border)",
                                    borderRadius: "20px",
                                    padding: "2rem",
                                    transition: "all 0.3s ease",
                                    cursor: "pointer",
                                    position: "relative",
                                    overflow: "hidden"
                                }}>
                                    <div style={{
                                        position: "absolute",
                                        top: "0",
                                        right: "0",
                                        width: "100px",
                                        height: "100px",
                                        background: "var(--brand)",
                                        borderRadius: "0 20px 0 50px",
                                        opacity: 0.05
