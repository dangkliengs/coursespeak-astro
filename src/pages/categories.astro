                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "var(--brand)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {totalCategories}+
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Categories
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                Diverse learning topics
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(35, 90%, 68%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M12 2L3.09 6.26L3 9.18l9 4.82 9-4.82V6.26L12 2zM3 11.77l-.78-.42L3.5 11 3 11.77z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(35, 90%, 68%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {totalCourses}+
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Udemy Courses
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                Professional training content
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(180, 50%, 40%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(180, 50%, 40%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                100%
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Free Access
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                No registration required
                            </p>
                        </div>

                        <div style={{
                            background: "var(--card)",
                            padding: "2rem",
                            borderRadius: "20px",
                            border: "1px solid var(--border)",
                            textAlign: "center",
                            transition: "all 0.3s ease"
                        }}>
                            <div style={{
                                width: "60px",
                                height: "60px",
                                background: "hsl(0, 84%, 60%)",
                                borderRadius: "16px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                margin: "0 auto 1.5rem"
                            }}>
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                </svg>
                            </div>
                            <h3 style={{ color: "hsl(0, 84%, 60%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                                {Math.round(totalCourses/totalCategories)}
                            </h3>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                                Avg per Category
                            </p>
                            <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                                Rich learning options
                            </p>
