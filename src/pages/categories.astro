                    position: "absolute",
                    bottom: "10%",
                    right: "10%",
                    width: "250px",
                    height: "250px",
                    background: "hsl(0, 84%, 60%)",
                    filter: "blur(100px)",
                    opacity: 0.1,
                    borderRadius: "50%",
