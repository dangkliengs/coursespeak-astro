---
import Layout from "../layouts/Layout.astro";
import { readDeals } from "../lib/store";

function normName(raw?: string | null) {
  if (!raw) return undefined;
  let v = String(raw).trim();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/\s+/g, " ");
  return v || undefined;
}

function slugifyCategory(name: string) {
  if (name === "Uncategorized") return "uncategorized";
  let v = name.toLowerCase();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/&/g, " and ");
  v = v.replace(/[^\w\s-]/g, "");
  v = v.trim();
  v = v.replace(/\s+/g, "-");
  v = v.replace(/-+/g, "-");
  return v;
}

// Get all deals and organize by categories
const deals = await readDeals();
const cats = new Map<string, { name: string; count: number; subs: Map<string, number> }>();

for (const d of deals) {
  const cName = normName(d.category) ?? "Uncategorized";
  const cKey = cName.toLowerCase();
  if (!cats.has(cKey)) cats.set(cKey, { name: cName, count: 0, subs: new Map() });
  const bucket = cats.get(cKey)!;
  bucket.count += 1;
  const sName = normName(d.subcategory);
  if (sName) {
    bucket.subs.set(sName, (bucket.subs.get(sName) || 0) + 1);
  }
}

const listRaw = Array.from(cats.values()).sort((a, b) => b.count - a.count);

// Add icon paths
const list = listRaw.map((c) => {
  const cSlug = slugifyCategory(c.name);
  let icon = "/categories/default.svg";
  // You can add specific icon logic here if needed
  return { ...c, icon, slug: cSlug };
});

// Calculate statistics for structured data
const totalCategories = list.length;
const totalCourses = deals.length;
const averageCourses = Math.round(totalCourses / totalCategories);

const pageTitle = `Course Categories | ${totalCategories}+ Topics, ${totalCourses}+ Udemy Courses`;
const pageDescription = `Browse ${totalCategories}+ course categories with ${totalCourses}+ Udemy deals. Find Python, web dev, data science, AI & more with free coupons.`;
---

<Layout title={pageTitle} description={pageDescription}>
    <!-- Enhanced Categories Page Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://coursespeak.com/categories",
          "url": "https://coursespeak.com/categories",
          "name": "Browse All Course Categories | {totalCategories}+ Categories, {totalCourses}+ Udemy Courses | CourseSpeak",
          "description": "Explore {totalCategories} course categories with {totalCourses}+ Udemy deals and 100% off coupons. Find your perfect learning path in development, design, business, marketing & more.",
          "isPartOf": {
            "@id": "https://coursespeak.com"
          },
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://coursespeak.com/logo.svg"
          },
          "datePublished": "2023-01-01",
          "dateModified": "2026-01-15",
          "inLanguage": "en-US",
          "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://coursespeak.com"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Categories",
                "item": "https://coursespeak.com/categories"
              }
            ]
          },
          "mainEntity": {
            "@type": "ItemList",
            "name": "Course Categories",
            "description": "Comprehensive list of all course categories available on CourseSpeak",
            "numberOfItems": "{totalCategories}",
            "itemListElement": [
              {list.map((c, index) => ({
                "@type": "ListItem",
                "position": index + 1,
                "item": {
                  "@type": "Thing",
                  "name": c.name,
                  "description": "{c.count} courses in {c.name} category",
                  "url": "https://coursespeak.com/categories/{c.slug}"
                }
              }))}
            ]
          }
        },
        {
          "@type": "Dataset",
          "name": "CourseSpeak Categories Dataset",
          "description": "Comprehensive dataset of Udemy course categories and subcategories with deal counts",
          "url": "https://coursespeak.com/categories",
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "provider": {
            "@type": "Organization",
            "@id": "https://coursespeak.com/#organization"
          },
          "datePublished": "2023-01-01",
          "dateModified": "2026-01-15"
        },
        {
          "@type": "Organization",
          "@id": "https://coursespeak.com/#organization",
          "name": "CourseSpeak",
          "url": "https://coursespeak.com",
          "logo": "https://coursespeak.com/logo.svg",
          "description": "Free Udemy coupons platform with {totalCategories} categories and {totalCourses}+ courses",
          "foundingDate": "2023",
          "sameAs": [
            "https://x.com/courses_peak",
            "https://www.facebook.com/CourseSpeakOfficial/"
          ]
        }
      ]
    }
    </script>
    <div class="hero-gradient" style={{ minHeight: "100vh", color: "var(--text)" }}>
        <main>
            {/* Hero Section */}
            <section
                class="hero-gradient"
                style={{
                    position: "relative",
                    padding: "8rem 1rem 4rem",
                    textAlign: "center",
                    overflow: "hidden",
                }}
            >
                <div class="container" style={{ position: "relative", zIndex: 10 }}>
                    <div style={{
                        display: "inline-flex",
                        alignItems: "center",
                        gap: "0.5rem",
                        background: "var(--brand-soft)",
                        padding: "0.5rem 1rem",
                        borderRadius: "9999px",
                        marginBottom: "2rem",
                        fontSize: "0.9rem",
                        color: "var(--brand)",
                        fontWeight: 600
                    }}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
