        {
          "@type": "GuidePage",
          "@id": "https://coursespeak.com/udemy-coupons-guide",
          "url": "https://coursespeak.com/udemy-coupons-guide",
          "name": "Complete Udemy Coupons Guide - Find & Use Free Udemy Course Coupons",
