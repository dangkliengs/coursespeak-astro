---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-hub.css";
import allDeals from "../data/deals.json";
import {
  comptiaVouchers,
  awsVouchers,
  microsoftVouchers,
  microsoftCatalog,
  linuxVouchers,
  providerMeta,
  ALL_VOUCHERS_HUB_URL,
  SECOND_CHANCE_URL,
  voucherPageCount,
  currentExamCount,
  linuxVoucherCount,
  voucherPrice,
} from "../data/vouchers";

const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-certification-vouchers";

const pageTitle = `Udemy Certification Vouchers ${currentYear}: Save on AWS, CompTIA, Microsoft & Linux Foundation Exams`;
const pageDescription = `Compare ${voucherPageCount} official Udemy certification voucher pages in ${currentYear} — ${currentExamCount} current exams across CompTIA, AWS and Microsoft, plus ${linuxVoucherCount} Linux Foundation vouchers (CKA, CKS, CNPE). Prices, retake rules, validity and exam codes checked ${updatedLong}.`;
const pageKeywords = "Udemy certification vouchers, Udemy exam vouchers, AWS exam vouchers, CompTIA vouchers, Microsoft vouchers, Linux Foundation vouchers, CKA, CKS, CNPE, Second Chance, Retake Assurance, certification exam discount";

const sources = [
  { label: "Udemy all certification vouchers", url: ALL_VOUCHERS_HUB_URL },
  { label: "AWS certification exam pricing", url: "https://aws.amazon.com/certification/certification-exams/" },
  { label: "Microsoft retired certification exams", url: "https://learn.microsoft.com/en-us/credentials/support/retired-certification-exams" },
  { label: "Linux Foundation CKA", url: "https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" },
  { label: "Linux Foundation CKS", url: "https://training.linuxfoundation.org/certification/certified-kubernetes-security-specialist/" },
  { label: "Linux Foundation CNPE", url: "https://training.linuxfoundation.org/certification/certified-cloud-native-platform-engineer-cnpe/" },
];

const allVoucherPages = [
  ...comptiaVouchers.map((vv) => ({ code: vv.code, name: vv.title, url: vv.url })),
  ...awsVouchers.map((vv) => ({ code: vv.code, name: vv.title, url: vv.url })),
  ...microsoftCatalog.map((e) => ({ code: e.code, name: e.name, url: e.url })),
];
const linuxVoucherPages = linuxVouchers.map((vv) => ({ code: vv.code, name: vv.title, url: vv.url }));

// Real, still-live coupon deals from the daily catalogue, matched to the voucher exams.
const getDeal = (id: string) => {
  const deal = allDeals.find((d) => String(d.id) === id);
  return deal && Date.parse(String(deal.expiresAt)) > Date.now() ? deal : null;
};
const coursePickIds = [
  { id: "1731", provider: "CompTIA", topic: "/topics/comptia-security-plus", why: "Security+ SY0-701 prep — the voucher's matching exam" },
  { id: "9691", provider: "CompTIA", topic: "/topics/comptia-a", why: "A+ Core 1 220-1201 hands-on prep" },
  { id: "151", provider: "AWS", topic: "/topics/aws-certified-solutions-architect-associate", why: "SAA-C03 associate architect prep" },
  { id: "143", provider: "AWS", topic: "/topics/aws-certified-cloud-practitioner", why: "CLF-C02 foundational cloud prep" },
  { id: "5316", provider: "Microsoft", topic: "/topics/microsoft-azure-fundamentals", why: "AZ-900 fundamentals prep" },
  { id: "5319", provider: "Microsoft", topic: "/topics/it-certifications", why: "AZ-104 administrator exam prep" },
];
const coursePicks = coursePickIds
  .map((pick) => ({ ...pick, deal: getDeal(pick.id) }))
  .filter((pick) => pick.deal !== null);

// Each provider card opens a different, provider-specific official voucher listing.
const providerVoucherUrl: Record<string, string> = {
  comptia: comptiaVouchers[3].url,
  aws: awsVouchers[2].url,
  microsoft: microsoftVouchers[0].url,
  linux: linuxVouchers[0].url,
};

const faqs = [
  { q: "How do Udemy certification exam vouchers work?", cat: "basics", a: "A voucher is a prepaid exam seat. You buy it on Udemy for roughly 10% less than the retail exam fee, receive a voucher code in My learning → Certifications, then enter that code at the payment step when you schedule with Pearson VUE (AWS, Microsoft, CompTIA) or the Linux Foundation My Portal and PSI (Linux Foundation). Exams can be taken online with a proctor or at a test centre, depending on the provider." },
  { q: "How much money do I actually save?", cat: "price", a: "About 10% on AWS and Microsoft, 10–12.5% on CompTIA, and a flat 30% on Linux Foundation. Examples checked November 2026: CompTIA Security+ $439 retail vs about $384–$395 on Udemy; A+ $274 per core vs about $240–$247; AWS Cloud Practitioner $100 vs $90; Microsoft AZ-900 $99 vs $89.10; Linux Foundation CKA/CKS/CNPE $445 vs $311.50 (a $133.50 saving). The bigger saving usually comes from pairing the voucher with a coupon-discounted prep course." },
  { q: "Which Linux Foundation vouchers does Udemy sell?", cat: "linux", a: "Udemy currently lists four Linux Foundation vouchers: CKA, CKAD, CKS and CNPE, each at $311.50 against the $445 list price. CourseSpeak's dedicated guide covers the three role tracks in depth — CKA (administrator), CKS (security specialist) and CNPE (platform engineer) — and notes CKAD as the developer-focused alternative." },
  { q: "What is the difference between Second Chance and Retake Assurance?", cat: "retake", a: "Second Chance is the AWS retake product: if you fail, report the result in My learning → Certifications within 9 months, Udemy verifies it, and a new voucher code usually arrives within 7 days. Retake Assurance is used on CompTIA and select Microsoft exams: if you fail, you rebook the same exam with the same voucher code — there is no claim and no new code. Both must be bought with the original voucher, cover exactly one extra attempt, and are not refunded if you pass first time. Linux Foundation vouchers include two attempts as standard." },
  { q: "Can I use an Udemy coupon code to discount a voucher?", cat: "price", a: "No. Udemy coupons and site-wide promo codes never apply to exam voucher purchases — this is stated on every Udemy voucher page. Udemy credits can sometimes be applied, and coupons do apply to the prep courses themselves. The cheapest overall path is a coupon-discounted prep course plus the voucher." },
  { q: "How long are vouchers valid, and are they refundable?", cat: "rules", a: "CompTIA, AWS and Microsoft vouchers are valid for at least 9 months from purchase, including retake coverage. Udemy's Linux Foundation vouchers must be redeemed within 6 months of purchase, then the exam must be taken within 12 months of redemption. Vouchers and retake add-ons are non-refundable and non-transferable, valid only in the country of purchase, and an expired voucher's value is forfeited." },
  { q: "Which certification should I start with?", cat: "choice", a: "Complete beginners: CompTIA Tech+ or A+, AWS Cloud Practitioner CLF-C02, or Microsoft AZ-900 — all foundational with no prerequisites. Aspiring cloud engineers: AWS Solutions Architect Associate SAA-C03 or Microsoft AZ-104. Aspiring security analysts: CompTIA Security+ SY0-701, then CySA+ CS0-004. Kubernetes roles: Linux Foundation CKA first, then CKS after CKA is passed. Each provider guide lists exams in recommended order." },
  { q: "How do I schedule, reschedule, or troubleshoot my exam?", cat: "rules", a: "Udemy does not handle scheduling — booking, rescheduling, ID checks and technical issues go through Pearson VUE and the certification provider. After purchase, copy your code from My learning → Certifications and paste it in the payment step on the provider's scheduling site: AWS Certification, Microsoft Learn → Credentials, or your CompTIA account. Linux Foundation candidates redeem in My Portal, then schedule through PSI. If a code will not apply, verify the exact exam code and country, then contact the provider's support." },
  { q: "What happens if a voucher is out of stock?", cat: "rules", a: "Voucher stock is limited and popular exams sell out. Udemy advises checking back regularly — vouchers can also surface inside eligible prep courses under the Overview tab. Use any waiting time to finish the prep course and practice exams so you are ready the moment stock returns." },
  { q: "Why are there 77 voucher pages but only 58 current exams?", cat: "basics", a: "The count is 15 CompTIA + 12 AWS + 50 Microsoft pages = 77. Current exams are 15 CompTIA + 10 AWS + 33 Microsoft = 58. The gap is Microsoft: 16 of its 50 pages are retired or legacy, and one more (MS-102) retires on November 30, 2026. AWS also has two legacy Specialty listings that remain usable because its vouchers are level-wide. Linux Foundation vouchers are tracked separately and are not included in either figure." },
  { q: "Which Microsoft exams retired in 2026?", cat: "microsoft", a: "Fifteen role-based Microsoft exams retired between June and October 2026: AI-900, DP-100, AI-102, AZ-204, AZ-500, AZ-800, AZ-801, PL-200, PL-400, PL-500, PL-600, MB-240, MB-280, MB-335 and MB-700. MS-102 retires on November 30, 2026. The Microsoft guide flags all 16 retired or legacy pages and explains which replacement codes have no Udemy voucher yet." },
  { q: "Are Udemy exam vouchers legitimate?", cat: "basics", a: "Yes. Udemy is an authorised seller of exam vouchers for these providers. The voucher is a prepaid code issued by the certification provider; you still schedule and take the official exam through the provider's proctoring system. The certification you earn is identical to one booked direct — the discount comes from Udemy subsidising the exam fee, not from a different exam." },
  { q: "Can I use a voucher bought in one country in another?", cat: "rules", a: "No. Udemy vouchers are valid only in the country of purchase. This matters for travellers and cross-border teams: buy the voucher in the country where you will sit the exam, and make sure the name on your provider account matches your government ID exactly." },
  { q: "Can I transfer a voucher to someone else or change the name?", cat: "rules", a: "No. Vouchers are non-transferable and tied to the buyer's identity. The name on your certification account must match your photo ID on exam day. If you buy a voucher for an employee, have them redeem and schedule it under their own account rather than trying to move the code later." },
  { q: "What if my exam retires before I use the voucher?", cat: "rules", a: "An exam retirement can shorten a voucher's useful life even if the printed expiry is later. Check the provider's retirement notices before buying — the Microsoft guide flags retired 2026 exams and MS-102's November 30, 2026 retirement. AWS vouchers are level-wide, which makes them more resilient to a single exam code changing." },
  { q: "Do vouchers include training courses?", cat: "basics", a: "No. A voucher buys exam attempts only; it does not include a prep course. The exception is a Linux Foundation bundle bought directly from LF, which can add a course or subscription. On Udemy, buy the voucher and a discounted prep course separately — coupons apply to the course, not to the voucher." },
  { q: "Can I get a refund if I pass on the first attempt with a retake bundle?", cat: "retake", a: "No. Second Chance and Retake Assurance are non-refundable, and the retake fee is not returned if you pass first time. Price the add-on as insurance, not as a deposit. Linux Foundation's two attempts are included in the standard price, so there is no separate retake premium to forfeit." },
  { q: "What is the cheapest voucher on Udemy?", cat: "price", a: "Microsoft Fundamentals AZ-900 and DP-900 are about $89.10 against a $99 list price, and AWS Cloud Practitioner CLF-C02 is $90 against $100. CompTIA Tech+ starts around $116. Prices vary by country and campaign, so check the live page for your region before buying." },
  { q: "Can I pay with Udemy credits?", cat: "price", a: "Udemy credits can sometimes be applied at checkout to voucher purchases, but coupon codes cannot. Credits are account-specific and their availability varies; treat them as a bonus rather than a guaranteed discount." },
  { q: "Do Linux Foundation vouchers include the Killer.sh simulator?", cat: "linux", a: "Linux Foundation exam registration includes two Killer.sh simulator attempts, each with 36 hours of access from activation. Udemy's voucher page advertises the two exam attempts, so confirm simulator access in your Linux Foundation portal after redemption." },
  { q: "Does Udemy sell vouchers for Google, IBM or Oracle certifications?", cat: "basics", a: "Not in the catalogues CourseSpeak tracks. The Udemy voucher programme covers CompTIA, AWS, Microsoft and Linux Foundation exams. Other providers' exams are booked directly with the certification body." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      image: "https://coursespeak.com/images/og/og-default.png",
      isPartOf: { "@id": "https://coursespeak.com/#website" },
      publisher: { "@id": "https://coursespeak.com/#organization" },
      inLanguage: "en-US",
      datePublished: "2025-01-01",
      dateModified: lastModified,
      author: { "@id": "https://coursespeak.com/#author" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      keywords: pageKeywords,
      about: [
        { "@type": "Thing", name: "Udemy certification exam vouchers", sameAs: ["https://www.udemy.com/all-certification-vouchers/"] },
        { "@type": "Organization", name: "CompTIA", sameAs: ["https://www.comptia.org/"] },
        { "@type": "Organization", name: "Amazon Web Services", sameAs: ["https://aws.amazon.com/certification/"] },
        { "@type": "Organization", name: "Microsoft", sameAs: ["https://learn.microsoft.com/en-us/credentials/"] },
        { "@type": "Organization", name: "Linux Foundation", sameAs: ["https://training.linuxfoundation.org/certification/"] },
      ],
      citation: sources.map((s) => s.url),
      speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", ".hb-sub", "#faq"] },
    },
    { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: canonicalUrl }] },
    { "@type": "ItemList", "@id": `${canonicalUrl}#vouchers`, name: `Udemy Certification Exam Vouchers ${currentYear}`, numberOfItems: allVoucherPages.length, itemListElement: allVoucherPages.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.name} (${vv.code})` })) },
    { "@type": "ItemList", "@id": `${canonicalUrl}#linux-vouchers`, name: `Linux Foundation Exam Vouchers ${currentYear}`, numberOfItems: linuxVoucherPages.length, itemListElement: linuxVoucherPages.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.name} (${vv.code})` })) },
    { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#how-to-buy`,
      name: `How to buy and use a Udemy certification voucher in ${currentYear}`,
      description: "Compare voucher pages, check the live price, buy on Udemy, copy the code from My learning, and apply it when scheduling with the certification provider.",
      totalTime: "PT10M",
      estimatedCost: { "@type": "MonetaryAmount", value: "89.10", currency: "USD" },
      step: [
        { "@type": "HowToStep", position: 1, name: "Choose the right provider", text: "Match the voucher to your role: CompTIA for IT support and security, AWS for cloud, Microsoft for Azure and Microsoft 365, Linux Foundation for Kubernetes and platform engineering.", url: `${canonicalUrl}#decision` },
        { "@type": "HowToStep", position: 2, name: "Check the live price", text: "Compare the Udemy voucher price with the provider list price. Expect around 10% off on AWS, Microsoft and CompTIA, and 30% off on Linux Foundation.", url: `${canonicalUrl}#prices` },
        { "@type": "HowToStep", position: 3, name: "Buy the voucher and any retake cover", text: "Second Chance (AWS) and Retake Assurance (CompTIA, selected Microsoft) must be bought with the original voucher. Udemy coupons do not apply to vouchers.", url: `${canonicalUrl}#rules` },
        { "@type": "HowToStep", position: 4, name: "Copy the code", text: "Find the code in My learning → Certifications. It is also emailed after purchase.", url: `${canonicalUrl}#steps` },
        { "@type": "HowToStep", position: 5, name: "Schedule and pay with the code", text: "Schedule through Pearson VUE (AWS, Microsoft, CompTIA) or Linux Foundation My Portal and PSI, then paste the code at payment.", url: `${canonicalUrl}#steps` },
      ],
    },
    { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about", knowsAbout: ["Udemy certification vouchers", "AWS certification", "CompTIA certification", "Microsoft certification", "Kubernetes certification"] },
  ],
};

const ticker = [
  { name: "CompTIA Security+", note: "Most-booked security voucher", price: comptiaVouchers[3] ? voucherPrice(comptiaVouchers[3]) : "$384–$395", href: "/udemy-comptia-exam-vouchers", color: "var(--brand)" },
  { name: "AWS SAA-C03", note: "Associate-level favourite", price: voucherPrice(awsVouchers[2]), href: "/udemy-aws-exam-vouchers", color: "var(--brand)" },
  { name: "Microsoft AZ-900", note: "Azure fundamentals entry point", price: voucherPrice(microsoftVouchers[0]), href: "/udemy-microsoft-exam-vouchers", color: "var(--brand)" },
  { name: "Microsoft AZ-104", note: "Azure administrator associate", price: "$148.50", href: "/udemy-microsoft-exam-vouchers", color: "var(--brand)" },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} publishedTime="2025-01-01" modifiedTime={lastModified} canonical={canonicalUrl} type="article" image="/images/og/og-default.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hb-hero">
  <div class="hb-hero-inner">
    <div>
      <span class="hb-eyebrow"><span class="hb-dot"></span> Voucher command center · checked <time datetime={lastModified}>{updatedLong}</time></span>
      <h1 class="hb-title">Udemy Certification <span>Vouchers {currentYear}</span></h1>
      <p class="hb-sub">
        Every voucher page we track, every price that matters, and the rules that decide whether you save money or waste an attempt.
        <strong>{voucherPageCount} voucher pages</strong> and <strong>{currentExamCount} current exams</strong> across CompTIA, AWS and Microsoft —
        verified in one place, with matching prep courses you can add for a few dollars.
      </p>
      <div class="hb-metrics">
        <div class="hb-metric"><b>{voucherPageCount}</b><span>voucher pages tracked</span></div>
        <div class="hb-metric"><b>{currentExamCount}</b><span>current exams</span></div>
        <div class="hb-metric"><b>10–12.5%</b><span>typical voucher saving</span></div>
      </div>
      <div class="hb-actions">
        <a href={ALL_VOUCHERS_HUB_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse all {voucherPageCount} vouchers →</a>
        <a href={SECOND_CHANCE_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-ghost">Second Chance voucher →</a>
        <a href="#quick-answer" class="hb-btn-quiet">Read the 60-second answer ↓</a>
      </div>
      <p class="hb-meta">
        By <a href="/about#author">Josh Smith</a>, Founder &amp; Editor · Reviewed <time datetime={lastModified}>{updatedLong}</time> ·
        Sources: <a href={ALL_VOUCHERS_HUB_URL} target="_blank" rel="noopener noreferrer">Udemy catalogue</a>,
        <a href="https://aws.amazon.com/certification/certification-exams/" target="_blank" rel="noopener noreferrer">AWS pricing</a>,
        <a href="https://learn.microsoft.com/en-us/credentials/support/retired-certification-exams" target="_blank" rel="noopener noreferrer">Microsoft retirements</a> and
        <a href="https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" target="_blank" rel="noopener noreferrer">Linux Foundation</a>.
        Sponsored — we may earn a commission at no extra cost. <a href="/affiliate-disclosure">Disclosure</a>
      </p>
    </div>
    <aside class="hb-ticker" aria-label="Live voucher snapshot">
      <div class="hb-ticker-head"><b>Voucher snapshot</b><span><span class="hb-dot"></span> Checked</span></div>
      {ticker.map((t) => (
        <a class="hb-ticker-row" href={t.href} style={{ textDecoration: "none" }}>
          <span class="hb-ticker-name" style={{ color: t.color }}>{t.name}</span>
          <span class="hb-ticker-note">{t.note}</span>
          <span class="hb-ticker-price"><b>{t.price}</b><span>Udemy</span></span>
        </a>
      ))}
      <div class="hb-ticker-foot">List prices and regional availability change. Confirm at checkout before paying.</div>
    </aside>
  </div>
</section>

<div class="hb-rail">
  <div class="hb-rail-inner">
    <a href="#quick-answer">01 Quick answer</a>
    <a href="#decision">02 Pick your path</a>
    <a href="#providers">03 Providers</a>
    <a href="#provider-compare">04 Side by side</a>
    <a href="#prices">05 Prices</a>
    <a href="#courses">06 Prep courses</a>
    <a href="#rules">07 Rules</a>
    <a href="#examples">08 Real maths</a>
    <a href="#roadmap">09 Roadmap</a>
    <a href="#mistakes">10 Mistakes</a>
    <a href="#evidence">11 Evidence</a>
    <a href="#steps">12 How to buy</a>
    <a href="#faq">13 FAQ</a>
  </div>
  <div class="hb-progress" id="hb-progress"></div>
</div>

<section class="hb-section" id="quick-answer">
  <div class="hb-answer">
    <span class="hb-answer-label">Answer first · fact-checked {updatedLong}</span>
    <h2>Udemy certification vouchers: the 60-second answer</h2>
    <p>
      Udemy sells prepaid exam vouchers for selected <strong>CompTIA, AWS and Microsoft</strong> certifications.
      CourseSpeak tracks <strong>{voucherPageCount} voucher pages</strong> covering <strong>{currentExamCount} current exams</strong> across those three providers.
      Savings are typically <strong>about 10%</strong> on AWS and Microsoft and <strong>10–12.5%</strong> on CompTIA. Every voucher is non-refundable,
      country-locked, and excludes training. Udemy coupons discount prep courses, never the voucher itself.
      A separate Linux Foundation voucher set exists but is not included in the {voucherPageCount}/{currentExamCount} figures.
    </p>
    <ul>
      <li><strong>Cheapest standard seat:</strong> Microsoft Fundamentals at about $89.10, or AWS Cloud Practitioner at $90. Typical savings are 10–12.5% across the main three providers.</li>
      <li><strong>Retake cover:</strong> AWS Second Chance and CompTIA/selected Microsoft Retake Assurance must be bought upfront. Linux Foundation includes two attempts.</li>
      <li><strong>Validity:</strong> at least 9 months for CompTIA/AWS/Microsoft. Linux Foundation Udemy vouchers: redeem within 6 months, sit the exam within 12 months of redemption.</li>
      <li><strong>Scheduling:</strong> Pearson VUE for AWS, Microsoft and CompTIA; Linux Foundation My Portal then PSI.</li>
      <li><strong>Before you buy:</strong> check the exam code, your country, the expiry date and whether the exam is retiring.</li>
    </ul>
    <div class="hb-chips">
      {sources.map((s) => (
        <a class="hb-chip" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<section class="hb-section alt" id="decision">
  <div class="hb-section-inner">
    <span class="hb-kicker">Decision desk</span>
    <h2 class="hb-h2">Which voucher actually fits your next move?</h2>
    <p class="hb-lead">Pick the statement closest to your situation. The recommendation updates instantly — no quiz, no email gate.</p>
    <div class="hb-decision" style={{ marginTop: "1.4rem" }}>
      <div class="hb-options" id="hb-decision-form">
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="comptia" data-title="Start with CompTIA" data-text="For IT support, networking or security roles, begin with Security+ SY0-701 or A+. Vouchers cover 15 pages, saving roughly 10–12.5% off list, with optional Retake Assurance." data-label="Open the CompTIA guide →" data-link="/udemy-comptia-exam-vouchers" />
          <span><b>I'm starting in IT support, networking or security</b><small>Foundational and security certifications that employers ask for first.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="aws" data-title="Start with AWS" data-text="Cloud and DevOps roles map to AWS. Cloud Practitioner CLF-C02 is the entry point; Solutions Architect Associate SAA-C03 is the job-getter. Vouchers are level-wide and about 10% off." data-label="Open the AWS guide →" data-link="/udemy-aws-exam-vouchers" />
          <span><b>I'm moving into cloud, DevOps or data</b><small>AWS vouchers are level-wide, so one code covers any exam at that level.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="microsoft" data-title="Start with Microsoft" data-text="Azure, data, security and Microsoft 365 roles start with AZ-900, then AZ-104 or SC-200. Microsoft vouchers save about 10%, but 16 pages are retired or legacy — check the code first." data-label="Open the Microsoft guide →" data-link="/udemy-microsoft-exam-vouchers" />
          <span><b>I work with Azure, data or Microsoft 365</b><small>Just remember that 16 of the 50 voucher pages are retired or legacy.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="linux" data-title="Start with Linux Foundation" data-text="Kubernetes administrators should take CKA first, then CKS after CKA is passed. Platform engineers can go straight to CNPE. All three cost $311.50 instead of $445, with two attempts included." data-label="Open the Linux Foundation guide →" data-link="/udemy-linux-foundation-exam-vouchers" />
          <span><b>I run Kubernetes clusters or build internal platforms</b><small>CKA → CKS → CNPE. Udemy's LF vouchers are a flat 30% off.</small></span>
