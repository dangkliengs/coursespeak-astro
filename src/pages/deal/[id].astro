---
import Layout from "../../layouts/Layout.astro";
import { readDeals } from "../../lib/store";
import DealPage from "../../components/DealPage";
import type { Deal } from "../../types/deal";

export const prerender = import.meta.env.PROD;

export async function getStaticPaths() {
  if (import.meta.env.PROD) {
    const allDeals = await readDeals();
    const paths = [];
    const seen = new Set();
    for (const deal of allDeals) {
      for (const id of [deal.id, deal.slug].filter(Boolean)) {
        if (!seen.has(id)) {
          seen.add(id);
          paths.push({
            params: { id },
            props: { deal, allDeals }
          });
        }
 }
      }
    return paths;
  }
  return [];
}

const { deal: propDeal, allDeals: propAllDeals } = Astro.props as {
  deal?: Deal;
  allDeals?: Deal[];
};

let deal: Deal;
let allDeals: Deal[];

if (import.meta.env.PROD) {
  if (!propDeal || !propAllDeals) {
    throw new Error('Missing props in production mode');
  }
  deal = propDeal;
  allDeals = propAllDeals;
} else {
  const url = new URL(Astro.request.url);
  const slug = url.pathname.split('/').pop() || '';
  allDeals = await readDeals();
  const foundDeal = allDeals.find((d) => d.id === slug || d.slug === slug);

  if (!foundDeal) {
    return new Response(null, {
      status: 302,
      headers: { 'Location': '/' }
    });
  }

  deal = foundDeal;
}

const relatedDeals = allDeals
  .filter((d) => {
    if (d.id === deal.id) return false;
    if (deal.subcategory && d.subcategory) {
      return d.subcategory === deal.subcategory;
    }
    return d.category === deal.category;
  })
  .slice(0, 4);

const discountPercentage = deal.originalPrice && deal.price && deal.originalPrice > deal.price
  ? Math.round(((deal.originalPrice - deal.price) / deal.originalPrice) * 100)
  : 0;

const siteUrl = "https://coursespeak.com";
const dealUrl = `${siteUrl}/deal/${deal.id}`;

function parseDuration(duration: string | undefined): string | undefined {
  if (!duration) return undefined;
  const h = duration.match(/(\d+)h/);
  const m = duration.match(/(\d+)m/);
  let iso = "PT";
  if (h) iso += `${h[1]}H`;
  if (m) iso += `${m[1]}M`;
  return iso === "PT" ? undefined : iso;
}

function extractSkills(deal: Deal): string {
  const skills = new Set<string>();
  if (deal.category) skills.add(deal.category);
  if (deal.subcategory) skills.add(deal.subcategory);
  if (deal.learn) {
    deal.learn.slice(0, 5).forEach(item => {
      const words = item.toLowerCase().split(' ');
      if (words.includes('python')) skills.add('Python');
      if (words.includes('javascript') || words.includes('js')) skills.add('JavaScript');
      if (words.includes('react')) skills.add('React');
      if (words.includes('html')) skills.add('HTML');
      if (words.includes('css')) skills.add('CSS');
      if (words.includes('data') && words.includes('analysis')) skills.add('Data Analysis');
      if (words.includes('machine') && words.includes('learning')) skills.add('Machine Learning');
      if (words.includes('web') && words.includes('development')) skills.add('Web Development');
      if (words.includes('mobile') && words.includes('development')) skills.add('Mobile Development');
    });
  }
  return Array.from(skills).slice(0, 10).join(", ");
}
---

<Layout
    title={`${deal.title} | ${discountPercentage}% Off Udemy Coupon`}
    description={deal.seoDescription || deal.description || ""}
    image={deal.seoOgImage || deal.image}
    canonical={dealUrl}
>
    <script type="application/ld+json" set:html={
        JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebPage",
                    "@id": `${dealUrl}#webpage`,
                    "url": dealUrl,
                    "name": `${deal.title} — ${discountPercentage}% Off Udemy Coupon`,
                    "description": (deal.seoDescription || deal.description || "").slice(0, 160),
                    "inLanguage": "en-US",
                    "isPartOf": {
                        "@type": "WebSite",
                        "name": "CourseSpeak",
                        "url": siteUrl
                    },
                    "datePublished": deal.createdAt ? new Date(deal.createdAt).toISOString().split('T')[0] : undefined,
                    "dateModified": deal.updatedAt ? new Date(deal.updatedAt).toISOString().split('T')[0] : undefined,
                    "publisher": {
                        "@type": "Organization",
                        "name": "CourseSpeak",
                        "url": siteUrl,
                        "logo": {
                            "@type": "ImageObject",
                            "url": `${siteUrl}/logo.svg`
                        },
                        "sameAs": [
                            "https://www.facebook.com/CourseSpeakOfficial/",
                            "https://x.com/courses_peak"
                        ]
                    },
                    "about": { "@type": "Course", "@id": `${dealUrl}#course` },
                    "mainEntity": { "@type": "Course", "@id": `${dealUrl}#course` }
                },
                {
                    "@type": "Course",
                    "@id": `${dealUrl}#course`,
                    "name": deal.title,
                    "description": deal.seoDescription || deal.description || "",
                    "image": deal.seoOgImage || deal.image,
                    "thumbnailUrl": deal.seoOgImage || deal.image,
                    "url": dealUrl,
                    "provider": {
                        "@type": "Organization",
                        "name": deal.provider || "Udemy",
                        "url": deal.provider === "Udemy" ? "https://www.udemy.com" : undefined
                    },
                    "instructor": deal.instructor ? {
                        "@type": "Person",
                        "name": deal.instructor
                    } : undefined,
                    "offers": {
                        "@type": "Offer",
                        "price": (deal.price ?? 0).toString(),
                        "priceCurrency": "USD",
                        "availability": "https://schema.org/InStock",
                        "url": deal.url || dealUrl,
                        "priceValidUntil": deal.expiresAt ? new Date(deal.expiresAt).toISOString().split('T')[0] : undefined,
                        "seller": {
                            "@type": "Organization",
                            "name": deal.provider || "Udemy"
                        }
                    },
                    "aggregateRating": deal.rating ? {
                        "@type": "AggregateRating",
                        "ratingValue": deal.rating.toString(),
                        "reviewCount": Math.max(1, Math.round(deal.students ?? 0)),
                        "bestRating": "5",
                        "worstRating": "1"
                    } : undefined,
                    "educationalLevel": "All Levels",
                    "teaches": extractSkills(deal),
                    "inLanguage": deal.language || "English",
                    "timeRequired": parseDuration(deal.duration),
                    "datePublished": deal.createdAt ? new Date(deal.createdAt).toISOString().split('T')[0] : undefined,
                    "dateModified": deal.updatedAt ? new Date(deal.updatedAt).toISOString().split('T')[0] : undefined,
                    "hasCourseInstance": {
                        "@type": "CourseInstance",
                        "courseMode": "online",
                        "instructor": deal.instructor ? {
                            "@type": "Person",
                            "name": deal.instructor
                        } : undefined
                    }
                },
                {
                    "@type": "BreadcrumbList",
                    "@id": `${dealUrl}#breadcrumb`,
                    "itemListElement": [
                        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
                        { "@type": "ListItem", "position": 2, "name": "Deals", "item": `${siteUrl}/deals` },
                        ...(deal.category ? [{
                            "@type": "ListItem" as const,
                            "position": 3,
                            "name": deal.category,
                            "item": `${siteUrl}/categories/${deal.category.toLowerCase().replace(/\s+/g, '-')}`
                        }] : []),
                        { "@type": "ListItem", "position": deal.category ? 4 : 3, "name": deal.title, "item": dealUrl }
                    ]
                },
                ...(deal.faqs && deal.faqs.length > 0 ? [{
                    "@type": "FAQPage",
                    "@id": `${dealUrl}#faq`,
                    "mainEntity": deal.faqs.slice(0, 8).map((faq: any) => ({
                        "@type": "Question",
                        "name": faq.q,
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": (faq.a || "").replace(/<[^>]*>/g, "").trim()
                        }
                    }))
                }] : []),
                {
                    "@type": "Organization",
                    "@id": `${siteUrl}#organization`,
                    "name": "CourseSpeak",
                    "url": siteUrl,
                    "logo": `${siteUrl}/logo.svg`,
                    "description": "CourseSpeak provides verified Udemy coupons and discount codes for premium online courses.",
                    "foundingDate": "2024",
                    "sameAs": [
                        "https://www.facebook.com/CourseSpeakOfficial/",
                        "https://x.com/courses_peak"
                    ],
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "contactType": "customer service",
                        "availableLanguage": "English"
                    }
                }
            ]
        })
    } />

    <DealPage client:load deal={deal} relatedDeals={relatedDeals} />

</Layout>
