                      borderRadius: "0 20px 0 50px"
                    }}></div>
                    <div style={{
                      fontSize: "2.5rem",
                      fontWeight: "800",
                      color: "rgba(255,255,255,0.95)",
                      textShadow: "2px 2px 8px rgba(0,0,0,0.3)",
