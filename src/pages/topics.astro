---
import Layout from '../layouts/Layout.astro';
import { readDeals } from '../lib/store';

const allDeals = await readDeals();

// Function to decode HTML entities
const decodeHtml = (str: string) => str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

// Decode subcategories in deals
allDeals.forEach(deal => {
  if (deal.subcategory) {
    deal.subcategory = decodeHtml(deal.subcategory);
  }
});

// Get unique subcategories with course counts, sorted by count descending
const topicCounts: Record<string, number> = {};
allDeals.forEach(deal => {
  if (deal.subcategory) {
    topicCounts[deal.subcategory] = (topicCounts[deal.subcategory] || 0) + 1;
  }
});
const topicsData = (Object.entries(topicCounts) as [string, number][])
  .sort((a, b) => b[1] - a[1])
  .map(([topic]) => {
    const slug = topic.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    return { name: topic, slug };
  });

const topics = topicsData.map(t => t.name);

// Calculate statistics for better SEO
const totalTopics = topics.length;
const totalCourses = allDeals.length;
const avgCoursesPerTopic = Math.round(totalCourses / totalTopics);

const title = `Course Topics | ${totalTopics}+ Udemy Topics, ${totalCourses}+ Courses`;
const description = `Browse ${totalTopics}+ specialized course topics with ${totalCourses}+ Udemy courses. Find Python, web dev, data science, AI & cybersecurity deals.`;

const canonicalUrl = "https://coursespeak.com/topics";

// Enhanced JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": "https://coursespeak.com"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://coursespeak.com/logo.svg"
      },
      "datePublished": "2024-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://coursespeak.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Course Topics",
            "item": canonicalUrl
          }
        ]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Udemy Course Topics",
        "description": `Complete list of ${totalTopics} Udemy course topics with deals and courses`,
        "numberOfItems": totalTopics,
        "itemListElement": topicsData.slice(0, 20).map((topicData, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "item": {
            "@type": "Thing",
            "name": `Best Udemy Courses for ${topicData.name}`,
            "description": getTopicDescription(topicData.name),
            "url": `https://coursespeak.com/topics/${topicData.slug}`
          }
        }))
      }
    },
    {
      "@type": "Dataset",
      "name": "CourseSpeak Udemy Topics Dataset",
      "description": "Comprehensive dataset of Udemy course topics and specialized learning areas",
      "url": canonicalUrl,
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "provider": {
        "@id": "https://coursespeak.com/#organization"
      },
      "datePublished": "2024-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "variableMeasured": [
        {
          "@type": "PropertyValue",
          "name": "Total Topics",
          "value": totalTopics
        },
        {
          "@type": "PropertyValue",
          "name": "Total Courses",
          "value": totalCourses
        },
        {
          "@type": "PropertyValue",
          "name": "Average Courses per Topic",
          "value": avgCoursesPerTopic
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://coursespeak.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Course Topics",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Udemy Course Topics",
      "description": "Complete list of Udemy course topics with deals",
      "numberOfItems": topics.length,
      "itemListElement": topicsData.map((topicData, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": topicData.name,
        "url": `https://coursespeak.com/topics/${topicData.slug}`
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are Udemy course topics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Course topics categorize Udemy courses by subject areas like Python, Web Development, Data Science, AI, and more. Each topic page features curated deals on high-quality courses from expert instructors."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find the best deals on Udemy courses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browse our topics page to discover courses by category, then check individual course pages for current deals, ratings, and student reviews. We regularly update with the latest Udemy discounts."
          }
        },
        {
          "@type": "Question",
          "name": "Are Udemy courses worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Udemy offers thousands of courses taught by industry experts. Many courses include lifetime access, certificates of completion, and money-back guarantees. Our topic pages help you find highly-rated courses in your area of interest."
          }
        },
        {
          "@type": "Question",
          "name": "How often are deals updated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We monitor Udemy deals daily and update our listings with the latest discounts. Check back frequently or follow our newsletter for notifications about new deals across all course topics."
          }
        }
      ]
    }
  ]
};

// Array of gradient colors for variety (softer for dark theme)
const gradients = [
  "linear-gradient(135deg, #4a90e2 0%, #5b6bc0 100%)",
  "linear-gradient(135deg, #e91e63 0%, #f06292 100%)",
  "linear-gradient(135deg, #00bcd4 0%, #26c6da 100%)",
  "linear-gradient(135deg, #4caf50 0%, #66bb6a 100%)",
  "linear-gradient(135deg, #ff9800 0%, #ffb74d 100%)",
  "linear-gradient(135deg, #9c27b0 0%, #ba68c8 100%)",
  "linear-gradient(135deg, #607d8b 0%, #78909c 100%)",
  "linear-gradient(135deg, #3f51b5 0%, #5c6bc0 100%)"
];

// Function to get descriptive text for topic
function getTopicIcon(topic: string): string {
  return `${topic} Courses`;
}

// Function to get unique description for topic
function getTopicDescription(topic: string): string {
  const lowerTopic = topic.toLowerCase();

  if (lowerTopic.includes('python')) {
    return "Master Python programming with expert courses covering data science, web development, automation, and machine learning.";
  }
  if (lowerTopic.includes('web') || lowerTopic.includes('javascript')) {
    return "Build modern web applications with comprehensive courses on HTML, CSS, JavaScript, and popular frameworks.";
  }
  if (lowerTopic.includes('data') || lowerTopic.includes('analytics')) {
    return "Transform data into insights with courses on data analysis, visualization, statistics, and business intelligence tools.";
  }
  if (lowerTopic.includes('ai') || lowerTopic.includes('machine learning')) {
    return "Explore artificial intelligence and machine learning with hands-on courses from TensorFlow to advanced algorithms.";
  }
  if (lowerTopic.includes('design')) {
    return "Create stunning visuals and user experiences with professional design courses covering UI/UX, graphic design, and tools.";
  }
  if (lowerTopic.includes('business') || lowerTopic.includes('marketing')) {
    return "Grow your business skills with courses on digital marketing, entrepreneurship, management, and finance.";
  }
  if (lowerTopic.includes('security') || lowerTopic.includes('cyber')) {
    return "Protect digital assets with cybersecurity courses covering ethical hacking, network security, and compliance.";
  }
  if (lowerTopic.includes('mobile')) {
    return "Develop mobile apps for iOS and Android with courses on React Native, Swift, Kotlin, and app store deployment.";
  }

  return `Discover comprehensive courses on ${topic} to advance your career and gain practical skills in high-demand areas.`;
}
---

