                    }}>
                      {topic.charAt(0)}
                    </div>
                  </div>

                  {/* Content */}
                  <div style={{ padding: "2rem", position: "relative", zIndex: 1 }}>
                    <h3 style={{
                      fontSize: "1.2rem",
                      fontWeight: 700,
                      color: "var(--text)",
                      marginBottom: "0.75rem",
                      lineHeight: 1.4
                    }}>
                      {topic} Courses
                    </h3>

                    <div style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "0.5rem",
                      marginBottom: "1rem"
                    }}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style={{ color: "var(--brand)" }}>
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      <span style={{
                        color: "var(--muted)",
                        fontSize: "0.9rem",
                        fontWeight: 600
                      }}>
                        {dealCount} course{dealCount !== 1 ? 's' : ''} available
                      </span>
                    </div>

                    <p style={{
                      color: "var(--muted)",
                      fontSize: "0.9rem",
                      lineHeight: "1.5",
                      marginBottom: "1.5rem",
                      display: "-webkit-box",
                      WebkitLineClamp: 3,
                      WebkitBoxOrient: "vertical",
                      overflow: "hidden"
                    }}>
                      {topicDescription}
                    </p>

                    <a
                      href={`/topics/${topicSlug}`}
                      style={{
                        display: "inline-flex",
                        alignItems: "center",
                        gap: "0.5rem",
                        padding: "0.875rem 1.5rem",
                        background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
                        color: "white",
                        textDecoration: "none",
                        borderRadius: "12px",
                        fontWeight: 600,
                        fontSize: "0.95rem",
                        transition: "all 0.3s ease",
                        width: "100%",
                        justifyContent: "center",
                        boxShadow: "0 4px 12px rgba(0,0,0,0.15)"
                      }}
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      Explore {topic}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>

        </div>
      </section>

      {/* FAQ Section */}
      <section class="card-gradient" style={{ padding: "4rem 1rem" }}>
        <div class="container" style={{ maxWidth: "1000px" }}>
          <div style={{
            textAlign: "center",
            marginBottom: "3rem"
          }}>
            <h2 style={{
              fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
              fontWeight: 800,
              color: "var(--text)",
              marginBottom: "1rem"
            }}>
              Frequently Asked Questions
            </h2>
            <p style={{
              color: "var(--muted)",
              fontSize: "1.1rem",
              maxWidth: "600px",
              margin: "0 auto",
              lineHeight: 1.6
            }}>
              Get answers to common questions about our specialized course topics and Udemy learning platform
            </p>
          </div>

          <div style={{ display: "grid", gap: "2rem" }}>
            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              transition: "all 0.3s ease"
            }}>
              <h3 style={{
                color: "var(--brand)",
                marginBottom: "1rem",
                fontSize: "1.3rem",
                fontWeight: "700",
                display: "flex",
                alignItems: "center",
                gap: "0.75rem"
              }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                </svg>
                What are Udemy course topics?
              </h3>
              <p style={{
                color: "var(--muted)",
                margin: 0,
                lineHeight: "1.7",
                fontSize: "1rem"
              }}>
                Course topics categorize Udemy courses by subject areas like Python, Web Development, Data Science, AI, and more. Each topic page features curated deals on high-quality courses from expert instructors.
              </p>
            </div>

            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              transition: "all 0.3s ease"
            }}>
              <h3 style={{
                color: "hsl(35, 90%, 68%)",
                marginBottom: "1rem",
                fontSize: "1.3rem",
                fontWeight: "700",
                display: "flex",
                alignItems: "center",
                gap: "0.75rem"
              }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                How do I find the best deals?
              </h3>
              <p style={{
                color: "var(--muted)",
                margin: 0,
                lineHeight: "1.7",
                fontSize: "1rem"
              }}>
                Browse our topics page to discover courses by category, then check individual course pages for current deals, ratings, and student reviews. We regularly update with the latest Udemy discounts.
              </p>
            </div>

            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              transition: "all 0.3s ease"
            }}>
              <h3 style={{
                color: "hsl(180, 50%, 40%)",
                marginBottom: "1rem",
                fontSize: "1.3rem",
                fontWeight: "700",
                display: "flex",
                alignItems: "center",
                gap: "0.75rem"
              }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                Are Udemy courses worth it?
              </h3>
              <p style={{
                color: "var(--muted)",
                margin: 0,
                lineHeight: "1.7",
                fontSize: "1rem"
              }}>
                Yes, Udemy offers thousands of courses taught by industry experts. Many courses include lifetime access, certificates of completion, and money-back guarantees. Our topic pages help you find highly-rated courses in your area of interest.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Call to Action */}
      <section class="hero-gradient" style={{ padding: "4rem 1rem" }}>
        <div class="container" style={{ maxWidth: "800px", textAlign: "center" }}>
          <h2 style={{
            fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
            fontWeight: 800,
            color: "var(--text)",
            marginBottom: "1rem"
          }}>
            Ready to Start Your Learning Journey?
          </h2>
          <p style={{
            color: "var(--muted)",
            fontSize: "1.1rem",
            maxWidth: "600px",
            margin: "0 auto 3rem",
            lineHeight: 1.6
          }}>
            Choose from {totalTopics}+ specialized topics and access premium Udemy courses with exclusive deals. Transform your career with expert-led education.
          </p>

          <div style={{
            display: "flex",
            gap: "1rem",
            justifyContent: "center",
            flexWrap: "wrap"
          }}>
            <a href="/categories" style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "0.5rem",
              padding: "1rem 2rem",
              background: "var(--brand)",
              color: "var(--bg)",
              textDecoration: "none",
              borderRadius: "12px",
              fontSize: "1.1rem",
              fontWeight: 600,
              transition: "all 0.3s ease",
              boxShadow: "0 4px 12px rgba(0,0,0,0.15)"
            }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              Browse Categories
            </a>
            <a href="/deals" style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "0.5rem",
