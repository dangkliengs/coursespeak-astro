---
import Layout from "../layouts/Layout.astro";
import { readDeals } from "../lib/store";

const decodeHtml = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

function normName(raw?: string | null) {
  if (!raw) return undefined;
  let v = String(raw).trim();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/\s+/g, " ");
  return v || undefined;
}

function slugifyTopic(name: string) {
  let v = name.toLowerCase();
  v = v.replace(/c\s*\+\+/g, 'cpp');
  v = v.replace(/#/g, 'sharp');
  v = v.replace(/\+/g, 'plus');
  v = v.replace(/[^a-z0-9\s-]/g, '');
  v = v.trim();
  v = v.replace(/\s+/g, '-');
  v = v.replace(/-+/g, '-');
  return v;
}

const allDeals = await readDeals();
allDeals.forEach(deal => {
  if (deal.subcategory) deal.subcategory = decodeHtml(deal.subcategory);
});

// Build topic data with counts and parent category
const topicMap = new Map<string, { name: string; count: number; category: string }>();
for (const deal of allDeals) {
  const sub = normName(deal.subcategory);
  if (!sub) continue;
  const key = sub.toLowerCase();
  if (!topicMap.has(key)) {
    topicMap.set(key, { name: sub, count: 0, category: normName(deal.category) || 'Other' });
  }
  const bucket = topicMap.get(key)!;
  bucket.count += 1;
  const cat = normName(deal.category);
  if (cat) bucket.category = cat;
}

const topicsData = Array.from(topicMap.values()).sort((a, b) => b.count - a.count);

const totalTopics = topicsData.length;
const totalCourses = allDeals.length;

const CATEGORY_COLORS: Record<string, string> = {
  development: "#3B82F6",
  "it-and-software": "#06B6D4",
  programming: "#8B5CF6",
  "programming-languages": "#8B5CF6",
  business: "#10B981",
  design: "#A855F7",
  marketing: "#EC4899",
  "data-science": "#14B8A6",
  "personal-development": "#8B5CF6",
  "photography-and-video": "#F43F5E",
  music: "#6366F1",
  "teaching-and-academics": "#F97316",
  "office-productivity": "#0EA5E9",
  "finance-and-accounting": "#F59E0B",
};

function getCategoryColor(category: string): string {
  if (!category) return "#6B7280";
  const slug = category.toLowerCase().replace(/&/g, " and ").replace(/[^\w\s-]/g, "").trim().replace(/\s+/g, "-").replace(/-+/g, "-");
  return CATEGORY_COLORS[slug] || "#6B7280";
}

const faqs = [
  {
    q: "What are Udemy course topics on CourseSpeak?",
    a: "CourseSpeak organizes Udemy courses into specialized topic pages based on subcategories — such as Python, React, Data Science, and Cybersecurity. Each topic page lists verified coupon deals for courses in that subject area, updated daily."
  },
  {
    q: "How do I find free or discounted Udemy courses by topic?",
    a: "Click any topic card on this page to browse verified Udemy coupon deals for that subject. Each listing shows the discount percentage, original price, and a direct enrollment link. All coupons are verified before listing."
  },
  {
    q: "Are the Udemy coupons on CourseSpeak actually free?",
    a: "Many coupons listed offer 100% off, making the course completely free. Others provide significant discounts (80-95% off). Each listing shows the current price after coupon so you know exactly what to expect."
  },
  {
    q: "How often are new Udemy topic deals added?",
    a: "New deals are added every day. Udemy coupons expire quickly, so we recommend checking back frequently or bookmarking the topic page most relevant to your learning goals."
  },
  {
    q: "Which topics have the most free Udemy courses?",
    a: `Popular topics with the most free courses include ${topicsData.slice(0, 5).map(t => t.name).join(', ')}. Check the course count on each topic card.`
  },
  {
    q: "Can I learn a complete skill by browsing one topic?",
    a: "Yes — each topic page contains courses from beginner to advanced levels. You can start with fundamentals and progress through intermediate and advanced courses, all within the same subject area."
  }
];

// Structured data
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://coursespeak.com/topics#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://coursespeak.com" },
        { "@type": "ListItem", "position": 2, "name": "Course Topics", "item": "https://coursespeak.com/topics" }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": "https://coursespeak.com/topics",
      "url": "https://coursespeak.com/topics",
      "name": `${totalTopics} Udemy Course Topics — Free Coupons & Deals | CourseSpeak`,
      "description": `Browse ${totalTopics} specialized Udemy course topics covering Python, web development, data science, AI, cybersecurity, and more. Find verified 100% off coupons updated daily.`,
      "isPartOf": { "@id": "https://coursespeak.com" },
      "breadcrumb": { "@id": "https://coursespeak.com/topics#breadcrumb" },
      "dateModified": new Date().toISOString().split("T")[0],
      "inLanguage": "en-US",
      "mainEntity": {
        "@type": "ItemList",
        "name": "Udemy Course Topics on CourseSpeak",
        "description": `${totalTopics} topics with ${totalCourses}+ verified coupon deals`,
        "numberOfItems": totalTopics,
        "itemListElement": topicsData.slice(0, 30).map((t, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "Thing",
            "name": `${t.name} Courses on Udemy`,
            "description": `Browse ${t.count} ${t.name} courses with verified Udemy coupons and discounts.`,
            "url": `https://coursespeak.com/topics/${slugifyTopic(t.name)}`
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://coursespeak.com/topics#faq",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout title={`${totalTopics} Udemy Course Topics — Free Coupons & Deals | CourseSpeak`} description={`Browse ${totalTopics} specialized Udemy course topics covering Python, web development, data science, AI, cybersecurity, and more. Find verified 100% off coupons updated daily.`}>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div style="min-height: 100vh; color: var(--text); background: var(--bg);">
    <div>

      <!-- ── Hero ── -->
      <section
        aria-labelledby="topics-hero-heading"
        style="padding: 4rem 1rem 3rem; text-align: center; position: relative; overflow: hidden;"
      >
        <div aria-hidden="true" style="position:absolute;top:20%;left:10%;width:300px;height:300px;background:var(--brand);filter:blur(120px);opacity:.08;border-radius:50%;pointer-events:none;"></div>
        <div aria-hidden="true" style="position:absolute;bottom:10%;right:10%;width:250px;height:250px;background:hsl(0,84%,60%);filter:blur(100px);opacity:.08;border-radius:50%;pointer-events:none;"></div>

        <div class="container" style="position:relative;z-index:1;">
          <div aria-hidden="true" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(212,167,55,0.12);padding:.5rem 1rem;border-radius:9999px;margin-bottom:1.5rem;font-size:.875rem;color:var(--brand);font-weight:600;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Browse All Topics
          </div>

          <h1
            id="topics-hero-heading"
            style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;line-height:1.1;margin:0 auto 1.5rem;max-width:900px;color:var(--text);"
          >
            {totalTopics}+ Learning Topics —
            <span style="background:linear-gradient(135deg,var(--brand),hsl(35,90%,68%));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
              Find Free Udemy Coupons
            </span>
            by Subject
          </h1>

          <p style="font-size:clamp(1rem,2.5vw,1.2rem);color:var(--muted);max-width:680px;margin:0 auto 2.5rem;line-height:1.7;">
            CourseSpeak organizes <strong style="color:var(--text);">{totalCourses}+ verified Udemy coupons</strong> across {totalTopics} specialized learning topics — from Python and React to data science and cybersecurity. Browse by topic to find discounted courses in your field, updated daily.
          </p>

          <ul role="list" aria-label="Site statistics" style="display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;list-style:none;padding:0;margin:0;">
            {[
              { value: `${totalTopics}+`, label: "Topics" },
              { value: `${totalCourses}+`, label: "Udemy Courses" },
              { value: "100%", label: "Verified Coupons" },
              { value: "Daily", label: "Fresh Updates" },
            ].map(({ value, label }) => (
              <li style="background:var(--card);padding:1rem 2rem;border-radius:12px;border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;min-width:130px;">
                <strong style="color:var(--brand);font-size:1.5rem;line-height:1;">{value}</strong>
                <span style="color:var(--muted);font-size:.85rem;margin-top:.35rem;">{label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ── Topics Grid ── -->
      <section
        aria-labelledby="topics-grid-heading"
        style="padding:4rem 1rem;background:var(--bg);"
      >
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2
              id="topics-grid-heading"
              style="font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800;color:var(--text);margin-bottom:.75rem;"
            >
              Browse All {totalTopics} Topics
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:580px;margin:0 auto;line-height:1.65;">
              Each topic links to a dedicated page listing all available Udemy coupons in that subject. Courses are grouped by subcategory, sorted by rating, and verified daily.
            </p>
          </div>

          {topicsData.length === 0 ? (
            <div style="text-align:center;padding:3rem;background:var(--card);border-radius:16px;border:1px solid var(--border);">
              <h3 style="color:var(--text);margin-bottom:1rem;">No topics found</h3>
              <p style="color:var(--muted);margin-bottom:1.5rem;">We loaded {allDeals.length} deals but couldn't group them into topics. Please try again later.</p>
              <a href="/deals" style="padding:.875rem 1.75rem;background:var(--brand);color:#fff;text-decoration:none;border-radius:10px;font-weight:600;">Browse All Deals</a>
            </div>
          ) : (
            <div class="adv-cards">
              {topicsData.map((t) => {
                const slug = slugifyTopic(t.name);
                const catColor = getCategoryColor(t.category);
                return (
                  <a href={`/topics/${slug}`}
                     title={`Browse ${t.count} ${t.name} courses with Udemy coupons`}
                     class="adv-card">
                    <div style={{ display: "flex", alignItems: "center", gap: "12px", marginBottom: "12px" }}>
                      <div style={{ width: "44px", height: "44px", borderRadius: "10px",
                          background: "linear-gradient(135deg,var(--brand),#C5A028)",
                          display: "flex", alignItems: "center", justifyContent: "center",
                          color: "#1a1814", flexShrink: 0 }}>
                        <span style="font-weight:800;font-size:1rem;">{t.name.charAt(0).toUpperCase()}</span>
                      </div>
                      <div>
                        <h3 style={{ margin: 0, fontSize: "1rem", fontWeight: 700, color: "var(--text)", lineHeight: 1.2 }}>{t.name}</h3>
                        <p style={{ margin: "2px 0 0", fontSize: "0.82rem", color: "var(--brand)", fontWeight: 600 }}>{t.count} course{t.count !== 1 ? 's' : ''}</p>
                      </div>
                    </div>
                    <p style={{ fontSize: "0.85rem", color: "var(--text-secondary)", lineHeight: 1.55, margin: "0 0 12px" }}>
                      {t.name} courses covering fundamentals to advanced skills with hands-on projects and expert instruction. Find verified Udemy coupons and discounts.
                    </p>
                    <span style={{ display: "inline-block", padding: "2px 10px", borderRadius: "999px",
                        fontSize: "0.7rem", fontWeight: 700, color: catColor,
                        background: "var(--card)", border: `1px solid ${catColor}` }}>
                      {t.category}
                    </span>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </section>

      <!-- ── ABOUT TOPICS ── -->
      <section style="padding:4rem 1rem;background:var(--card);">
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:800;color:var(--text);margin-bottom:.75rem;">
              About Course Topics
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:700px;margin:0 auto;line-height:1.6;">
              Everything you need to know about browsing and using topic pages to find the perfect Udemy coupons for your learning goals
            </p>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                What Are Course Topics?
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                CourseSpeak organizes Udemy courses into {totalTopics} specialized topics based on subcategories. Each topic contains courses with verified coupons, making it easy to find discounted courses in your specific area of interest. From Python programming to UX design, our topics cover all major learning subjects.
              </p>
            </div>

            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(120,70%,45%)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                How to Browse Topics
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Simply click on any topic card to view all available courses with coupons in that subject. Each topic page shows course count, ratings, and detailed descriptions. All coupons are verified and updated daily, ensuring you only see working deals.
              </p>
            </div>

            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(210,100%,60%)"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                Topic Organization
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Each topic is organized under its parent category. For example, React is listed under Development, and Financial Modeling is under Business. This hierarchical organization helps you discover related topics and build comprehensive learning paths.
              </p>
            </div>

            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(35,90%,68%)"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                Global Topic Access
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Our course topics serve learners worldwide, supporting multiple languages including English, Spanish, Portuguese, French, German, Japanese, Chinese, and more. Find courses in your preferred language across all topics.
              </p>
            </div>

            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(280,70%,60%)"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                Verified Coupons Only
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Every course listed in our topics has a verified, working coupon. Our team manually checks each coupon daily to ensure it provides the advertised discount. Expired or invalid coupons are immediately removed, so you can trust every deal you see.
              </p>
            </div>

            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(200,70%,60%)"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                Popular Topics
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                The most popular topics on CourseSpeak are {topicsData.slice(0, 5).map(t => t.name).join(", ")}. These topics reflect the most in-demand skills in today's job market and have the most courses and coupons available.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── FAQ ── -->
      <section style="padding:4rem 1rem;background:var(--bg);">
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:800;color:var(--text);margin-bottom:0.75rem;">
              Frequently Asked Questions About Course Topics
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:700px;margin:0 auto;line-height:1.6;">
              Get answers to common questions about browsing course topics, finding coupons by subject, and using CourseSpeak.
            </p>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:1.5rem;">
            {faqs.map((faq) => (
              <div style="background:var(--card);border-radius:14px;border:1px solid var(--border);overflow:hidden;">
                <div style="padding:1.25rem 1.5rem;">
                  <h3 style="margin:0;color:var(--text);font-size:1rem;font-weight:700;margin-bottom:0.75rem;">
                    {faq.q}
                  </h3>
                  <p style="color:var(--muted);line-height:1.7;margin:0;font-size:0.95rem;">
                    {faq.a}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── CTA ── -->
      <section style="padding:4rem 1rem;text-align:center;background:var(--bg);">
        <div class="container" style="max-width:1400px;">
          <div style="max-width:700px;margin:0 auto;">
            <h2 style="font-size:clamp(1.4rem,3vw,1.9rem);font-weight:800;color:var(--text);margin-bottom:.75rem;">
              Can't Find What You're Looking For?
            </h2>
            <p style="color:var(--muted);line-height:1.65;margin-bottom:2rem;">
              Browse our full collection of <strong style="color:var(--text);">{totalCourses}+ Udemy deals</strong> or browse by category to discover more learning opportunities.
            </p>
            <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
              <a
                href="/deals"
                style="padding:.9rem 2rem;background:var(--brand);color:#fff;text-decoration:none;border-radius:10px;font-size:1rem;font-weight:700;transition:opacity .2s;"
              >
                Browse All Deals
              </a>
              <a
                href="/categories"
                style="padding:.9rem 2rem;background:transparent;color:var(--brand);text-decoration:none;border-radius:10px;font-size:1rem;font-weight:700;border:2px solid var(--brand);transition:background .2s;"
              >
                Browse by Category
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>

  <style>
    .container { max-width: 1400px; margin: 0 auto; }
  </style>
</Layout>
