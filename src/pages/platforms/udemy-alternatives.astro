const related = [
  { href: "/platforms/udemy-vs-coursera", label: "Udemy vs Coursera" },
  { href: "/platforms/udemy-vs-edx", label: "Udemy vs edX" },
  { href: "/platforms/udemy-vs-skillshare", label: "Udemy vs Skillshare" },
