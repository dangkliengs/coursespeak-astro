---
import Layout from "../../layouts/Layout.astro";
import DealCard from "../../components/DealCard.astro";
import { readDeals, isDealAddedToday } from "../../lib/store";

export async function getStaticPaths() {
  const allDeals = await readDeals();
  const PAGE_SIZE = 12;
  const totalPages = Math.ceil(allDeals.length / PAGE_SIZE);

  // Start from page 2 — page 1 is handled by /deals.astro
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) }
  }));
}

const allDeals = await readDeals();
const PAGE_SIZE = 12;

const currentPage = Math.max(2, parseInt(Astro.params.page || '2', 10));

const totalPages = Math.ceil(allDeals.length / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = allDeals.slice(startIndex, endIndex);

// Pagination URLs
const siteUrl = "https://coursespeak.com";
const baseDealsPath = "/deals";
const baseDealsUrl = `${siteUrl}${baseDealsPath}`;
const currentUrl = `${baseDealsUrl}/${currentPage}`;
const prevUrl = currentPage === 2 ? baseDealsPath : `${baseDealsPath}/${currentPage - 1}`;
const nextUrl = currentPage < totalPages ? `${baseDealsPath}/${currentPage + 1}` : null;
const prevUrlAbs = `${siteUrl}${prevUrl}`;
const nextUrlAbs = nextUrl ? `${siteUrl}${nextUrl}` : null;

// SEO (WIB/Asia-Jakarta)
const TIMEZONE = 'Asia/Jakarta';
const currentDate = new Date();
const currentMonth = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, month: 'long' });
const currentYear  = currentDate.toLocaleDateString('en-US', { timeZone: TIMEZONE, year: 'numeric' });
const todayWIB     = currentDate.toLocaleDateString('en-CA', { timeZone: TIMEZONE });

const totalDeals = allDeals.length;

const maxSavings = (() => {
  const valid = allDeals.filter((d: any) => d.originalPrice && d.price !== undefined && d.originalPrice > 0 && d.originalPrice > d.price);
  if (valid.length === 0) return 90;
  const max = valid.reduce((m: number, d: any) =>
    Math.max(m, ((d.originalPrice - (d.price ?? 0)) / d.originalPrice) * 100), 0);
  return Math.round(max);
})();

const todayAdded = allDeals.filter(isDealAddedToday).length;

const catsSet = new Set<string>();
allDeals.forEach((d: any) => { if (d.category) catsSet.add(d.category); });
const categories = Array.from(catsSet).sort();

const latestUpdate = allDeals.reduce((latest: number, d: any) => {
  const t = new Date(d.updatedAt || d.createdAt || 0).getTime();
  return t > latest ? t : latest;
}, 0);
const diffMs = currentDate.getTime() - latestUpdate;
const diffMin = Math.floor(diffMs / 60000);
let lastVerified;
if (diffMin < 1) lastVerified = 'Just now';
else if (diffMin < 60) lastVerified = `${diffMin}m ago`;
else {
  const diffHr = Math.floor(diffMin / 60);
  lastVerified = diffHr < 24 ? `${diffHr}h ago` : `${Math.floor(diffHr / 24)}d ago`;
}

function slugifyCategory(cat: string): string {
  return cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

const pageTitle = `Udemy promo codes, coupons, and deals for ${currentMonth} ${currentYear} — Page ${currentPage} | CourseSpeak`;
const pageDescription = `Page ${currentPage} of Udemy promo codes, coupons, and deals for ${currentMonth} ${currentYear}. Browse more verified discounted courses with savings up to ${maxSavings}% off. Updated daily.`;

// FAQ data — identical between schema and visible HTML (Google requirement)
const faqs = [
  {
    q: "Are Udemy deals on CourseSpeak legitimate?",
    a: "Yes! All deals on CourseSpeak are verified and sourced directly from Udemy or authorized partners. We regularly check and update our listings to ensure every coupon is active and working."
  },
  {
    q: "Are CourseSpeak coupon codes really free?",
    a: "The coupon codes themselves are completely free to use. They give you access to heavily discounted Udemy courses, typically 87–95% off the regular price, rather than completely free courses."
  },
  {
    q: "How often are new Udemy coupons added?",
    a: "CourseSpeak adds new Udemy coupons daily. We continuously monitor and verify deals from instructors worldwide to bring you the latest discounted courses."
  },
  {
    q: "How much can I save with a Udemy coupon?",
    a: "Deals on CourseSpeak currently offer savings of up to 95% off the regular course price. The exact discount is shown on each deal card and applied automatically at checkout on Udemy."
  },
  {
    q: "Can I get a certificate from Udemy courses enrolled with a coupon?",
    a: "Yes. You receive the same certificate of completion for coupon-enrolled courses as you would for full-price ones — provided you complete the course requirements."
  },
  {
    q: "How do I apply a Udemy coupon code?",
    a: "Click any deal on CourseSpeak. You will be taken directly to the Udemy course page where the discount is automatically applied. In most cases, no coupon code entry is needed."
  },
  {
    q: "How does CourseSpeak verify Udemy coupons?",
    a: "CourseSpeak runs automated checks against Udemy's servers to verify each coupon is valid and active. Expired deals are removed automatically, ensuring you only see working coupons."
  }
];

// Build page number list — no key prop, no >= operator
type PageItem = { type: 'page'; value: number } | { type: 'ellipsis'; id: string };
const pageItems: PageItem[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - windowSize && p <= currentPage + windowSize;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}

// JSON-LD — no Organization/WebSite (already in Layout.astro)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Udemy Deals & Coupons", "item": baseDealsUrl },
        { "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": siteUrl },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "dateModified": todayWIB,
      "inLanguage": "en-US",
      "mainEntity": {
        "@type": "ItemList",
        "name": `Udemy Deals & Coupon Codes — Page ${currentPage}`,
        "numberOfItems": allDeals.length,
        "itemListElement": currentItems.map((deal: any, index: number) => ({
          "@type": "ListItem",
          "position": startIndex + index + 1,
          "item": {
            "@type": "Course",
            "name": deal.title,
            "description": deal.description || `Get ${deal.title} at up to ${maxSavings}% off with a verified coupon code.`,
            "url": `${siteUrl}/deal/${deal.id}`,
            "image": deal.image,
            "provider": {
              "@type": "Organization",
              "name": deal.provider || "Udemy",
              "url": "https://www.udemy.com"
            },
            "offers": {
              "@type": "Offer",
              "price": String(deal.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock",
              "priceValidUntil": deal.expiresAt || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toLocaleDateString('en-CA', { timeZone: TIMEZONE }),
              "seller": { "@type": "Organization", "name": "CourseSpeak", "url": siteUrl }
            },
            ...(deal.rating ? {
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": deal.rating.toString(),
                "bestRating": "5",
                "worstRating": "1",
                "ratingCount": Math.max(1, Math.round(deal.students ?? 1000))
              }
            } : {})
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${currentUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
>
  <Fragment slot="head">
    <link rel="prev" href={prevUrlAbs} />
    {nextUrlAbs && <link rel="next" href={nextUrlAbs} />}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO — page 2+ ── */}
    <section style={{ padding: "3rem 1rem 1.5rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          Updated Daily — {currentMonth} {currentYear}
        </div>
        <h1 style={{ fontSize: "clamp(1.5rem, 4vw, 2.2rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Udemy Promo Codes, Coupons & Deals</span>
          <br />
          <span style={{ background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Page {currentPage}</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "600px", margin: "0 auto", lineHeight: 1.6 }}>
          Browse more verified Udemy deals — showing {startIndex + 1}–{Math.min(endIndex, allDeals.length)} of {allDeals.length} discounted courses with coupon codes.
        </p>
      </div>
    </section>

    {/* ── STATS GRID ── */}
    <section style={{ paddingBottom: "2rem", marginTop: "0.5rem" }}>
      <div class="container">
        <div class="stat-grid" style={{ gridTemplateColumns: "repeat(4,1fr)", maxWidth: "850px" }}>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              {todayAdded}
            </div>
            <div class="stat-label">Added Today</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {totalDeals}
            </div>
            <div class="stat-label">Total Coupons</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              {categories.length}
            </div>
            <div class="stat-label">Categories</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {lastVerified}
            </div>
            <div class="stat-label">Verified</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── CATEGORIES ── */}
    <section style={{ background: "var(--card)", borderTop: "1px solid var(--border)", padding: "2rem 1.5rem", textAlign: "center" }}>
      <div class="container" style={{ maxWidth: "1280px" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Browse by Topic
        </div>
        <h2 style={{ fontSize: "1.1rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.35rem" }}>
          Course Categories
        </h2>
        <p style={{ fontSize: "0.85rem", color: "var(--muted)", margin: "0 auto 1rem", maxWidth: "550px", lineHeight: 1.6 }}>
          Find Udemy coupon codes in {categories.length} categories — from programming and data science to design, marketing, and more.
        </p>
        <div style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem", justifyContent: "center" }}>
          <a href="/deals" style={{ fontSize: "0.78rem", fontWeight: 600, color: "white", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--brand)", background: "var(--brand)" }}>All</a>
          {categories.slice(0, 15).map((cat: string) => (
            <a href={`/categories/${slugifyCategory(cat)}`} style={{ fontSize: "0.78rem", fontWeight: 600, color: "var(--muted)", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--border)", background: "var(--bg)" }}>{cat}</a>
          ))}
        </div>
      </div>
    </section>

    {/* ── DEALS SECTION ── */}
    <section style={{ padding: "3rem 1.5rem 4rem", maxWidth: "1280px", margin: "0 auto" }}>
        <div style={{ textAlign: "center", marginBottom: "1.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Page {currentPage} — Continued
          </div>
          <h2 style={{ fontSize: "1.3rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.3rem" }}>
            More Udemy Promo Codes, Coupons & Deals
          </h2>
          <p style={{ fontSize: "0.9rem", color: "var(--muted)", maxWidth: "650px", margin: "0 auto", lineHeight: 1.6 }}>
            Browse {currentItems.length} more verified Udemy promo codes, coupons, and deals with discounts up to {maxSavings}%. Find courses in programming, web development, data science, and more — all updated {currentMonth} {currentYear}.
          </p>
        </div>
        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(3, 1fr)",
          gap: "1.25rem"
        }}>
          {currentItems.map((deal: any) => (
            <DealCard deal={deal} />
          ))}
        </div>

        {/* ── PAGINATION ── */}
        <nav aria-label="Pagination" style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: "0.75rem", padding: "1.5rem 0", marginTop: "1.5rem", borderTop: "1px solid var(--border)" }}>
          <a href={prevUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>← Prev</a>
          <div style={{ display: "flex", alignItems: "center", gap: "4px" }}>
            {pageItems.map((item) => {
              if (item.type === 'ellipsis') {
                return <span style={{ fontSize: "0.85rem", color: "var(--muted)", width: "34px", textAlign: "center" }}>...</span>;
              }
              const p = item.value;
              const isActive = p === currentPage;
              const href = p === 1 ? baseDealsPath : `${baseDealsPath}/${p}`;
              return isActive
                ? <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "white", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--brand)", background: "var(--brand)" }}>{p}</span>
                : <a href={href} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--text)", textDecoration: "none", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--border)" }}>{p}</a>;
            })}
          </div>
          {nextUrl ? (
            <a href={nextUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>Next →</a>
          ) : (
            <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--muted)", opacity: 0.4, padding: "0.4rem 0.85rem" }}>Next →</span>
          )}
        </nav>

    </section>

    {/* ── HOW COURSEPEAK VERIFIES — SEO ── */}
    <section style={{ padding: "4rem 1rem", background: "linear-gradient(135deg, rgba(212,167,55,0.03) 0%, transparent 100%)" }}>
      <div class="container" style={{ maxWidth: "1280px" }}>
        <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "1rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Real-Time Verification
          </div>
          <h2 style={{ fontSize: "clamp(1.5rem, 4vw, 2rem)", fontWeight: 800, color: "var(--text)", marginBottom: "0.75rem" }}>
            How CourseSpeak verifies Udemy coupons
          </h2>
          <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "700px", margin: "0 auto", lineHeight: 1.6 }}>
            Every coupon on CourseSpeak is checked against Udemy automatically. Expired coupons disappear, new ones appear — all in near real time.
          </p>
        </div>

        <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "2rem" }}>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))", gap: "1.5rem" }}>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: "0.5rem", marginBottom: "0.5rem" }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--brand)"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14" stroke="white" stroke-width="1.5"/></svg>
                <span style={{ fontWeight: 700, fontSize: "0.95rem", color: "var(--text)" }}>Live Coupon Checking</span>
              </div>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: 0 }}>
                CourseSpeak checks every coupon against Udemy in near real time. When a coupon runs out, it disappears from this list automatically. New coupons are added throughout the day.
              </p>
            </div>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: "0.5rem", marginBottom: "0.5rem" }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--brand)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span style={{ fontWeight: 700, fontSize: "0.95rem", color: "var(--text)" }}>Trusted & Transparent</span>
              </div>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: "0 0 0.75rem" }}>
                CourseSpeak is committed to full transparency. Every coupon is verified against Udemy before listing, and we clearly disclose our affiliate relationships. Our recommendations are based on real-time availability, not commissions — so you always get working coupons you can trust.
              </p>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: "0 0 0.75rem" }}>
                Browse <a href="/categories" style={{ color: "var(--brand)", textDecoration: "none", fontWeight: 600 }}>categories</a> or view <a href="/deals" style={{ color: "var(--brand)", textDecoration: "none", fontWeight: 600 }}>all deals</a>.
              </p>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: 0 }}>
                Learn how <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" target="_blank" rel="noopener noreferrer" style={{ color: "var(--brand)", textDecoration: "none", fontWeight: 600 }}>Udemy improves free coupons</a> for better targeting and learning quality.
              </p>
            </div>
          </div>
          <div style={{ marginTop: "1.5rem", paddingTop: "1.25rem", borderTop: "1px solid var(--border)" }}>
            <p style={{ color: "var(--muted)", fontSize: "0.85rem", lineHeight: 1.7, margin: 0 }}>
              <strong style={{ color: "var(--text)" }}>Affiliate Disclosure:</strong> CourseSpeak is an affiliate marketing platform. We earn small commissions from qualifying purchases made through our links. This helps us maintain and improve CourseSpeak at no cost to you. Our affiliate relationships do not influence which courses we recommend.{" "}
              <a href="/affiliate-disclosure" style={{ color: "var(--brand)", textDecoration: "underline" }}>Read Full Disclosure</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── ABOUT UDEMY COUPONS — SEO Content ── */}
    <section style={{ padding: "4rem 1rem", background: "var(--card)" }}>
      <div class="container" style={{ maxWidth: "1400px" }}>
        <div style={{ textAlign: "center", marginBottom: "3rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "1rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Learn More
          </div>
