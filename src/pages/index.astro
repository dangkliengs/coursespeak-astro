---
import Layout from "../layouts/Layout.astro";
import DealCard from "../components/DealCard.astro";
import DealsList from "../components/DealsList";
import HeaderSearch from "../components/HeaderSearch";
import { readDeals } from "../lib/store";
import { uniqueProviders } from "../lib/mockData";

// Get current month and year for dynamic title (consistent timezone)
const currentDate = new Date();
const utcDate = new Date(currentDate.toISOString());
const monthNames = ["January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"];
const currentMonth = monthNames[utcDate.getMonth()];
const currentYear = utcDate.getFullYear();

// Dynamic title and description focusing on Udemy coupons with long-tail keywords
const pageTitle = `100% Off Udemy Coupons ${currentMonth} ${currentYear} | Free Udemy Courses`;
const pageDescription = `Discover verified 100% off Udemy coupons and free courses updated daily. Get premium courses completely free with working coupon codes.`;

const allDeals = await readDeals();

// Initial pagination
const PAGE_SIZE = 12;
const initialItems = allDeals.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allDeals.length / PAGE_SIZE);

// Extract top categories for filter links
const categories = [
  ...new Set(allDeals.map((d) => d.category).filter(Boolean).map(normName).filter(Boolean)),
] as string[];

// Normalize function for category names
function normName(raw?: string | null) {
  if (!raw) return undefined;
  let v = String(raw).trim();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/\s+/g, " ");
  return v || undefined;
}

// Slugify function for category URLs
function slugifyCategory(name: string) {
  if (name === "Uncategorized") return "uncategorized";
  let v = name.toLowerCase();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/&/g, " and ");
  v = v.replace(/[^\w\s-]/g, "");
  v = v.trim();
  v = v.replace(/\s+/g, "-");
  v = v.replace(/-+/g, "-");
  return v;
}

// Get description for category
function getCategoryDescription(category: string) {
  const cat = category.toLowerCase();
  if (cat === 'development') {
    return "Master programming, web development, and software engineering";
  }
  if (cat === 'programming') {
    return "Learn coding languages, algorithms, and software development fundamentals";
  }
  if (cat === 'it & software') {
    return "Learn IT infrastructure, cybersecurity, and software tools";
  }
  if (cat.includes('business')) {
    return "Build business skills in management, finance, and entrepreneurship";
  }
  if (cat === 'finance') {
    return "Master financial analysis, investment strategies, and accounting principles";
  }
  if (cat.includes('marketing')) {
    return "Master digital marketing, SEO, and social media strategies";
  }
  if (cat.includes('data') || cat.includes('analytics')) {
    return "Learn data science, analytics, and machine learning techniques";
  }
  if (cat.includes('teaching & academics')) {
    return "Advance your academic knowledge with specialized educational courses";
  }
  if (cat.includes('design')) {
    return "Explore design,graphic design, UI/UX, and creative tools";
  }
  if (cat.includes('photography')) {
    return "Master photography techniques and digital image processing";
  }
  if (cat.includes('music')) {
    return "Learn music production, composition, and audio engineering";
  }
  if (cat.includes('personal')) {
    return "Develop personal growth and soft skills for career success";
  }
  if (cat.includes('office productivity')) {
    return "Boost productivity with Microsoft Office, Google Workspace, and collaboration tools";
  }
  // Default description
  return "Explore premium courses with exclusive coupons and deals";
}

// Get icon and color for category
function getCategoryIconAndColor(category: string) {
  const cat = category.toLowerCase();
  // Exact matches to avoid duplicates
  if (cat === 'development') {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0L19.2 12l-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
        <path d="M21 2H3c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM3 4h18v16H3V4z"/>
      </svg>`,
      color: "hsl(210, 100%, 60%)" // Blue
    };
  }
  if (cat.includes('it') || cat.includes('software')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M9.5 3L8 4.5 11.5 8 9 10.5 10.5 12 14 8.5 10.5 5z"/>
        <path d="M14.5 3L16 4.5 12.5 8 15 10.5 13.5 12 10 8.5 13.5 5z"/>
        <rect x="2" y="15" width="20" height="7" rx="1" ry="1"/>
        <circle cx="9" cy="18" r="1"/>
        <circle cx="15" cy="18" r="1"/>
      </svg>`,
      color: "hsl(120, 100%, 35%)" // Green
    };
  }
  if (cat.includes('design') || cat.includes('photography') || cat.includes('art')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <circle cx="12" cy="12" r="3.2"/>
        <path d="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
      </svg>`,
      color: "hsl(45, 100%, 55%)" // Orange
    };
  }
  if (cat.includes('business') || cat.includes('finance')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/>
        <path d="M0 0h24v24H0z" fill="none"/>
      </svg>`,
      color: "hsl(240, 100%, 60%)" // Purple
    };
  }
  if (cat.includes('marketing')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M7 4V2C7 1.45 7.45 1 8 1h8c.55 0 1 .45 1 1v2h4c.55 0 1 .45 1 1s-.45 1-1 1h-1v14c0 1.1-.9 2-2 2H6c-1.1 0-2-.9-2-2V6H3c-.55 0-1-.45-1-1s.45-1 1-1h4zM9 3v1h6V3H9zM7 6v12h10V6H7z"/>
        <path d="M9 8h6v2H9V8zM9 12h6v2H9v-2z"/>
      </svg>`,
      color: "hsl(0, 100%, 55%)" // Red
    };
  }
  if (cat.includes('data') || cat.includes('science') || cat.includes('analytics')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4zm2.5 2.1h-15V5h15v14.1zm0-16.1h-15c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
      </svg>`,
      color: "hsl(180, 100%, 40%)" // Teal
    };
  }
  if (cat.includes('teaching') || cat.includes('academics') || cat.includes('education')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3m-1 16.35L5 15.82V11.9l6 3.25v4.2m7-9.9l-7-3.82-7 3.82 7 3.82 7-3.82z"/>
      </svg>`,
      color: "hsl(30, 100%, 55%)" // Brown
    };
  }
  if (cat.includes('personal') || cat.includes('development')) {
    return {
      icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
      </svg>`,
      color: "hsl(270, 100%, 60%)" // Magenta
    };
  }
  // Default book icon
  return {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="white">
      <path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
    </svg>`,
    color: "var(--brand)" // Default theme color
  };
}

// Success stories data for reviews section
const successStories = [
  {
    name: "Sarah Johnson",
    role: "Web Developer",
    course: "Complete Web Development Bootcamp",
    rating: 5,
    review: "Thanks to CourseSpeak's Udemy coupons, I got access to premium web development courses for free. Now I'm working as a full-stack developer!",
    avatar: "/images/avatars/sarah-johnson.jpg"
  },
  {
    name: "Michael Chen",
    role: "Data Scientist",
    course: "Python for Data Science & Machine Learning",
    rating: 5,
    review: "The free Udemy coupons from CourseSpeak helped me transition from marketing to data science. Best investment in my career!",
    avatar: "/images/avatars/michael-chen.jpg"
  },
  {
    name: "Emily Rodriguez",
    role: "UX Designer",
    course: "UI/UX Design Masterclass",
    rating: 5,
    review: "I accessed premium design courses completely free through CourseSpeak. The quality and value exceeded my expectations!",
    avatar: "/images/avatars/emily-rodriguez.jpg"
  },
  {
    name: "David Kim",
    role: "Mobile Developer",
    course: "React Native Complete Course",
    rating: 5,
    review: "CourseSpeak's free coupons made it possible to learn mobile development without financial burden. Now I'm building apps for startups!",
    avatar: "/images/avatars/david-kim.jpg"
  },
  {
    name: "Lisa Thompson",
    role: "Digital Marketer",
    course: "Digital Marketing Complete Course",
    rating: 5,
    review: "Free Udemy courses from CourseSpeak helped me advance my marketing career. The course quality was exceptional!",
    avatar: "/images/avatars/lisa-thompson.jpg"
  },
  {
    name: "James Wilson",
    role: "DevOps Engineer",
    course: "Docker & Kubernetes Masterclass",
    rating: 5,
    review: "Thanks to CourseSpeak, I learned DevOps skills through free Udemy coupons and landed my dream job with a 40% salary increase!",
    avatar: "/images/avatars/james-wilson.jpg"
  }
];


// Featured Deals (e.g. top rated)
const featuredDeals = allDeals
  .filter((d) => d.rating && d.rating >= 4.5)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0))
  .slice(0, 3);

// Use first featured deal image for OG
const featuredImage = featuredDeals.length > 0 ? featuredDeals[0].image : "/og-image.jpg";

// JSON-LD Structured Data following Rahul Shetty Academy pattern with reviews
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://coursespeak.com/#organization",
      "name": "CourseSpeak",
      "url": "https://coursespeak.com",
      "logo": "https://coursespeak.com/logo.png",
      "description": "Transform your learning journey with exclusive free course coupons. 100K+ students accessing premium courses completely free.",
      "sameAs": [
        "https://x.com/courses_peak",
        "https://www.facebook.com/CourseSpeakOfficial",
        "https://www.linkedin.com/company/coursespeak/",
        "https://t.me/coursespeak"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+1-555-COURSE",
        "contactType": "customer service",
        "availableLanguage": "English"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": 4.9,
        "reviewCount": successStories.length,
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://coursespeak.com/#website",
      "url": "https://coursespeak.com",
      "name": "CourseSpeak",
      "description": "Master your skills with free course coupons. Premium Udemy, Coursera, and edX courses completely free. Daily updated verified coupons.",
      "publisher": {
        "@id": "https://coursespeak.com/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://coursespeak.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "EducationalOrganization",
      "@id": "https://coursespeak.com/#educational",
      "name": "CourseSpeak Learning Platform",
      "description": "Free access to premium online courses from top providers like Udemy, Coursera, and edX.",
      "url": "https://coursespeak.com",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Free Course Coupons",
        "itemListElement": allDeals.slice(0, 10).map((deal, index) => ({
          "@type": "Course",
          "position": index + 1,
          "name": deal.title,
          "description": deal.description,
          "provider": {
            "@type": "Organization",
            "name": deal.provider || "Udemy"
          },
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
            "validFrom": deal.createdAt,
            "priceValidUntil": deal.expiresAt,
            "description": "100% off - completely free course"
          },
          "aggregateRating": deal.rating ? {
            "@type": "AggregateRating",
            "ratingValue": deal.rating.toString(),
            "reviewCount": Math.max(1, Math.round(deal.students ?? 1000)),
            "bestRating": "5"
          } : undefined
        })).filter(Boolean)
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://coursespeak.com/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://coursespeak.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Free Course Coupons",
          "item": "https://coursespeak.com/deals"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Premium Courses",
          "item": "https://coursespeak.com/categories"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://coursespeak.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are your course coupons really 100% free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All our course coupons are completely free and provide 100% discount on premium courses from Udemy, Coursera, edX, and more. No hidden fees or charges."
          }
        },
        {
          "@type": "Question",
          "name": "How often do you update course coupons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We update our course coupon database daily with fresh deals and verified codes. New free courses added every day from top learning platforms."
          }
        },
        {
          "@type": "Question",
          "name": "Do course coupons expire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, course coupons have limited validity ranging from a few days to several weeks. We recommend using coupons as soon as possible to avoid missing out on free courses."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get certificates with free courses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely! Free courses obtained through our coupons include the same benefits as paid courses, including completion certificates, lifetime access, and all course materials."
          }
        }
      ]
    },
    ...successStories.map((story, index) => ({
      "@type": "Review",
      "@id": `https://coursespeak.com/#review-${index + 1}`,
      "itemReviewed": {
        "@type": "Course",
        "name": story.course,
        "provider": {
          "@type": "Organization",
          "name": "Udemy"
        }
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": story.rating.toString(),
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": story.name,
        "jobTitle": story.role
      },
      "reviewBody": story.review,
      "datePublished": new Date().toISOString()
    }))
  ]
};
---

<style>
.category-card:hover {
  background: #2d3348 !important;
  transform: translateY(-2px);
}
</style>

<Layout 
    title={pageTitle}
    description={pageDescription}
    image={featuredImage}
    canonical="https://coursespeak.com"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="hero-gradient" style={{ minHeight: "100vh", color: "var(--text)" }}>
    <main>
      {/* Hero Section - Following Rahul Shetty Academy Pattern */}
      <section
        class="hero-gradient"
        style={{
          position: "relative",
          padding: "8rem 1rem 4rem",
          textAlign: "center",
          overflow: "hidden",
        }}
      >
        <div class="container" style={{ position: "relative", zIndex: 10 }}>
          <div style={{
            display: "inline-flex",
            alignItems: "center",
            gap: "0.5rem",
            background: "var(--brand-soft)",
            padding: "0.5rem 1rem",
            borderRadius: "9999px",
            marginBottom: "2rem",
            fontSize: "0.9rem",
            color: "var(--brand)",
            fontWeight: 600
          }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Trusted by 100,000+ Learners Worldwide
          </div>
          
          <h1
            style={{
              fontSize: "clamp(2.5rem, 5vw, 4rem)",
              fontWeight: 800,
              lineHeight: 1.1,
              marginBottom: "1.5rem",
              maxWidth: "1200px",
              margin: "0 auto 1.5rem"
            }}
          >
            <span style={{
              background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              backgroundClip: "text"
            }}>
              100% Off Udemy Coupons
            </span>
            <br/>
            <span style={{
              background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              backgroundClip: "text"
            }}>
              Free Premium Udemy Courses
            </span>
          </h1>
          <p
            style={{
              fontSize: "clamp(1.1rem, 2.5vw, 1.4rem)",
              color: "var(--muted)",
              maxWidth: "700px",
              margin: "0 auto 3rem",
              lineHeight: 1.6,
              fontWeight: 400
            }}
          >
            Get verified 100% off Udemy coupons and free Udemy courses updated daily. 
            Access premium Udemy programming, web development, data science, and marketing courses completely free.
          </p>

          {/* CTA Buttons */}
          <div style={{
            display: "flex",
            gap: "1rem",
            justifyContent: "center",
            flexWrap: "wrap",
            marginBottom: "3rem"
          }}>
            <a
              href="/deals"
              class="btn accent-gradient"
              style={{
                padding: "1rem 2rem",
                fontSize: "1.1rem",
                fontWeight: 600,
                textDecoration: "none",
                borderRadius: "12px",
                display: "inline-flex",
                alignItems: "center",
                gap: "0.5rem",
                boxShadow: "0 8px 30px -4px hsla(45, 95%, 58%, 0.3)"
              }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              Browse Udemy Coupons
            </a>
            <a
              href="/categories"
              style={{
                padding: "1rem 2rem",
                fontSize: "1.1rem",
                fontWeight: 600,
                textDecoration: "none",
                borderRadius: "12px",
                background: "transparent",
                color: "var(--text)",
                border: "2px solid var(--border)",
                display: "inline-flex",
                alignItems: "center",
                gap: "0.5rem",
                transition: "all 0.3s ease"
              }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
              </svg>
              Explore Categories
            </a>
          </div>

          {/* Learning Platforms */}
          <div style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: "2rem",
            flexWrap: "wrap",
            opacity: 0.8
          }}>
            <span style={{ color: "var(--muted)", fontSize: "0.9rem" }}>Udemy Courses:</span>
            <div style={{ display: "flex", gap: "2rem", alignItems: "center" }}>
              <span style={{ color: "var(--text)", fontWeight: 600 }}>Programming</span>
              <span style={{ color: "var(--text)", fontWeight: 600 }}>Web Development</span>
              <span style={{ color: "var(--text)", fontWeight: 600 }}>Data Science</span>
              <span style={{ color: "var(--text)", fontWeight: 600 }}>Marketing</span>
            </div>
          </div>
        </div>

        {/* Decorative elements with brand colors */}
        <div
          style={{
            position: "absolute",
            top: "20%",
            left: "10%",
            width: "300px",
            height: "300px",
            background: "var(--brand)",
            filter: "blur(120px)",
            opacity: 0.1,
            borderRadius: "50%",
          }}
        />
        <div
          style={{
            position: "absolute",
            bottom: "10%",
            right: "10%",
            width: "250px",
            height: "250px",
            background: "var(--accent)",
            filter: "blur(100px)",
            opacity: 0.1,
            borderRadius: "50%",
          }}
        />
      </section>

      
      {/* Featured Section */}
      {
        featuredDeals.length > 0 && (
          <section
            class="container"
            style={{ padding: "2rem 1rem", marginBottom: "2rem" }}
          >
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "end",
                marginBottom: "1.5rem",
              }}
            >
              <div>
                <h2
                  style={{ fontSize: "1.75rem", fontWeight: 700 }}
                >
                  <span style={{ color: "var(--brand)" }}>Featured</span> Udemy Courses
                </h2>
                <p
                  style={{
                    color: "var(--muted)",
                    fontSize: "1.1rem",
                    marginBottom: "1rem",
                    lineHeight: 1.6
                  }}
                >
                  Handpicked premium Udemy courses with the highest ratings, featuring expert instructors and comprehensive content for skill development.
                </p>
                <a
                  href="/deals"
                  style={{
                    color: "#3b82f6",
                    textDecoration: "none",
                    fontWeight: 600,
                  }}
                >
                  View all &rarr;
                </a>
              </div>
            </div>
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fill, minmax(280px, 1fr))",
                gap: "2rem",
              }}
            >
              {featuredDeals.map((deal) => (
                <DealCard deal={deal} />
              ))}
            </div>
          </section>
        )
