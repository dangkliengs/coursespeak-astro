---
import Layout from "../layouts/Layout.astro";

const canonicalUrl = "https://coursespeak.com/about";
const pageTitle = "About CourseSpeak — Free Udemy Coupons & Verified Deals";
const pageDescription = "CourseSpeak makes quality education accessible with verified free Udemy coupons and 100% off courses. Learn our mission, verification process and team.";
const lastModified = new Date().toISOString().split('T')[0];
---
<Layout title={pageTitle} description={pageDescription} type="article" canonical={canonicalUrl}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AboutPage",
        "@id": `${canonicalUrl}#about`,
        "url": canonicalUrl,
        "name": "About CourseSpeak - Free Udemy Coupons Platform",
        "description": pageDescription,
        "inLanguage": "en-US",
        "dateModified": lastModified,
        "mainEntity": { "@type": "Organization", "@id": "https://coursespeak.com/#organization", "name": "CourseSpeak", "url": "https://coursespeak.com" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "What makes CourseSpeak different?", "acceptedAnswer": { "@type": "Answer", "text": "CourseSpeak offers 100% verified free Udemy coupons that are personally tested before publishing. We focus on premium quality courses from reputable instructors, update daily, and maintain a 4.5 star minimum standard." } },
          { "@type": "Question", "name": "Is CourseSpeak free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. CourseSpeak is completely free to use. All coupons, deals and recommendations cost nothing, and our affiliate relationships do not influence which courses we feature." } },
          { "@type": "Question", "name": "How are coupons verified?", "acceptedAnswer": { "@type": "Answer", "text": "Every coupon is redeemed end-to-end against Udemy before publishing. Expired or abuse-prone codes are removed within hours, keeping our Udemy coupons guide accurate." } }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://coursespeak.com" },
          { "@type": "ListItem", "position": 2, "name": "About", "item": canonicalUrl }
        ]
      }
    ]
  })} />

  <div style="min-height:100vh;color:var(--text);">
    <section style={{ padding:"4rem 1rem 2rem",textAlign:"center" }}>
      <div style={{ maxWidth:"1100px",margin:"0 auto" }}>
        <div style={{ display:"inline-flex",alignItems:"center",gap:"0.5rem",background:"rgba(212,167,55,0.1)",padding:"0.35rem 0.85rem",borderRadius:"20px",marginBottom:"0.75rem",fontSize:"0.75rem",fontWeight:700,color:"var(--brand)",textTransform:"uppercase",letterSpacing:"0.06em" }}>
          Our Story & Mission
        </div>
        <h1 style={{ fontSize:"clamp(1.8rem,4.5vw,2.8rem)",fontWeight:800,lineHeight:1.2,margin:"0 auto 0.75rem" }}>
          <span style={{ background:"linear-gradient(135deg,var(--brand) 0%,hsl(35,90%,68%) 100%)",WebkitBackgroundClip:"text",WebkitTextFillColor:"transparent",backgroundClip:"text" }}>About CourseSpeak</span>
          <br />
          <span style={{ color:"var(--text)" }}>Making Education Accessible for Everyone</span>
        </h1>
        <p style={{ color:"var(--muted)",fontSize:"1rem",maxWidth:"720px",margin:"0 auto 1.5rem",lineHeight:1.6 }}>
          Founded in 2023, CourseSpeak helps <strong style={{ color:"var(--text)" }}>150K+ learners</strong> access premium online courses for free through verified Udemy coupons. Our mission is simple: remove financial barriers so anyone, anywhere can learn from the best.
        </p>
        <img src="/images/about-coursespeak.png" alt="About CourseSpeak mission graphic showing free Udemy coupons and verified deals" width="1200" height="600" loading="eager" decoding="async" style={{ width:"100%",height:"auto",maxWidth:"900px",borderRadius:"14px",border:"1px solid var(--border)",margin:"1.5rem auto 0",display:"block" }} />
        <div style={{ display:"flex",gap:"1rem",justifyContent:"center",flexWrap:"wrap",marginTop:"1.5rem" }}>
          <a href="/deals" style={{ padding:"0.85rem 2rem",borderRadius:"10px",background:"var(--brand)",color:"var(--bg)",textDecoration:"none",fontSize:"1rem",fontWeight:700,display:"inline-flex",alignItems:"center",gap:"0.5rem" }}>
            Browse Free Courses →
          </a>
          <a href="/udemy-coupons-guide" style={{ padding:"0.85rem 2rem",borderRadius:"10px",color:"var(--text)",textDecoration:"none",fontSize:"1rem",fontWeight:700,display:"inline-flex",alignItems:"center",gap:"0.5rem",border:"2px solid var(--border)",background:"transparent" }}>
            Read the Coupon Guide
          </a>
        </div>
      </div>
    </section>

    <article aria-label="About CourseSpeak" style="padding:3rem 1rem 4rem;">
      <div class="pp-grid">
        <main class="article-body">
          <section id="mission" style="margin-bottom:3rem;">
            <h2 class="section-heading">Our mission & values</h2>
            <p>
              CourseSpeak exists to democratize education. Quality learning should never depend on a wallet, and we remove financial barriers so cost is never a reason to stop learning. That core belief drives every free deal we publish and shapes how we choose which <a href="/udemy-coupons-guide" style={{ color:"var(--brand)", textDecoration:"underline" }}>Udemy coupons</a> are worth your time.
            </p>
            <h3 style={{ color:"var(--text)",fontSize:"1.05rem",fontWeight:700,margin:"1rem 0 0.4rem" }}>Democratize education</h3>
            <p>Everyone deserves access to quality education regardless of financial situation. We break down barriers so cost is never the reason someone stops learning, whether they are a student, career switcher, or working professional browsing course categories.</p>
            <h3 style={{ color:"var(--text)",fontSize:"1.05rem",fontWeight:700,margin:"1rem 0 0.4rem" }}>Quality first</h3>
            <p>We curate only high-quality courses from reputable instructors. Every coupon is tested and verified, and we reject stale or abandoned courses. Learn the full method in our Udemy coupons guide.</p>
            <h3 style={{ color:"var(--text)",fontSize:"1.05rem",fontWeight:700,margin:"1rem 0 0.4rem" }}>Community focused</h3>
            <p>150K+ learners across 180+ countries. Their wins inspire others to pursue goals without financial barriers; read real examples on our <a href="/success-stories" style={{ color:"var(--brand)", textDecoration:"underline" }}>success stories</a> page.</p>
          </section>

          <section id="numbers" style="margin-bottom:3rem;">
            <h2 class="section-heading">CourseSpeak by the numbers</h2>
            <p>
              These figures reflect the trust our community places in CourseSpeak as a source of verified free Udemy coupons and quality course deals. Each number is revisited daily as new deals are verified.
            </p>
            <p><strong>150K+ happy learners</strong> have found free courses through CourseSpeak, while <strong>50K+ free courses</strong> have been featured with coupons updated around the clock. The platform serves <strong>180+ countries</strong> and maintains a <strong>4.8★ average rating</strong>, reflecting the <strong>100% verified coupon</strong> standard we hold on every listing.</p>
          </section>

          <section id="verify" style="margin-bottom:3rem;">
            <h2 class="section-heading">How CourseSpeak verifies coupons</h2>
            <p>
              Every coupon code on CourseSpeak is checked against Udemy automatically. Expired coupons disappear, new ones appear, and the list stays accurate in near real time so visitors only ever see working deals.
            </p>
            <p><strong>Live coupon checking.</strong> We verify each code end-to-end before publishing and purge dead codes within hours, which is what keeps our coupon guide accurate rather than misleading.</p>
            <p><strong>Trusted and transparent.</strong> We disclose affiliate relationships clearly and recommend courses based on real-time availability, not commissions. Read the full affiliate disclosure for details.</p>
          </section>

          <section id="standards" style="margin-bottom:3rem;">
            <h2 class="section-heading">Editorial standards</h2>
            <p>
              Before any free Udemy deal is published it must pass a quality gate. We inspect instructor reputation, course quality (4.5★+ only), recent content updates, and redeem every coupon end-to-end. Stale or abandoned courses are rejected, including borderline materials referenced in our Udemy Personal Plan review.
            </p>
            <p><strong>Instructor reputation.</strong> We feature instructors with proven, highly-rated catalogs rather than unknown or low-effort publishers, so the courses you find offer genuine expertise.</p>
            <p><strong>Course quality (4.5★+).</strong> Only well-structured, updated courses make the cut. This rejects stale or abandoned courses and keeps recommendations trustworthy.</p>
            <p><strong>Coupon verification.</strong> Every code is redeemed before publishing and expired codes are purged within hours.</p>
            <p><strong>Community impact.</strong> We track outcomes like career switches and upskilling wins, some of which are shared on our success stories page, alongside data from coupon research.</p>
          </section>

          <section id="journey" style="margin-bottom:3rem;">
            <h2 class="section-heading">Our journey</h2>
            <p>CourseSpeak's growth tracks the rising demand for accessible education. Each milestone reflects more learners discovering free Udemy coupons and turning them into career moves.</p>
            <p><strong>2023.</strong> Launched with a hand-curated list of verified free Udemy coupons and a mission to remove paywalls for every learner.</p>
            <p><strong>2024.</strong> Crossed 100K learners, introduced automated coupon verification and added category-level filters across categories.</p>
            <p><strong>2025.</strong> Scaled to 50K+ featured courses, added a verification engine and expanded platform comparisons.</p>
            <p><strong>2026.</strong> 150K+ learners across 180+ countries with daily updates and a public success stories hub.</p>
          </section>

          <section id="outcomes" style="margin-bottom:3rem;">
            <h2 class="section-heading">Real outcomes from free learning</h2>
            <p>These representative cases show how verified coupon access plus disciplined study converts into career moves. Compare paths via our Udemy Personal Plan review when paid depth is needed, and learn redemption via how to redeem a coupon.</p>
            <p><strong>Career switcher.</strong> A marketing analyst used free Python and data-science courses to transition into analytics, staying on track by browsing course categories.</p>
            <p><strong>Upskilling professional.</strong> A developer stacked AWS and Kubernetes courses for certification prep, then evaluated the <a href="/udemy-personal-plan" style={{ color:"var(--brand)", textDecoration:"underline" }}>Personal Plan</a> for lab access.</p>
            <p><strong>Budget-constrained learner.</strong> A student completed an entire programming track using only 100% off coupons from free deals, saving hundreds of dollars without sacrificing quality.</p>
          </section>

          <section id="author" style="margin-bottom:3rem;">
            <h2 class="section-heading">About the author</h2>
            <p>
              <strong>Josh Smith</strong> is a Udemy coupon specialist with 8+ years of experience finding and verifying the best deals. He has helped thousands of students save on premium courses through carefully curated coupon codes. His mission: making high-quality education accessible and affordable for everyone. Connect on <a href="https://www.linkedin.com/in/anandayuda/" target="_blank" rel="noopener noreferrer" style={{ color:"var(--brand)", textDecoration:"underline" }}>LinkedIn</a>, <a href="https://x.com/courses_peak" target="_blank" rel="noopener noreferrer" style={{ color:"var(--brand)", textDecoration:"underline" }}>X</a> or <a href="https://www.facebook.com/CourseSpeakOfficial/" target="_blank" rel="noopener noreferrer" style={{ color:"var(--brand)", textDecoration:"underline" }}>Facebook</a>.
            </p>
          </section>

          <section id="faq" style="margin-bottom:2rem;">
            <h2 class="section-heading">Frequently asked questions</h2>
            <p><strong>What makes CourseSpeak different?</strong> 100% verified coupons, daily updates, premium-quality filtering (4.5★+ courses only) and a community of 150K+ learners. Every coupon is tested before publishing.</p>
            <p><strong>Is CourseSpeak really free?</strong> Yes. CourseSpeak is completely free, and affiliate relationships never influence which courses we feature. Read the full <a href="/affiliate-disclosure" style={{ color:"var(--brand)", textDecoration:"underline" }}>affiliate disclosure</a>.</p>
            <p><strong>How often are new deals added?</strong> Fresh coupons are added every day, with 50K+ courses featured and deals refreshed throughout the year.</p>
            <p><strong>Do free courses include certificates?</strong> Yes. Most featured free courses include completion certificates and lifetime access to premium features.</p>
            <p><strong>How are coupons verified?</strong> Every coupon is redeemed end-to-end before publishing; expired or abuse-prone codes are purged within hours.</p>
          </section>

          <div style={{ background:"var(--card)",border:"1px solid var(--border)",borderRadius:"12px",padding:"2rem",textAlign:"center",marginTop:"2rem" }}>
            <h2 style={{ fontSize:"1.3rem",fontWeight:800,color:"var(--text)",marginBottom:"0.5rem" }}>Ready to start learning?</h2>
            <p style={{ color:"var(--muted)",fontSize:"0.9rem",marginBottom:"1.5rem",maxWidth:"480px",margin:"0 auto 1.5rem",lineHeight:1.6 }}>Join 150K+ learners who transformed their careers with free premium courses from CourseSpeak.</p>
            <div style={{ display:"flex",gap:"0.75rem",justifyContent:"center",flexWrap:"wrap" }}>
              <a href="/deals" style={{ display:"inline-flex",alignItems:"center",gap:"0.5rem",padding:"0.75rem 1.75rem",background:"var(--brand)",color:"var(--bg)",textDecoration:"none",borderRadius:"8px",fontWeight:700,fontSize:"0.9rem" }}>Browse Free Courses</a>
              <a href="/platforms" style={{ display:"inline-flex",alignItems:"center",gap:"0.5rem",padding:"0.75rem 1.75rem",color:"var(--text)",textDecoration:"none",borderRadius:"8px",fontWeight:700,fontSize:"0.9rem",border:"2px solid var(--border)" }}>Compare Platforms</a>
            </div>
          </div>
</main>
        <aside class="pp-sidebar">
          <div class="pp-toc">
            <h4>On this page</h4>
            <ol>
              {[
                ["#mission","Mission & values"],
                ["#numbers","By the numbers"],
                ["#verify","Verification"],
                ["#standards","Editorial standards"],
                ["#journey","Our journey"],
                ["#outcomes","Real outcomes"],
                ["#author","Author"],
                ["#faq","FAQ"],
              ].map(([h,l])=>(<li><a href={h}>{l}</a></li>))}
            </ol>
          </div>
          <div class="pp-cta">
            <p>Find verified free Udemy coupons updated daily.</p>
            <a href="/deals">Browse Deals →</a>
          </div>
          <div class="pp-trust">
            <span>✓ 100% verified</span>
            <span>✓ Free forever</span>
            <span>✓ Daily updates</span>
          </div>
        </aside>
      </div>
    </article>
  </div>

  <style>
    .container { max-width:1200px; margin:0 auto; }
    .pp-grid { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:2.5rem; max-width:1200px; margin:0 auto; align-items:start; }
    .pp-sidebar { position:sticky; top:88px; display:flex; flex-direction:column; gap:1rem; }
    .pp-toc { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1rem 1.1rem; }
    .pp-toc h4 { margin:0 0 0.6rem; font-size:0.9rem; font-weight:800; color:var(--text); }
    .pp-toc ol { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.3rem; }
    .pp-toc a { font-size:0.82rem; color:var(--brand); text-decoration:none; }
    .pp-cta { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1rem 1.1rem; text-align:center; }
    .pp-cta p { font-size:0.8rem; color:var(--muted); margin:0 0 0.75rem; line-height:1.5; }
    .pp-cta a { display:inline-block; background:var(--brand); color:var(--bg); text-decoration:none; font-weight:700; font-size:0.85rem; padding:0.6rem 1.2rem; border-radius:8px; }
    .pp-trust { display:flex; flex-direction:column; gap:0.35rem; font-size:0.75rem; color:var(--muted); }
    .article-body { font-size:0.95rem; line-height:1.75; color:var(--muted); }
    .article-body p { margin-bottom:1rem; }
    .article-body p:last-child { margin-bottom:0; }
    .article-body ul, .article-body ol { padding-left:1.5rem; margin-bottom:1.25rem; }
    .article-body li { margin-bottom:0.5rem; }
    .article-body strong { color:var(--text); }
    .article-body a { color:var(--brand); text-decoration:underline; }
    .section-heading { font-size:clamp(1.2rem,2.5vw,1.5rem); font-weight:800; color:var(--text); margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border); }
    @media (max-width:960px) { .pp-grid { grid-template-columns:1fr; } .pp-sidebar { position:static; order:-1; } }
    @media (max-width:640px) { .container { padding:0 0.75rem; } }
  </style>

</Layout>
---