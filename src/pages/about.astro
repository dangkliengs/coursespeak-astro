---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="About CourseSpeak: Free Udemy Coupons"
    description="Discover CourseSpeak: Your trusted source for verified free Udemy coupons and 100% off online courses. Join + learners accessing premium education without cost."
    image="https://coursespeak.com/logo.svg"
    canonical="https://coursespeak.com/about"
>
    <!-- About Page Enhanced Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "AboutPage",
          "@id": "https://coursespeak.com/about",
          "url": "https://coursespeak.com/about",
          "name": "About CourseSpeak - Free Udemy Coupons Platform",
          "description": "Learn about CourseSpeak's mission to make quality education accessible through verified 100% off Udemy coupons. Helping 150K+ learners access premium courses for free.",
          "isPartOf": {
            "@id": "https://coursespeak.com"
          },
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://coursespeak.com/logo.svg"
          },
          "datePublished": "2023-01-01",
          "dateModified": "2026-05-24",
          "inLanguage": "en-US",
          "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://coursespeak.com"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "About",
                "item": "https://coursespeak.com/about"
              }
            ]
          },
          "mainEntity": {
            "@type": "Organization",
            "name": "CourseSpeak",
            "description": "Online learning platform providing free Udemy course coupons and discounts",
            "foundingDate": "2023",
            "mission": "To make quality education accessible and affordable for everyone through verified coupon codes",
            "author": {
              "@type": "Person",
              "name": "CourseSpeak Team",
              "jobTitle": "Founder & Education Advocate",
              "description": "Passionate about democratizing education and removing financial barriers to quality learning"
            }
          }
        },
        {
          "@type": "Organization",
          "@id": "https://coursespeak.com/#organization",
          "name": "CourseSpeak",
          "url": "https://coursespeak.com",
          "logo": "https://coursespeak.com/logo.svg",
          "description": "Free Udemy coupons platform helping learners access premium courses for free",
          "foundingDate": "2023",
          "numberOfEmployees": "1-10",
          "areaServed": "Worldwide",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer Support",
            "url": "https://coursespeak.com/contact"
          },
          "sameAs": [
            "https://x.com/courses_peak",
            "https://www.facebook.com/CourseSpeakOfficial/"
          ],
          "knowsAbout": ["Udemy Coupons", "Online Education", "Free Courses", "Course Discounts", "Educational Technology"],
          "founder": {
            "@type": "Person",
            "name": "CourseSpeak Team",
            "description": "Education Advocate & Platform Creator"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://coursespeak.com/#website",
          "url": "https://coursespeak.com",
          "name": "CourseSpeak",
          "description": "Free Udemy coupons and premium courses for learners worldwide",
          "publisher": {
            "@id": "https://coursespeak.com/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://coursespeak.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Article",
          "@id": "https://coursespeak.com/about#article",
          "headline": "About CourseSpeak - How We're Democratizing Online Education",
          "alternativeHeadline": "Free Udemy Coupons & Premium Courses for 150K+ Learners",
          "description": "Learn how CourseSpeak helps 150K+ students access premium Udemy courses for free with verified coupons. Discover our mission, team, and why educators choose us.",
          "image": "https://coursespeak.com/logo.svg",
          "datePublished": "2023-01-01",
          "dateModified": "2026-05-24",
          "author": {
            "@type": "Person",
            "name": "Josh Smith",
            "jobTitle": "Lead Course Reviewer",
            "url": "https://coursespeak.com/about",
            "sameAs": ["https://x.com/courses_peak", "https://www.facebook.com/CourseSpeakOfficial/"]
          },
          "publisher": {
            "@id": "https://coursespeak.com/#organization"
          },
          "articleBody": "CourseSpeak is a platform dedicated to making quality education accessible to everyone. Founded in 2023, we provide verified 100% off Udemy coupons and free course deals from top learning platforms worldwide. Our mission is to democratize education and remove financial barriers to premium learning. With 150K+ happy learners and 50K+ free courses, we've established ourselves as the most trusted coupon platform. Our team, led by reviewer Josh Smith, meticulously vets every course to ensure only the best educational content reaches our community.",
          "wordCount": 2000,
          "inLanguage": "en-US",
          "isAccessibleForFree": true,
          "isPartOf": {
            "@id": "https://coursespeak.com/#website"
          },
          "mainEntity": {
            "@id": "https://coursespeak.com/#organization"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What makes CourseSpeak different from other coupon sites?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "CourseSpeak offers 100% verified coupons that are tested before sharing. We focus on premium quality courses from reputable instructors with daily updates and lifetime access to all free courses. Our Lead Reviewer Josh Smith personally curates every course to ensure 4.5★+ quality standards."
              }
            },
            {
              "@type": "Question",
              "name": "Is CourseSpeak really free?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, CourseSpeak is completely free to use. We provide verified free course deals and 100% off Udemy coupons at no cost to our users. Our platform, coupons, and recommendations are all free."
              }
            },
            {
              "@type": "Question",
              "name": "How often are new deals added?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We add fresh coupons and deals every single day, 24/7. Our team continuously searches and verifies new opportunities for our community. On average we add 50+ new deals daily."
              }
            },
            {
              "@type": "Question",
              "name": "Do free courses include certificates?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, most of our featured free courses include completion certificates. When you enroll through our verified coupons, you get lifetime access to the course material, completion certificate, and all premium features."
              }
            },
            {
              "@type": "Question",
              "name": "How do you choose which courses to feature?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every course featured on CourseSpeak goes through rigorous review. We only feature courses with 4.5★+ ratings, reputable instructors, comprehensive content, and proven student satisfaction. Quality over quantity is our priority."
              }
            },
            {
              "@type": "Question",
              "name": "How are coupons verified on CourseSpeak?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every coupon code is personally tested before publishing to ensure it works. We check expiration dates, discount amounts, and course availability. We remove expired coupons immediately and update daily. This 100% verification guarantee sets us apart."
              }
            },
            {
              "@type": "Question",
              "name": "Is CourseSpeak affiliated with Udemy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "While we're not officially affiliated with Udemy, we are an independent platform that helps learners find verified discounts and free courses on Udemy and other platforms. We maintain ethical standards and always provide authentic, working coupons."
              }
            },
            {
              "@type": "Question",
              "name": "How can I trust CourseSpeak coupons?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every coupon on CourseSpeak is 100% verified and tested by our team. We check each code before publishing and remove expired ones immediately. With 150K+ satisfied learners, we've built a trusted reputation in the community."
              }
            }
          ]
        }
      ]
    }
    </script>
  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO ── */}
    <section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Our Story & Mission
        </div>
        <h1 style={{ fontSize: "clamp(1.8rem, 4.5vw, 2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>About CourseSpeak</span>
          <br />
          <span style={{ color: "var(--text)" }}>Making Education Accessible for Everyone</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "650px", margin: "0 auto 0.5rem", lineHeight: 1.6 }}>
          Founded in 2023, CourseSpeak helps <strong style={{ color: "var(--text)" }}>150K+ learners</strong> access premium online courses for free through verified Udemy coupons. We remove financial barriers so anyone, anywhere can learn from the best.
        </p>
      </div>
    </section>

    {/* ── STATS GRID ── */}
    <section style={{ paddingBottom: "2rem", marginTop: "0.5rem" }}>
      <div class="container">
        <div class="stat-grid" style={{ gridTemplateColumns: "repeat(4,1fr)", maxWidth: "850px" }}>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              150K+
            </div>
            <div class="stat-label">Happy Learners</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              50K+
            </div>
            <div class="stat-label">Free Courses</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              24/7
            </div>
            <div class="stat-label">Daily Updates</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              4.8★
            </div>
            <div class="stat-label">Avg Rating</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── MISSION & VALUES ── */}
    <section style={{ padding: "4rem 1rem", background: "var(--bg)" }}>
      <div class="container" style={{ maxWidth: "1280px" }}>
        <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            What We Stand For
          </div>
          <h2 style={{ fontSize: "clamp(1.5rem, 4vw, 2rem)", fontWeight: 800, color: "var(--text)", marginBottom: "0.75rem" }}>Our Mission & Values</h2>
          <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "600px", margin: "0 auto", lineHeight: 1.6 }}>What drives us to make quality education accessible for everyone.</p>
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(320px, 1fr))", gap: "1.5rem" }}>
          <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "2rem" }}>
            <h3 style={{ color: "var(--brand)", fontSize: "1.15rem", marginBottom: "0.75rem", fontWeight: 700, display: "flex", alignItems: "center", gap: "0.5rem" }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Democratize Education
            </h3>
            <p style={{ color: "var(--muted)", lineHeight: 1.7, fontSize: "0.9rem", margin: 0 }}>Everyone deserves access to quality education regardless of financial situation. We break down barriers so cost is never a reason to stop learning.</p>
          </div>
          <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "2rem" }}>
            <h3 style={{ color: "var(--accent)", fontSize: "1.15rem", marginBottom: "0.75rem", fontWeight: 700, display: "flex", alignItems: "center", gap: "0.5rem" }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Quality First
            </h3>
            <p style={{ color: "var(--muted)", lineHeight: 1.7, fontSize: "0.9rem", margin: 0 }}>We curate only high-quality courses from reputable instructors. Every coupon is tested and verified to ensure real value — no junk courses.</p>
          </div>
          <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "2rem" }}>
            <h3 style={{ color: "hsl(180, 50%, 40%)", fontSize: "1.15rem", marginBottom: "0.75rem", fontWeight: 700, display: "flex", alignItems: "center", gap: "0.5rem" }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="hsl(180, 50%, 40%)"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              Community Focused
            </h3>
            <p style={{ color: "var(--muted)", lineHeight: 1.7, fontSize: "0.9rem", margin: 0 }}>We're building a global community of 150K+ learners. Every success story inspires others to pursue their educational goals without financial barriers.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── HOW COURSEPEAK VERIFIES — SEO ── */}
    <section style={{ padding: "4rem 1rem", background: "linear-gradient(135deg, rgba(212,167,55,0.03) 0%, transparent 100%)" }}>
      <div class="container" style={{ maxWidth: "1280px" }}>
        <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "1rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Real-Time Verification
          </div>
          <h2 style={{ fontSize: "clamp(1.5rem, 4vw, 2rem)", fontWeight: 800, color: "var(--text)", marginBottom: "0.75rem" }}>How CourseSpeak verifies coupons</h2>
          <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "700px", margin: "0 auto", lineHeight: 1.6 }}>
            Every coupon on CourseSpeak is checked against Udemy automatically. Expired coupons disappear, new ones appear — all in near real time.
          </p>
        </div>
        <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "2rem" }}>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))", gap: "1.5rem" }}>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: "0.5rem", marginBottom: "0.5rem" }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--brand)"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14" stroke="white" stroke-width="1.5"/></svg>
                <span style={{ fontWeight: 700, fontSize: "0.95rem", color: "var(--text)" }}>Live Coupon Checking</span>
              </div>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: 0 }}>
                CourseSpeak checks every coupon against Udemy in near real time. When a coupon runs out, it disappears automatically. New coupons are added throughout the day.
              </p>
            </div>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: "0.5rem", marginBottom: "0.5rem" }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--brand)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span style={{ fontWeight: 700, fontSize: "0.95rem", color: "var(--text)" }}>Trusted & Transparent</span>
              </div>
              <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.6, margin: 0 }}>
                CourseSpeak is committed to full transparency. Every coupon is verified against Udemy before listing, and we clearly disclose our affiliate relationships. Our recommendations are based on real-time availability, not commissions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── AUTHOR ── */}
    <section style={{ padding: "3rem 1.5rem", maxWidth: "900px", margin: "0 auto" }}>
      <div style={{ textAlign: "center", marginBottom: "1.5rem" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          About the Author
        </div>
        <h2 style={{ fontSize: "clamp(1.3rem, 3vw, 1.8rem)", fontWeight: 800, color: "var(--text)", margin: "0 0 0.5rem" }}>Josh Smith</h2>
        <p style={{ color: "var(--muted)", fontSize: "1rem", lineHeight: 1.6 }}>Udemy coupon specialist ensuring only the best courses make it to CourseSpeak.</p>
      </div>
      <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "1.5rem" }}>
        <div style={{ display: "flex", alignItems: "center", gap: "1.5rem", flexWrap: "wrap" }}>
          <div style={{ width: "80px", height: "80px", borderRadius: "50%", flexShrink: 0, overflow: "hidden", border: "3px solid var(--brand)" }}>
            <img src="/images/author.jpg" alt="Josh Smith - Udemy Coupon Expert" style={{ width: "100%", height: "100%", objectFit: "cover" }} loading="lazy" />
          </div>
          <div style={{ flex: 1, minWidth: "280px" }}>
            <p style={{ fontSize: "0.9rem", color: "var(--muted)", lineHeight: 1.6, margin: "0 0 0.75rem" }}>Udemy coupon specialist with 8+ years of experience finding and verifying the best deals. I've helped thousands of students save thousands of dollars on premium courses through carefully curated coupon codes. My mission is making high-quality education accessible and affordable for everyone.</p>
            <div style={{ display: "flex", alignItems: "center", gap: "1rem", flexWrap: "wrap" }}>
              <span style={{ display: "flex", alignItems: "center", gap: "0.35rem", fontSize: "0.8rem", color: "var(--muted)", fontWeight: 600 }}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--brand)"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                4.8/5 Avg
              </span>
              <span style={{ display: "flex", alignItems: "center", gap: "0.35rem", fontSize: "0.8rem", color: "var(--muted)", fontWeight: 600 }}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--brand)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Trusted by 2M+ Students
              </span>
            </div>
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: "0.4rem" }}>
            <a href="https://www.linkedin.com/in/anandayuda/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style={{ display: "flex", alignItems: "center", justifyContent: "center", width: "36px", height: "36px", borderRadius: "8px", background: "linear-gradient(135deg,#0077b5,#005885)", border: "1px solid #0077b5", textDecoration: "none" }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
