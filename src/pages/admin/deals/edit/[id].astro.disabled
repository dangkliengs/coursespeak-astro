---
import AdminShell from "../../../../components/admin/AdminShell.astro";
import DealForm from "../../../../components/admin/DealForm.astro";
import { getDealById } from "../../../../lib/store";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return new Response("ID parameter missing", { status: 400 });
}

const deal = await getDealById(id);
---

{deal ? (
  <AdminShell title="Edit Deal" badge={`ID: ${deal.id}`} desc={`Edit "${deal.title}"`} parent="Deals" parentHref="/admin/deals">
    <DealForm deal={deal} />
  </AdminShell>
) : (
  <AdminShell title="Deal Not Found" badge="404" parent="Deals" parentHref="/admin/deals">
    <div class="adm-card adm-empty">
      <p style="font-size:1.05rem;color:var(--adm-text);margin-bottom:.4rem;">No deal found for <strong>"{id}"</strong>.</p>
      <p style="margin:0 0 1.25rem;color:var(--adm-muted);">It may have been deleted, or the ID is wrong.</p>
      <a class="adm-btn adm-btn-primary" href="/admin/deals">Back to Deals</a>
    </div>
  </AdminShell>
)}
