      <script>
        // Tab switching functionality
        function showTab(tabName: string) {
          // Hide all tab contents
          const tabContents = ['basicTabContent', 'contentTabContent', 'pricingTabContent', 'seoTabContent', 'settingsTabContent'];
          tabContents.forEach(contentId => {
            const element = document.getElementById(contentId);
            if (element) element.style.display = 'none';
          });

          // Remove active class from all tabs
          const tabs = ['basicTab', 'contentTab', 'pricingTab', 'seoTab', 'settingsTab'];
          tabs.forEach(tabId => {
            const element = document.getElementById(tabId);
            if (element) {
              element.style.background = 'transparent';
              element.style.color = '#94a3b8';
              element.style.borderColor = 'transparent';
              element.style.boxShadow = 'none';
            }
          });

          // Show selected tab content
          const selectedContent = document.getElementById(tabName + 'TabContent');
          if (selectedContent) selectedContent.style.display = 'block';

          // Highlight selected tab
          const selectedTab = document.getElementById(tabName + 'Tab');
          if (selectedTab) {
            selectedTab.style.background = 'rgba(96, 165, 250, 0.1)';
            selectedTab.style.color = '#60a5fa';
            selectedTab.style.borderColor = 'rgba(96, 165, 250, 0.3)';
            selectedTab.style.boxShadow = '0 2px 8px rgba(96, 165, 250, 0.15)';
          }
        }

        // Rich text editor functions with keyboard shortcuts
        function formatText(command: string) {
          document.execCommand(command, false, undefined);
          const editor = document.getElementById('contentEditor');
          if (editor) {
            editor.focus();
            updateContentField();
          }
        }

        function insertLink() {
          const url = prompt('Enter the URL:');
          if (url) {
            document.execCommand('createLink', false, url);
            const editor = document.getElementById('contentEditor');
            if (editor) {
              editor.focus();
              updateContentField();
            }
          }
        }

        function updateContentField() {
          const editor = document.getElementById('contentEditor') as HTMLElement;
          const hiddenField = document.getElementById('contentField') as HTMLInputElement;
          if (editor && hiddenField) {
            hiddenField.value = editor.innerHTML;
          }
        }

        // Keyboard shortcuts to prevent scrolling
        function handleKeyboardShortcuts(e: KeyboardEvent) {
          const editor = document.getElementById('contentEditor');
          if (!editor || document.activeElement !== editor) return;

          if (e.ctrlKey) {
            // Prevent default browser behavior for these shortcuts
            if (e.key === 'b' || e.key === 'B') {
              e.preventDefault();
              formatText('insertUnorderedList');
            } else if (e.key === 'n' || e.key === 'N') {
              e.preventDefault();
              formatText('insertOrderedList');
            }
          }
        }

        // Form submission handling
        document.getElementById('createForm')?.addEventListener('submit', async function(e) {
          e.preventDefault();

          const form = this as HTMLFormElement;
          const formData = new FormData(form);
          const dealData: Record<string, any> = {};

          // Convert FormData to object
          for (let [key, value] of formData.entries()) {
            if (key === 'learn' || key === 'requirements') {
              // Split by newlines and filter empty lines
              dealData[key] = value.toString().split('\n').filter(line => line.trim());
            } else if (key === 'price' || key === 'originalPrice' || key === 'rating' || key === 'students') {
              // Convert to number if it's a numeric field
              const numValue = parseFloat(value.toString());
              dealData[key] = isNaN(numValue) ? undefined : numValue;
            } else if (value.toString().trim()) {
              dealData[key] = value.toString();
            }
          }

          try {
            const response = await fetch('/api/deals', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(dealData)
            });

            if (response.ok) {
              const result = await response.json();
              alert('Deal created successfully! ID: ' + result.id);
              window.location.href = '/admin/deals';
            } else {
              const error = await response.json();
              alert('Error creating deal: ' + (error.error || 'Unknown error'));
            }
          } catch (error) {
            console.error('Error:', error);
            alert('Error creating deal. Please check the console for details.');
          }
        });

        // Initialize
        showTab('basic');

        // Add keyboard shortcut listener
        document.addEventListener('keydown', handleKeyboardShortcuts);

        // Make functions globally accessible
        (window as any).showTab = showTab;
        (window as any).formatText = formatText;
        (window as any).insertLink = insertLink;
        (window as any).updateContentField = updateContentField;
      </script>

