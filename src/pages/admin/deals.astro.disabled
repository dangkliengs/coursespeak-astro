---
import Layout from "../../layouts/Layout.astro";
import AdminProtection from "../../components/AdminProtection.astro";
import AdminAuthGate from "../../components/AdminAuthGate";
import { readDeals } from "../../lib/store";

const allDeals = await readDeals();

const pageTitle = "Manage Deals - Admin Dashboard";
const pageDescription = "View, edit, and delete course deals on CourseSpeak.";
---

<Layout title={pageTitle} description={pageDescription}>
  <AdminProtection>
    <AdminAuthGate>
      <div style={{ background: "var(--bg)", minHeight: "100vh", color: "var(--text)" }}>
        <div style={{ marginBottom: "2rem", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <div>
              <h1 style={{
                fontSize: "2.5rem",
                fontWeight: 700,
                color: "#fff",
                marginBottom: "0.5rem"
              }}>
                Manage Deals
              </h1>
              <p style={{
                fontSize: "1.125rem",
                color: "#a9b0c0"
              }}>
                {allDeals.length} total deals
              </p>
            </div>
            <div style={{ display: "flex", gap: "1rem", alignItems: "center" }}>
              <a
                href="/deals"
                target="_blank"
                style={{
                  padding: "0.75rem 1.5rem",
                  backgroundColor: "#10b981",
                  color: "#fff",
                  textDecoration: "none",
                  borderRadius: "0.5rem",
                  fontWeight: 600,
                  border: "1px solid #10b981",
                  transition: "all 0.2s ease"
                }}
                onmouseover="this.style.backgroundColor='#059669'"
                onmouseout="this.style.backgroundColor='#10b981'"
              >
                View Posts/Deals →
              </a>
              <a href="/admin/deals/create" style={{
                display: "inline-block",
                padding: "0.75rem 1.5rem",
                backgroundColor: "var(--brand)",
                color: "#fff",
                textDecoration: "none",
                borderRadius: "0.5rem",
                fontWeight: 600
              }}>
                + Create New Deal
              </a>
            </div>
          </div>

          <!-- Search Form -->
          <div style={{ marginBottom: "2rem" }}>
            <div style={{
              borderRadius: "1rem",
              border: "1px solid rgba(91, 140, 255, 0.24)",
              background: "linear-gradient(140deg, rgba(11, 13, 18, 0.98) 0%, rgba(18, 24, 40, 0.98) 55%, rgba(42, 64, 110, 0.38) 100%)",
              boxShadow: "0 18px 36px rgba(8, 12, 26, 0.45)",
              padding: "1.5rem"
            }}>
              <div style={{ display: "flex", gap: "1rem", alignItems: "flex-end", flexWrap: "wrap" }}>
                <div style={{ flex: 1, minWidth: "200px" }}>
                  <label for="searchInput" style={{ display: "block", color: "#fff", marginBottom: "0.5rem", fontWeight: 600 }}>
                    Search Courses
                  </label>
                  <input
                    type="text"
                    id="searchInput"
                    name="searchInput"
                    placeholder="Search by title, provider, or category..."
                    style={{
                      width: "100%",
                      padding: "0.75rem",
                      backgroundColor: "rgba(255, 255, 255, 0.1)",
                      border: "1px solid rgba(91, 140, 255, 0.24)",
                      borderRadius: "0.5rem",
                      color: "#fff",
                      fontSize: "1rem"
                    }}
                    oninput="performSearch()"
                    onkeypress="if(event.key === 'Enter') performSearch()"
                  />
                </div>
                <div style={{ minWidth: "150px" }}>
                  <label for="categoryFilter" style={{ display: "block", color: "#fff", marginBottom: "0.5rem", fontWeight: 600 }}>
                    Category
                  </label>
                  <select
                    id="categoryFilter"
                    name="categoryFilter"
                    style={{
                      width: "100%",
                      padding: "0.75rem",
                      backgroundColor: "rgba(255, 255, 255, 0.1)",
                      border: "1px solid rgba(91, 140, 255, 0.24)",
                      borderRadius: "0.5rem",
                      color: "#fff",
                      fontSize: "1rem"
                    }}
                    onchange="filterDeals()"
                  >
                    <option value="">All Categories</option>
                  </select>
                </div>
                <button
                  onclick="clearFilters()"
                  style={{
                    padding: "0.75rem 1.5rem",
                    backgroundColor: "transparent",
                    color: "#a9b0c0",
                    border: "1px solid #a9b0c0",
                    borderRadius: "0.5rem",
                    fontWeight: 600,
                    cursor: "pointer"
                  }}
                >
                  Clear
                </button>
                <button
                  onclick="performSearch()"
                  style={{
                    padding: "0.75rem 1.5rem",
                    backgroundColor: "var(--brand)",
                    color: "#fff",
                    border: "1px solid var(--brand)",
                    borderRadius: "0.5rem",
                    fontWeight: 600,
                    cursor: "pointer"
                  }}
                >
                  Search
                </button>
              </div>
              <div id="searchResults" style={{ marginTop: "1rem", color: "#a9b0c0", fontSize: "0.875rem" }}>
                Showing all {allDeals.length} deals
              </div>
            </div>
          </div>

          <div style={{
            borderRadius: "1rem",
            border: "1px solid rgba(91, 140, 255, 0.24)",
            background: "linear-gradient(140deg, rgba(11, 13, 18, 0.98) 0%, rgba(18, 24, 40, 0.98) 55%, rgba(42, 64, 110, 0.38) 100%)",
            boxShadow: "0 18px 36px rgba(8, 12, 26, 0.45)",
            overflow: "hidden"
          }}>
            <div style={{ overflowX: "auto" }}>
              <table style={{ width: "100%", borderCollapse: "collapse" }}>
                <thead>
                  <tr style={{ borderBottom: "1px solid rgba(91, 140, 255, 0.24)" }}>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Title</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Provider</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Category</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Price</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Date</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Coupon</th>
                    <th style={{ padding: "1rem", textAlign: "left", color: "var(--brand)", fontWeight: 600 }}>Actions</th>
                  </tr>
                </thead>
                <tbody id="dealsTableBody">
                </tbody>
              </table>
            </div>

            <div id="pagination" style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: "0.5rem",
              flexWrap: "wrap",
              padding: "1.25rem",
              borderTop: "1px solid rgba(91, 140, 255, 0.1)"
            }}>
            </div>
          </div>
        </div>

      <!-- Hidden element to store deals data for JavaScript -->
      <div id="deals-data" style="display: none;">{JSON.stringify(allDeals)}</div>

      <script>
        console.log('Script loaded!');

        const PAGE_SIZE = 20;
        let currentPage = 1;
        let allDealsData: any[] = [];

        const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
        const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement | null;
        const tableBody = document.getElementById('dealsTableBody');
        const searchResults = document.getElementById('searchResults');
        const pagination = document.getElementById('pagination');

        document.addEventListener('DOMContentLoaded', function() {
          console.log('DOM loaded');

          console.log('Elements found:', {
            searchInput: !!searchInput,
            categoryFilter: !!categoryFilter,
            tableBody: !!tableBody
          });

          loadDataAndInitialize();
        });

        function loadDataAndInitialize() {
          try {
            const dealsElement = document.getElementById('deals-data');
            if (dealsElement) {
              allDealsData = JSON.parse(dealsElement.textContent);
              console.log('Data loaded:', allDealsData.length, 'deals');
            }
            populateCategories();
            currentPage = 1;
            renderDeals();
          } catch (error) {
            console.error('Error loading data:', error);
          }
        }

        function populateCategories() {
          if (!categoryFilter) return;
          const categories = Array.from(
            new Set(
              allDealsData
                .map((d: any) => d.category)
                .filter((c: any) => c && typeof c === 'string')
            )
          ).sort();
          categories.forEach((cat: string) => {
            const opt = document.createElement('option');
            opt.value = cat;
            opt.textContent = cat;
            categoryFilter.appendChild(opt);
          });
        }

        function getFilteredDeals() {
          const term = (searchInput?.value || '').toLowerCase().trim();
          const cat = categoryFilter?.value || '';

          return allDealsData.filter((deal: any) => {
            const matchTerm = !term ||
              (deal.title && deal.title.toLowerCase().includes(term)) ||
              (deal.provider && deal.provider.toLowerCase().includes(term)) ||
              (deal.category && deal.category.toLowerCase().includes(term)) ||
              (deal.coupon && deal.coupon.toLowerCase().includes(term));

            const matchCat = !cat || (deal.category && deal.category === cat);

            return matchTerm && matchCat;
          });
        }

        function buildRowHtml(deal: any): string {
          const esc = (s: any) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

          return `
            <td style="padding: 1rem; color: var(--text);">
              <div style="max-width: 300px;">
                <div style="font-weight: 600; margin-bottom: 0.25rem;">${esc(deal.title) || 'Untitled'}</div>
                <div style="font-size: 0.875rem; color: #a9b0c0;">ID: ${esc(deal.id) || 'Unknown'}</div>
              </div>
            </td>
            <td style="padding: 1rem; color: var(--text);">${esc(deal.provider) || 'Unknown'}</td>
            <td style="padding: 1rem; color: var(--text);">
              <div>
                <div>${esc(deal.category) || 'Uncategorized'}</div>
                ${deal.subcategory ? `<div style="font-size: 0.875rem; color: #a9b0c0;">${esc(deal.subcategory)}</div>` : ''}
              </div>
            </td>
            <td style="padding: 1rem; color: var(--text);">
              $${deal.price || '0'}
              ${deal.originalPrice ? `<span style="text-decoration: line-through; color: #a9b0c0; margin-left: 0.5rem;">$${deal.originalPrice}</span>` : ''}
            </td>
            <td style="padding: 1rem; color: var(--text);">
              <div style="font-size: 0.875rem;">
                ${deal.updatedAt ? new Date(deal.updatedAt).toLocaleDateString() : (deal.createdAt ? new Date(deal.createdAt).toLocaleDateString() : 'Unknown')}
              </div>
            </td>
            <td style="padding: 1rem; color: var(--text);">
              <div style="
                font-size: 0.875rem;
                font-family: monospace;
                background-color: rgba(91, 140, 255, 0.1);
                padding: 0.25rem 0.5rem;
                border-radius: 0.25rem;
                display: inline-block;
              ">
                ${esc(deal.coupon) || 'N/A'}
              </div>
            </td>
            <td style="padding: 1rem;">
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="/deal/${deal.id || ''}" target="_blank" style="
                  padding: 0.5rem 1rem;
                  background-color: #10b981;
                  color: #fff;
                  text-decoration: none;
                  border-radius: 0.375rem;
                  font-size: 0.875rem;
                  font-weight: 600;
                  border: 1px solid #10b981;
                ">View</a>
                <a href="/admin/deals/edit/${deal.id || ''}" style="
                  padding: 0.5rem 1rem;
                  background-color: transparent;
                  color: var(--brand);
                  border: 1px solid var(--brand);
                  text-decoration: none;
                  border-radius: 0.375rem;
                  font-size: 0.875rem;
                  font-weight: 600;
                ">Edit</a>
                <button onclick="deleteDeal('${esc(deal.id) || ''}')" style="
                  padding: 0.5rem 1rem;
                  background-color: transparent;
                  color: var(--destructive);
                  border: 1px solid var(--destructive);
                  border-radius: 0.375rem;
                  font-size: 0.875rem;
                  font-weight: 600;
                  cursor: pointer;
                ">Delete</button>
              </div>
            </td>
          `;
        }

        function renderDeals() {
          if (!tableBody || !searchResults) return;

          const filtered = getFilteredDeals();
          const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));

          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          const start = (currentPage - 1) * PAGE_SIZE;
          const pageItems = filtered.slice(start, start + PAGE_SIZE);

          tableBody.innerHTML = '';

          if (pageItems.length === 0) {
            const emptyRow = document.createElement('tr');
            emptyRow.innerHTML = `<td colspan="7" style="padding: 2rem; text-align: center; color: #a9b0c0;">No deals found</td>`;
            tableBody.appendChild(emptyRow);
          } else {
            pageItems.forEach((deal: any) => {
              const row = document.createElement('tr');
              row.style.borderBottom = '1px solid rgba(91, 140, 255, 0.1)';
              row.setAttribute('data-deal-id', String(deal.id || ''));
              row.innerHTML = buildRowHtml(deal);
              tableBody.appendChild(row);
            });
          }

          searchResults.textContent = filtered.length === 0
            ? 'No deals found'
            : `Showing ${filtered.length} of ${allDealsData.length} deals (page ${currentPage} of ${totalPages})`;

          renderPagination(totalPages, filtered.length, start, pageItems.length);
        }

        function renderPagination(totalPages: number, totalItems: number, start: number, count: number) {
          if (!pagination) return;
          pagination.innerHTML = '';

          if (totalPages <= 1) return;

          const info = document.createElement('span');
          info.style.color = '#a9b0c0';
          info.style.fontSize = '0.875rem';
          info.style.marginRight = '0.5rem';
          info.textContent = `${start + 1}-${start + count} of ${totalItems}`;
          pagination.appendChild(info);

          const btnStyle = (active: boolean) => `
            padding: 0.5rem 0.9rem;
            background-color: ${active ? 'var(--brand)' : 'transparent'};
            color: ${active ? '#fff' : '#a9b0c0'};
            border: 1px solid ${active ? 'var(--brand)' : 'rgba(91, 140, 255, 0.24)'};
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            min-width: 2.5rem;
          `;

          const addBtn = (label: string, page: number, active = false, disabled = false) => {
            const btn = document.createElement('button');
            btn.textContent = label;
            btn.setAttribute('style', btnStyle(active));
            if (disabled) {
              btn.disabled = true;
              btn.style.opacity = '0.4';
              btn.style.cursor = 'not-allowed';
            } else {
              btn.onclick = () => {
                currentPage = page;
                renderDeals();
                window.scrollTo({ top: 0, behavior: 'smooth' });
              };
            }
            pagination.appendChild(btn);
          };

          addBtn('‹ Prev', currentPage - 1, false, currentPage === 1);

          const pageNumbers: (number | string)[] = [];
          if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
          } else {
            pageNumbers.push(1);
            const from = Math.max(2, currentPage - 1);
            const to = Math.min(totalPages - 1, currentPage + 1);
            if (from > 2) pageNumbers.push('...');
            for (let i = from; i <= to; i++) pageNumbers.push(i);
            if (to < totalPages - 1) pageNumbers.push('...');
            pageNumbers.push(totalPages);
          }

          pageNumbers.forEach((p) => {
            if (p === '...') {
              const span = document.createElement('span');
              span.textContent = '...';
              span.style.color = '#a9b0c0';
              span.style.padding = '0 0.25rem';
              pagination.appendChild(span);
            } else {
              addBtn(String(p), p as number, p === currentPage);
            }
          });

          addBtn('Next ›', currentPage + 1, false, currentPage === totalPages);
        }

        function performSearch() {
          console.log('Searching...');
          currentPage = 1;
          renderDeals();
        }

        function filterDeals() {
          console.log('Filtering by category...');
          currentPage = 1;
          renderDeals();
        }

        function clearFilters() {
          console.log('Clearing filters');
          if (searchInput) searchInput.value = '';
          if (categoryFilter) categoryFilter.value = '';
          currentPage = 1;
          renderDeals();
        }

        function testSearch() {
          console.log('Testing search function');
          performSearch();
        }

        function deleteDeal(dealId: string) {
          console.log('Deleting deal:', dealId);

          if (!confirm('Are you sure you want to delete this deal? This action cannot be undone.')) {
            return;
          }

          fetch(`/api/deals?id=${encodeURIComponent(dealId)}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert(`Deal deleted successfully! ID: ${data.deletedId}`);

              allDealsData = allDealsData.filter((d: any) => d.id !== dealId);
              renderDeals();

              const countElement = document.querySelector('p');
              if (countElement && countElement.textContent?.includes('total deals')) {
                countElement.textContent = `${allDealsData.length} total deals`;
              }

              console.log('Deal deleted successfully:', data);
            } else {
              alert('Error deleting deal: ' + (data.error || 'Unknown error'));
              console.error('Delete failed:', data);
            }
          })
          .catch(error => {
            console.error('Network error during delete:', error);
            alert('Network error occurred while deleting deal. Please try again.');
          });
        }

        // Add type declarations for global window
        declare global {
          interface Window {
            performSearch: () => void;
            filterDeals: () => void;
            clearFilters: () => void;
            testSearch: () => void;
            deleteDeal: (dealId: string) => void;
          }
        }
        window.performSearch = performSearch;
        window.filterDeals = filterDeals;
        window.clearFilters = clearFilters;
        window.testSearch = testSearch;
        window.deleteDeal = deleteDeal;
        console.log('Functions exposed');
      </script>
    </AdminAuthGate>
  </AdminProtection>
</Layout>
