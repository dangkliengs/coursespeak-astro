---
import AdminShell from "../../components/admin/AdminShell.astro";
import { readDeals } from "../../lib/store";

const allDeals = await readDeals();
const now = Date.now();

const isExpired = (d: { expiresAt?: string }) => {
  if (!d.expiresAt) return false;
  const t = new Date(d.expiresAt).getTime();
  return !isNaN(t) && t < now;
};

const rows = allDeals.map((d) => ({
  id: d.id,
  title: d.title,
  image: d.image ?? "",
  category: d.category,
  subcategory: d.subcategory ?? "",
  price: d.price,
  originalPrice: d.originalPrice ?? 0,
  coupon: d.coupon ?? "",
  instructor: d.instructor ?? "",
  updatedAt: d.updatedAt ?? d.createdAt ?? "",
  expired: isExpired(d),
}));

const staleDays = (iso: string) => {
  const t = new Date(iso).getTime();
  if (!iso || isNaN(t)) return 0;
  return Math.floor(Math.max(0, now - t) / 86400000);
};

const activeCount = rows.filter((r) => !r.expired).length;
const expiredCount = rows.length - activeCount;
const staleCount = rows.filter((r) => !r.expired && staleDays(r.updatedAt) >= 7).length;
---

<AdminShell title="Deals" desc="Manage course deal listings" badge={`${rows.length} deals`}>
  <div slot="actions">
    <a class="adm-btn adm-btn-primary" href="/admin/deals/create">+ New Deal</a>
  </div>

  <div class="adm-stats">
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{rows.length.toLocaleString()}</div><div class="adm-stat-lbl">Total Deals</div></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{activeCount.toLocaleString()}</div><div class="adm-stat-lbl">Active</div></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{expiredCount.toLocaleString()}</div><div class="adm-stat-lbl">Expired</div></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{staleCount}</div><div class="adm-stat-lbl">Stale (7+ days)</div></div>
    </div>
  </div>

  <div class="adm-card">
    <div class="adm-toolbar">
      <input class="adm-input" id="searchBox" type="search" placeholder="Search title, coupon code, category…" />
      <select class="adm-select" id="catFilter" style="max-width:220px;">
        <option value="">All categories</option>
        {[...new Set(allDeals.map((d) => d.category).filter(Boolean))].sort().map((cat) => (
          <option value={cat}>{cat}</option>
        ))}
      </select>
      <select class="adm-select" id="statusFilter" style="max-width:180px;">
        <option value="">All status</option>
        <option value="active">Active ({activeCount})</option>
        <option value="expired">Expired ({expiredCount})</option>
      </select>
      <span class="adm-count" id="countLabel"></span>
    </div>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Price</th>
            <th>Coupon Code</th>
            <th>Updated</th>
            <th style="text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody id="rows">
          {rows.map((r) => (
            <tr data-row
                data-search={[r.title, r.category, r.subcategory, r.instructor, r.id, r.coupon].join(" ").toLowerCase()}
                data-status={r.expired ? "expired" : "active"}
                data-id={r.id}>
              <td>
                <div class="adm-course">
                  {r.image ? (
                    <img class="adm-thumb" src={r.image} alt="" loading="lazy" />
                  ) : (
                    <div class="adm-thumb" style="display:grid;place-items:center;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                  )}
                  <div style="min-width:0;">
                    <a class="adm-link" href={`/deal/${r.id}`} target="_blank">{r.title}</a>
                    <div class="adm-chip">ID: {r.id}</div>
                  </div>
                </div>
              </td>
              <td>
                {r.category}
                {r.subcategory && <div class="adm-sub">{r.subcategory}</div>}
              </td>
              <td>
                <span class="adm-price">${r.price ?? 0}{r.originalPrice ? <s>${r.originalPrice}</s> : null}</span>
              </td>
              <td>
                {r.coupon ? (
                  <code class="adm-coupon">{r.coupon}</code>
                ) : (
                  <span class="adm-muted">—</span>
                )}
              </td>
              <td class="adm-muted">{r.updatedAt ? new Date(r.updatedAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" }) : "—"}</td>
              <td>
                <div class="adm-actions" style="justify-content:flex-end;">
                  <a class="adm-btn adm-btn-ghost adm-btn-sm" href={`/admin/deals/edit/${r.id}`}>Edit</a>
                  <button class="adm-btn adm-btn-danger adm-btn-sm" type="button" data-delete data-id={r.id}>Delete</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="adm-pagination" id="pager"></div>
  </div>
</AdminShell>

<style is:global>
  @media (max-width:1150px){
    .adm-table th:nth-child(5),.adm-table td:nth-child(5){display:none;}
  }
  @media (max-width:950px){
    .adm-table th:nth-child(2),.adm-table td:nth-child(2){display:none;}
    .adm-link{max-width:220px;}
  }
  @media (max-width:720px){
    .adm-link{max-width:140px;}
    .adm-stat-num{font-size:1.25rem;}
  }
</style>

<script>
  const searchBox = document.getElementById("searchBox") as HTMLInputElement;
  const catFilter = document.getElementById("catFilter") as HTMLSelectElement;
  const statusFilter = document.getElementById("statusFilter") as HTMLSelectElement;
  const countLabel = document.getElementById("countLabel") as HTMLElement;
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-row]"));
  const pager = document.getElementById("pager") as HTMLElement;
  const PAGE_SIZE = 50;
  let currentPage = 1;
  let matched: HTMLElement[] = [];

  function applyFilters() {
    const q = searchBox.value.trim().toLowerCase();
    const cat = catFilter.value;
    const status = statusFilter.value;
    matched = rows.filter((row) => {
      const text = row.dataset.search || "";
      const rowCat = row.children[1]?.textContent?.trim() || "";
      const matchQ = !q || text.includes(q);
      const matchCat = !cat || rowCat.startsWith(cat);
      const matchStatus = !status || row.dataset.status === status;
      return matchQ && matchCat && matchStatus;
    });
    const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    renderPage();
    countLabel.textContent = `${matched.length} / ${rows.length} shown`;
    renderPager(totalPages);
  }

  function renderPage() {
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    rows.forEach((row) => {
      row.style.display = "none";
    });
    matched.slice(start, end).forEach((row) => {
      row.style.display = "";
    });
  }

  function makePgBtn(label: string, page: number, opts: { disabled?: boolean; current?: boolean } = {}) {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "adm-pg-btn" + (opts.current ? " current" : "");
    b.textContent = label;
    b.disabled = !!opts.disabled;
    if (!opts.disabled && !opts.current) b.addEventListener("click", () => {
      currentPage = page;
      applyFilters();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    return b;
  }

  function makePgEllipsis() {
    const s = document.createElement("span");
    s.className = "adm-pg-info";
    s.textContent = "…";
    return s;
  }

  function renderPager(totalPages: number) {
    pager.innerHTML = "";
    if (totalPages <= 1) return;
    const info = document.createElement("span");
    info.className = "adm-pg-info";
    info.textContent = `Page ${currentPage} of ${totalPages}`;
    pager.appendChild(info);
    pager.appendChild(makePgBtn("‹ Prev", currentPage - 1, { disabled: currentPage === 1 }));
    const windowSize = 5;
    let startPage = Math.max(1, currentPage - Math.floor(windowSize / 2));
    let endPage = Math.min(totalPages, startPage + windowSize - 1);
    startPage = Math.max(1, endPage - windowSize + 1);
    if (startPage > 1) {
      pager.appendChild(makePgBtn("1", 1, { current: currentPage === 1 }));
      if (startPage > 2) pager.appendChild(makePgEllipsis());
    }
    for (let p = startPage; p <= endPage; p++) {
      pager.appendChild(makePgBtn(String(p), p, { current: p === currentPage }));
    }
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) pager.appendChild(makePgEllipsis());
      pager.appendChild(makePgBtn(String(totalPages), totalPages, { current: currentPage === totalPages }));
    }
    pager.appendChild(makePgBtn("Next ›", currentPage + 1, { disabled: currentPage === totalPages }));
  }

  searchBox.addEventListener("input", () => { currentPage = 1; applyFilters(); });
  catFilter.addEventListener("change", () => { currentPage = 1; applyFilters(); });
  statusFilter.addEventListener("change", () => { currentPage = 1; applyFilters(); });
  applyFilters();

  document.querySelectorAll<HTMLElement>(".adm-coupon").forEach((el) => {
    el.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(el.textContent || "");
        el.classList.add("copied");
        const orig = el.textContent;
        el.textContent = "Copied ✓";
        setTimeout(() => {
          el.textContent = orig;
          el.classList.remove("copied");
        }, 1200);
      } catch {}
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const dealId = btn.dataset.id || "";
      const title = btn.closest("tr")?.querySelector(".adm-link")?.textContent || dealId;
      if (!confirm(`Delete deal "${title}"?\n\nThis cannot be undone.`)) return;
      btn.disabled = true;
      btn.textContent = "…";
      try {
        const res = await fetch(`/api/deals?id=${encodeURIComponent(dealId)}`, { method: "DELETE" });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || "Delete failed");
        btn.closest("tr")?.remove();
        applyFilters();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = "Delete";
        alert(`Error: ${(err as Error).message}`);
      }
    });
  });
</script>
