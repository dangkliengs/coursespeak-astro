---
import Layout from "../layouts/Layout.astro";

const canonicalUrl = "https://coursespeak.com/terms";
const pageTitle = "Terms of Service — Legal Terms & Conditions | CourseSpeak";
const pageDescription = "CourseSpeak Terms of Service: legal terms governing the use of our Udemy coupon platform, including user conduct, disclaimers, and intellectual property.";
const lastModified = new Date().toISOString().split('T')[0];
const monthYear = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---

<Layout title={pageTitle} description={pageDescription} type="article" canonical={canonicalUrl}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription,
        "isPartOf": { "@id": "https://coursespeak.com" },
        "datePublished": "2023-01-01",
        "dateModified": lastModified,
        "inLanguage": "en-US"
      },
      {
        "@type": "Organization",
        "@id": "https://coursespeak.com/#organization",
        "name": "CourseSpeak",
        "url": "https://coursespeak.com",
        "logo": "https://coursespeak.com/logo.svg",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "legal",
          "email": "contact@coursespeak.com"
        }
      }
    ]
  })} />
  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO ── */}
    <section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
          Legal Terms — Updated {monthYear}
        </div>
        <h1 style={{ fontSize: "clamp(1.8rem, 4.5vw, 2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Terms of Service</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "650px", margin: "0 auto 1.5rem", lineHeight: 1.6 }}>
          Please read these terms carefully before using CourseSpeak. By accessing our services, you agree to be bound by these conditions.
        </p>
        <div style={{ display: "flex", justifyContent: "center", alignItems: "center", gap: "1rem", flexWrap: "wrap", fontSize: "0.8rem", color: "var(--muted)" }}>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            By <strong style={{ color: "var(--text)" }}>Josh Smith</strong>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
            Updated <time datetime={lastModified}>{new Date(lastModified).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            10 min read
          </span>
        </div>
      </div>
    </section>

    {/* ── ARTICLE BODY ── */}
    <article style={{ padding: "2rem 1rem 4rem" }}>
      <div class="article-body" style={{ maxWidth: "900px", margin: "0 auto" }}>

        <p>
          <strong>Last Updated:</strong> {monthYear}. These Terms of Service ("Terms") govern your access to and use of CourseSpeak (coursespeak.com), including any content, features, and services offered through our platform.
        </p>
        <p>
          By accessing or using CourseSpeak, you agree to be bound by these Terms. If you do not agree, please do not use our service.
        </p>

        {/* ── Service Overview Cards ── */}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:1rem; margin:1.5rem 0;">
          {[
            { d: "M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.41zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z", title: "Free Coupon Service", desc: "Verified Udemy coupon links completely free of charge. No registration or payment required." },
            { d: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z", title: "No Purchase Required", desc: "All services are free. We earn through affiliate partnerships, not user fees." },
            { d: "M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z", title: "Third-Party Purchases", desc: "Any purchases are made directly on Udemy. We facilitate access but do not process payments." },
            { d: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z", title: "Community Guidelines", desc: "Use our services responsibly and respect intellectual property rights." },
          ].map(card => (
            <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.25rem;">
              <h3 style="font-size:0.9rem; font-weight:700; color:var(--text); margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--brand)" style="flex-shrink:0;"><path d={card.d}/></svg>
                {card.title}
              </h3>
              <p style="font-size:0.82rem; color:var(--muted); line-height:1.6; margin:0;">{card.desc}</p>
            </div>
          ))}
        </div>

        {/* ── 1. Acceptance of Terms ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="acceptance" class="section-heading">1. Acceptance of Terms</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin:0;">By accessing and using CourseSpeak, you accept and agree to be bound by the terms and provision of this agreement. If you do not agree to abide by the above, please do not use this service.</p>
          </div>
        </section>

        {/* ── 2. Description of Service ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="description" class="section-heading">2. Description of Service</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:1rem;">CourseSpeak is an educational resource platform that provides links to discounted and free courses on third-party learning platforms, primarily Udemy. We aggregate and share coupon codes to help users access quality education at reduced costs.</p>
            <div style="background:rgba(212,167,55,0.07); border-left:4px solid var(--brand); padding:0.75rem 1rem; border-radius:8px;">
              <strong style="color:var(--brand);">Important:</strong> CourseSpeak does not host or provide courses directly. All course content and transactions occur on third-party platforms.
            </div>
          </div>
        </section>

        {/* ── 3. Coupon and Deal Information ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="coupon-info" class="section-heading">3. Coupon and Deal Information</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">While we strive to provide accurate and up-to-date coupon information, CourseSpeak cannot guarantee the validity or availability of any specific coupon or deal. Coupons may expire, be discontinued, or have limited quantities.</p>
            <p style="margin:0;">We are not responsible for any purchases made on third-party websites, including billing disputes, refunds, or customer service issues.</p>
          </div>
        </section>

        {/* ── 4. User Conduct ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="user-conduct" class="section-heading">4. User Conduct and Responsibilities</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">You agree to use CourseSpeak only for lawful purposes and in accordance with these Terms of Service. Prohibited activities include:</p>
            <ul style="margin:0; padding-left:1.25rem;">
              <li>Attempting to access or use the service through unauthorized means</li>
              <li>Interfering with or disrupting the service or servers</li>
              <li>Using automated tools to scrape or collect data</li>
              <li>Violating any applicable laws or regulations</li>
              <li>Misrepresenting your identity or affiliation</li>
            </ul>
          </div>
        </section>

        {/* ── 5. Intellectual Property ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="intellectual-property" class="section-heading">5. Intellectual Property</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">All content, features, and functionality on CourseSpeak, including but not limited to text, graphics, logos, and software, are owned by CourseSpeak or its licensors and are protected by copyright, trademark, and other intellectual property laws.</p>
            <p style="margin:0;">Third-party trademarks, service marks, and trade names that appear on CourseSpeak are the property of their respective owners.</p>
          </div>
        </section>

        {/* ── 6. Privacy ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="privacy" class="section-heading">6. Privacy and Data Protection</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">Your privacy is important to us. Our collection and use of personal information is governed by our <a href="/privacy">Privacy Policy</a>, which forms part of these Terms of Service.</p>
            <p style="margin:0;">By using CourseSpeak, you consent to the collection and use of information as outlined in our Privacy Policy.</p>
          </div>
        </section>

        {/* ── 7. Disclaimers ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="disclaimers" class="section-heading">7. Disclaimers and Limitations of Liability</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">CourseSpeak is provided on an "as is" and "as available" basis. We make no warranties, expressed or implied, and hereby disclaim all warranties including merchantability, fitness for a particular purpose, and non-infringement.</p>
            <p style="margin:0;">In no event shall CourseSpeak be liable for any direct, indirect, incidental, special, or consequential damages arising out of or in any way connected with your use of our service.</p>
          </div>
        </section>

        {/* ── 8. Termination ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="termination" class="section-heading">8. Termination</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">We reserve the right to terminate or suspend your access to CourseSpeak immediately, without prior notice, for any reason including breach of these Terms of Service.</p>
            <p style="margin:0;">Upon termination, your right to use the service will cease immediately.</p>
          </div>
        </section>

        {/* ── 9. Changes to Terms ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="changes" class="section-heading">9. Changes to Terms</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:0.75rem;">We reserve the right to modify these Terms of Service at any time. Changes will be effective immediately upon posting on this page. Your continued use of CourseSpeak after changes constitutes acceptance of the new terms.</p>
            <p style="margin:0;"><strong>Last updated:</strong> {monthYear}.</p>
          </div>
        </section>

        {/* ── Contact ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="contact" class="section-heading">Contact Us</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:1rem;">If you have questions about these Terms of Service, please contact us:</p>
            <p style="margin:0;">
              <strong style="color:var(--text);">Email:</strong>{' '}
              <a href="mailto:contact@coursespeak.com" style="color:var(--brand);">contact@coursespeak.com</a>
              <span style="color:var(--muted); font-size:0.85rem; display:block;">Use subject: "Legal Inquiry"</span>
            </p>
          </div>
        </section>

        {/* ── CTA ── */}
        <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center; margin-top:2rem;">
          <h2 style="font-size:1.3rem; font-weight:800; color:var(--text); margin-bottom:0.5rem;">
            Browse Free Udemy Coupons
          </h2>
          <p style="color:var(--muted); font-size:0.9rem; margin-bottom:1.5rem; max-width:440px; margin-left:auto; margin-right:auto; line-height:1.6;">
            Verified 100% off Udemy coupons — updated daily across 100+ topics. No account required.
          </p>
          <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
            <a href="/deals" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.6rem; background:var(--brand); color:var(--bg); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem;">
              Browse Free Deals
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </div>

      </div>
    </article>

  </div>

  <style>
    .section-heading {
      font-size: clamp(1.15rem, 2.5vw, 1.45rem);
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--border);
    }
    .article-body { font-size: 0.95rem; line-height: 1.75; color: var(--muted); }
    .article-body p { margin-bottom: 1rem; }
    .article-body p:last-child { margin-bottom: 0; }
    .article-body strong { color: var(--text); }
    .article-body a { color: var(--brand); text-decoration: underline; }
    .article-body ul { margin-bottom: 1rem; color: var(--muted); }
    .article-body ul li { margin-bottom: 0.35rem; }
    .article-body ul li:last-child { margin-bottom: 0; }
  </style>
</Layout>
