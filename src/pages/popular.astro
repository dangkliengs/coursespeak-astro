---
import Layout from "../layouts/Layout.astro";
import DealCard from "../components/DealCard.astro";
import { readDeals } from "../lib/store";
import { normName, slugifyCategory } from "../lib/utils";

// Import deals data
const allDeals = await readDeals();

// Calculate statistics for better SEO
const totalDeals = allDeals.length;
const popularCourses = allDeals
  .filter(deal => deal.rating && deal.rating >= 4.5)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0))
  .slice(0, 12);

const avgRating = (popularCourses.reduce((sum, course) => sum + (course.rating || 0), 0) / popularCourses.length).toFixed(1);
const totalPopularCourses = popularCourses.length;

// Get actual categories from data - simple approach
const categoryMap = new Map();

allDeals.forEach(deal => {
  const categoryName = normName(deal.category) || "Uncategorized";
  if (!categoryMap.has(categoryName)) {
    categoryMap.set(categoryName, 0);
  }
  categoryMap.set(categoryName, categoryMap.get(categoryName) + 1);
});

const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({ name, count }))
  .slice(0, 9);

console.log('All categories from deals:', Array.from(categoryMap.keys()));
console.log('Processed categories for display:', categories);

// Enhanced SEO metadata with dynamic statistics
const pageTitle = `Popular Udemy Courses | ${totalPopularCourses}+ Top Rated, ${avgRating}★ Average`;
const pageDescription = `${totalPopularCourses}+ highest-rated Udemy courses with ${avgRating}★ average. Popular programming, design & marketing courses with free deals.`;

const canonicalUrl = "https://coursespeak.com/popular";

// Enhanced JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@id": "https://coursespeak.com"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://coursespeak.com/logo.svg"
      },
      "datePublished": "2024-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://coursespeak.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Popular Courses",
            "item": canonicalUrl
          }
        ]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Popular Udemy Courses",
        "description": `Top ${totalPopularCourses} rated Udemy courses with ${avgRating}★ average rating`,
        "numberOfItems": totalPopularCourses,
        "itemListElement": popularCourses.slice(0, 10).map((course, index) => ({
          "@type": "Course",
          "position": index + 1,
          "name": course.title,
          "description": course.description || `Highly rated Udemy course with ${course.rating}★ rating`,
          "url": `https://coursespeak.com/deal/${course.id}`,
          "provider": {
            "@type": "Organization",
            "name": course.provider || "Udemy",
            "url": "https://www.udemy.com"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": course.rating,
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": Math.max(1, Math.round(course.students ?? 1000))
          },
          "educationalLevel": "Beginner to Advanced",
          "inLanguage": "en"
        }))
      }
    },
    {
      "@type": "Dataset",
      "name": "CourseSpeak Popular Courses Dataset",
      "description": "Dataset of most popular and highest-rated Udemy courses",
      "url": canonicalUrl,
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "provider": {
        "@id": "https://coursespeak.com/#organization"
      },
      "datePublished": "2024-01-01",
      "dateModified": new Date().toISOString().split('T')[0],
      "variableMeasured": [
        {
          "@type": "PropertyValue",
          "name": "Total Popular Courses",
          "value": totalPopularCourses
        },
        {
          "@type": "PropertyValue",
          "name": "Average Rating",
          "value": `${avgRating} stars`
        },
        {
          "@type": "PropertyValue",
          "name": "Rating Threshold",
          "value": "4.5+ stars"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What makes a course 'popular' on CourseSpeak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our popular courses are selected based on high ratings (4.5+ stars) and student demand. We feature the most sought-after courses that thousands of learners are currently taking."
          }
        },
        {
          "@type": "Question",
          "name": "Are popular courses more expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at all! All courses featured on our popular page are available for free through our exclusive Udemy deals. The popularity is based on quality and demand, not price."
          }
        },
        {
          "@type": "Question",
          "name": "How often are popular courses updated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We regularly update our popular courses list based on current ratings, student enrollment numbers, and trending topics. Check back frequently to discover new highly-rated courses."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get a certificate for popular courses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Popular courses from Udemy typically include certificates of completion. Certificate availability may vary by course, but most high-rated courses offer this feature."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://coursespeak.com/logo.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content="https://coursespeak.com/logo.svg" />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="keywords" content="popular Udemy courses, top rated courses, free courses, trending courses, highest rated Udemy courses, CourseSpeak popular" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="hero-gradient" style={{ minHeight: "100vh", color: "var(--text)" }}>
    <main>
      {/* Hero Section */}
      <section class="hero-gradient" style={{ padding: "6rem 1rem 4rem", textAlign: "center" }}>
        <div class="container">
          <div style={{
            display: "inline-flex",
            alignItems: "center",
            gap: "0.5rem",
            background: "var(--brand-soft)",
            padding: "0.5rem 1rem",
            borderRadius: "9999px",
            marginBottom: "2rem",
            fontSize: "0.9rem",
            color: "var(--brand)",
            fontWeight: 600
          }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            {totalPopularCourses}+ Top-Rated Courses
          </div>
          
          <h1 style={{
            fontSize: "clamp(2.5rem, 5vw, 4rem)",
            fontWeight: 800,
            lineHeight: 1.1,
            marginBottom: "1.5rem",
            maxWidth: "1000px",
            margin: "0 auto 1.5rem"
          }}>
            <span style={{
              background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              backgroundClip: "text"
            }}>
              Popular
            </span>
            <br/>
            <span style={{
              background: "linear-gradient(135deg, var(--text) 0%, var(--muted) 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              backgroundClip: "text"
            }}>
              Free Courses
            </span>
          </h1>
          
          <p style={{
            fontSize: "clamp(1.1rem, 2.5vw, 1.4rem)",
            color: "var(--muted)",
            maxWidth: "700px",
            margin: "0 auto 3rem",
            lineHeight: 1.6,
            fontWeight: 400
          }}>
            Explore {totalPopularCourses}+ most sought-after Udemy courses with an average rating of {avgRating}★.
            Top-rated content from industry experts, zero cost - the perfect combination for your learning journey.
          </p>

          <div style={{
            display: "flex",
            justifyContent: "center",
            gap: "2rem",
            flexWrap: "wrap",
            marginBottom: "3rem"
          }}>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: "3rem", fontWeight: 800, color: "var(--brand)", marginBottom: "0.5rem" }}>
                {avgRating}★
              </div>
              <div style={{ color: "var(--muted)", fontSize: "0.9rem" }}>
                Average Rating
              </div>
            </div>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: "3rem", fontWeight: 800, color: "var(--accent)", marginBottom: "0.5rem" }}>
                {totalPopularCourses}+
              </div>
              <div style={{ color: "var(--muted)", fontSize: "0.9rem" }}>
                Top Courses
              </div>
            </div>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: "3rem", fontWeight: 800, color: "hsl(180, 50%, 40%)", marginBottom: "0.5rem" }}>
                100%
              </div>
              <div style={{ color: "var(--muted)", fontSize: "0.9rem" }}>
                Free Access
              </div>
            </div>
          </div>
        </div>

        {/* Decorative elements */}
        <div style={{
          position: "absolute",
          top: "20%",
          left: "10%",
          width: "300px",
          height: "300px",
          background: "var(--brand)",
          filter: "blur(120px)",
          opacity: 0.1,
          borderRadius: "50%",
        }}></div>
        <div style={{
          position: "absolute",
          bottom: "10%",
          right: "10%",
          width: "250px",
          height: "250px",
          background: "hsl(0, 84%, 60%)",
          filter: "blur(100px)",
          opacity: 0.1,
          borderRadius: "50%",
        }}></div>
      </section>

      {/* Popular Courses Overview */}
      <section class="card-gradient" style={{ padding: "4rem 1rem" }}>
        <div class="container">
          <div style={{
            textAlign: "center",
            marginBottom: "3rem"
          }}>
            <h2 style={{
              fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
              fontWeight: 800,
              color: "var(--text)",
              marginBottom: "1rem"
            }}>
              Why Choose Popular Courses?
            </h2>
            <p style={{
              color: "var(--muted)",
              fontSize: "1.1rem",
              maxWidth: "600px",
              margin: "0 auto",
              lineHeight: 1.6
            }}>
              Join thousands of learners who trust the most highly-rated courses on Udemy. Quality content that delivers real results.
            </p>
          </div>

          <div style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(250px, 1fr))",
            gap: "2rem",
            marginBottom: "4rem"
          }}>
            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              textAlign: "center",
              transition: "all 0.3s ease"
            }}>
              <div style={{
                width: "60px",
                height: "60px",
                background: "var(--brand)",
                borderRadius: "16px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                margin: "0 auto 1.5rem"
              }}>
                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <h3 style={{ color: "var(--brand)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                {avgRating}★
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                Average Rating
              </p>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                Highly rated by students
              </p>
            </div>

            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              textAlign: "center",
              transition: "all 0.3s ease"
            }}>
              <div style={{
                width: "60px",
                height: "60px",
                background: "hsl(35, 90%, 68%)",
                borderRadius: "16px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                margin: "0 auto 1.5rem"
              }}>
                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                  <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
              </div>
              <h3 style={{ color: "hsl(35, 90%, 68%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                100K+
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                Students Enrolled
              </p>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                In popular courses
              </p>
            </div>

            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              textAlign: "center",
              transition: "all 0.3s ease"
            }}>
              <div style={{
                width: "60px",
                height: "60px",
                background: "hsl(180, 50%, 40%)",
                borderRadius: "16px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                margin: "0 auto 1.5rem"
              }}>
                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                  <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/>
                </svg>
              </div>
              <h3 style={{ color: "hsl(180, 50%, 40%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                100%
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                Free Access
              </p>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                No hidden costs
              </p>
            </div>

            <div style={{
              background: "var(--card)",
              padding: "2rem",
              borderRadius: "20px",
              border: "1px solid var(--border)",
              textAlign: "center",
              transition: "all 0.3s ease"
            }}>
              <div style={{
                width: "60px",
                height: "60px",
                background: "hsl(0, 84%, 60%)",
                borderRadius: "16px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                margin: "0 auto 1.5rem"
              }}>
                <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <h3 style={{ color: "hsl(0, 84%, 60%)", fontSize: "1.8rem", marginBottom: "0.5rem", fontWeight: 800 }}>
                4.5+
              </h3>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "1rem", marginBottom: "0.5rem", fontWeight: 600 }}>
                Rating Threshold
              </p>
              <p style={{ color: "var(--muted)", lineHeight: 1.6, fontSize: "0.9rem" }}>
                Only top courses
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Popular Courses Grid */}
      <section class="container" style={{ padding: "2rem 1rem 4rem" }}>
        <div style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: "2rem",
          flexWrap: "wrap",
          gap: "1rem"
        }}>
          <h2 style={{
            fontSize: "clamp(1.5rem, 3vw, 2rem)",
            fontWeight: 800,
            color: "var(--text)",
            margin: 0
          }}>
            Trending Courses
          </h2>
          
          <div style={{
            display: "flex",
            gap: "1rem",
            alignItems: "center"
          }}>
            <button style={{
              padding: "0.5rem 1rem",
              borderRadius: "8px",
              background: "var(--card)",
              border: "1px solid var(--border)",
              color: "var(--text)",
              fontSize: "0.9rem",
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: "0.5rem"
            }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/>
              </svg>
              Filter
            </button>
            
            <button style={{
              padding: "0.5rem 1rem",
              borderRadius: "8px",
              background: "var(--card)",
              border: "1px solid var(--border)",
              color: "var(--text)",
              fontSize: "0.9rem",
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: "0.5rem"
            }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 10l5 5 5-5z"/>
              </svg>
              Sort
            </button>
          </div>
        </div>

        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
          gap: "2rem",
          marginBottom: "3rem"
        }}>
          {popularCourses.map((course) => (
            <div style={{
              background: "var(--card)",
              borderRadius: "16px",
              border: "1px solid var(--border)",
              overflow: "hidden",
              transition: "all 0.3s ease",
              position: "relative"
            }}>
              {/* Badge */}
              <div style={{
                position: "absolute",
                top: "1rem",
                right: "1rem",
                background: "var(--brand)",
                color: "var(--bg)",
                padding: "0.25rem 0.75rem",
                borderRadius: "999px",
                fontSize: "0.75rem",
                fontWeight: 700,
                zIndex: 10
              }}>
                HOT
              </div>

              {/* Course Image */}
              <div style={{
                height: "180px",
                background: `linear-gradient(135deg, var(--brand-soft) 0%, var(--accent-soft) 100%)`,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                position: "relative"
              }}>
                <img 
                  src={course.image || "/images/course-placeholder.jpg"} 
                  alt={course.title}
                  style={{
                    width: "100%",
                    height: "100%",
                    objectFit: "cover"
                  }}
                />
              </div>

              {/* Course Content */}
              <div style={{ padding: "1.5rem" }}>
                <h3 style={{
                  fontSize: "1.1rem",
                  fontWeight: 700,
                  color: "var(--text)",
                  marginBottom: "0.5rem",
                  lineHeight: 1.4,
                  display: "-webkit-box",
                  WebkitLineClamp: 2,
                  WebkitBoxOrient: "vertical",
                  overflow: "hidden"
                }}>
                  {course.title}
                </h3>

                <p style={{
                  color: "var(--muted)",
                  fontSize: "0.9rem",
                  marginBottom: "1rem",
                  lineHeight: 1.5,
                  display: "-webkit-box",
                  WebkitLineClamp: 3,
                  WebkitBoxOrient: "vertical",
                  overflow: "hidden"
                }}>
                  {course.description || "Master this in-demand skill with comprehensive training from industry experts."}
                </p>

                <div style={{
                  display: "flex",
                  alignItems: "center",
                  gap: "0.5rem",
                  marginBottom: "1rem"
                }}>
                  <div style={{
                    display: "flex",
                    gap: "0.25rem",
                    alignItems: "center"
                  }}>
                    {[...Array(5)].map((_, i) => (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill={i < (course.rating || 4.5) ? "var(--brand)" : "var(--border)"}>
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                  </div>
                  <span style={{
                    color: "var(--muted)",
                    fontSize: "0.85rem",
                    fontWeight: 600
                  }}>
                    {course.rating || "4.8"} ({Math.floor(Math.random() * 5000) + 1000})
                  </span>
                </div>

                <div style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  marginBottom: "1rem"
                }}>
                  <div style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "0.5rem"
                  }}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--muted)">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span style={{
                      color: "var(--muted)",
                      fontSize: "0.85rem"
                    }}>
                      Verified
                    </span>
                  </div>
                  
                  <div style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "0.5rem"
                  }}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--muted)">
                      <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
                    </svg>
                    <span style={{
                      color: "var(--muted)",
                      fontSize: "0.85rem"
                    }}>
                      {Math.floor(Math.random() * 20) + 5}h
                    </span>
                  </div>
                </div>

                <a
                  href={course.url || "#"}
                  style={{
                    display: "block",
                    width: "100%",
                    padding: "0.75rem",
                    background: "var(--brand)",
                    color: "var(--bg)",
                    textDecoration: "none",
                    borderRadius: "8px",
                    textAlign: "center",
                    fontWeight: 600,
                    fontSize: "0.9rem",
                    transition: "all 0.3s ease",
                    border: "none",
                    cursor: "pointer"
                  }}
                >
                  Enroll for Free
                </a>
              </div>
            </div>
          ))}
        </div>

        {/* Load More Section */}
        <div style={{
          textAlign: "center",
          marginTop: "3rem"
        }}>
          <a
            href="/deals"
            style={{
              padding: "1rem 2.5rem",
              borderRadius: "12px",
              background: "var(--brand)",
              color: "var(--bg)",
              textDecoration: "none",
              fontSize: "1rem",
              fontWeight: 700,
              display: "inline-flex",
              alignItems: "center",
              gap: "0.5rem",
              transition: "all 0.3s ease",
              boxShadow: "0 4px 20px -4px hsla(45, 95%, 58%, 0.4)"
            }}
          >
            View All Free Courses
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
            </svg>
          </a>
        </div>
      </section>

      {/* Categories Section */}
      <section class="card-gradient" style={{ padding: "4rem 1rem" }}>
        <div class="container">
          <h2 style={{
            fontSize: "clamp(1.8rem, 4vw, 2.5rem)",
            fontWeight: 800,
            color: "var(--text)",
            textAlign: "center",
            marginBottom: "3rem"
          }}>
            <span style={{ color: "var(--brand)" }}>Popular</span> Categories
          </h2>
          
          <div style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))",
            gap: "1rem",
            marginBottom: "2rem"
          }}>
            {categories.map((category) => (
              <a
                href={`/categories/${slugifyCategory(category.name)}`}
                style={{
                  display: "block",
                  padding: "1rem",
                  background: "var(--card)",
                  border: "1px solid var(--border)",
                  borderRadius: "12px",
                  textAlign: "center",
                  color: "var(--text)",
                  textDecoration: "none",
                  fontSize: "0.9rem",
                  fontWeight: 600,
                  transition: "all 0.3s ease"
                }}
              >
                {category.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>
  </div>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-gradient {
      background: linear-gradient(135deg, hsl(222, 47%, 7%) 0%, hsl(222, 43%, 10%) 100%);
    }

    .card-gradient {
      background: var(--bg);
    }
  </style>
</Layout>
