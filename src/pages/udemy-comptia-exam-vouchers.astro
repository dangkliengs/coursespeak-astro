---
import Layout from "../layouts/Layout.astro";
import { comptiaVouchers, comptiaGroupBlurbs, ALL_VOUCHERS_URL } from "../data/vouchers";
const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-comptia-exam-vouchers";
const pageTitle = `Udemy CompTIA Exam Vouchers ${currentYear}: Save 10% | CourseSpeak`;
const pageDescription = `All 15 official CompTIA exam vouchers on Udemy ${currentYear} — Security+ SY0-701, A+ Core 1 & 2, Network+ N10-009, CySA+, PenTest+, Linux+, CloudNetX. Save ~10% vs $239–$404 retail, valid 9+ months, Second Chance included.`;
const groups: Record<string, typeof comptiaVouchers> = {};
for (const vv of comptiaVouchers) { (groups[vv.category] ||= []).push(vv); }
const faqs = [
  { q: "What does each CompTIA voucher cost through Udemy?", a: "Udemy cuts roughly 10% off retail. Indicative retail: A+ ~$253 per core (two cores required), Network+ ~$358, Security+ ~$404, CySA+ and PenTest+ ~$392, Linux+/Cloud+/Server+ ~$358. Confirm the live Udemy price before buying — it varies by region." },
  { q: "Does one A+ voucher cover both Core 1 and Core 2?", a: "No. A single A+ voucher covers either the Core 1 or the Core 2 exam — never both. You need two vouchers to earn the full A+ certification. Budget for both before you start." },
  { q: "How does Second Chance work on CompTIA exams?", a: "Buy the voucher + Second Chance bundle together. If you fail, report it from My learning → Certifications within 9 months. Udemy verifies your result with CompTIA and issues a brand-new voucher code, usually within 7 days. The replacement is valid at least 9 more months. One extra attempt only, non-refundable." },
  { q: "Online or in-person — which should I choose?", a: "Both use the same voucher. Online proctored exams (via Pearson VUE OnVUE) suit quiet home setups with a webcam; test centers suit anyone with unreliable internet or strict ID requirements. The exam content and passing score are identical." },
  { q: "Which CompTIA cert should I take first?", a: "Zero experience: Tech+ then A+. With 6–12 months of IT exposure: Network+ then Security+ SY0-701 — the combination most help-desk-to-SOC job posts ask for. After Security+: CySA+ for defense, PenTest+ for offense, Linux+ or Cloud+ for infrastructure." },
  { q: "Can I use an Udemy coupon on the voucher itself?", a: "No — coupons never apply to vouchers. They do apply to the prep courses, which is where the real saving stacks: a $15 prep course plus a discounted voucher beats full-price training plus retail exam fees." },
];
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl, name: pageTitle, description: pageDescription, isPartOf: { "@id": "https://coursespeak.com/#website" }, inLanguage: "en-US", datePublished: "2025-01-01", dateModified: lastModified, author: { "@id": "https://coursespeak.com/#author" } },
  { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "CompTIA", item: canonicalUrl }] },
  { "@type": "ItemList", name: `CompTIA Exam Vouchers ${currentYear}`, numberOfItems: comptiaVouchers.length, itemListElement: comptiaVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })) },
  { "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about" },
]};
---
<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} type="article" image="/assets/images/vouchers/provider-comptia.svg" ogImageType="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .voucher-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
  .voucher-card:hover{transform:translateY(-3px);border-color:var(--brand)}
  .voucher-card img{width:100%;height:140px;object-fit:cover;background:#fff}
  @media(max-width:768px){.grid-3{grid-template-columns:1fr!important}}
</style>
<section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
  <div style={{ maxWidth: "880px", margin: "0 auto" }}>
    <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>CompTIA Vouchers · Updated {new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" })}</div>
    <h1 style={{ fontSize: "clamp(1.8rem,4.5vw,2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
      <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Udemy CompTIA Exam Vouchers</span><br />
      <span style={{ color: "var(--text)" }}>Security+ · A+ · Network+ & 12 More</span>
    </h1>
    <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "680px", margin: "0 auto 1.5rem", lineHeight: 1.7 }}>
      All 15 official CompTIA vouchers on Udemy — from Tech+ and A+ through Security+ SY0-701, CySA+, PenTest+,
      Linux+, and the new CloudNetX and DataAI exams. Save roughly 10% versus $239–$404 retail fees, valid at least
      9 months, with Second Chance retake cover on almost every exam. CompTIA vouchers arrived on Udemy in August 2025;
      every voucher below schedules through CompTIA/Pearson VUE, online proctored or in person.
    </p>
    <img src="/assets/images/vouchers/provider-comptia.svg" alt="CompTIA exam vouchers — Security+, A+, Network+" width="480" height="270" loading="eager" fetchpriority="high" style={{ width: "100%", maxWidth: "720px", height: "auto", borderRadius: "16px", border: "1px solid var(--border)", margin: "0 auto 1.5rem", display: "block", background: "#fff" }} />
    <div style={{ display: "flex", gap: "0.75rem", justifyContent: "center", flexWrap: "wrap" }}>
      <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary btn-lg" style={{ borderRadius: "999px" }}>Browse All CompTIA Vouchers →</a>
      <a href="/udemy-certification-vouchers" class="btn btn-ghost btn-lg" style={{ borderRadius: "999px" }}>All Providers</a>
    </div>
    <p style={{ fontSize: "0.78rem", color: "var(--muted)", marginTop: "0.9rem" }}>Sponsored — CourseSpeak may earn a commission at no extra cost to you. <a href="/affiliate-disclosure" style={{ color: "var(--brand)" }}>Affiliate Disclosure</a></p>
  </div>
</section>
<section style={{ paddingBottom: "2rem" }}>
  <div class="container"><div class="stat-grid" style={{ gridTemplateColumns: "repeat(3,1fr)", maxWidth: "600px" }}>
    <div class="stat-box"><div class="stat-value">15</div><div class="stat-label">Official vouchers</div></div>
    <div class="stat-box"><div class="stat-value">~10%</div><div class="stat-label">Saved vs retail</div></div>
    <div class="stat-box"><div class="stat-value">≥9 mo</div><div class="stat-label">Validity</div></div>
  </div></div>
</section>
<section style={{ padding: "1rem 1rem 3rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <div style={{ textAlign: "center", marginBottom: "1.5rem" }}>
      <span class="section-title">Full list</span>
      <h2 class="section-heading">All 15 CompTIA Exam Vouchers</h2>
      <p style={{ color: "var(--muted)", fontSize: "0.9rem" }}>Each card shows the real exam-ticket artwork and links to the official Udemy voucher page.</p>
    </div>
    {Object.entries(groups).map(([cat, list]) => (
      <div style={{ marginBottom: "2rem" }}>
        <h3 style={{ fontSize: "1.05rem", fontWeight: 800, margin: "0 0 0.9rem" }}>{cat}</h3>
        <p style={{ margin: "0.35rem 0 1rem", color: "var(--muted)", fontSize: "0.88rem", lineHeight: 1.65 }}>{comptiaGroupBlurbs[cat]}</p>
        <div class="grid-3" style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: "1rem" }}>
          {list.map((vv) => (
            <div class="voucher-card">
              <img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" />
              <div style={{ padding: "1.1rem 1.2rem", display: "flex", flexDirection: "column", gap: "0.5rem", flex: 1 }}>
                <span style={{ fontSize: "0.72rem", fontWeight: 800, letterSpacing: "0.05em", textTransform: "uppercase", color: "var(--brand)" }}>{vv.code}{vv.badge ? ` · ${vv.badge}` : ""}</span>
                <div style={{ fontWeight: 700 }}>{vv.title}</div>
                <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.83rem", lineHeight: 1.6 }}>{vv.blurb}</p>
                <a href={vv.url} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary" style={{ borderRadius: "8px", marginTop: "0.3rem" }}>Get Voucher →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "1.5rem" }}>
      <h3 style={{ margin: "0 0 0.5rem", fontSize: "1rem" }}>How to study for CompTIA on a budget</h3>
      <p style={{ color: "var(--muted)", fontSize: "0.92rem", lineHeight: 1.7, margin: 0 }}>Pair each voucher with a coupon-discounted prep course: Jason Dion's and Professor Messer-style courses dominate the bestseller lists for A+, Network+, and Security+. Run one full practice exam per week, drill the acronyms daily, and book the exam only after two consecutive passing practice scores. Browse <a href="/deals" style={{ color: "var(--brand)", fontWeight: 600 }}>verified prep-course coupons</a>, or compare <a href="/udemy-aws-exam-vouchers" style={{ color: "var(--brand)", fontWeight: 600 }}>AWS vouchers</a> and <a href="/udemy-microsoft-exam-vouchers" style={{ color: "var(--brand)", fontWeight: 600 }}>Microsoft vouchers</a>.</p>
    </div>
  </div>
</section>
<section style={{ padding: "2rem 1rem 4rem", background: "var(--bg-secondary)" }}>
  <div class="container" style={{ maxWidth: "900px" }}>
    <h2 class="section-heading" style={{ textAlign: "center", marginBottom: "1.5rem" }}>CompTIA Voucher FAQ</h2>
    <div style={{ display: "grid", gap: "0.75rem" }}>
      {faqs.map((f) => (
        <details style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: "12px", padding: "1.1rem 1.25rem" }}>
          <summary style={{ fontWeight: 700, cursor: "pointer" }}>{f.q}</summary>
          <p style={{ color: "var(--muted)", margin: "0.6rem 0 0", lineHeight: 1.7, fontSize: "0.92rem" }}>{f.a}</p>
        </details>
      ))}
    </div>
    <div class="cta-box" style={{ marginTop: "2.5rem" }}>
      <span class="cta-eyebrow">Commit today</span>
      <h2>Lock In Your CompTIA Exam Date</h2>
      <p class="cta-subtext">Valid 9+ months, online or in person, Second Chance available.</p>
      <div class="cta-actions"><a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary btn-lg" style="border-radius:999px">Get CompTIA Vouchers →</a></div>
    </div>
  </div>
</section>
</Layout>
