---
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-v2.css";
import { comptiaVouchers, comptiaGroupBlurbs, ALL_VOUCHERS_URL, voucherPageCount, currentExamCount, voucherPrice } from "../data/vouchers";
const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-comptia-exam-vouchers";
const pageTitle = `Udemy CompTIA Exam Vouchers ${currentYear}: Prices & Current Codes`;
const pageDescription = `All 15 Udemy CompTIA exam vouchers in ${currentYear}: Security+ SY0-701, A+ 220-1201/1202, Network+ N10-009, CySA+ CS0-004. Retail vs Udemy prices, 2026 exam changes and Retake Assurance.`;
const groups: Record<string, typeof comptiaVouchers> = {};
for (const vv of comptiaVouchers) { (groups[vv.category] ||= []).push(vv); }

const quickPicks = [
  { voucher: comptiaVouchers[3], label: "Security+ · most-booked" },
  { voucher: comptiaVouchers[1], label: "A+ · two cores required" },
  { voucher: comptiaVouchers[2], label: "Network+ · current V9" },
];

const priceRows = [
  { cert: "Tech+", code: "FC0-U71", retail: 129, note: "Entry-level; no prerequisites." },
  { cert: "A+ (per core)", code: "220-1201 / 220-1202", retail: 274, note: "Two exams required; budget for two vouchers." },
  { cert: "Network+", code: "N10-009", retail: 399, note: "N10-010 is a draft; no launch date." },
  { cert: "Security+", code: "SY0-701", retail: 439, note: "SY0-801 launches Nov 17, 2026." },
  { cert: "CySA+", code: "CS0-004", retail: 439, note: "CS0-003 retires Dec 22, 2026." },
  { cert: "PenTest+", code: "PT0-003", retail: 439, note: "Current V3; no PT0-004 announced." },
  { cert: "SecurityX", code: "CAS-005", retail: 544, note: "Expert-level; pass/fail scoring." },
  { cert: "Linux+", code: "XK0-006", retail: 399, note: "V8, launched July 2025." },
  { cert: "Cloud+", code: "CV0-004", retail: 399, note: "V4; vendor-neutral cloud operations." },
  { cert: "Server+", code: "SK0-005", retail: 399, note: "SK0-006 is a draft; no launch date." },
  { cert: "CloudNetX", code: "CNX-001", retail: 544, note: "Expert-level; pass/fail scoring." },
  { cert: "Data+", code: "DA0-002", retail: 264, note: "V2, launched October 2025." },
  { cert: "DataSys+", code: "DS0-002", retail: 399, note: "V2; DS0-001 retires Apr 16, 2027." },
  { cert: "DataAI", code: "DY0-001", retail: 544, note: "Formerly DataX; pass/fail scoring." },
  { cert: "Project+", code: "PK0-005", retail: 399, note: "V5; IT project management." },
].map((r) => ({
  ...r,
  low: Math.round(r.retail * 0.875),
  high: Math.round(r.retail * 0.9),
  saveLow: r.retail - Math.round(r.retail * 0.9),
  saveHigh: r.retail - Math.round(r.retail * 0.875),
}));

const faqs = [
  { q: "Which CompTIA vouchers can I buy on Udemy?", a: "Udemy lists 15 CompTIA voucher products, and all 15 map to exams you can book today: Tech+ FC0-U71, A+ 220-1201/220-1202, Network+ N10-009, Security+ SY0-701, CySA+ CS0-004, PenTest+ PT0-003, SecurityX CAS-005, Linux+ XK0-006, Cloud+ CV0-004, Server+ SK0-005, CloudNetX CNX-001, Data+ DA0-002, DataSys+ DS0-002, DataAI DY0-001 and Project+ PK0-005. Unlike AWS, each CompTIA voucher is sold for a specific exam, so the exam code on the voucher matters." },
  { q: "How much do CompTIA vouchers cost on Udemy?", a: "CompTIA's US retail fees run from $129 for Tech+ to $544 for SecurityX, CloudNetX and DataAI. Udemy advertises about 10% off, and US checkouts in July 2026 showed 12.5% off, so expect roughly $113–$116 for Tech+, $384–$395 for Security+, $349–$359 for Network+ or Linux+, and $476–$490 for the $544 expert exams. Regional pricing varies, so confirm the live price at checkout." },
  { q: "Does one A+ voucher cover both Core 1 and Core 2?", a: "No. One CompTIA A+ voucher covers either Core 1 (220-1201) or Core 2 (220-1202), never both. You need two vouchers to earn the certification. At $274 retail per core, that is $548 retail, or roughly $480–$494 through Udemy for both." },
  { q: "How much does CompTIA A+ cost in total?", a: "Budget for two exam vouchers, not one. Retail is $274 per core, so $548 for both exams. Udemy vouchers at roughly 10–12.5% off bring the pair to about $480–$494. Training, practice tests and any retake cover are extra. Do not buy both vouchers months in advance unless you are ready to sit both exams inside the voucher window." },
  { q: "Which Security+ version should I buy — SY0-701 or SY0-801?", a: "SY0-701 is the current exam and the version Udemy currently lists. SY0-801 launches on November 17, 2026, and SY0-701 retires on June 11, 2027 in English (translations retire August 13, 2027). If you will sit before June 11, 2027, SY0-701 is fine. If your test date could slip past that, wait for the SY0-801 voucher listing — a SY0-701 voucher cannot be used for SY0-801." },
  { q: "What happens to my voucher when an exam retires?", a: "The retirement date overrides the voucher expiry date. CompTIA vouchers are exam-specific, so a voucher for a retiring exam cannot be used for its replacement. If you already hold a SY0-701, CS0-003 or DS0-001 voucher, sit the exam before the last date. If you have not bought yet and your test date is after the retirement, buy the new-code voucher instead. Vouchers are non-refundable." },
  { q: "Is CySA+ CS0-004 current?", a: "Yes. CySA+ CS0-004 is the current exam. The older CS0-003 retires on December 22, 2026 in English. Buy the CS0-004 voucher, and check that the code shown at scheduling is CS0-004 — a CS0-003 voucher will not book the new exam." },
  { q: "What is the current DataSys+ exam code?", a: "DataSys+ V2 is DS0-002, launched October 13, 2026. The older DS0-001 retires on April 16, 2027. Udemy's DataSys+ page is generic rather than version-specific, so confirm DS0-002 when you schedule. If you are testing after April 16, 2027, do not buy a DS0-001 voucher." },
  { q: "Is there a new Network+ or Server+ exam?", a: "Only drafts. N10-010 and SK0-006 objectives exist, but CompTIA has not announced launch dates as of November 3, 2026. N10-009 and SK0-005 remain the current exams and the versions Udemy sells. Do not delay a planned exam waiting for a draft that has no date." },
  { q: "How does Retake Assurance work on CompTIA exams?", a: "Retake Assurance is Udemy's optional CompTIA retake add-on. You must buy it together with the original voucher — it cannot be added after you fail. If you do not pass, rebook the same exam and use the same voucher code; there is no new code to wait for. It covers one extra attempt and must be used before the voucher expires. If you pass first time, the add-on expires unused and is not refunded." },
  { q: "Is CompTIA Retake Assurance the same as AWS Second Chance?", a: "No. Both cover one extra attempt and both must be bought with the original voucher, but the mechanics differ. CompTIA Retake Assurance reuses the same voucher code and needs no claim or verification step. AWS Second Chance requires you to report the failed result in My learning, then Udemy verifies it and issues a new code, usually within seven days. Do not follow AWS Second Chance instructions for a CompTIA voucher." },
  { q: "How do I schedule a CompTIA exam with a voucher?", a: "Sign in to your CompTIA certification account and follow the scheduling link to Pearson VUE. Choose an online proctored exam or a test centre, then paste the voucher code from My learning → Certifications at the payment step. Vouchers are valid only in the country of purchase, and the name on your CompTIA profile must match your photo ID." },
  { q: "Can I reschedule or cancel a CompTIA exam?", a: "Yes, but you must reschedule or cancel at least 24 hours before the appointment. Later changes or a no-show can forfeit the exam fee and the voucher. The voucher's own expiry date does not move when you reschedule, and it cannot be extended." },
  { q: "Can I get a refund on an Udemy CompTIA voucher?", a: "No. Udemy exam vouchers and Retake Assurance are non-refundable and non-transferable. If you cancel an appointment under CompTIA's policy, that affects the appointment, not the voucher purchase. Read the live terms before paying, and do not buy a voucher until your exam date is realistic." },
  { q: "Do CompTIA vouchers expire?", a: "Yes. Udemy CompTIA vouchers are valid for at least nine months from purchase, and the expiry date cannot be extended. CompTIA direct vouchers are valid for 12 months. The exam retirement date can shorten the effective life of a voucher, which is why buying months ahead for a retiring exam is risky." },
  { q: "Can I use an Udemy coupon on a CompTIA voucher?", a: "No. Udemy coupons and promo codes never apply to exam vouchers. Udemy credits can sometimes be applied at checkout. Coupons do apply to the prep courses, which is where the real saving stacks: a discounted course plus a discounted voucher beats full-price training plus a retail exam fee." },
  { q: "Are Udemy CompTIA vouchers legitimate?", a: "Yes. Udemy is the seller; CompTIA owns the certification and Pearson VUE delivers the exam. The code appears in My learning → Certifications and is redeemed in the CompTIA/Pearson VUE checkout. Buy from the official Udemy listing, and avoid anyone selling codes by direct message or bank transfer." },
  { q: "Which CompTIA cert should I take first?", a: "No IT experience: Tech+ first, then A+. Some help-desk exposure: Network+ then Security+ — the combination most IT-to-security job posts ask for. After Security+: CySA+ for defence, PenTest+ for offensive security, Linux+ or Cloud+ for infrastructure. Data roles: Data+ then DataSys+ then DataAI. Project delivery: Project+." },
];

const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl, name: pageTitle, description: pageDescription, image: "https://coursespeak.com/images/og/og-comptia-vouchers.png", isPartOf: { "@id": "https://coursespeak.com/#website" }, inLanguage: "en-US", datePublished: "2025-01-01", dateModified: lastModified, author: { "@id": "https://coursespeak.com/#author" }, breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` } },
  { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "CompTIA", item: canonicalUrl }] },
  { "@type": "ItemList", name: `CompTIA Exam Vouchers ${currentYear}`, numberOfItems: comptiaVouchers.length, itemListElement: comptiaVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })) },
  { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about" },
]};
---
<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} type="article" image="/images/og/og-comptia-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .voucher-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
  .voucher-card:hover{transform:translateY(-3px);border-color:var(--brand)}
  .voucher-card img{width:100%;height:140px;object-fit:cover;background:#fff}
  .compare-table{width:100%;border-collapse:collapse;font-size:.86rem;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .compare-table th,.compare-table td{padding:.7rem .9rem;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
  .compare-table thead th{background:var(--bg-secondary);font-weight:700}
  .compare-table tbody tr:last-child td{border-bottom:0}
  .table-wrap{overflow-x:auto;border-radius:12px}
  .toc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem 1rem;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem}
  .toc a{color:var(--muted);text-decoration:none;font-size:.86rem;line-height:1.5}
  .toc a:hover{color:var(--brand)}
  .callout{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--brand);border-radius:0 12px 12px 0;padding:1rem 1.15rem}
  .choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .choice-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.2rem 1.3rem}
  .choice-card h3{margin:0 0 .35rem;font-size:1.02rem}
  .choice-card p{margin:.4rem 0;color:var(--muted);font-size:.86rem;line-height:1.6}
  .choice-card .price{color:var(--brand);font-weight:800;font-size:1.15rem}
  .related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
  .related-grid a{display:block;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:.85rem 1rem;text-decoration:none}
  .related-grid strong{display:block;color:var(--text);font-size:.9rem}
  .related-grid span{display:block;color:var(--muted);font-size:.8rem;margin-top:.2rem}
  @media(max-width:768px){.grid-3,.choice-grid,.related-grid,.toc{grid-template-columns:1fr!important}.compare-table{min-width:820px}}
</style>

<section class="vp-hero">
  <div class="container vp-hero-grid">
    <div>
      <div class="vp-eyebrow">CompTIA Vouchers · Checked {updatedLong}</div>
      <h1>
        <span class="vp-gradient">Udemy CompTIA Exam Vouchers {currentYear}</span>
        <span class="vp-title-sub">Prices, current codes & Retake Assurance</span>
      </h1>
      <p class="vp-lede">
        Udemy lists <strong>15 CompTIA voucher products</strong>, all bookable today. Prices run 10–12.5% below retail —
        <strong>$113 for Tech+</strong> to <strong>$476–$490 for SecurityX, CloudNetX and DataAI</strong>.
        Security+, CySA+ and DataSys+ transition between November 2026 and April 2027.
      </p>
      <div class="vp-chips">
        <span class="vp-chip"><strong>15</strong> current exams</span>
        <span class="vp-chip">From <strong>$113</strong></span>
        <span class="vp-chip">Retake Assurance available</span>
        <span class="vp-chip">9+ months validity</span>
      </div>
      <div class="vp-hero-actions">
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary btn-lg" style={{ borderRadius: "999px" }}>Browse All 15 Vouchers →</a>
        <a href="#vouchers" class="btn btn-ghost btn-lg" style={{ borderRadius: "999px" }}>See Voucher List</a>
      </div>
      <p class="vp-meta">
        By <a href="/about#author">Josh Smith</a>, Founder & Editor · Reviewed {updatedLong} ·
        Sources: <a href="https://www.comptia.org/en-us/certifications/" target="_blank" rel="noopener noreferrer">CompTIA certification pages</a> and <a href="https://www.udemy.com/all-certification-vouchers/" target="_blank" rel="noopener noreferrer">Udemy voucher catalogue</a>
      </p>
      <p class="vp-disclosure">Sponsored — CourseSpeak may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a></p>
    </div>
    <aside class="vp-hero-card" aria-label="Top CompTIA vouchers">
      <div class="vp-hero-card-head">
        <div>
          <span class="vp-kicker">Top picks</span>
          <strong>Most-booked CompTIA exams</strong>
        </div>
        <span class="vp-live">Prices live</span>
      </div>
      {quickPicks.map((p) => (
        <a class="vp-quick-row" href={p.voucher.url} target="_blank" rel="sponsored noopener noreferrer">
          <span class="vp-quick-info"><strong>{p.voucher.code}</strong><span>{p.label}</span></span>
          <span class="vp-quick-price"><strong>{voucherPrice(p.voucher)}</strong><span>Udemy</span></span>
        </a>
      ))}
      <div class="vp-hero-card-foot">
        <span>Retail vs Udemy checked {updatedLong}</span>
        <a href="#vouchers">All 15 →</a>
      </div>
    </aside>
  </div>
</section>

<section id="vouchers" class="vp-listing">
  <div class="container" style={{ maxWidth: "1180px" }}>
    <div class="vp-section-head">
      <div>
        <span class="section-title">Voucher list</span>
        <h2>All 15 CompTIA voucher products on Udemy</h2>
        <p>One product per exam, grouped by career track. Every card shows the current exam code, the voucher-only price and a direct link to the official Udemy listing.</p>
      </div>
      <a class="vp-head-link" href="#prices">Compare prices ↓</a>
    </div>
    {Object.entries(groups).map(([cat, list]) => (
      <div style={{ marginBottom: "1.8rem" }}>
        <h3 style={{ fontSize: "1.02rem", fontWeight: 800, margin: "0 0 0.35rem" }}>{cat}</h3>
        <p style={{ margin: "0 0 0.85rem", color: "var(--muted)", fontSize: "0.86rem", lineHeight: 1.6 }}>{comptiaGroupBlurbs[cat]}</p>
        <div class="vp-voucher-grid">
          {list.map((vv) => (
            <a class="vp-voucher-card" href={vv.url} target="_blank" rel="sponsored noopener noreferrer">
              <div class="vp-voucher-media"><img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" /></div>
              <div class="vp-voucher-body">
                <span class="vp-voucher-code">{vv.code}{vv.badge ? ` · ${vv.badge}` : ""}</span>
                <div class="vp-voucher-title">{vv.title}</div>
                <p class="vp-voucher-blurb">{vv.blurb}</p>
                {vv.note && <p class="vp-voucher-note">{vv.note}</p>}
                <div class="vp-voucher-footer">
                  <span class="vp-voucher-price">{voucherPrice(vv)}<span>Udemy</span></span>
                  <span class="vp-voucher-cta">Get voucher →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
    <p class="vp-list-note">CompTIA vouchers are <em>exam-specific</em>, not level-wide. A SY0-701 voucher will not book SY0-801, and a CS0-003 voucher will not book CS0-004. This guide separates the current code from the retiring one, does the two-voucher A+ maths, and explains Retake Assurance — the CompTIA retake add-on that reuses the same voucher code.</p>
    <div class="callout" style={{ marginTop: "1.2rem" }}>
      <h3 style={{ margin: "0 0 0.4rem", fontSize: "1rem" }}>Why 15 products for 15 exams?</h3>
      <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}>Each CompTIA certification has its own exam code and its own voucher. There is no level-wide CompTIA voucher like the AWS Associate or Professional voucher. That is why a version transition matters: the voucher you buy is locked to the exam code shown on the page, and cannot be redirected to the new exam.</p>
    </div>
  </div>
</section>

<section style={{ padding: "0 1rem 2rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <div class="callout" style={{ marginBottom: "1rem" }}>
      <h2 style={{ margin: "0 0 0.5rem", fontSize: "1.1rem" }}>Quick answer: which CompTIA voucher do you need?</h2>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>No IT experience:</strong> Tech+ FC0-U71 (~$113–$116) then A+. A+ is two exams, so budget for two vouchers (~$480–$494 total).</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Best job value:</strong> Security+ SY0-701 (~$384–$395) or Network+ N10-009 (~$349–$359). Security+ is the baseline most IT-to-security roles ask for.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Need a safety net:</strong> add Retake Assurance at purchase. It covers one extra attempt on the same voucher code and cannot be added after you fail.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Testing in 2027:</strong> check the transition table first. A SY0-701, CS0-003 or DS0-001 voucher cannot be used for the replacement exam.</p>
    </div>
    <nav class="vp-anchor-bar" aria-label="On this page">
      <a href="#vouchers">1. All 15 vouchers</a>
      <a href="#prices">2. Voucher prices</a>
      <a href="#changes">3. Exam changes</a>
      <a href="#which">4. Which voucher</a>
      <a href="#redeem">5. Buy & redeem</a>
      <a href="#retake">6. Retake Assurance</a>
      <a href="#compare">7. Udemy vs direct</a>
      <a href="#legit">8. Legitimacy</a>
      <a href="#worth">9. Is it worth it?</a>
      <a href="#study">10. How to prepare</a>
      <a href="#faq">11. FAQ</a>
    </nav>
  </div>
</section>

<section id="prices" style={{ padding: "1rem 1rem 2.5rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <span class="section-title">Prices</span>
    <h2 class="section-heading">How much do Udemy CompTIA vouchers cost?</h2>
    <p style={{ color: "var(--muted)", fontSize: "0.95rem", lineHeight: 1.75, maxWidth: "840px", margin: "0.75rem 0 1.25rem" }}>
      CompTIA sets a different retail fee for each exam, and Udemy resells one prepaid attempt at a discount.
      The important point is that <strong style={{ color: "var(--text)" }}>one voucher equals one exam attempt</strong> — A+ needs two vouchers,
      and a Retake Assurance purchase is the only way to add a second attempt without paying full price again.
    </p>
    <div class="table-wrap"><table class="compare-table">
      <thead><tr><th>Certification</th><th>Current code</th><th>CompTIA retail</th><th>Udemy (approx.)</th><th>You save</th><th>Version note</th></tr></thead>
      <tbody>
        {priceRows.map((r) => (
          <tr>
            <td><strong>{r.cert}</strong></td>
            <td>{r.code}</td>
            <td>${r.retail}</td>
            <td><strong>${r.low}–${r.high}</strong></td>
            <td>${r.saveLow}–${r.saveHigh}</td>
            <td><span style={{ color: "var(--muted)", fontSize: "0.8rem" }}>{r.note}</span></td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p style={{ color: "var(--muted)", fontSize: "0.8rem", margin: "0.7rem 0 1.25rem", lineHeight: 1.6 }}>
      Snapshot: November 3, 2026, USD, before tax. Udemy's page copy says "save 10%"; US checkouts in July 2026 showed 12.5% off
      (A+ $239.75, Security+ $384.12). The table shows the 10–12.5% range. Regional pricing and campaigns vary; confirm the live price at checkout.
    </p>

    <h3 style={{ fontSize: "1.05rem", margin: "0 0 0.5rem" }}>A+ is two exams — budget for two vouchers</h3>
    <div class="callout" style={{ borderLeftColor: "#d97706", marginBottom: "1.25rem" }}>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>One A+ voucher covers Core 1 or Core 2, not both.</strong> The current exams are 220-1201 (Core 1) and 220-1202 (Core 2). You must pass both to earn A+.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Retail:</strong> $274 per core, so $548 for both. <strong style={{ color: "var(--text)" }}>Udemy:</strong> about $240–$247 per core, so roughly <strong style={{ color: "var(--text)" }}>$480–$494 for the pair</strong>.</p>
