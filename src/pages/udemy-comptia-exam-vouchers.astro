---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-hub.css";
import allDeals from "../data/deals.json";
import { comptiaVouchers, comptiaGroupBlurbs, ALL_VOUCHERS_URL, voucherPrice } from "../data/vouchers";

const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-comptia-exam-vouchers";
const pageTitle = `CompTIA Exam Vouchers ${currentYear}: Prices, Current Codes & Retake Assurance`;
const pageDescription = `All 15 Udemy CompTIA exam vouchers in ${currentYear}: Security+ SY0-701, A+ 220-1201/1202, Network+ N10-009, CySA+ CS0-004. Retail vs Udemy prices, 2026 exam changes and Retake Assurance.`;
const pageKeywords = "CompTIA vouchers, Udemy CompTIA vouchers, Security+ SY0-701, A+ 220-1201, Network+ N10-009, CySA+ CS0-004, Retake Assurance, CompTIA exam discount";

const sources = [
  { label: "CompTIA certification pages", url: "https://www.comptia.org/en-us/certifications/" },
  { label: "Udemy voucher catalogue", url: ALL_VOUCHERS_URL },
  { label: "CompTIA exam objectives", url: "https://www.comptia.org/en-us/resources/exam-objectives" },
];

const groups: Record<string, typeof comptiaVouchers> = {};
for (const vv of comptiaVouchers) { (groups[vv.category] ||= []).push(vv); }

const priceRows = [
  { cert: "Tech+", code: "FC0-U71", retail: 129, note: "Entry-level; no prerequisites." },
  { cert: "A+ (per core)", code: "220-1201 / 220-1202", retail: 274, note: "Two exams required; budget for two vouchers." },
  { cert: "Network+", code: "N10-009", retail: 399, note: "N10-010 is a draft; no launch date." },
  { cert: "Security+", code: "SY0-701", retail: 439, note: "SY0-801 launches Nov 17, 2026." },
  { cert: "CySA+", code: "CS0-004", retail: 439, note: "CS0-003 retires Dec 22, 2026." },
  { cert: "PenTest+", code: "PT0-003", retail: 439, note: "Current V3; no PT0-004 announced." },
  { cert: "SecurityX", code: "CAS-005", retail: 544, note: "Expert-level; pass/fail scoring." },
  { cert: "Linux+", code: "XK0-006", retail: 399, note: "V8, launched July 2025." },
  { cert: "Cloud+", code: "CV0-004", retail: 399, note: "V4; vendor-neutral cloud operations." },
  { cert: "Server+", code: "SK0-005", retail: 399, note: "SK0-006 is a draft; no launch date." },
  { cert: "CloudNetX", code: "CNX-001", retail: 544, note: "Expert-level; pass/fail scoring." },
  { cert: "Data+", code: "DA0-002", retail: 264, note: "V2, launched October 2025." },
  { cert: "DataSys+", code: "DS0-002", retail: 399, note: "V2; DS0-001 retires Apr 16, 2027." },
  { cert: "DataAI", code: "DY0-001", retail: 544, note: "Formerly DataX; pass/fail scoring." },
  { cert: "Project+", code: "PK0-005", retail: 399, note: "V5; IT project management." },
].map((r) => ({
  ...r,
  low: Math.round(r.retail * 0.875),
  high: Math.round(r.retail * 0.9),
  saveLow: r.retail - Math.round(r.retail * 0.9),
  saveHigh: r.retail - Math.round(r.retail * 0.875),
}));

const changeRows = [
  { cert: "Security+", old: "SY0-701", next: "SY0-801", date: "SY0-801 launches November 17, 2026; SY0-701 English retires June 11, 2027 (translations August 13, 2027)", impact: "Udemy currently lists SY0-701. Buy it only if you will sit before retirement; a SY0-701 voucher cannot book SY0-801." },
  { cert: "CySA+", old: "CS0-003", next: "CS0-004", date: "CS0-003 retires December 22, 2026 (English)", impact: "Buy CS0-004. Old-code vouchers cannot be used for the new exam." },
  { cert: "DataSys+", old: "DS0-001", next: "DS0-002", date: "DS0-002 launched October 13, 2026; DS0-001 retires April 16, 2027", impact: "Udemy's page is generic. Confirm DS0-002 when scheduling; DS0-001 vouchers expire with the old exam." },
  { cert: "Network+", old: "N10-009", next: "N10-010 (draft)", date: "No launch date announced", impact: "N10-009 remains current. Do not wait for a draft with no date." },
  { cert: "Server+", old: "SK0-005", next: "SK0-006 (draft)", date: "No launch date announced", impact: "SK0-005 remains current. Do not wait for a draft with no date." },
  { cert: "A+", old: "220-1201 / 220-1202", next: "Same (V15)", date: "Launched March 25, 2025; estimated retirement around 2028", impact: "No action needed. V15 is current; the 2028 date is an estimate, not an official notice." },
];

const faqs = [
  { q: "Which CompTIA vouchers can I buy on Udemy?", cat: "catalog", a: "Udemy lists 15 CompTIA voucher products, and all 15 map to exams you can book today: Tech+ FC0-U71, A+ 220-1201/220-1202, Network+ N10-009, Security+ SY0-701, CySA+ CS0-004, PenTest+ PT0-003, SecurityX CAS-005, Linux+ XK0-006, Cloud+ CV0-004, Server+ SK0-005, CloudNetX CNX-001, Data+ DA0-002, DataSys+ DS0-002, DataAI DY0-001 and Project+ PK0-005. Unlike AWS, each CompTIA voucher is sold for a specific exam, so the exam code on the voucher matters." },
  { q: "How much do CompTIA vouchers cost on Udemy?", cat: "price", a: "CompTIA US retail fees run from $129 for Tech+ to $544 for SecurityX, CloudNetX and DataAI. Udemy advertises about 10% off, and US checkouts in July 2026 showed 12.5% off, so expect roughly $113–$116 for Tech+, $384–$395 for Security+, $349–$359 for Network+ or Linux+, and $476–$490 for the $544 expert exams. Regional pricing varies — confirm the live price at checkout." },
  { q: "Does one A+ voucher cover both Core 1 and Core 2?", cat: "exam", a: "No. One CompTIA A+ voucher covers either Core 1 (220-1201) or Core 2 (220-1202), never both. You need two vouchers to earn the certification. At $274 retail per core, that is $548 retail, or roughly $480–$494 through Udemy for both." },
  { q: "Which Security+ version should I buy — SY0-701 or SY0-801?", cat: "changes", a: "SY0-701 is the current exam and the version Udemy currently lists. SY0-801 launches November 17, 2026, and SY0-701 retires June 11, 2027 in English (translations August 13, 2027). If you will sit before June 11, 2027, SY0-701 is fine. If your date could slip past that, wait for the SY0-801 voucher listing — a SY0-701 voucher cannot be used for SY0-801." },
  { q: "What happens to my voucher when an exam retires?", cat: "changes", a: "The retirement date overrides the voucher expiry date. CompTIA vouchers are exam-specific, so a voucher for a retiring exam cannot be used for its replacement. If you already hold a SY0-701, CS0-003 or DS0-001 voucher, sit the exam before the last date. Vouchers are non-refundable." },
  { q: "Is CySA+ CS0-004 current?", cat: "changes", a: "Yes. CS0-004 is the current exam. The older CS0-003 retires December 22, 2026 in English. Buy the CS0-004 voucher, and check that the code shown at scheduling is CS0-004." },
  { q: "What is the current DataSys+ exam code?", cat: "changes", a: "DataSys+ V2 is DS0-002, launched October 13, 2026. The older DS0-001 retires April 16, 2027. Udemy's DataSys+ page is generic, so confirm DS0-002 when you schedule." },
  { q: "Is there a new Network+ or Server+ exam?", cat: "changes", a: "Only drafts. N10-010 and SK0-006 objectives exist, but CompTIA has not announced launch dates as of November 3, 2026. N10-009 and SK0-005 remain current and are the versions Udemy sells." },
  { q: "How does Retake Assurance work on CompTIA exams?", cat: "retake", a: "Retake Assurance is Udemy's optional CompTIA retake add-on. You must buy it together with the original voucher — it cannot be added after you fail. If you do not pass, rebook the same exam and use the same voucher code; there is no new code to wait for. It covers one extra attempt and must be used before the voucher expires. If you pass first time, the add-on expires unused and is not refunded." },
  { q: "Is CompTIA Retake Assurance the same as AWS Second Chance?", cat: "retake", a: "No. Both cover one extra attempt and both must be bought with the original voucher, but the mechanics differ. CompTIA Retake Assurance reuses the same voucher code and needs no claim. AWS Second Chance requires you to report the failed result in My learning, then Udemy verifies it and issues a new code, usually within seven days." },
  { q: "How do I schedule a CompTIA exam with a voucher?", cat: "booking", a: "Sign in to your CompTIA certification account and follow the scheduling link to Pearson VUE. Choose online proctoring or a test centre, then paste the voucher code from My learning → Certifications at payment. Vouchers are valid only in the country of purchase, and your CompTIA profile name must match your photo ID." },
  { q: "Can I reschedule or cancel a CompTIA exam?", cat: "booking", a: "Yes, but you must reschedule or cancel at least 24 hours before the appointment. Later changes or a no-show can forfeit the exam fee and the voucher. The voucher's own expiry date does not move when you reschedule, and it cannot be extended." },
  { q: "Can I get a refund on an Udemy CompTIA voucher?", cat: "booking", a: "No. Udemy exam vouchers and Retake Assurance are non-refundable and non-transferable. Cancelling an appointment under CompTIA's policy affects the appointment, not the voucher purchase." },
  { q: "Do CompTIA vouchers expire?", cat: "rules", a: "Yes. Udemy CompTIA vouchers are valid for at least nine months from purchase and cannot be extended. CompTIA direct vouchers are valid for 12 months. An exam retirement can shorten the effective life of a voucher, which is why buying months ahead for a retiring exam is risky." },
  { q: "Can I use an Udemy coupon on a CompTIA voucher?", cat: "price", a: "No. Udemy coupons and promo codes never apply to exam vouchers. Udemy credits can sometimes be applied at checkout. Coupons do apply to prep courses — a discounted course plus a discounted voucher beats full-price training plus a retail exam fee." },
  { q: "Are Udemy CompTIA vouchers legitimate?", cat: "trust", a: "Yes. Udemy is the seller; CompTIA owns the certification and Pearson VUE delivers the exam. The code appears in My learning → Certifications and is redeemed in the CompTIA/Pearson VUE checkout. Buy from the official Udemy listing, and avoid anyone selling codes by direct message or bank transfer." },
  { q: "Which CompTIA cert should I take first?", cat: "choice", a: "No IT experience: Tech+ then A+. Some help-desk exposure: Network+ then Security+ — the combination most IT-to-security posts ask for. After Security+: CySA+ for defence, PenTest+ for offensive security, Linux+ or Cloud+ for infrastructure. Data roles: Data+ then DataSys+ then DataAI. Project delivery: Project+." },
  { q: "Can I use a CompTIA voucher for a different exam?", cat: "rules", a: "No. CompTIA vouchers are exam-specific, not level-wide. A Security+ voucher books SY0-701 only — it cannot be redirected to Network+, SY0-801, or any other exam. Check the code before you pay, because the voucher is non-refundable." },
  { q: "Does the voucher include the exam objectives or a study guide?", cat: "rules", a: "No. A voucher buys one exam attempt only. CompTIA publishes the official exam objectives for free, and Udemy coupons work on prep courses — never on the voucher itself. Budget separately for training." },
  { q: "How do I know which exam code my voucher books?", cat: "booking", a: "The code is printed on the Udemy voucher product title and appears again when you schedule through Pearson VUE. For transitioning exams — Security+ SY0-701, CySA+ CS0-003, DataSys+ DS0-001 — confirm the exact code at scheduling before paying with the voucher." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      image: "https://coursespeak.com/images/og/og-comptia-vouchers.png",
      isPartOf: { "@id": "https://coursespeak.com/#website" },
      publisher: { "@id": "https://coursespeak.com/#organization" },
      inLanguage: "en-US",
      datePublished: "2025-01-01",
      dateModified: lastModified,
      author: { "@id": "https://coursespeak.com/#author" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      keywords: pageKeywords,
      about: [
        { "@type": "Organization", name: "CompTIA", sameAs: ["https://www.comptia.org/"] },
        { "@type": "Organization", name: "Pearson VUE", sameAs: ["https://www.pearsonvue.com/"] },
        { "@type": "Thing", name: "CompTIA certification exam vouchers", sameAs: ["https://www.udemy.com/all-certification-vouchers/"] },
      ],
      citation: sources.map((s) => s.url),
      speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", ".hb-sub", "#faq"] },
    },
    { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "CompTIA", item: canonicalUrl }] },
    { "@type": "ItemList", "@id": `${canonicalUrl}#vouchers`, name: `CompTIA Exam Vouchers ${currentYear}`, numberOfItems: comptiaVouchers.length, itemListElement: comptiaVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })) },
    { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#how-to-buy`,
      name: `How to buy and redeem a CompTIA voucher in ${currentYear}`,
      description: "Confirm the current exam code, buy the voucher with optional Retake Assurance, copy the code from My learning, and schedule through Pearson VUE.",
      totalTime: "PT10M",
      estimatedCost: { "@type": "MonetaryAmount", value: "384", currency: "USD" },
      step: [
        { "@type": "HowToStep", position: 1, name: "Confirm the exam code", text: "Check the version tables: SY0-701, CS0-004 and DS0-002 are current; avoid old-code vouchers for transitioning exams.", url: `${canonicalUrl}#changes` },
        { "@type": "HowToStep", position: 2, name: "Compare the live price", text: "Compare the Udemy price with CompTIA's retail fee. Expect roughly 10–12.5% off. A+ needs two vouchers.", url: `${canonicalUrl}#prices` },
        { "@type": "HowToStep", position: 3, name: "Buy with Retake Assurance if needed", text: "Retake Assurance must be bought with the original voucher and cannot be added after checkout.", url: `${canonicalUrl}#retake` },
        { "@type": "HowToStep", position: 4, name: "Copy the code", text: "Find the code in My learning → Certifications. Keep the expiry date.", url: `${canonicalUrl}#steps` },
        { "@type": "HowToStep", position: 5, name: "Schedule through Pearson VUE", text: "Log in to your CompTIA account, schedule online or at a test centre, and paste the code at payment.", url: `${canonicalUrl}#steps` },
      ],
    },
    { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about", knowsAbout: ["CompTIA certification", "CompTIA Security+", "CompTIA A+", "Udemy exam vouchers"] },
  ],
};

const ticker = [
  { voucher: comptiaVouchers[3], label: "Security+ · most-booked" },
  { voucher: comptiaVouchers[1], label: "A+ · two cores required" },
  { voucher: comptiaVouchers[2], label: "Network+ · current V9" },
  { voucher: comptiaVouchers[0], label: "Tech+ · entry level" },
];

const getDeal = (id: string) => {
  const deal = allDeals.find((d) => String(d.id) === id);
  return deal && Date.parse(String(deal.expiresAt)) > Date.now() ? deal : null;
};
const coursePickIds = [
  { id: "1731", topic: "/topics/comptia-security-plus", why: "Security+ SY0-701 prep" },
  { id: "9691", topic: "/topics/comptia-a", why: "A+ Core 1 220-1201 prep" },
  { id: "5882", topic: "/topics/comptia-network-plus", why: "Network+ N10-009 prep" },
  { id: "1597", topic: "/topics/comptia-tech-plus", why: "Tech+ FC0-U71 prep" },
];
const coursePicks = coursePickIds.map((pick) => ({ ...pick, deal: getDeal(pick.id) })).filter((pick) => pick.deal !== null);
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} publishedTime="2025-01-01" modifiedTime={lastModified} canonical={canonicalUrl} type="article" image="/images/og/og-comptia-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hb-hero">
  <div class="hb-hero-inner">
    <div>
      <span class="hb-eyebrow"><span class="hb-dot"></span> CompTIA voucher command center · checked <time datetime={lastModified}>{updatedLong}</time></span>
      <h1 class="hb-title">CompTIA Exam <span>Vouchers {currentYear}</span></h1>
      <p class="hb-sub">
        All <strong>15 CompTIA voucher products</strong>, current exam codes, live prices and the 2026–2027 version changes —
        plus <strong>Retake Assurance</strong>, A+'s two-voucher maths, and matching prep courses. One page, no dead codes.
      </p>
      <div class="hb-metrics">
        <div class="hb-metric"><b>15</b><span>current voucher products</span></div>
        <div class="hb-metric"><b>10–12.5%</b><span>typical saving</span></div>
        <div class="hb-metric"><b>9+ mo</b><span>voucher validity</span></div>
      </div>
      <div class="hb-actions">
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse all 15 vouchers →</a>
        <a href={comptiaVouchers[3].url} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-ghost">Get Security+ voucher →</a>
        <a href="#quick-answer" class="hb-btn-quiet">Read the 60-second answer ↓</a>
      </div>
      <p class="hb-meta">
        By <a href="/about#author">Josh Smith</a>, Founder &amp; Editor · Reviewed <time datetime={lastModified}>{updatedLong}</time> ·
        Sources: <a href="https://www.comptia.org/en-us/certifications/" target="_blank" rel="noopener noreferrer">CompTIA</a>,
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer">Udemy voucher catalogue</a> and
        <a href="https://www.comptia.org/en-us/resources/exam-objectives" target="_blank" rel="noopener noreferrer">official exam objectives</a>.
        Sponsored — we may earn a commission at no extra cost. <a href="/affiliate-disclosure">Disclosure</a>
      </p>
    </div>
    <aside class="hb-ticker" aria-label="Top CompTIA vouchers">
      <div class="hb-ticker-head"><b>Top CompTIA vouchers</b><span><span class="hb-dot"></span> Checked</span></div>
      {ticker.map((t) => (
        <a class="hb-ticker-row" href={t.voucher.url} target="_blank" rel="sponsored noopener noreferrer" style={{ textDecoration: "none" }}>
          <span class="hb-ticker-name" style={{ color: "var(--brand)" }}>{t.voucher.code}</span>
          <span class="hb-ticker-note">{t.label}</span>
          <span class="hb-ticker-price"><b>{voucherPrice(t.voucher)}</b><span>Udemy</span></span>
        </a>
      ))}
      <div class="hb-ticker-foot">Exam codes verified {updatedLong}. Prices vary by country — confirm at checkout.</div>
    </aside>
  </div>
</section>

<div class="hb-rail">
  <div class="hb-rail-inner">
    <a href="#quick-answer">01 Quick answer</a>
    <a href="#decision">02 Pick your path</a>
    <a href="#vouchers">03 All 15 vouchers</a>
    <a href="#prices">04 Prices</a>
    <a href="#courses">05 Prep courses</a>
    <a href="#changes">06 Exam changes</a>
    <a href="#which">07 Which cert</a>
    <a href="#retake">08 Retake Assurance</a>
    <a href="#steps">09 How to buy</a>
    <a href="#evidence">10 Evidence</a>
    <a href="#faq">11 FAQ</a>
  </div>
  <div class="hb-progress" id="hb-progress"></div>
</div>

<section class="hb-section" id="quick-answer">
  <div class="hb-answer">
    <span class="hb-answer-label">Answer first · fact-checked {updatedLong}</span>
    <h2>CompTIA vouchers: the 60-second answer</h2>
    <p>
      Udemy sells <strong>15 CompTIA vouchers</strong>, one per exam. Prices run roughly <strong>10–12.5% below CompTIA retail</strong>
      — about <strong>$384–$395 for Security+ SY0-701</strong>, <strong>$349–$359 for Network+ N10-009</strong>, and
      <strong>$113–$116 for Tech+</strong>. Every voucher buys one attempt, is non-refundable, country-locked and valid at least nine months.
      <strong>A+ needs two vouchers</strong> (Core 1 and Core 2). Udemy coupons never apply to vouchers — they apply to prep courses.
    </p>
    <ul>
      <li><strong>No experience:</strong> Tech+ FC0-U71 first, then A+ (budget two vouchers, about $480–$494 total).</li>
      <li><strong>Best job value:</strong> Security+ SY0-701 or Network+ N10-009 — the baseline for IT-to-security roles.</li>
      <li><strong>Safety net:</strong> add Retake Assurance at purchase; it reuses the same voucher code and cannot be added later.</li>
      <li><strong>Testing in 2027:</strong> check the transition table — SY0-701, CS0-003 and DS0-001 vouchers cannot book the replacement exams.</li>
    </ul>
    <div class="hb-chips">
      {sources.map((s) => (
        <a class="hb-chip" href={s.url} target="_blank" rel={s.url === ALL_VOUCHERS_URL ? "sponsored noopener noreferrer" : "noopener noreferrer"}>{s.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<section class="hb-section alt" id="decision">
  <div class="hb-section-inner">
    <span class="hb-kicker">Decision desk</span>
    <h2 class="hb-h2">Which CompTIA voucher fits your next role?</h2>
    <p class="hb-lead">Pick your situation. The recommendation updates instantly with the right exam code and a direct voucher link.</p>
    <div class="hb-decision" style={{ marginTop: "1.4rem" }}>
      <div class="hb-options" id="hb-decision-form">
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="support" data-title="Start with A+" data-text="For IT support roles, A+ is the baseline. It is two exams — 220-1201 Core 1 and 220-1202 Core 2 — so budget for two vouchers. Tech+ FC0-U71 is the softer entry point if you have no experience." data-label="Get the A+ voucher →" data-link={comptiaVouchers[1].url} />
          <span><b>I'm starting in IT support</b><small>A+ is two exams. Tech+ works if you are a complete beginner.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="security" data-title="Start with Security+" data-text="Security+ SY0-701 is the most-booked CompTIA voucher and the baseline certification for IT-to-security roles. Check the date first: SY0-801 launches November 17, 2026 and SY0-701 retires June 11, 2027." data-label="Get the Security+ voucher →" data-link={comptiaVouchers[3].url} />
          <span><b>I'm moving into cybersecurity</b><small>Security+ is the baseline; check the SY0-701 → SY0-801 calendar.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="network" data-title="Start with Network+" data-text="Network+ N10-009 is the current version and pairs with Security+ for IT-to-security job posts. N10-010 exists only as a draft with no launch date, so do not wait for it." data-label="Get the Network+ voucher →" data-link={comptiaVouchers[2].url} />
          <span><b>I work with networks</b><small>N10-009 is current. The next version is only a draft with no date.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="data" data-title="Start with Data+" data-text="Data+ DA0-002 is the cheapest CompTIA entry point at $264 retail, roughly $231–$238 on Udemy. Move on to DataSys+ DS0-002 and DataAI DY0-001 for deeper data and AI roles." data-label="Get the Data+ voucher →" data-link={comptiaVouchers[11].url} />
          <span><b>I work with data or AI</b><small>Data+ first, then DataSys+ (DS0-002) and DataAI.</small></span>
        </label>
      </div>
      <div class="hb-result" id="hb-result">
        <h3 id="hb-result-title">Your best starting point</h3>
