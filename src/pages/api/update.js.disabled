import { updateDeal } from '../../lib/store';

export const prerender = false;

export async function POST({ request }) {
  try {
    console.log('[API/UPDATE] Received update request');

    const dealData = await request.json();
    console.log('[API/UPDATE] Deal data received:', dealData);

    if (!dealData.id) {
      console.error('[API/UPDATE] Missing deal ID');
      return new Response(JSON.stringify({
        success: false,
        error: 'Deal ID is required'
      }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    console.log(`[API/UPDATE] Updating deal ${dealData.id}`);
    const updatedDeal = await updateDeal(dealData.id, dealData);

    if (updatedDeal) {
      console.log('[API/UPDATE] Deal updated successfully');
      return new Response(JSON.stringify({
        success: true,
        message: 'Deal updated successfully',
        updatedDeal
      }), {
        status: 200,
        headers: { 'Content-Type': 'application/json' }
      });
    } else {
      console.error(`[API/UPDATE] Deal with ID ${dealData.id} not found`);
      return new Response(JSON.stringify({
        success: false,
        error: `Deal with ID ${dealData.id} not found`
      }), {
        status: 404,
        headers: { 'Content-Type': 'application/json' }
      });
    }

  } catch (error) {
    console.error('[API/UPDATE] Error updating deal:', error);
    return new Response(JSON.stringify({
      success: false,
      error: error.message || 'Internal server error'
    }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}