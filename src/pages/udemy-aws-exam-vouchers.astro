---
import Layout from "../layouts/Layout.astro";
import { awsVouchers, awsGroupBlurbs, ALL_VOUCHERS_URL } from "../data/vouchers";
const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-aws-exam-vouchers";
const pageTitle = `Udemy AWS Exam Vouchers ${currentYear}: Prices, Second Chance & Codes`;
const pageDescription = `Compare all 12 Udemy AWS exam vouchers in ${currentYear} — voucher-only vs Second Chance prices, current exam codes, and the AWS exam changes through January 2027.`;
const groups: Record<string, typeof awsVouchers> = {};
for (const vv of awsVouchers) { (groups[vv.category] ||= []).push(vv); }

const faqs = [
  { q: "Which AWS vouchers can I buy on Udemy?", a: "Udemy lists 12 voucher products covering 10 current exams: Foundational (Cloud Practitioner CLF-C02, AI Practitioner AIF-C01), Associate (Solutions Architect SAA-C03, Developer DVA-C03, Data Engineer DEA-C01, CloudOps SOA-C03, ML Engineer MLA-C02), Professional (Solutions Architect SAP-C03, DevOps Engineer DOP-C02), and Specialty (Security SCS-C03). Two legacy Specialty listings — Machine Learning MLS-C01 (retired March 31, 2026) and Advanced Networking ANS-C01 (retires December 31, 2026) — remain purchasable because vouchers are tier-wide. Associate vouchers work across all Associate exams; Professional/Specialty vouchers across all active Pro/Specialty exams." },
  { q: "How much do AWS vouchers cost on Udemy?", a: "Voucher-only prices are about 10% off the AWS list price: $90 for Foundational ($100 retail), $135 for Associate ($150 retail), and $270 for Professional/Specialty ($300 retail). The optional Second Chance bundle costs $115.50, $177.80, and $348.80 respectively. These are US list prices observed on November 2, 2026; regional pricing varies, so confirm the live price at checkout." },
  { q: "Is Second Chance included in the voucher price?", a: "No. The voucher-only price buys one exam attempt. Second Chance is a separate bundle: $115.50 for Foundational, $177.80 for Associate, and $348.80 for Professional/Specialty. It must be bought with the original voucher and cannot be added after you fail." },
  { q: "Which AWS exams are changing in 2026–2027?", a: "SAP-C02 becomes SAP-C03 on November 17, 2026 (last SAP-C02 sitting November 16). DVA-C02 becomes DVA-C03 on December 1, 2026 (last DVA-C02 sitting November 30). MLA-C01 English retired September 28, 2026; MLA-C02 beta is open at $75, and the standard exam starts January 14, 2027. ANS-C01 retires December 31, 2026 with no replacement announced. MLS-C01 retired March 31, 2026." },
  { q: "What happens if I book SAP-C02 after November 16, 2026?", a: "You cannot. SAP-C02's last sitting is November 16, 2026. From November 17, book SAP-C03 instead. The Professional/Specialty voucher is tier-wide, so a voucher bought before the switch still works for SAP-C03." },
  { q: "Can I use an Associate voucher for any Associate exam?", a: "Yes. Udemy vouchers are level-wide. One Associate voucher covers SAA-C03, DVA-C03, DEA-C01, SOA-C03 and MLA-C02. You choose the exam at the AWS/Pearson VUE checkout, not when you buy the voucher on Udemy." },
  { q: "How does Second Chance work for AWS exams?", a: "Buy the voucher and Second Chance as a bundle. Take the exam through Pearson VUE. If you fail, report the result from My learning → Certifications within 9 months. Udemy verifies the result and issues a brand-new voucher code, usually within 7 days, valid at least 9 more months. One extra attempt, non-refundable, must be bought with the original voucher — it cannot be added after you fail." },
  { q: "How do I schedule an AWS exam with a voucher?", a: "Log in to your AWS Certification account, which directs you to Pearson VUE. Paste the voucher code from My learning → Certifications at the payment step. Choose online proctored (OnVUE) or a test center. Vouchers are valid only in the country of purchase." },
  { q: "Can I reschedule or cancel an AWS exam?", a: "You can reschedule up to 24 hours before your appointment, and each appointment can be rescheduled twice. A third change requires cancelling and rebooking. Exam voucher expiry dates cannot be extended, so check the date before moving the exam." },
  { q: "Can I get a refund on an Udemy AWS voucher?", a: "Udemy vouchers are non-refundable and non-transferable. If you cancel an exam appointment more than 24 hours before the slot, AWS and Pearson VUE's cancellation policy applies to the appointment; the Udemy voucher itself is not refunded. Read the live terms before buying." },
  { q: "Can I use an Udemy coupon on an AWS voucher?", a: "No — coupons never apply to vouchers. They do apply to the prep courses (Stephane Maarek's courses dominate the AWS bestseller list), which is the cheapest way to get exam-ready: discounted training plus a discounted exam seat." },
  { q: "Do AWS exam vouchers expire?", a: "Yes. Udemy vouchers are valid for at least 9 months from purchase, including Second Chance coverage. The expiry date cannot be extended. Schedule early enough to leave room for a retake." },
  { q: "Is the AWS 50% discount voucher better than a Udemy voucher?", a: "If you already hold an AWS certification, often yes. AWS gives a 50% discount voucher for recertification or another exam: SAA-C03 drops to $75 and SAP-C03 to $150, versus $135 and $270 on Udemy. If you are not certified yet, you cannot use it — the Udemy voucher is the accessible discount." },
  { q: "Are Udemy AWS vouchers legitimate?", a: "Yes. Udemy sells official AWS exam vouchers; AWS owns the certification and Pearson VUE delivers the exam. Buy from the official Udemy listing, receive the code in My learning → Certifications, and redeem it in the AWS/Pearson VUE checkout. Avoid anyone selling codes by DM or bank transfer." },
  { q: "Can I use a voucher for an online proctored AWS exam?", a: "Yes. Vouchers work for both OnVUE online proctoring and Pearson VUE test centers, subject to availability in your country. The voucher is valid only in the country of purchase." },
  { q: "Can one voucher be used for more than one exam?", a: "No. One voucher covers one exam attempt, even though it can be used for any exam at its level. Second Chance adds a second attempt only if you fail and claim it before the original voucher expires." },
  { q: "Why is my AWS voucher code not working?", a: "The most common causes are booking a different exam level, booking in a different country from the purchase, or entering the code in the promo-code field instead of the payment step. Confirm the level and country first, then contact Pearson VUE or AWS Certification support if the code is still rejected." },
  { q: "Which AWS cert first?", a: "New to cloud: Cloud Practitioner CLF-C02 (1–3 weeks of study). First cloud job: Solutions Architect Associate SAA-C03 — the most requested AWS cert in job posts. Then specialize: Developer DVA-C03 for builders, DevOps Professional DOP-C02 for platform roles, Security Specialty SCS-C03 for security engineers." },
];

const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebPage", "@id": `${canonicalUrl}#webpage`, url: canonicalUrl, name: pageTitle, description: pageDescription, image: "https://coursespeak.com/images/og/og-aws-vouchers.png", isPartOf: { "@id": "https://coursespeak.com/#website" }, inLanguage: "en-US", datePublished: "2025-01-01", dateModified: lastModified, author: { "@id": "https://coursespeak.com/#author" }, breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` } },
  { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "AWS", item: canonicalUrl }] },
  { "@type": "ItemList", name: `AWS Exam Vouchers ${currentYear}`, numberOfItems: awsVouchers.length, itemListElement: awsVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })) },
  { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about" },
]};
---
<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} type="article" image="/images/og/og-aws-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .voucher-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
  .voucher-card:hover{transform:translateY(-3px);border-color:var(--brand)}
  .voucher-card img{width:100%;height:140px;object-fit:cover;background:#fff}
  .compare-table{width:100%;border-collapse:collapse;font-size:.86rem;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .compare-table th,.compare-table td{padding:.7rem .9rem;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
  .compare-table thead th{background:var(--bg-secondary);font-weight:700}
  .compare-table tbody tr:last-child td{border-bottom:0}
  .table-wrap{overflow-x:auto;border-radius:12px}
  .toc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem 1rem;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem}
  .toc a{color:var(--muted);text-decoration:none;font-size:.86rem;line-height:1.5}
  .toc a:hover{color:var(--brand)}
  .callout{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--brand);border-radius:0 12px 12px 0;padding:1rem 1.15rem}
  .choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .choice-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.2rem 1.3rem}
  .choice-card h3{margin:0 0 .35rem;font-size:1.02rem}
  .choice-card p{margin:.4rem 0;color:var(--muted);font-size:.86rem;line-height:1.6}
  .choice-card .price{color:var(--brand);font-weight:800;font-size:1.15rem}
  .related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
  .related-grid a{display:block;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:.85rem 1rem;text-decoration:none}
  .related-grid strong{display:block;color:var(--text);font-size:.9rem}
  .related-grid span{display:block;color:var(--muted);font-size:.8rem;margin-top:.2rem}
  @media(max-width:768px){.grid-3,.choice-grid,.related-grid,.toc{grid-template-columns:1fr!important}.compare-table{min-width:680px}}
</style>

<section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
  <div style={{ maxWidth: "900px", margin: "0 auto" }}>
    <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>AWS Vouchers · Checked {updatedLong}</div>
    <h1 style={{ fontSize: "clamp(1.8rem,4.5vw,2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
      <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Udemy AWS Exam Vouchers {currentYear}</span><br />
      <span style={{ color: "var(--text)" }}>Prices, Current Codes & Exam Changes</span>
    </h1>
    <p style={{ color: "var(--muted)", fontSize: "0.86rem", margin: "0 auto 1rem", lineHeight: 1.6 }}>
      By <a href="/about#author" style={{ color: "var(--brand)" }}>Josh Smith</a>, Founder & Editor · Reviewed {updatedLong} ·
      Sources: <a href="https://aws.amazon.com/certification/policies/before-testing/" target="_blank" rel="noopener noreferrer" style={{ color: "var(--brand)" }}>AWS exam pricing</a> and <a href="https://www.udemy.com/all-certification-vouchers/" target="_blank" rel="noopener noreferrer" style={{ color: "var(--brand)" }}>Udemy voucher catalogue</a>
    </p>
    <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "720px", margin: "0 auto 0.75rem", lineHeight: 1.7 }}>
      Udemy lists <strong style={{ color: "var(--text)" }}>12 AWS voucher products</strong>, but only <strong style={{ color: "var(--text)" }}>10 map to exams you can book today</strong>.
      The other two are legacy Specialty listings that still work because vouchers are level-wide, not exam-specific.
      Voucher-only prices start at $90 for Foundational, $135 for Associate and $270 for Professional/Specialty — roughly 10% below the AWS list price.
    </p>
    <p style={{ color: "var(--muted)", fontSize: "0.9rem", maxWidth: "720px", margin: "0 auto 1.5rem", lineHeight: 1.7 }}>
      Second Chance is <em>not</em> included at those prices. The optional retake bundle costs $115.50, $177.80 or $348.80.
      This guide separates the two, flags the exam codes changing between November 2026 and January 2027, and shows when booking direct with AWS is actually cheaper.
    </p>
    <img src="/assets/images/vouchers/provider-aws.svg" alt="AWS exam vouchers — Cloud Practitioner, Solutions Architect and Specialty" width="480" height="270" loading="eager" fetchpriority="high" style={{ width: "100%", maxWidth: "720px", height: "auto", borderRadius: "16px", border: "1px solid var(--border)", margin: "0 auto 1.5rem", display: "block", background: "#fff" }} />
    <div style={{ display: "flex", gap: "0.75rem", justifyContent: "center", flexWrap: "wrap" }}>
      <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary btn-lg" style={{ borderRadius: "999px" }}>Browse All AWS Vouchers →</a>
      <a href="#prices" class="btn btn-ghost btn-lg" style={{ borderRadius: "999px" }}>Compare Prices</a>
    </div>
    <p style={{ fontSize: "0.78rem", color: "var(--muted)", marginTop: "0.9rem" }}>Sponsored — CourseSpeak may earn a commission at no extra cost to you. <a href="/affiliate-disclosure" style={{ color: "var(--brand)" }}>Affiliate Disclosure</a></p>
  </div>
</section>

<section style={{ paddingBottom: "2rem" }}>
  <div class="container"><div class="stat-grid" style={{ gridTemplateColumns: "repeat(3,1fr)", maxWidth: "650px" }}>
    <div class="stat-box"><div class="stat-value">12</div><div class="stat-label">Voucher products</div></div>
    <div class="stat-box"><div class="stat-value">10</div><div class="stat-label">Current exams</div></div>
    <div class="stat-box"><div class="stat-value">$90</div><div class="stat-label">Lowest voucher-only</div></div>
  </div></div>
</section>

<section style={{ padding: "0 1rem 1.5rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <div class="callout" style={{ marginBottom: "1rem" }}>
      <h2 style={{ margin: "0 0 0.5rem", fontSize: "1.1rem" }}>Quick answer: which AWS voucher do you need?</h2>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>First certification:</strong> the $90 Foundational voucher covers CLF-C02 or AIF-C01. No prerequisites; most people need 1–3 weeks.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Best job value:</strong> the $135 Associate voucher covers SAA-C03, DVA-C03, DEA-C01, SOA-C03 and MLA-C02. Pick the exam at Pearson VUE checkout.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Need a safety net:</strong> add Second Chance at purchase — $115.50 / $177.80 / $348.80. It cannot be added after you fail.</p>
      <p style={{ margin: "0.35rem 0", color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.7 }}><strong style={{ color: "var(--text)" }}>Already AWS certified?</strong> Check the 50% discount voucher in your AWS Certification Account first — it can beat every Udemy price on this page.</p>
    </div>
    <nav class="toc" aria-label="On this page">
      <a href="#prices">1. Voucher prices vs AWS list</a>
      <a href="#changes">2. Exam changes: 2026 – January 2027</a>
      <a href="#vouchers">3. All 12 voucher products</a>
      <a href="#which">4. Which voucher to buy</a>
      <a href="#redeem">5. How to buy and redeem</a>
      <a href="#second-chance">6. How Second Chance works</a>
      <a href="#discount">7. The 50% AWS discount voucher</a>
      <a href="#compare">8. Udemy vs booking direct</a>
      <a href="#legit">9. Legitimacy, refunds and expiry</a>
      <a href="#worth">10. Is it worth it?</a>
      <a href="#study">11. How to prepare</a>
      <a href="#faq">12. AWS voucher FAQ</a>
    </nav>
  </div>
</section>

<section id="prices" style={{ padding: "1rem 1rem 2.5rem" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <span class="section-title">Prices</span>
    <h2 class="section-heading">How much do Udemy AWS vouchers cost?</h2>
    <p style={{ color: "var(--muted)", fontSize: "0.95rem", lineHeight: 1.75, maxWidth: "820px", margin: "0.75rem 0 1.25rem" }}>
      AWS sets the exam fee by level, not by individual certification. Udemy resells one prepaid attempt at roughly 10% below the USD list price.
      The important distinction is between <strong style={{ color: "var(--text)" }}>voucher-only</strong> (one attempt) and the
      <strong style={{ color: "var(--text)" }}>+ Second Chance bundle</strong> (two attempts). They are separate products, and the bundle is not a discount on a single exam.
    </p>
    <div class="table-wrap"><table class="compare-table">
      <thead><tr><th>Level</th><th>AWS list (1 attempt)</th><th>Udemy voucher-only</th><th>Udemy + Second Chance</th><th>Two direct attempts</th><th>Saving vs two attempts</th></tr></thead>
      <tbody>
        <tr><td><strong>Foundational</strong><br /><span style={{ color: "var(--muted)", fontSize: "0.8rem" }}>CLF-C02, AIF-C01</span></td><td>$100</td><td><strong>$90</strong></td><td>$115.50</td><td>$200</td><td>$84.50</td></tr>
        <tr><td><strong>Associate</strong><br /><span style={{ color: "var(--muted)", fontSize: "0.8rem" }}>SAA-C03, DVA-C03, DEA-C01, SOA-C03, MLA-C02</span></td><td>$150</td><td><strong>$135</strong></td><td>$177.80</td><td>$300</td><td>$122.20</td></tr>
        <tr><td><strong>Professional / Specialty</strong><br /><span style={{ color: "var(--muted)", fontSize: "0.8rem" }}>SAP-C03, DOP-C02, SCS-C03</span></td><td>$300</td><td><strong>$270</strong></td><td>$348.80</td><td>$600</td><td>$251.20</td></tr>
      </tbody>
    </table></div>
    <p style={{ color: "var(--muted)", fontSize: "0.8rem", margin: "0.7rem 0 1.25rem", lineHeight: 1.6 }}>Snapshot: November 2, 2026, USD, before tax. Udemy rotates prices by country and campaign; confirm the live price at checkout. Second Chance and Retake Assurance are optional bundles that cost more.</p>
    <h3 style={{ fontSize: "1.05rem", margin: "0 0 0.5rem" }}>How much does an AWS exam cost in 2026?</h3>
    <p style={{ color: "var(--muted)", fontSize: "0.92rem", lineHeight: 1.75, margin: "0 0 1.25rem" }}>
      AWS charges by exam level: <strong style={{ color: "var(--text)" }}>$100 for Foundational, $150 for Associate, and $300 for Professional or Specialty</strong>, per attempt.
      Taxes and local-currency pricing vary by country. A Udemy voucher replaces that fee with $90, $135 or $270 — but only if the live voucher price is actually below your local AWS fee. That is why the comparison table above includes both numbers.
    </p>
    <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(260px,1fr))", gap: "1rem" }}>
      <div class="callout">
        <h3 style={{ margin: "0 0 0.4rem", fontSize: "0.95rem" }}>Voucher-only is the honest comparison</h3>
        <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.86rem", lineHeight: 1.7 }}>One attempt for $90, $135 or $270. If you are confident and have scored above 80% on practice exams twice, this is the cheapest path. The bundle premium is $25.50, $42.80 or $78.80 — money you lose if you pass first time.</p>
      </div>
      <div class="callout" style={{ borderLeftColor: "#d97706" }}>
        <h3 style={{ margin: "0 0 0.4rem", fontSize: "0.95rem" }}>The bundle is insurance, not a discount</h3>
        <p style={{ margin: 0, color: "var(--muted)", fontSize: "0.86rem", lineHeight: 1.7 }}>It only wins if you actually need the retake. For a $300 Professional exam, the $78.80 premium is rational protection. For Foundational, $25.50 is cheap peace of mind — but still optional.</p>
      </div>
    </div>
    <p style={{ color: "var(--muted)", fontSize: "0.9rem", lineHeight: 1.75, margin: "1.25rem 0 0" }}>
      Udemy coupons never apply to vouchers. Udemy credits can sometimes be applied at checkout, but the sticker price is the price.
      Compare the live voucher-only price with the AWS list price on the day you buy: in some countries the voucher is barely cheaper, and in a few it is more expensive.
    </p>
  </div>
</section>

<section id="changes" style={{ padding: "1rem 1rem 2.5rem", background: "var(--bg-secondary)" }}>
  <div class="container" style={{ maxWidth: "1080px" }}>
    <span class="section-title">Exam transitions</span>
    <h2 class="section-heading">AWS exam changes: 2026 – January 2027</h2>
    <p style={{ color: "var(--muted)", fontSize: "0.95rem", lineHeight: 1.75, maxWidth: "820px", margin: "0.75rem 0 1.25rem" }}>
      Five exams that appear in these 12 voucher listings have retired or change code between March 2026 and January 2027.
      Most voucher pages still show the old codes. Here is the accurate timeline and what it means for a voucher you buy today.
    </p>
    <div class="table-wrap"><table class="compare-table">
      <thead><tr><th>Exam</th><th>Old code</th><th>New code</th><th>Last old sitting</th><th>New code live</th><th>Voucher impact</th></tr></thead>
      <tbody>
        <tr><td><strong>Solutions Architect – Professional</strong></td><td>SAP-C02</td><td><strong>SAP-C03</strong></td><td>November 16, 2026</td><td>November 17, 2026</td><td>Same $270 Pro/Specialty voucher. Book C02 only if you can sit it by November 16; otherwise study SAP-C03.</td></tr>
        <tr><td><strong>Developer – Associate</strong></td><td>DVA-C02</td><td><strong>DVA-C03</strong></td><td>November 30, 2026</td><td>December 1, 2026</td><td>Same $135 Associate voucher. DVA-C03 adds AI-assisted development and AI-service security.</td></tr>
        <tr><td><strong>ML Engineer – Associate</strong></td><td>MLA-C01</td><td><strong>MLA-C02</strong></td><td>September 28, 2026 (English)</td><td>Beta now; GA January 14, 2027</td><td>Beta is $75 and can be taken once; pay the beta fee directly. The standard exam starts January 14, 2027.</td></tr>
        <tr><td><strong>Advanced Networking – Specialty</strong></td><td>ANS-C01</td><td>None announced</td><td>December 31, 2026</td><td>Retired January 1, 2027</td><td>Voucher stays tier-wide. Use it for SCS-C03 if you do not sit ANS-C01 in time.</td></tr>
        <tr><td><strong>Machine Learning – Specialty</strong></td><td>MLS-C01</td><td>None</td><td>March 31, 2026</td><td>Retired</td><td>Listing remains purchasable because the voucher is level-wide, not exam-specific.</td></tr>
      </tbody>
    </table></div>
    <p style={{ color: "var(--muted)", fontSize: "0.8rem", margin: "0.7rem 0 1.25rem", lineHeight: 1.6 }}>Dates checked against AWS Certification announcements on November 2, 2026. AWS can change schedules; confirm the exam page before booking.</p>

    <h3 style={{ fontSize: "1.05rem", margin: "1.5rem 0 0.5rem" }}>What the changes mean for your booking</h3>
    <ul style={{ margin: 0, paddingLeft: "1.2rem", color: "var(--muted)", fontSize: "0.92rem", lineHeight: 1.85 }}>
      <li><strong style={{ color: "var(--text)" }}>The voucher is tied to the level, not the code.</strong> A Professional/Specialty voucher bought before November 17 still works for SAP-C03. You are not locked into the old exam.</li>
