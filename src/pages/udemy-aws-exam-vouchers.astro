---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/voucher-hub.css";
import allDeals from "../data/deals.json";
import { awsVouchers, ALL_VOUCHERS_URL, voucherPrice } from "../data/vouchers";

const currentYear = new Date().getFullYear();
const lastModified = new Date().toISOString().split("T")[0];
const updatedLong = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const canonicalUrl = "https://coursespeak.com/udemy-aws-exam-vouchers";
const pageTitle = `AWS Exam Vouchers ${currentYear}: Prices, Second Chance & Current Codes`;
const pageDescription = `All 12 Udemy AWS exam vouchers in ${currentYear}: voucher-only vs Second Chance prices, current exam codes, and AWS exam changes through January 2027.`;
const pageKeywords = "AWS exam vouchers, Udemy AWS vouchers, SAA-C03, CLF-C02, SAP-C03, DVA-C03, Second Chance, AWS certification discount, AWS 50% discount voucher";

const sources = [
  { label: "AWS certification exam pricing", url: "https://aws.amazon.com/certification/certification-exams/" },
  { label: "AWS candidate handbook", url: "https://aws.amazon.com/certification/policies/before-testing/" },
  { label: "Udemy voucher catalogue", url: ALL_VOUCHERS_URL },
];

const faqs = [
  { q: "Which AWS vouchers can I buy on Udemy?", cat: "catalog", a: "Udemy lists 12 voucher products covering 10 current exams: Foundational (Cloud Practitioner CLF-C02, AI Practitioner AIF-C01), Associate (Solutions Architect SAA-C03, Developer DVA-C03, Data Engineer DEA-C01, CloudOps SOA-C03, ML Engineer MLA-C02), Professional (Solutions Architect SAP-C03, DevOps Engineer DOP-C02), and Specialty (Security SCS-C03). Two legacy Specialty listings — Machine Learning MLS-C01 (retired March 31, 2026) and Advanced Networking ANS-C01 (retires December 31, 2026) — remain purchasable because vouchers are tier-wide." },
  { q: "How much do AWS vouchers cost on Udemy?", cat: "price", a: "Voucher-only prices are about 10% off AWS list price: $90 for Foundational ($100 retail), $135 for Associate ($150 retail), and $270 for Professional/Specialty ($300 retail). The optional Second Chance bundle costs $115.50, $177.80 and $348.80 respectively. US list prices observed November 2, 2026; regional pricing varies." },
  { q: "Is Second Chance included in the voucher price?", cat: "retake", a: "No. The voucher-only price buys one exam attempt. Second Chance is a separate bundle: $115.50 Foundational, $177.80 Associate, $348.80 Professional/Specialty. It must be bought with the original voucher and cannot be added after you fail." },
  { q: "Which AWS exams are changing in 2026–2027?", cat: "changes", a: "SAP-C02 becomes SAP-C03 on November 17, 2026 (last sitting November 16). DVA-C02 becomes DVA-C03 on December 1, 2026 (last sitting November 30). MLA-C01 English retired September 28, 2026; MLA-C02 beta is open at $75 and the standard exam starts January 14, 2027. ANS-C01 retires December 31, 2026 with no replacement. MLS-C01 retired March 31, 2026." },
  { q: "What happens if I book SAP-C02 after November 16, 2026?", cat: "changes", a: "You cannot. SAP-C02's last sitting is November 16, 2026. From November 17, book SAP-C03. The Professional/Specialty voucher is tier-wide, so a voucher bought before the switch still works for SAP-C03." },
  { q: "Can I use an Associate voucher for any Associate exam?", cat: "rules", a: "Yes. Udemy vouchers are level-wide. One Associate voucher covers SAA-C03, DVA-C03, DEA-C01, SOA-C03 and MLA-C02. You choose the exam at the AWS/Pearson VUE checkout, not when you buy on Udemy." },
  { q: "How does Second Chance work for AWS exams?", cat: "retake", a: "Buy the voucher and Second Chance as a bundle. Take the exam through Pearson VUE. If you fail, report the result from My learning → Certifications within 9 months. Udemy verifies it and issues a brand-new code, usually within 7 days, valid at least 9 more months. One extra attempt, non-refundable, must be bought upfront." },
  { q: "How do I schedule an AWS exam with a voucher?", cat: "booking", a: "Log in to your AWS Certification account, which directs you to Pearson VUE. Paste the voucher code from My learning → Certifications at the payment step. Choose online proctored (OnVUE) or a test centre. Vouchers are valid only in the country of purchase." },
  { q: "Can I reschedule or cancel an AWS exam?", cat: "booking", a: "You can reschedule up to 24 hours before your appointment, and each appointment can be rescheduled twice. A third change requires cancelling and rebooking. Voucher expiry dates cannot be extended." },
  { q: "Can I get a refund on an Udemy AWS voucher?", cat: "booking", a: "Udemy vouchers are non-refundable and non-transferable. If you cancel an appointment more than 24 hours before the slot, AWS and Pearson VUE's cancellation policy applies to the appointment; the Udemy voucher itself is not refunded." },
  { q: "Can I use an Udemy coupon on an AWS voucher?", cat: "price", a: "No — coupons never apply to vouchers. They do apply to prep courses, which is the cheapest way to get exam-ready: discounted training plus a discounted exam seat. Udemy credits can sometimes be applied at checkout." },
  { q: "Do AWS exam vouchers expire?", cat: "rules", a: "Yes. Udemy vouchers are valid for at least 9 months from purchase, including Second Chance coverage. The expiry date cannot be extended. Schedule early enough to leave room for a retake." },
  { q: "Is the AWS 50% discount voucher better than a Udemy voucher?", cat: "price", a: "If you already hold an AWS certification, often yes. AWS gives a 50% discount voucher for recertification or another exam: SAA-C03 drops to $75 and SAP-C03 to $150, versus $135 and $270 on Udemy. If you are not certified yet, the Udemy voucher is the accessible discount." },
  { q: "Are Udemy AWS vouchers legitimate?", cat: "trust", a: "Yes. Udemy sells official AWS exam vouchers; AWS owns the certification and Pearson VUE delivers the exam. Buy from the official Udemy listing, receive the code in My learning → Certifications, and redeem it in the AWS/Pearson VUE checkout. Avoid anyone selling codes by DM or bank transfer." },
  { q: "Can I use a voucher for an online proctored AWS exam?", cat: "booking", a: "Yes. Vouchers work for both OnVUE online proctoring and Pearson VUE test centres, subject to country availability. The voucher is valid only in the country of purchase." },
  { q: "Can one voucher be used for more than one exam?", cat: "rules", a: "No. One voucher covers one exam attempt, even though it can be used for any exam at its level. Second Chance adds a second attempt only if you fail and claim it before the original voucher expires." },
  { q: "Why is my AWS voucher code not working?", cat: "booking", a: "Common causes: booking a different exam level, booking in a different country from the purchase, or entering the code in the promo-code field instead of the payment step. Confirm level and country first, then contact Pearson VUE or AWS Certification support." },
  { q: "Which AWS cert first?", cat: "choice", a: "New to cloud: Cloud Practitioner CLF-C02 (1–3 weeks). First cloud job: Solutions Architect Associate SAA-C03, the most requested AWS cert in job posts. Then specialize: Developer DVA-C03 for builders, DevOps Professional DOP-C02 for platform roles, Security Specialty SCS-C03 for security engineers." },
  { q: "Can I use a voucher on the MLA-C02 beta?", cat: "changes", a: "No. The MLA-C02 beta is $75 and is booked directly with AWS; it can be taken once and results take up to five business days. Do not burn a $135 Associate voucher on a $75 beta. If you want the standard exam, wait for January 14, 2027." },
  { q: "Does the AWS 50% discount apply to a first certification?", cat: "price", a: "No. The 50% discount voucher is issued to candidates who have already passed an AWS certification. It covers recertification or another exam. If you are not certified yet, the Udemy voucher is the accessible discount." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      image: "https://coursespeak.com/images/og/og-aws-vouchers.png",
      isPartOf: { "@id": "https://coursespeak.com/#website" },
      publisher: { "@id": "https://coursespeak.com/#organization" },
      inLanguage: "en-US",
      datePublished: "2025-01-01",
      dateModified: lastModified,
      author: { "@id": "https://coursespeak.com/#author" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      keywords: pageKeywords,
      about: [
        { "@type": "Organization", name: "Amazon Web Services", sameAs: ["https://aws.amazon.com/certification/"] },
        { "@type": "Organization", name: "Pearson VUE", sameAs: ["https://www.pearsonvue.com/"] },
        { "@type": "Thing", name: "AWS certification exam vouchers", sameAs: ["https://www.udemy.com/all-certification-vouchers/"] },
      ],
      citation: sources.map((s) => s.url),
      speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", ".hb-sub", "#faq"] },
    },
    { "@type": "BreadcrumbList", "@id": `${canonicalUrl}#breadcrumb`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://coursespeak.com" }, { "@type": "ListItem", position: 2, name: "Exam Vouchers", item: "https://coursespeak.com/udemy-certification-vouchers" }, { "@type": "ListItem", position: 3, name: "AWS", item: canonicalUrl }] },
    { "@type": "ItemList", "@id": `${canonicalUrl}#vouchers`, name: `AWS Exam Vouchers ${currentYear}`, numberOfItems: awsVouchers.length, itemListElement: awsVouchers.map((vv, i) => ({ "@type": "ListItem", position: i + 1, url: vv.url, name: `${vv.title} (${vv.code})` })) },
    { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#how-to-buy`,
      name: `How to buy and redeem an AWS exam voucher in ${currentYear}`,
      description: "Confirm the level, buy the voucher with optional Second Chance, copy the code from My learning, and schedule through Pearson VUE.",
      totalTime: "PT10M",
      estimatedCost: { "@type": "MonetaryAmount", value: "135", currency: "USD" },
      step: [
        { "@type": "HowToStep", position: 1, name: "Choose the exam level", text: "Foundational $90, Associate $135, Professional/Specialty $270. The voucher is tier-wide — you choose the exact exam later.", url: `${canonicalUrl}#which` },
        { "@type": "HowToStep", position: 2, name: "Check the current code", text: "SAP-C03, DVA-C03 and MLA-C02 are changing. Book the new code if your test date falls after the switch.", url: `${canonicalUrl}#changes` },
        { "@type": "HowToStep", position: 3, name: "Buy with Second Chance if needed", text: "Second Chance must be bought with the original voucher and cannot be added after checkout.", url: `${canonicalUrl}#second-chance` },
        { "@type": "HowToStep", position: 4, name: "Copy the code", text: "Find the code in My learning → Certifications. Keep the expiry date.", url: `${canonicalUrl}#steps` },
        { "@type": "HowToStep", position: 5, name: "Schedule with Pearson VUE", text: "Use your AWS Certification Account, choose OnVUE or a test centre, and paste the code at payment.", url: `${canonicalUrl}#steps` },
      ],
    },
    { "@type": "Person", "@id": "https://coursespeak.com/#author", name: "Josh Smith", jobTitle: "Founder & Editor, CourseSpeak", url: "https://coursespeak.com/about", knowsAbout: ["AWS certification", "AWS Solutions Architect", "AWS DevOps", "Udemy exam vouchers"] },
  ],
};

const ticker = [
  { voucher: awsVouchers[0], label: "Cloud Practitioner · foundational" },
  { voucher: awsVouchers[2], label: "Solutions Architect · associate" },
  { voucher: awsVouchers[7], label: "Solutions Architect · professional" },
  { voucher: awsVouchers[9], label: "Security · specialty" },
];

const getDeal = (id: string) => {
  const deal = allDeals.find((d) => String(d.id) === id);
  return deal && Date.parse(String(deal.expiresAt)) > Date.now() ? deal : null;
};
const coursePickIds = [
  { id: "151", topic: "/topics/aws-certified-solutions-architect-associate", why: "SAA-C03 associate architect prep" },
  { id: "143", topic: "/topics/aws-certified-cloud-practitioner", why: "CLF-C02 foundational cloud prep" },
  { id: "2226", topic: "/topics/aws-certified-devops-engineer-professional", why: "DOP-C02 DevOps Professional prep" },
  { id: "1945", topic: "/topics/aws-certified-security-specialty", why: "SCS-C03 security specialty prep" },
  { id: "889", topic: "/topics/aws-certified-solutions-architect-professional", why: "SAP-C03 professional architect prep" },
  { id: "893", topic: "/topics/aws-certified-data-engineer-associate", why: "DEA-C01 data engineer prep" },
];
const coursePicks = coursePickIds.map((pick) => ({ ...pick, deal: getDeal(pick.id) })).filter((pick) => pick.deal !== null);
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} publishedTime="2025-01-01" modifiedTime={lastModified} canonical={canonicalUrl} type="article" image="/images/og/og-aws-vouchers.png">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hb-hero">
  <div class="hb-hero-inner">
    <div>
      <span class="hb-eyebrow"><span class="hb-dot"></span> AWS voucher command center · checked <time datetime={lastModified}>{updatedLong}</time></span>
      <h1 class="hb-title">AWS Exam <span>Vouchers {currentYear}</span></h1>
      <p class="hb-sub">
        All <strong>12 AWS voucher products</strong> for <strong>10 current exams</strong>, with voucher-only and Second Chance prices,
        the tier-wide rule that makes AWS different, and the exam-code changes through January 2027 — plus matching prep courses.
      </p>
      <div class="hb-metrics">
        <div class="hb-metric"><b>12</b><span>voucher products</span></div>
        <div class="hb-metric"><b>10</b><span>current exams</span></div>
        <div class="hb-metric"><b>From $90</b><span>voucher-only price</span></div>
      </div>
      <div class="hb-actions">
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse all 12 vouchers →</a>
        <a href={awsVouchers[2].url} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-ghost">Get SAA-C03 voucher →</a>
        <a href="#quick-answer" class="hb-btn-quiet">Read the 60-second answer ↓</a>
      </div>
      <p class="hb-meta">
        By <a href="/about#author">Josh Smith</a>, Founder &amp; Editor · Reviewed <time datetime={lastModified}>{updatedLong}</time> ·
        Sources: <a href="https://aws.amazon.com/certification/certification-exams/" target="_blank" rel="noopener noreferrer">AWS exam pricing</a>,
        <a href="https://aws.amazon.com/certification/policies/before-testing/" target="_blank" rel="noopener noreferrer">candidate handbook</a> and
        <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer">Udemy voucher catalogue</a>.
        Sponsored — we may earn a commission at no extra cost. <a href="/affiliate-disclosure">Disclosure</a>
      </p>
    </div>
    <aside class="hb-ticker" aria-label="Top AWS vouchers">
      <div class="hb-ticker-head"><b>Top AWS vouchers</b><span><span class="hb-dot"></span> Checked</span></div>
      {ticker.map((t) => (
        <a class="hb-ticker-row" href={t.voucher.url} target="_blank" rel="sponsored noopener noreferrer" style={{ textDecoration: "none" }}>
          <span class="hb-ticker-name" style={{ color: "var(--brand)" }}>{t.voucher.code}</span>
          <span class="hb-ticker-note">{t.label}</span>
          <span class="hb-ticker-price"><b>{voucherPrice(t.voucher)}</b><span>Udemy</span></span>
        </a>
      ))}
      <div class="hb-ticker-foot">Codes verified {updatedLong}. Prices vary by country — confirm at checkout.</div>
    </aside>
  </div>
</section>

<div class="hb-rail">
  <div class="hb-rail-inner">
    <a href="#quick-answer">01 Quick answer</a>
    <a href="#decision">02 Pick your level</a>
    <a href="#vouchers">03 All 12 vouchers</a>
    <a href="#prices">04 Prices</a>
    <a href="#courses">05 Prep courses</a>
    <a href="#changes">06 Exam changes</a>
    <a href="#which">07 Which level</a>
    <a href="#second-chance">08 Second Chance</a>
    <a href="#discount">09 50% discount</a>
    <a href="#steps">10 How to buy</a>
    <a href="#evidence">11 Evidence</a>
    <a href="#faq">12 FAQ</a>
  </div>
  <div class="hb-progress" id="hb-progress"></div>
</div>

<section class="hb-section" id="quick-answer">
  <div class="hb-answer">
    <span class="hb-answer-label">Answer first · fact-checked {updatedLong}</span>
    <h2>AWS vouchers: the 60-second answer</h2>
    <p>
      Udemy sells <strong>12 AWS voucher products</strong> covering <strong>10 current exams</strong>. Prices are tier-wide:
      <strong>$90 Foundational</strong>, <strong>$135 Associate</strong> and <strong>$270 Professional/Specialty</strong> — about 10% below AWS list.
      You buy a level, then choose the exact exam at the Pearson VUE checkout. <strong>Second Chance</strong> is an optional retake bundle
      ($115.50 / $177.80 / $348.80) that must be bought upfront. Vouchers are non-refundable, country-locked and valid at least nine months.
    </p>
    <ul>
      <li><strong>First certification:</strong> the $90 Foundational voucher covers CLF-C02 or AIF-C01. Usually 1–3 weeks of study.</li>
      <li><strong>Best job value:</strong> the $135 Associate voucher covers SAA-C03, DVA-C03, DEA-C01, SOA-C03 and MLA-C02.</li>
      <li><strong>Already AWS certified?</strong> Check the 50% discount voucher in your AWS Certification Account first — it can beat every price here.</li>
      <li><strong>Testing in late 2026:</strong> SAP-C03 and DVA-C03 replace older codes; the voucher level stays the same.</li>
    </ul>
    <div class="hb-chips">
      {sources.map((s) => (
        <a class="hb-chip" href={s.url} target="_blank" rel={s.url === ALL_VOUCHERS_URL ? "sponsored noopener noreferrer" : "noopener noreferrer"}>{s.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<section class="hb-section alt" id="decision">
  <div class="hb-section-inner">
    <span class="hb-kicker">Decision desk</span>
    <h2 class="hb-h2">Which AWS voucher level fits your goal?</h2>
    <p class="hb-lead">Pick your situation. We'll match it to the right level, exam code and direct voucher link.</p>
    <div class="hb-decision" style={{ marginTop: "1.4rem" }}>
      <div class="hb-options" id="hb-decision-form">
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="foundation" data-title="Start with Foundational" data-text="The $90 voucher covers Cloud Practitioner CLF-C02 or AI Practitioner AIF-C01. No prerequisites; most candidates need 1–3 weeks. Choose the exam at the Pearson VUE checkout." data-label="Get the Foundational voucher →" data-link={awsVouchers[0].url} />
          <span><b>I'm new to AWS</b><small>CLF-C02 or AIF-C01, $90, no prerequisites.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="associate" data-title="Start with Associate" data-text="The $135 voucher covers SAA-C03, DVA-C03, DEA-C01, SOA-C03 and MLA-C02. Solutions Architect is the most requested AWS certification in job posts. Pick your exam at checkout." data-label="Get the Associate voucher →" data-link={awsVouchers[2].url} />
          <span><b>I want a cloud job</b><small>SAA-C03 is the flagships; one $135 code covers all Associate exams.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="professional" data-title="Go Professional" data-text="The $270 voucher covers SAP-C03 and DOP-C02. SAP-C03 replaced SAP-C02 on November 17, 2026. These exams assume hands-on production experience, not just course completion." data-label="Get the Professional voucher →" data-link={awsVouchers[7].url} />
          <span><b>I already hold an Associate cert</b><small>SAP-C03 or DOP-C02 at $270, tier-wide.</small></span>
        </label>
        <label class="hb-option">
          <input type="radio" name="hb-goal" value="specialty" data-title="Go Specialty" data-text="Security SCS-C03 is the active Specialty exam. ANS-C01 retires December 31, 2026 and MLS-C01 retired March 31, 2026 — both legacy listings are still tier-wide Professional/Specialty vouchers at $270." data-label="Get the Specialty voucher →" data-link={awsVouchers[9].url} />
          <span><b>I'm a security or network specialist</b><small>SCS-C03 is current; legacy listings are tier-wide.</small></span>
        </label>
      </div>
      <div class="hb-result" id="hb-result">
        <h3 id="hb-result-title">Your best level</h3>
        <p id="hb-result-text">Choose a statement on the left. We'll match it to the right AWS voucher level and current exam code.</p>
        <p style={{ marginTop: "0.8rem" }}><a id="hb-result-link" href="#vouchers">Compare all 12 vouchers →</a></p>
        <p style={{ marginTop: "0.7rem" }}><a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary" style={{ fontSize: "0.8rem", padding: "0.6rem 1rem" }}>Get the voucher →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="hb-section" id="vouchers">
  <div class="hb-section-head-row">
    <div class="hb-head">
      <span class="hb-kicker">Full catalogue</span>
      <h2 class="hb-h2">All 12 AWS voucher products on Udemy</h2>
      <p class="hb-lead">10 current exams plus 2 legacy Specialty listings. Prices are tier-wide: $90 / $135 / $270. Every “Get voucher” link opens the official Udemy listing.</p>
    </div>
    <a href={ALL_VOUCHERS_URL} target="_blank" rel="sponsored noopener noreferrer" class="hb-btn hb-btn-primary">Browse vouchers →</a>
  </div>
  <div class="hb-courses">
    {awsVouchers.map((vv) => (
      <div class="hb-course">
        <img src={vv.image} alt={vv.title} width="480" height="270" loading="lazy" />
        <div class="hb-course-body">
          <div class="hb-course-provider">{vv.code}{vv.badge ? ` · ${vv.badge}` : ""}</div>
          <h4 class="hb-course-title">{vv.title}</h4>
          <div class="hb-course-meta">{vv.blurb}</div>
          {vv.note && <div class="hb-course-meta" style={{ color: "#d97706" }}>{vv.note}</div>}
          <div class="hb-course-price">{voucherPrice(vv)}</div>
          <div class="hb-course-actions">
            <a class="hb-course-cta" href={vv.url} target="_blank" rel="sponsored noopener noreferrer">Get voucher →</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="hb-answer" style={{ marginTop: "1.2rem" }}>
    <h2 style={{ fontSize: "1.05rem", marginTop: 0 }}>Why 12 products for 10 exams?</h2>
    <p style={{ marginBottom: 0 }}>Udemy lists a separate product page for each exam name, but the voucher is valid for every exam at that level. The two legacy Specialty pages (MLS-C01 and ANS-C01) remain on sale as Professional/Specialty vouchers. You are buying the level, not the exam name.</p>
  </div>
</section>

<section class="hb-section alt" id="prices">
  <div class="hb-section-inner">
    <span class="hb-kicker">Price intelligence</span>
    <h2 class="hb-h2">Voucher-only vs Second Chance</h2>
    <p class="hb-lead">AWS charges by level, not by individual certification. One voucher buys one attempt; the + Second Chance bundle buys a second attempt only if you fail.</p>
    <div class="hb-ladder" style={{ margin: "1.6rem 0 0.8rem" }}>
      {[
        { label: "Foundational (1 attempt)", retail: 100, udemy: 90, save: "$10 saved" },
        { label: "Associate (1 attempt)", retail: 150, udemy: 135, save: "$15 saved" },
        { label: "Professional / Specialty", retail: 300, udemy: 270, save: "$30 saved" },
        { label: "Associate + Second Chance", retail: 300, udemy: 177.8, save: "$122.20 vs 2 attempts" },
      ].map((row) => (
        <div class="hb-ladder-row">
          <div class="hb-ladder-label">{row.label}</div>
          <div class="hb-track">
            <div class="hb-track-retail" style={{ width: "100%" }}></div>
            <div class="hb-track-voucher" style={{ width: `${Math.round((row.udemy / row.retail) * 100)}%` }}></div>
          </div>
          <div class="hb-ladder-save">{row.save}</div>
        </div>
      ))}
      <div class="hb-ladder-legend"><span><i style={{ background: "rgba(255,255,255,.16)" }}></i>Two direct attempts / list price</span><span><i style={{ background: "#d4af37" }}></i>Udemy price</span></div>
    </div>
