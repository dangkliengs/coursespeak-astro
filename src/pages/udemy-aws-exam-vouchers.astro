<script>
  const form = document.querySelector('#hb-decision-form');
  const title = document.querySelector('#hb-result-title');
  const text = document.querySelector('#hb-result-text');
  const link = document.querySelector('#hb-result-link');
  form?.addEventListener('change', (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    if (title) title.textContent = input.dataset.title || 'Your best level';
    if (text) text.textContent = input.dataset.text || '';
    if (link && input.dataset.link) {
      link.setAttribute('href', input.dataset.link);
      link.textContent = input.dataset.label || 'Open the guide →';
    }
  });
  const progress = document.querySelector('#hb-progress');
  const updateProgress = () => {
    const height = document.documentElement.scrollHeight - window.innerHeight;
    const pct = height > 0 ? (window.scrollY / height) * 100 : 0;
    if (progress) (progress as HTMLElement).style.width = `${pct}%`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>

