---
import Layout from "../../layouts/Layout.astro";
import DealCard from "../../components/DealCard.astro";
import { readDeals } from "../../lib/store";
import type { Deal } from "../../types/deal";

import { parseInstructors, createInstructorSlug, instructorSlugLookupKeys } from "../../lib/instructors";
import { getInstructorImageByName } from "../../lib/instructorProfiles";

// Types
interface InstructorData {
  name: string;
  slug: string;
  courses: Deal[];
  totalStudents: number;
  avgRating: number;
  categories: string[];
  totalReviews: number;
  courseCount: number;
  providers: string[];
}

// Generate static paths for instructors with 3+ courses
export async function getStaticPaths() {
  const allDeals = await readDeals();
  
  // Group deals by INDIVIDUAL instructor (split comma-separated names)
  const instructorMap = new Map<string, Deal[]>();
  
  allDeals.forEach((deal) => {
    const instructors = parseInstructors(deal.instructor);
    
    // Add this course to each individual instructor
    instructors.forEach((instructorName) => {
      if (!instructorMap.has(instructorName)) {
        instructorMap.set(instructorName, []);
      }
      instructorMap.get(instructorName)!.push(deal);
    });
  });
  
  // Filter instructors with 3+ courses and create paths
  const paths = [];
  const seen = new Set();
  
  for (const [name, courses] of instructorMap.entries()) {
    if (courses.length >= 3) {
      const slug = createInstructorSlug(name);
      
      if (!seen.has(slug)) {
        seen.add(slug);
        paths.push({
          params: { instructor: slug },
          props: { 
            instructorName: name,
            instructorSlug: slug 
          }
        });
      }
    }
  }
  
  return paths;
}

// Get props from static path generation
let { instructorName, instructorSlug } = Astro.props;
const { instructor } = Astro.params;

// Fetch all deals first (used for both lookup and filtering)
const allDeals = await readDeals();

// Fallback: if props not available (SSR mode), resolve slug → display name (never use raw slug as name)
if (!instructorName && instructor) {
  const slugToName = new Map<string, string>();

  allDeals.forEach((deal) => {
    for (const name of parseInstructors(deal.instructor)) {
      for (const key of instructorSlugLookupKeys(name)) {
        slugToName.set(key, name);
      }
    }
  });

  const mapped = slugToName.get(instructor);
  if (mapped) {
    instructorName = mapped;
    instructorSlug = instructor;
  }
}

// Guard against missing instructor
if (!instructorName) {
  return Astro.redirect('/instructors');
}

// Ensure instructorSlug is defined
if (!instructorSlug) {
  instructorSlug = createInstructorSlug(instructorName);
}

// Filter deals for this instructor (check if instructorName is in comma-separated list)
// Urutkan kursus berdasarkan enrollment (terbanyak dulu)
const instructorCourses = allDeals
  .filter(d => {
    const instructors = parseInstructors(d.instructor);
    return instructors.includes(instructorName);
  })
  .sort((a, b) => (b.students ?? 0) - (a.students ?? 0));

// Calculate instructor stats (students data comes from deals.json)
const totalStudents = instructorCourses.reduce((sum, c) => sum + (c.students || 0), 0);
const avgRating = instructorCourses.length > 0 
  ? Number((instructorCourses.reduce((sum, c) => sum + (c.rating || 0), 0) / instructorCourses.length).toFixed(1))
  : 0;
const categories = [...new Set(instructorCourses.map(c => c.category).filter(Boolean))];
const providers = [...new Set(instructorCourses.map(c => c.provider).filter(Boolean))];
const totalReviews = instructorCourses.reduce((sum, c) => sum + (c.students || 0), 0);

const instructorData: InstructorData = {
  name: instructorName,
  slug: instructorSlug,
  courses: instructorCourses,
  totalStudents,
  avgRating,
  categories,
  totalReviews,
  courseCount: instructorCourses.length,
  providers
};

const provider = providers[0] || 'Udemy';

function getMaxDiscount(courses: Deal[]): number {
  return Math.max(
    0,
    ...courses.map((c) => {
      if (!c.originalPrice || !c.price || c.price >= c.originalPrice) return 0;
      return Math.round(100 - (c.price / c.originalPrice) * 100);
    })
  );
}
const maxDisc = getMaxDiscount(instructorCourses);
const hasFree = instructorCourses.some((c) => c.price === 0);
const freeCount = instructorCourses.filter((c) => c.price === 0).length;

// Initials fallback untuk portrait
function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}

// SEO Data
const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const siteUrl = "https://coursespeak.com";
const instructorUrl = `${siteUrl}/instructor/${instructorSlug}`;

const cleanName = instructorName.replace(/[^\x20-\x7E]/g, '').trim();

// Foto instructor (Udemy CDN), fallback ke avatar inisial
const instructorImage = getInstructorImageByName(instructorName);

const pageTitle = `${instructorName}'s — Udemy Coupon Codes ${currentMonth} ${currentYear} | CourseSpeak`;
const pageDescription = `Access ${instructorData.courseCount} Udemy Coupon Codes by ${instructorName}. ${instructorData.totalStudents.toLocaleString()}+ students enrolled. Average rating ${instructorData.avgRating}★. Browse free online courses with 100% off coupons.`;

// FAQ Data
const faqs = [
  {
    q: `How many courses does ${instructorName} have on CourseSpeak?`,
    a: `${instructorName} currently has ${instructorData.courseCount} verified course${instructorData.courseCount === 1 ? '' : 's'} on CourseSpeak across ${providers[0] || 'Udemy'}.`
  },
  {
    q: `What is the average rating of ${instructorName}'s courses?`,
    a: `The average rating for ${instructorName}'s courses is ${instructorData.avgRating} out of 5 stars, based on student reviews.`
  },
  {
    q: `How do I get ${instructorName}'s courses for free?`,
    a: `Browse ${instructorName}'s courses on CourseSpeak and click any deal that interests you. Free courses are clearly marked with 100% off coupons — just enroll directly on Udemy.`
  },
  {
    q: `What topics does ${instructorName} teach?`,
    a: `${instructorName} teaches courses in ${categories.slice(0, 3).join(', ')}${categories.length > 3 ? ' and more' : ''}. Their expertise covers multiple areas in technology and professional development.`
  }
];

---

<Layout title={pageTitle} description={pageDescription} canonical={instructorUrl} image={instructorImage}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
              { '@type': 'ListItem', position: 2, name: 'Instructors', item: `${siteUrl}/instructors` },
              { '@type': 'ListItem', position: 3, name: cleanName, item: instructorUrl },
            ],
          },
          {
            '@type': 'Person',
            '@id': instructorUrl,
            name: instructorName,
            ...(instructorImage ? { image: instructorImage } : {}),
            jobTitle: 'Udemy Instructor',
            description: pageDescription,
            url: instructorUrl,
          },
          {
            '@type': 'CollectionPage',
            url: instructorUrl,
            name: pageTitle,
            description: pageDescription,
            mainEntity: {
              '@type': 'ItemList',
              numberOfItems: instructorData.courseCount,
            },
          },
          {
            '@type': 'FAQPage',
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ],
      })}
    />
    <link rel="preconnect" href="https://img-c.udemycdn.com" />
  </Fragment>

  <main>
    {/* ── HERO (headline + stats + portrait) ── */}
    <section class="ih-hero">
      <div class="container ih-grid">
        <div class="ih-copy anim-up">
          <p class="ih-eyebrow">
            <span class="ih-blink" aria-hidden="true"></span>
            {provider} · {instructorData.courseCount} Coupon Code{instructorData.courseCount === 1 ? '' : 's'}
          </p>
          <h1 class="ih-title">{instructorName}</h1>
          <p class="ih-sub">{pageDescription}</p>
          <div class="ih-stats">
            <div class="ih-stat">
              <div class="ih-stat-num"><span data-ih-count={instructorData.courseCount}>0</span></div>
              <div class="ih-stat-lab">courses</div>
            </div>
            <div class="ih-stat">
              <div class="ih-stat-num"><span data-ih-count={instructorData.totalStudents}>0</span>+</div>
              <div class="ih-stat-lab">students</div>
            </div>
            <div class="ih-stat">
              <div class="ih-stat-num">Up to <span data-ih-count={maxDisc}>0</span>%</div>
              <div class="ih-stat-lab">max discount</div>
            </div>
          </div>
          <div class="ih-toolbar">
            <a class="ih-btn" href="#deals">View all {instructorData.courseCount} courses</a>
            <a class="ih-btn ghost" href="/instructors">Browse all instructors</a>
            <a class="ih-btn ghost" href="/deals">Today's new deals</a>
          </div>
        </div>
        <div class="ih-portrait">
          <div class="ih-portrait-blob" aria-hidden="true"></div>
          {instructorImage ? (
            <img
              class="ih-portrait-img"
              src={instructorImage}
              alt={instructorName}
              width="220"
              height="220"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="ih-portrait-fb" aria-hidden="true">{getInitials(instructorName)}</span>
          )}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:1rem;">
      <div class="container">
        <div class="adv-grid">
          <div>
            <span class="section-title">Why {instructorName}</span>
            <h2 class="section-heading" style="max-width:450px;display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
              Learn from a trusted instructor.
              {freeCount > 0 && <span class="ih-tag">{freeCount} free deal{freeCount === 1 ? '' : 's'}</span>}
            </h2>
          </div>
          <p style="color:var(--text-secondary);font-size:1rem;line-height:1.7;margin:0">
            {instructorName} offers <strong>{instructorData.courseCount} verified course{instructorData.courseCount === 1 ? '' : 's'}</strong> on CourseSpeak. Browse top-rated courses with discounts up to <strong>{maxDisc}% off</strong>{hasFree ? ', including free courses' : ''}.
          </p>
        </div>
        <div class="adv-cards">
          <div class="adv-card">
            <div class="adv-icon" style="color:var(--brand)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Verified Coupons</h3>
            <p>Every coupon from {instructorName} is manually checked before listing. No expired or fake deals.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:#059669">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>Top-Rated Courses</h3>
            <p>{instructorData.avgRating > 0 ? `${instructorName}'s courses average ${instructorData.avgRating} stars` : `${instructorName}'s courses are available at great discounts`}.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:var(--brand)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
            <h3>Save up to {maxDisc}%</h3>
            <p>Get the best deals on {instructorName}'s {provider} courses with discounts up to {maxDisc}% off.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:#7c3aed">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3>Updated Daily</h3>
            <p>New coupons added regularly. Deals refresh daily so you never miss a discount from {instructorName}.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="deals" style="padding-top:3rem;scroll-margin-top:5rem;">
      <div class="container">
        <div class="ih-sec-head">
          <h2 class="ih-sec-title">
            All {instructorName} Courses with Verified Coupons
            <span class="ih-tag">{instructorData.courseCount} courses</span>
          </h2>
          <p class="ih-sec-desc">Sorted by enrollment — every coupon manually checked before listing.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem;">
          {instructorCourses.map((course) => (
            <DealCard deal={course} />
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container">
        <div class="ih-sec-head">
          <h2 class="ih-sec-title">
            Frequently asked questions
            <span class="ih-tag">{faqs.length} questions</span>
          </h2>
        </div>
        <div class="ih-faq-grid">
          {faqs.map((faq) => (
            <div class="ih-faq-card">
              <h3 class="ih-faq-q">{faq.q}</h3>
              <p class="ih-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container">
        <div class="cta-box">
          <p class="cta-eyebrow">More instructors to explore</p>
          <h2>Discover top Udemy instructors</h2>
          <p class="cta-subtext">Browse every verified instructor — all with manually checked coupon codes.</p>
          <div class="cta-actions">
            <a href="/instructors" class="ih-btn">Browse All Instructors →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

<style>
  /* ── Instructor hero ── */
  .ih-hero {
    background: linear-gradient(135deg, #080b12 0%, #141a2a 60%, #1a1408 100%);
    padding: 3.5rem 0 3rem;
    position: relative;
    overflow: hidden;
  }
  .ih-hero::before {
    content: '';
    position: absolute; top: -100px; left: 12%;
    width: 380px; height: 380px;
    background: radial-gradient(circle, rgba(212,167,55,0.16) 0%, transparent 65%);
    pointer-events: none;
  }
  .ih-hero::after {
    content: '';
    position: absolute; bottom: -120px; right: 8%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(232,197,71,0.10) 0%, transparent 65%);
    pointer-events: none;
  }
  .ih-grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.05fr 1fr;
    gap: 2.5rem; align-items: center;
  }
  .ih-copy { min-width: 0; }
  .ih-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.75rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--brand);
    background: var(--brand-soft);
    border: 1px solid rgba(212,167,55,0.35);
    border-radius: 999px; padding: 7px 16px;
    margin: 0 0 1.1rem;
  }
  .ih-blink {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--brand); flex-shrink: 0;
    animation: ihBlip 1.6s infinite;
  }
  @keyframes ihBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .ih-title {
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 800; line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 0.75rem;
  }
  .ih-sub {
    font-size: 1.02rem; color: var(--text-secondary);
    max-width: 560px; margin: 0 0 1.5rem; line-height: 1.65;
  }
  .ih-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .ih-stat { display: flex; flex-direction: column; }
  .ih-stat-num {
    font-size: 1.5rem; font-weight: 800; color: var(--brand);
    font-variant-numeric: tabular-nums;
  }
  .ih-stat-lab {
    font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted);
  }
  .ih-toolbar { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .ih-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.9rem; font-weight: 700; text-decoration: none;
    padding: 12px 20px; border-radius: 10px;
    background: linear-gradient(135deg, #B8860B 0%, #D4AF37 40%, #E8C547 60%, #D4AF37 100%);
    color: #080b12; white-space: nowrap;
    box-shadow: 0 10px 24px -8px rgba(212,167,55,0.5);
    transition: filter 0.2s, transform 0.2s;
  }
  .ih-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .ih-btn.ghost {
    background: transparent; color: var(--brand);
    border: 1px solid rgba(212,167,55,0.45); box-shadow: none;
  }
  .ih-btn.ghost:hover { background: var(--brand-soft); }
  .ih-portrait {
    display: flex; align-items: center; justify-content: center;
    min-width: 0; position: relative; padding: 1rem 0;
  }
  .ih-portrait-blob {
    position: absolute; width: min(320px, 90%); aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(212,167,55,0.30) 0%, transparent 55%),
      radial-gradient(circle, rgba(232,197,71,0.16) 0%, transparent 62%),
      radial-gradient(circle, rgba(212,167,55,0.10) 0%, transparent 70%);
    border: 1px solid rgba(212,167,55,0.30);
    pointer-events: none;
  }
  .ih-portrait-img {
    position: relative; width: min(220px, 62%); aspect-ratio: 1;
    border-radius: 50%; object-fit: cover;
    border: 5px solid rgba(212,167,55,0.85);
    box-shadow: 0 24px 60px -12px rgba(0,0,0,0.6), 0 0 40px -8px rgba(212,167,55,0.35);
  }
  .ih-portrait-fb {
    position: relative; width: min(220px, 62%); aspect-ratio: 1;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 3.5rem; color: #080b12;
    background: linear-gradient(135deg, #B8860B 0%, #D4AF37 40%, #E8C547 100%);
    border: 5px solid rgba(212,167,55,0.85);
    box-shadow: 0 24px 60px -12px rgba(0,0,0,0.6);
  }
  /* ── Section head + tag ── */
  .ih-sec-head { margin-bottom: 1.25rem; }
  .ih-sec-title {
    font-size: 1.25rem; font-weight: 800; color: var(--text);
    margin: 0 0 0.3rem; display: flex; align-items: center;
    gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em;
  }
  .ih-tag {
    font-size: 0.65rem; font-weight: 700; color: var(--muted);
    border: 1px solid var(--border); padding: 3px 10px;
    border-radius: 999px; text-transform: uppercase;
    letter-spacing: 0.05em; margin-left: auto; white-space: nowrap;
  }
  .ih-sec-desc { font-size: 0.88rem; color: var(--muted); margin: 0; }
  /* ── FAQ kartu ── */
  .ih-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .ih-faq-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.1rem 1.15rem;
    transition: border-color 0.2s;
  }
  .ih-faq-card:hover { border-color: rgba(212,167,55,0.45); }
  .ih-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
  .ih-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0; }
  @media (max-width: 900px) {
    .ih-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .ih-faq-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    function animate(el) {
      var target = parseInt(el.getAttribute('data-ih-count') || '0', 10);
      if (isNaN(target)) return;
      var dur = 900;
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min(1, (ts - start) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    function init() {
      var nodes = document.querySelectorAll('[data-ih-count]');
      if (!('IntersectionObserver' in window)) {
        nodes.forEach(animate);
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      nodes.forEach(function (n) { io.observe(n); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
</Layout>
