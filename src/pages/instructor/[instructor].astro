---
import Layout from "../../layouts/Layout.astro";
import DealCard from "../../components/DealCard.astro";
import { readDeals } from "../../lib/store";
import type { Deal } from "../../types/deal";

import { parseInstructors, createInstructorSlug, instructorSlugLookupKeys } from "../../lib/instructors";

// Types
interface InstructorData {
  name: string;
  slug: string;
  courses: Deal[];
  totalStudents: number;
  avgRating: number;
  categories: string[];
  totalReviews: number;
  courseCount: number;
  providers: string[];
}

// Generate static paths for instructors with 3+ courses
export async function getStaticPaths() {
  const allDeals = await readDeals();
  
  // Group deals by INDIVIDUAL instructor (split comma-separated names)
  const instructorMap = new Map<string, Deal[]>();
  
  allDeals.forEach((deal) => {
    const instructors = parseInstructors(deal.instructor);
    
    // Add this course to each individual instructor
    instructors.forEach((instructorName) => {
      if (!instructorMap.has(instructorName)) {
        instructorMap.set(instructorName, []);
      }
      instructorMap.get(instructorName)!.push(deal);
    });
  });
  
  // Filter instructors with 3+ courses and create paths
  const paths = [];
  const seen = new Set();
  
  for (const [name, courses] of instructorMap.entries()) {
    if (courses.length >= 3) {
      const slug = createInstructorSlug(name);
      
      if (!seen.has(slug)) {
        seen.add(slug);
        paths.push({
          params: { instructor: slug },
          props: { 
            instructorName: name,
            instructorSlug: slug 
          }
        });
      }
    }
  }
  
  return paths;
}

// Get props from static path generation
let { instructorName, instructorSlug } = Astro.props;
const { instructor } = Astro.params;

// Fetch all deals first (used for both lookup and filtering)
const allDeals = await readDeals();

// Fallback: if props not available (SSR mode), resolve slug → display name (never use raw slug as name)
if (!instructorName && instructor) {
  const slugToName = new Map<string, string>();

  allDeals.forEach((deal) => {
    for (const name of parseInstructors(deal.instructor)) {
      for (const key of instructorSlugLookupKeys(name)) {
        slugToName.set(key, name);
      }
    }
  });

  const mapped = slugToName.get(instructor);
  if (mapped) {
    instructorName = mapped;
    instructorSlug = instructor;
  }
}

// Guard against missing instructor
if (!instructorName) {
  return Astro.redirect('/instructors');
}

// Ensure instructorSlug is defined
if (!instructorSlug) {
  instructorSlug = createInstructorSlug(instructorName);
}

// Filter deals for this instructor (check if instructorName is in comma-separated list)
const instructorCourses = allDeals.filter(d => {
  const instructors = parseInstructors(d.instructor);
  return instructors.includes(instructorName);
});

// Calculate instructor stats (students data comes from deals.json)
const totalStudents = instructorCourses.reduce((sum, c) => sum + (c.students || 0), 0);
const avgRating = instructorCourses.length > 0 
  ? Number((instructorCourses.reduce((sum, c) => sum + (c.rating || 0), 0) / instructorCourses.length).toFixed(1))
  : 0;
const categories = [...new Set(instructorCourses.map(c => c.category).filter(Boolean))];
const providers = [...new Set(instructorCourses.map(c => c.provider).filter(Boolean))];
const totalReviews = instructorCourses.reduce((sum, c) => sum + (c.students || 0), 0);

const instructorData: InstructorData = {
  name: instructorName,
  slug: instructorSlug,
  courses: instructorCourses,
  totalStudents,
  avgRating,
  categories,
  totalReviews,
  courseCount: instructorCourses.length,
  providers
};

const provider = providers[0] || 'Udemy';

function getMaxDiscount(courses: Deal[]): number {
  return Math.max(
    0,
    ...courses.map((c) => {
      if (!c.originalPrice || !c.price || c.price >= c.originalPrice) return 0;
      return Math.round(100 - (c.price / c.originalPrice) * 100);
    })
  );
}
const maxDisc = getMaxDiscount(instructorCourses);
const hasFree = instructorCourses.some((c) => c.price === 0);

// SEO Data
const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const siteUrl = "https://coursespeak.com";
const instructorUrl = `${siteUrl}/instructor/${instructorSlug}`;

const cleanName = instructorName.replace(/[^\x20-\x7E]/g, '').trim();

const pageTitle = `${instructorName}'s — Udemy Coupon Codes ${currentMonth} ${currentYear} | CourseSpeak`;
const pageDescription = `Access ${instructorData.courseCount} Udemy Coupon Codes by ${instructorName}. ${instructorData.totalStudents.toLocaleString()}+ students enrolled. Average rating ${instructorData.avgRating}★. Browse free online courses with 100% off coupons.`;

// FAQ Data
const faqs = [
  {
    q: `How many courses does ${instructorName} have on CourseSpeak?`,
    a: `${instructorName} currently has ${instructorData.courseCount} verified course${instructorData.courseCount === 1 ? '' : 's'} on CourseSpeak across ${providers[0] || 'Udemy'}.`
  },
  {
    q: `What is the average rating of ${instructorName}'s courses?`,
    a: `The average rating for ${instructorName}'s courses is ${instructorData.avgRating} out of 5 stars, based on student reviews.`
  },
  {
    q: `How do I get ${instructorName}'s courses for free?`,
    a: `Browse ${instructorName}'s courses on CourseSpeak and click any deal that interests you. Free courses are clearly marked with 100% off coupons — just enroll directly on Udemy.`
  },
  {
    q: `What topics does ${instructorName} teach?`,
    a: `${instructorName} teaches courses in ${categories.slice(0, 3).join(', ')}${categories.length > 3 ? ' and more' : ''}. Their expertise covers multiple areas in technology and professional development.`
  }
];

---

<Layout title={pageTitle} description={pageDescription} canonical={instructorUrl}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
              { '@type': 'ListItem', position: 2, name: 'Instructors', item: `${siteUrl}/instructors` },
              { '@type': 'ListItem', position: 3, name: cleanName, item: instructorUrl },
            ],
          },
          {
            '@type': 'CollectionPage',
            url: instructorUrl,
            name: pageTitle,
            description: pageDescription,
            mainEntity: {
              '@type': 'ItemList',
              numberOfItems: instructorData.courseCount,
            },
          },
          {
            '@type': 'FAQPage',
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ],
      })}
    />
    <link rel="preconnect" href="https://img-c.udemycdn.com" />
  </Fragment>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content anim-up">
          <h1>
            <span style="display:block;font-size:1rem;font-weight:700;color:var(--brand);margin-bottom:0.5rem;">
             {instructorData.courseCount} Coupon Code {instructorData.courseCount === 1 ? '' : 's'} in {provider}  
            </span>
            <span class="hero-gradient-text" style="display:block;font-size:clamp(2rem,5vw,3.5rem)">
              {instructorName}
            </span>
          </h1>
          <p>{pageDescription}</p>
        </div>
      </div>
    </section>

    <section style="padding-bottom:2rem;margin-top:-1rem">
      <div class="container">
        <div class="stat-grid">
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {instructorData.avgRating}
            </div>
            <div class="stat-label">Avg Rating</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {instructorData.totalStudents.toLocaleString()}
            </div>
            <div class="stat-label">Students</div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              Up to {maxDisc}%
            </div>
            <div class="stat-label">Max Discount</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:1rem;">
      <div class="container">
        <div class="adv-grid">
          <div>
            <span class="section-title">Why {instructorName}</span>
            <h2 class="section-heading" style="max-width:450px">Learn from a trusted instructor.</h2>
          </div>
          <p style="color:var(--text-secondary);font-size:1rem;line-height:1.7;margin:0">
            {instructorName} offers <strong>{instructorData.courseCount} verified course{instructorData.courseCount === 1 ? '' : 's'}</strong> on CourseSpeak. Browse top-rated courses with discounts up to <strong>{maxDisc}% off</strong>{hasFree ? ', including free courses' : ''}.
          </p>
        </div>
        <div class="adv-cards">
          <div class="adv-card">
            <div class="adv-icon" style="color:var(--brand)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Verified Coupons</h3>
            <p>Every coupon from {instructorName} is manually checked before listing. No expired or fake deals.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:#059669">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>Top-Rated Courses</h3>
            <p>{instructorData.avgRating > 0 ? `${instructorName}'s courses average ${instructorData.avgRating} stars` : `${instructorName}'s courses are available at great discounts`}.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:var(--brand)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
            <h3>Save up to {maxDisc}%</h3>
            <p>Get the best deals on {instructorName}'s {provider} courses with discounts up to {maxDisc}% off.</p>
          </div>
          <div class="adv-card">
            <div class="adv-icon" style="color:#7c3aed">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3>Updated Daily</h3>
            <p>New coupons added regularly. Deals refresh daily so you never miss a discount from {instructorName}.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem;">
          {instructorCourses.map((course) => (
            <DealCard deal={course} />
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0;">
      <div class="container" style="max-width:800px;">
        <span class="section-title">FAQ</span>
        <h2 class="section-heading" style="margin:0 0 2rem;">Common Questions</h2>
        <div class="faq-grid">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.q}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="3" class="fi"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="faq-answer">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
