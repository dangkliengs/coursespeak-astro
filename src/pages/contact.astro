---
import Layout from "../layouts/Layout.astro";

const canonicalUrl = "https://coursespeak.com/contact";
const pageTitle = "Contact CourseSpeak — Support, Partnerships & Feedback | CourseSpeak";
const pageDescription = "Contact CourseSpeak for support with Udemy coupons, partnership inquiries, or feedback. Our team responds within 24 hours.";
const lastModified = new Date().toISOString().split('T')[0];
const monthYear = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---

<Layout title={pageTitle} description={pageDescription} type="article" canonical={canonicalUrl}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription,
        "isPartOf": { "@id": "https://coursespeak.com" },
        "datePublished": "2023-01-01",
        "dateModified": lastModified,
        "inLanguage": "en-US",
        "mainEntity": {
          "@type": "Organization",
          "name": "CourseSpeak",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "email": "contact@coursespeak.com",
            "availableLanguage": "English"
          }
        }
      },
      {
        "@type": "Person",
        "@id": "https://coursespeak.com/#author",
        "name": "Josh Smith",
        "sameAs": ["https://x.com/courses_peak"]
      },
      {
        "@type": "Organization",
        "@id": "https://coursespeak.com/#organization",
        "name": "CourseSpeak",
        "url": "https://coursespeak.com",
        "logo": "https://coursespeak.com/logo.svg",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "contact@coursespeak.com"
        },
        "sameAs": [
          "https://x.com/courses_peak",
          "https://www.facebook.com/CourseSpeakOfficial/"
        ]
      }
    ]
  })} />
  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO ── */}
    <section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          Get in Touch
        </div>
        <h1 style={{ fontSize: "clamp(1.8rem, 4.5vw, 2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Contact CourseSpeak</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "650px", margin: "0 auto 1.5rem", lineHeight: 1.6 }}>
          Have questions about Udemy coupons, need support, or want to discuss partnerships? Our team is ready to assist you.
        </p>
        <div style={{ display: "flex", justifyContent: "center", alignItems: "center", gap: "1rem", flexWrap: "wrap", fontSize: "0.8rem", color: "var(--muted)" }}>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            By <a href="https://x.com/courses_peak" target="_blank" rel="noopener noreferrer" style="color:var(--text); text-decoration:none;"><strong>Josh Smith</strong></a>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
            Updated <time datetime={lastModified}>{new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "0.3rem" }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--muted)"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            2 min read
          </span>
        </div>
      </div>
    </section>

    {/* ── ARTICLE BODY ── */}
    <article style={{ padding: "2rem 1rem 4rem" }}>
      <div class="article-body" style={{ maxWidth: "900px", margin: "0 auto" }}>

        <p>
          We respond to all inquiries within 24 hours during business days. For urgent coupon issues, check our <a href="/how-to-redeem-coupon">redemption guide</a> first.
        </p>

        {/* ── Contact Options ── */}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:1rem; margin:1.5rem 0;">
          {[
            { d: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z", title: "General Support", desc: "Questions about Udemy coupons, course deals, or how our platform works?", mailto: "Support Question" },
            { d: "M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63C19.68 7.55 18.92 7 18.09 7h-.25c-.34 0-.68.16-.92.45L14.5 10H12v2h2.47l.93 5H10v2h6v4h2zM10 4c0-1.11-.89-2-2-2s-2 .89-2 2 .89 2 2 2 2-.89 2-2zm4 18v-6H9.5l2.54-7.63C12.32 7.55 13.08 7 13.91 7h.25c.34 0 .68.16.92.45L17.5 10H20v2h-2.47l-.93 5H14v2h-6v4H8z", title: "Partnerships", desc: "Interested in collaborating? We work with instructors, platforms, and educational partners.", mailto: "Partnership Inquiry" },
            { d: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z", title: "Feedback", desc: "Love CourseSpeak or have suggestions? We value your input to improve our platform.", mailto: "Feedback" },
          ].map(card => (
            <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
              <h3 style="font-size:0.95rem; font-weight:700; color:var(--text); margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--brand)" style="flex-shrink:0;"><path d={card.d}/></svg>
                {card.title}
              </h3>
              <p style="font-size:0.85rem; color:var(--muted); line-height:1.6; margin-bottom:1rem;">{card.desc}</p>
              <a href={`mailto:contact@coursespeak.com?subject=${encodeURIComponent(card.mailto)}`} style="display:inline-flex; align-items:center; gap:0.4rem; font-size:0.85rem; font-weight:600; color:var(--brand); text-decoration:none;">
                Send email
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
              </a>
            </div>
          ))}
        </div>

        {/* ── Author ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="author" class="section-heading">About the Author</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <div style="display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap;">
              <div style="width:70px; height:70px; border-radius:50%; flex-shrink:0; overflow:hidden; border:3px solid var(--brand);">
                <img src="/images/author.jpg" alt="Josh Smith" style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
              </div>
              <div style="flex:1; min-width:200px;">
                <h3 style="font-size:1rem; font-weight:700; color:var(--text); margin:0 0 0.35rem;">Josh Smith</h3>
                <p style="font-size:0.85rem; color:var(--muted); line-height:1.6; margin:0;">Udemy coupon specialist with 8+ years of experience. I personally verify every deal to ensure you get working, 100% off coupons.</p>
              </div>
              <div style="display:flex; flex-direction:column; gap:0.35rem;">
                <a href="https://www.linkedin.com/in/anandayuda/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style="display:flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#0077b5,#005885); border:1px solid #0077b5; text-decoration:none;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <a href="https://x.com/courses_peak" target="_blank" rel="noopener noreferrer" aria-label="X" style="display:flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#000,#333); border:1px solid #000; text-decoration:none;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </section>

        {/* ── Social ── */}
        <section style="margin-bottom:2.5rem;">
          <h2 id="social" class="section-heading">Stay Connected</h2>
          <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem;">
            <p style="margin-bottom:1rem;">Follow us for the latest Udemy deals and educational updates.</p>
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
              <a href="https://x.com/courses_peak" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.65rem 1.1rem; background:var(--card); border:1px solid var(--border); border-radius:8px; text-decoration:none; color:var(--text); font-size:0.85rem; font-weight:600;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                X / Twitter
              </a>
              <a href="https://www.facebook.com/CourseSpeakOfficial/" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.65rem 1.1rem; background:var(--card); border:1px solid var(--border); border-radius:8px; text-decoration:none; color:var(--text); font-size:0.85rem; font-weight:600;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                Facebook
              </a>
              <a href="https://www.linkedin.com/in/anandayuda/" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.65rem 1.1rem; background:var(--card); border:1px solid var(--border); border-radius:8px; text-decoration:none; color:var(--text); font-size:0.85rem; font-weight:600;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </section>

        {/* ── CTA ── */}
        <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center; margin-top:2rem;">
          <h2 style="font-size:1.3rem; font-weight:800; color:var(--text); margin-bottom:0.5rem;">
            Browse Free Udemy Coupons
          </h2>
          <p style="color:var(--muted); font-size:0.9rem; margin-bottom:1.5rem; max-width:440px; margin-left:auto; margin-right:auto; line-height:1.6;">
            Verified 100% off Udemy coupons — updated daily across 100+ topics. No account required.
          </p>
          <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
            <a href="/deals" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.6rem; background:var(--brand); color:var(--bg); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem;">
              Browse Free Deals
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
            <a href="/udemy-coupons-guide" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.7rem 1.6rem; color:var(--text); text-decoration:none; border-radius:8px; font-weight:700; font-size:0.9rem; border:2px solid var(--border);">
              Udemy Coupons Guide
            </a>
          </div>
        </div>

      </div>
    </article>

  </div>

  <style>
    .section-heading {
      font-size: clamp(1.15rem, 2.5vw, 1.45rem);
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--border);
    }
    .article-body { font-size: 0.95rem; line-height: 1.75; color: var(--muted); }
    .article-body p { margin-bottom: 1rem; }
    .article-body p:last-child { margin-bottom: 0; }
    .article-body strong { color: var(--text); }
    .article-body a { color: var(--brand); text-decoration: underline; }
  </style>
</Layout>
