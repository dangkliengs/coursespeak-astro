---
import Layout from "../layouts/Layout.astro";
import { readDeals } from "../lib/store";

const allDeals = await readDeals();

const categories = [...new Set(allDeals.map(d => d.category).filter(Boolean))].sort();
const topics = [...new Set(allDeals.map(d => d.subcategory).filter(Boolean))].sort() as string[];

const instructorSet = new Set<string>();
allDeals.forEach(d => {
  if (!d.instructor) return;
  d.instructor.split(',').map(n => n.trim()).filter(n => n.length > 0).forEach(n => instructorSet.add(n));
});
const instructors = Array.from(instructorSet).sort();

const dates = [...new Set(
  allDeals.map(d => {
    const date = new Date(d.updatedAt ?? d.createdAt ?? d.expiresAt ?? 0);
    return date.toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
  })
)].sort().reverse().slice(0, 30);

const TIMEZONE = 'Asia/Jakarta';
const jakartaNow = new Date();
const jakartaDate = jakartaNow.toLocaleDateString('en-US', { timeZone: TIMEZONE, year: 'numeric', month: 'long', day: 'numeric' });
const jakartaMonth = jakartaNow.toLocaleDateString('en-US', { timeZone: TIMEZONE, month: 'long' });
const jakartaYear  = jakartaNow.toLocaleDateString('en-US', { timeZone: TIMEZONE, year: 'numeric' });

const pageTitle = `Sitemap | CourseSpeak - Free Udemy Courses ${jakartaMonth} ${jakartaYear}`;
const pageDescription = "Navigate CourseSpeak easily. Find all pages, categories, topics, instructors, and blog posts in one place.";
const canonical = "https://coursespeak.com/sitemap";
const siteUrl = "https://coursespeak.com";

const faqs = [
  { q: "What is the CourseSpeak Sitemap?", a: "The CourseSpeak Sitemap is a comprehensive navigation page that helps users discover all available pages, course categories, learning topics, instructors, and daily coupon updates on our platform." },
  { q: "How can I find free Udemy courses by category?", a: "Browse our Course Categories section on this page to find free Udemy courses organized by subject including Programming, Development, IT & Software, Business, Marketing, and more." },
  { q: "How often is the site map updated?", a: "Our site map updates automatically daily as new free Udemy courses are added to our database. Check the Daily Updates section for the latest coupon codes posted each day." },
  { q: "Can I search for courses by instructor?", a: "Yes! Our Top Instructors section lists all course creators on the platform. Click any instructor name to see all their available free courses with 100% off coupons." },
  { q: "How do I find today's free Udemy coupons?", a: "Visit the Daily Updates section on this site map or go directly to our blog page to see the latest Udemy coupon codes added today, updated every 24 hours." }
];
---

<Layout title={pageTitle} description={pageDescription} type="article" canonical={canonical}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": canonical,
        "url": canonical,
        "name": pageTitle,
        "description": pageDescription,
        "isPartOf": { "@id": siteUrl },
        "dateModified": jakartaNow.toLocaleDateString('en-CA', { timeZone: TIMEZONE }),
        "inLanguage": "en-US",
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
            { "@type": "ListItem", "position": 2, "name": "Sitemap", "item": canonical }
          ]
        }
      },
      {
        "@type": "Person",
        "@id": siteUrl + "/#author",
        "name": "Josh Smith",
        "sameAs": ["https://x.com/courses_peak"]
      },
      {
        "@type": "FAQPage",
        "@id": canonical + "#faq",
        "mainEntity": faqs.map(f => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <div style={{ minHeight: "100vh", color: "var(--text)" }}>

    {/* ── HERO ── */}
    <section style={{ padding: "4rem 1rem 2rem", textAlign: "center" }}>
      <div style={{ maxWidth: "900px", margin: "0 auto" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(212,167,55,0.1)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
          Site Navigation
        </div>
        <h1 style={{ fontSize: "clamp(1.8rem, 4.5vw, 2.8rem)", fontWeight: 800, lineHeight: 1.2, margin: "0 auto 0.75rem" }}>
          <span style={{ background: "linear-gradient(135deg, var(--brand) 0%, hsl(35, 90%, 68%) 100%)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>Sitemap</span>
        </h1>
        <p style={{ color: "var(--muted)", fontSize: "1rem", maxWidth: "650px", margin: "0 auto 1.5rem", lineHeight: 1.6 }}>
          Explore all pages and sections of CourseSpeak. Find free Udemy courses by category, topic, instructor, or date.
        </p>
      </div>
    </section>

    {/* ── MAIN CONTENT ── */}
    <article style={{ padding: "1rem 1rem 4rem" }}>
      <div style={{ maxWidth: "1100px", margin: "0 auto" }}>

        {/* Main Pages */}
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Quick Links</div>
          <h2 id="main-pages" class="section-heading">Main Pages</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Quick access to all important pages on CourseSpeak — from browsing deals to reading guides and success stories.</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px,1fr)); gap:0.75rem;">
            {[
              { href: "/", label: "Home", desc: "Latest free Udemy courses" },
              { href: "/deals", label: "All Coupons", desc: "Browse all verified deals" },
              { href: "/categories", label: "Categories", desc: "Courses by subject" },
              { href: "/topics", label: "Topics", desc: "Courses by specific topic" },
              { href: "/instructors", label: "Instructors", desc: "Top course creators" },
              { href: "/blog", label: "Blog", desc: "Daily coupon updates" },
              { href: "/popular", label: "Popular", desc: "Most viewed courses" },
              { href: "/how-to-redeem-coupon", label: "How to Redeem", desc: "Coupon redemption guide" },
              { href: "/udemy-coupons-guide", label: "Udemy Coupons Guide", desc: "Complete coupons guide" },
              { href: "/platforms", label: "Platform Comparisons", desc: "Udemy vs Coursera vs edX" },
              { href: "/about", label: "About", desc: "About CourseSpeak" },
              { href: "/affiliate-disclosure", label: "Affiliate Disclosure", desc: "Affiliate disclosure" },
              { href: "/success-stories", label: "Success Stories", desc: "Student success stories" },
              { href: "/search", label: "Search", desc: "Search courses" },
            ].map(page => (
              <a href={page.href} style="display:block; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.15rem; text-decoration:none; color:var(--text);">
                <div style="font-weight:600; font-size:0.9rem; margin-bottom:0.2rem; color:var(--brand);">{page.label}</div>
                <div style="font-size:0.8rem; color:var(--muted);">{page.desc}</div>
              </a>
            ))}
          </div>
        </section>

        {/* Categories */}
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Browse by Subject</div>
          <h2 id="categories" class="section-heading">Course Categories</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Find free Udemy courses organized by subject area — from development and IT to design, marketing, and more.</p>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
            {categories.map(cat => (
              <a href={`/categories/${encodeURIComponent(cat.toLowerCase().replace(/\s+/g, "-"))}`} style="display:inline-flex; align-items:center; gap:0.4rem; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:0.5rem 0.85rem; text-decoration:none; color:var(--text); font-size:0.85rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 2l-5.5 9h11z"/></svg>
                {cat}
              </a>
            ))}
          </div>
        </section>

        {/* Topics */}
        {topics.length > 0 && (
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Explore Topics</div>
          <h2 id="topics" class="section-heading">Learning Topics</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Drill down into specific learning topics like Python, React, Docker, AWS, and hundreds more.</p>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
            {topics.slice(0, 50).map(topic => (
              <a href={`/topics/${encodeURIComponent(topic.toLowerCase().replace(/\s+/g, "-"))}`} style="display:inline-flex; align-items:center; gap:0.4rem; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:0.5rem 0.85rem; text-decoration:none; color:var(--text); font-size:0.85rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--brand)"><path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                {topic}
              </a>
            ))}
          </div>
        </section>
        )}

        {/* Instructors */}
        {instructors.length > 0 && (
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Course Creators</div>
          <h2 id="instructors" class="section-heading">Top Instructors</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Browse courses by top Udemy instructors. Each instructor page lists all their available free courses.</p>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
            {instructors.slice(0, 50).map(instructor => {
              const slug = instructor.toLowerCase().replace(/[^\w\s-]/g,"").replace(/\s+/g,"-").replace(/-+/g,"-").substring(0,100);
              return (
                <a href={`/instructor/${slug}`} style="display:inline-flex; align-items:center; gap:0.4rem; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:0.5rem 0.85rem; text-decoration:none; color:var(--text); font-size:0.85rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                  {instructor}
                </a>
              );
            })}
          </div>
        </section>
        )}

        {/* Blog Dates */}
        {dates.length > 0 && (
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Recent Posts</div>
          <h2 id="daily-updates" class="section-heading">Daily Updates</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Catch up on the latest Udemy coupon codes organized by date. New deals added every day.</p>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
            {dates.map(date => (
              <a href={`/blog/top-udemy-coupons/${date}`} style="display:inline-flex; align-items:center; gap:0.4rem; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:0.5rem 0.85rem; text-decoration:none; color:var(--text); font-size:0.85rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--brand)"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
                {date}
              </a>
            ))}
          </div>
        </section>
        )}

        {/* Info Pages */}
        <section style="margin-bottom:2.5rem;">
          <div style="display:inline-flex; align-items:center; gap:0.3rem; background:rgba(212,167,55,0.1); padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem; font-size:0.65rem; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:0.06em;">Policies & Guides</div>
          <h2 id="info" class="section-heading">Information</h2>
          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1rem; line-height:1.6;">Review our policies, terms, and helpful guides to make the most of CourseSpeak.</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px,1fr)); gap:0.75rem;">
            {[
              { href: "/privacy", label: "Privacy Policy", desc: "How we handle your data" },
              { href: "/terms", label: "Terms of Service", desc: "Terms and conditions" },
              { href: "/udemy-coupons-guide", label: "Udemy Coupons Guide", desc: "Complete coupon guide" },
              { href: "/contact", label: "Contact", desc: "Get in touch with us" },
            ].map(page => (
              <a href={page.href} style="display:block; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.15rem; text-decoration:none; color:var(--text);">
                <div style="font-weight:600; font-size:0.9rem; margin-bottom:0.2rem; color:var(--brand);">{page.label}</div>
                <div style="font-size:0.8rem; color:var(--muted);">{page.desc}</div>
              </a>
            ))}
          </div>
        </section>

        {/* ── FAQ ── */}
        <section aria-labelledby="faq-heading" style="margin-bottom:2.5rem;">
          <h2 id="faq" class="section-heading">Frequently Asked Questions</h2>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            {faqs.map(faq => (
              <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.25rem 1.5rem;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text); margin:0 0 0.5rem; display:flex; align-items:center; gap:0.5rem;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  {faq.q}
                </h3>
                <p style="font-size:0.85rem; color:var(--muted); line-height:1.7; margin:0;">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        {/* ── CTA: Personal Plan ── */}
        <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center;">
          <h2 style="font-size:1.3rem; font-weight:800; color:var(--text); margin-bottom:0.5rem;">
            Go Unlimited with Udemy Personal Plan
          </h2>
          <p style="color:var(--muted); font-size:0.9rem; margin-bottom:1.5rem; max-width:440px; margin-left:auto; margin-right:auto; line-height:1.6;">
            One flat price, unlimited learning. Level up every month without buying courses one by one — and cancel anytime.
          </p>
          <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
            <a href="https://trk.udemy.com/c/6564357/3775958/39854" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" style="border-radius:999px;padding:1rem 2.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/></svg>
              Start Free Trial
            </a>
          </div>
          <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-top:1rem; font-size:0.8rem; color:var(--muted);">
            <span>26,000+ courses</span>
            <span>7-day free trial</span>
            <span>Cancel anytime</span>
            <span>From $20/month</span>
          </div>
        </div>

      </div>
    </article>

  </div>

  <style>
    .section-heading {
      font-size: clamp(1.15rem, 2.5vw, 1.45rem);
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--border);
    }
  </style>
</Layout>
