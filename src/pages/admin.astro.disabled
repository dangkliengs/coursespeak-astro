---
import AdminShell from "../components/admin/AdminShell.astro";
import { readDeals } from "../lib/store";
import { parseInstructors } from "../lib/instructors";

const allDeals = await readDeals();
const categories = new Set(allDeals.map((d) => d.category).filter(Boolean));
const providers = new Set(allDeals.map((d) => d.provider).filter(Boolean));
const instructorNames = new Set<string>();
allDeals.forEach((d) => {
  parseInstructors(d.instructor).forEach((n) => instructorNames.add(n));
});

const stats = [
  { num: allDeals.length.toLocaleString(), lbl: "Total Deals" },
  { num: String(categories.size), lbl: "Categories" },
  { num: String(providers.size), lbl: "Providers" },
  { num: instructorNames.size.toLocaleString(), lbl: "Instructors" },
];
---

<AdminShell title="Dashboard" desc="Manage courses, deals, and instructor photos" badge={`${allDeals.length} deals`}>
  <div slot="actions">
    <a class="adm-btn adm-btn-primary" href="/admin/deals/create">+ New Deal</a>
  </div>

  <div class="adm-stats">
    {stats.map((s) => (
      <div class="adm-stat">
        <div class="adm-stat-ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        </div>
        <div class="adm-stat-body"><div class="adm-stat-num">{s.num}</div><div class="adm-stat-lbl">{s.lbl}</div></div>
      </div>
    ))}
  </div>

  <div class="adm-card">
    <div class="adm-grid adm-grid-2">
      <div>
        <p class="adm-subhead"><span class="bar"></span>Manage Deals</p>
        <p class="adm-note" style="margin-bottom:1rem;">Create, edit, and delete course deals.</p>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
          <a class="adm-btn adm-btn-primary" href="/admin/deals/create">+ Create New Deal</a>
          <a class="adm-btn adm-btn-ghost" href="/admin/deals">View All Deals</a>
        </div>
      </div>
      <div>
        <p class="adm-subhead"><span class="bar"></span>Instructor Photos</p>
        <p class="adm-note" style="margin-bottom:1rem;">Set instructor photos — one photo applies to every course by that instructor.</p>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
          <a class="adm-btn adm-btn-ghost" href="/admin/instructors">Manage Photos</a>
          <a class="adm-btn adm-btn-outline" href="/instructors" target="_blank" rel="noopener">View Leaderboard</a>
        </div>
      </div>
    </div>
  </div>
</AdminShell>
