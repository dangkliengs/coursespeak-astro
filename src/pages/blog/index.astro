---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getAvailableDates, readDealsFromFile } from '../../lib/store.js';

const siteUrl = "https://coursespeak.com";
const ARTICLES_PER_PAGE = 12;
function jakartaDateString(dateValue = new Date()) {
  return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(dateValue);
}
const today = jakartaDateString();
const dates = await getAvailableDates();
const totalPages = Math.max(1, Math.ceil(dates.length / ARTICLES_PER_PAGE));
const page1Dates = dates.slice(0, ARTICLES_PER_PAGE);

const allDealsForImages = await readDealsFromFile();
const dateImageMap: Record<string, string> = {};
for (const deal of allDealsForImages) {
  if (!deal.image) continue;
  const dealDate = new Date(deal.updatedAt ?? deal.createdAt ?? 0);
  const dateStr = dealDate.toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
  if (!dateImageMap[dateStr]) {
    dateImageMap[dateStr] = deal.image;
  }
}

const excerptTemplates = [
  (label: string) => `Browse ${label}'s verified 100% off codes — programming, design, and business courses in one place.`,
  (label: string) => `Fresh batch of free Udemy courses from that day, grouped by category and sorted by rating.`,
  (label: string) => `That day's top-rated free courses and tested Udemy coupons. Open the article to filter by category.`,
  (label: string) => `All Udemy deals we published on ${label}. Development, Design, Marketing, and more.`,
  (label: string) => `Verified discount codes and free courses for ${label}. Click through to see the full list by category.`,
  (label: string) => `That date's curated Udemy coupons — 100% off and free courses, all verified before listing.`,
  (label: string) => `See what was live on ${label}: free Udemy courses and working coupon codes, grouped by topic.`,
  (label: string) => `Full rundown of ${label}'s Udemy deals. Top courses by rating and category inside the article.`,
  (label: string) => `Daily roundup for ${label}. Open to browse free courses and coupon links that were updated that day.`,
  (label: string) => `Udemy coupons and free courses from that day. Article includes category filters and direct links.`,
];

const articles = page1Dates.map((date, index) => {
  const d = new Date(date);
  const shortLabel = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const isTodayArticle = date === today;
  const isYesterday = index === 1 && page1Dates[0] === today;
  let excerpt: string;
  if (isTodayArticle) {
    excerpt = "Today's top free Udemy courses and verified 100% off coupons.";
  } else if (isYesterday) {
    excerpt = "Yesterday's verified Udemy coupons and free courses. Still-valid deals from the latest batch.";
  } else {
    const template = excerptTemplates[index % excerptTemplates.length];
    excerpt = template(shortLabel);
  }
  const hasUdemyImg = !!dateImageMap[date];
  return {
    date,
    shortLabel,
    title: `Top Udemy Coupons — ${shortLabel}`,
    url: `${siteUrl}/blog/top-udemy-coupons/${date}/`,
    excerpt,
    coverImage: dateImageMap[date] || `${siteUrl}/api/blog-cover/${date}.svg?version=${date}`,
    imageWidth: hasUdemyImg ? 480 : 1200,
    imageHeight: hasUdemyImg ? 270 : 630,
  };
});

const faqs = [
  {
    q: "What is the CourseSpeak blog?",
    a: "The CourseSpeak blog is a daily-updated list of Udemy coupon articles. Each article shows the top free Udemy courses and verified discount codes for that specific date.",
  },
  {
    q: "How often are new Udemy coupon articles published?",
    a: "We publish a new article every day. Each post contains that day's verified Udemy coupons and free courses, grouped by category.",
  },
  {
    q: "Are the Udemy coupons in these articles really free?",
    a: "Yes. Every coupon we list gives you 100% off the course price. We verify each code before publishing.",
  },
  {
    q: "How do I use the daily coupon articles?",
    a: "Pick a date from the grid. Each article opens a page with that day's Udemy coupons, sorted by category.",
  },
  {
    q: "Can I still use coupons from older dates?",
    a: "Many Udemy coupons stay valid for several days. Older articles may still have working codes. For the freshest deals, start with today's or yesterday's article.",
  },
  {
    q: "Where else can I find Udemy deals on CourseSpeak?",
    a: "Besides the blog, you can browse all current deals on our Deals page, filter by category, or use search.",
  },
];

const totalArticles = dates.length;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
      ],
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}/blog#blog`,
      "name": "CourseSpeak Blog — Daily Udemy Coupons & Free Course Deals",
      "description": "Daily updated Udemy coupon articles. Browse top free courses and verified discount codes by date.",
      "url": `${siteUrl}/blog`,
      "publisher": { "@id": `${siteUrl}/#organization` },
      "blogPost": articles.slice(0, 12).map((a) => ({
        "@type": "BlogPosting",
        "headline": a.title,
        "url": a.url,
        "datePublished": `${a.date}T00:00:00Z`,
        "dateModified": `${a.date}T00:00:00Z`,
        "description": a.excerpt,
        "image": { "@type": "ImageObject", "url": a.coverImage, "width": a.imageWidth, "height": a.imageHeight },
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}/blog#list`,
      "name": "Daily Udemy Coupon Articles",
      "numberOfItems": totalArticles,
      "itemListElement": articles.map((a, i) => ({
        "@type": "ListItem", "position": i + 1, "url": a.url, "name": a.title,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/blog#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question", "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---

<Layout
  title="Blog | CourseSpeak — Daily Udemy Coupons & Free Course Deals"
  description="Browse daily Udemy coupon articles by date. Top free courses and verified discount codes — CourseSpeak."
  canonical={`${siteUrl}/blog`}
  image={`/api/blog-cover-feed.svg?v=${Date.now()}`}
>
  {totalPages > 1 && (
    <link rel="next" href={`${siteUrl}/blog/page/2`} slot="head" />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div style="min-height: 100vh; color: var(--text); background: var(--bg);">
    <div>

      <!-- ── Hero ── -->
      <section
        aria-labelledby="blog-hero-heading"
        style="padding: 4rem 1rem 3rem; text-align: center; position: relative; overflow: hidden;"
      >
        <div aria-hidden="true" style="position:absolute;top:20%;left:10%;width:300px;height:300px;background:var(--brand);filter:blur(120px);opacity:.08;border-radius:50%;pointer-events:none;"></div>
        <div aria-hidden="true" style="position:absolute;bottom:10%;right:10%;width:250px;height:250px;background:hsl(0,84%,60%);filter:blur(100px);opacity:.08;border-radius:50%;pointer-events:none;"></div>

        <div class="container" style="position:relative;z-index:1;">
          <div aria-hidden="true" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(212,167,55,0.12);padding:.5rem 1rem;border-radius:9999px;margin-bottom:1.5rem;font-size:.875rem;color:var(--brand);font-weight:600;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Daily Udemy Coupon Articles
          </div>

          <h1
            id="blog-hero-heading"
            style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;line-height:1.1;margin:0 auto 1.5rem;max-width:900px;color:var(--text);"
          >
            Blog —
            <span style="background:linear-gradient(135deg,var(--brand),hsl(35,90%,68%));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
              Daily Udemy Coupons
            </span>
            by Date
          </h1>

          <p style="font-size:clamp(1rem,2.5vw,1.2rem);color:var(--muted);max-width:680px;margin:0 auto 2.5rem;line-height:1.7;">
            Browse <strong style="color:var(--text);">{totalArticles} daily articles</strong> with verified Udemy coupons, sorted by date. Each article lists that day's free courses and discount codes.
          </p>

          <ul role="list" aria-label="Site statistics" style="display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;list-style:none;padding:0;margin:0;">
            {[
              { value: `${totalArticles}+`, label: "Articles" },
              { value: `${allDealsForImages.length}+`, label: "Coupons" },
              { value: "100%", label: "Verified" },
              { value: "Daily", label: "Updates" },
            ].map(({ value, label }) => (
              <li style="background:var(--card);padding:1rem 2rem;border-radius:12px;border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;min-width:130px;">
                <strong style="color:var(--brand);font-size:1.5rem;line-height:1;">{value}</strong>
                <span style="color:var(--muted);font-size:.85rem;margin-top:.35rem;">{label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ── Articles Grid ── -->
      <section
        aria-labelledby="articles-grid-heading"
        style="padding:4rem 1rem;background:var(--bg);"
      >
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2
              id="articles-grid-heading"
              style="font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800;color:var(--text);margin-bottom:.75rem;"
            >
              Browse All Articles
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:580px;margin:0 auto;line-height:1.65;">
              Pick a date to see all available Udemy coupon deals published that day, grouped by category.
            </p>
          </div>

          <div class="adv-cards blog-cards">
            {articles.map((a, i) => (
              <a href={`/blog/top-udemy-coupons/${a.date}/`} class="adv-card blog-card-item">
                <Image
                  src={a.coverImage}
                  width={480}
                  height={270}
                  style={{ width: "100%", height: "auto", aspectRatio: "16 / 9", objectFit: "cover", display: "block", borderRadius: "8px", marginBottom: "12px" }}
                  alt={`Top Udemy Coupons — ${a.shortLabel}`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="card-badge">Deals</span>
                <div style={{ fontSize: "0.82rem", color: "var(--brand)", fontWeight: 600, marginBottom: "4px" }}>
                  {a.shortLabel}
                </div>
                <h3 style={{ margin: 0, fontSize: "1rem", fontWeight: 700, color: "var(--text)", lineHeight: 1.3, marginBottom: "8px" }}>
                  {a.title}
                </h3>
                <p style={{ fontSize: "0.85rem", color: "var(--text-secondary)", lineHeight: 1.55, margin: 0 }}>
                  {a.excerpt}
                </p>
              </a>
            ))}
          </div>

          {totalPages > 1 && (
            <nav aria-label="Pagination" style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: "0.75rem", padding: "1.5rem 0", marginTop: "1.5rem", borderTop: "1px solid var(--border)" }}>
              <span style={{ fontSize: "0.85rem", color: "var(--muted)", fontWeight: 500 }}>Page 1 of {totalPages}</span>
              <a href="/blog/page/2" style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>Next →</a>
            </nav>
          )}
        </div>
      </section>

      <!-- ── About ── -->
      <section style="padding:4rem 1rem;background:var(--card);">
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:800;color:var(--text);margin-bottom:.75rem;">
              About the CourseSpeak Blog
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:700px;margin:0 auto;line-height:1.6;">
              Everything you need to know about using the blog to find the best Udemy coupons and free courses.
            </p>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                Daily Updates
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                We publish a new article every single day with that day's verified Udemy coupons. Each post is curated and tested before publishing, so you always get working discount codes.
              </p>
            </div>
            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(210,100%,60%)"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                Verified Coupons
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Every coupon code we list is tested before publication. We verify that each code gives 100% off or the advertised discount, so you never waste time on expired deals.
              </p>
            </div>
            <div style="background:var(--bg);padding:2rem;border-radius:12px;border:1px solid var(--border);">
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="hsl(35,90%,68%)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Organized by Date
              </h3>
              <p style="color:var(--muted);line-height:1.7;margin:0;">
                Articles are organized by publication date, making it easy to browse historical deals or jump to today's latest offers. Each article groups coupons by category for quick scanning.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── FAQ ── -->
      <section style="padding:4rem 1rem;background:var(--bg);">
        <div class="container" style="max-width:1400px;">
          <div style="text-align:center;margin-bottom:3rem;">
            <h2 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:800;color:var(--text);margin-bottom:0.75rem;">
              Frequently Asked Questions
            </h2>
            <p style="color:var(--muted);font-size:1rem;max-width:700px;margin:0 auto;line-height:1.6;">
              Get answers to common questions about the CourseSpeak blog and how daily Udemy coupon articles work.
            </p>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:1.5rem;">
            {faqs.map((faq) => (
              <div style="background:var(--card);border-radius:14px;border:1px solid var(--border);overflow:hidden;">
                <div style="padding:1.25rem 1.5rem;">
                  <h3 style="margin:0;color:var(--text);font-size:1rem;font-weight:700;margin-bottom:0.75rem;">
                    {faq.q}
                  </h3>
                  <p style="color:var(--muted);line-height:1.7;margin:0;font-size:0.95rem;">
                    {faq.a}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── CTA ── -->
      <section style="padding:4rem 1rem;text-align:center;background:var(--bg);">
        <div class="container" style="max-width:1400px;">
          <div style="max-width:700px;margin:0 auto;">
            <h2 style="font-size:clamp(1.4rem,3vw,1.9rem);font-weight:800;color:var(--text);margin-bottom:.75rem;">
              Ready to Start Saving?
            </h2>
            <p style="color:var(--muted);line-height:1.65;margin-bottom:2rem;">
              Jump to today's deals or browse our full collection of <strong style="color:var(--text);">{allDealsForImages.length}+ Udemy coupons</strong>.
            </p>
            <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
              <a
                href={`/blog/top-udemy-coupons/${today}/`}
                style="padding:.9rem 2rem;background:var(--brand);color:#fff;text-decoration:none;border-radius:10px;font-size:1rem;font-weight:700;transition:opacity .2s;"
              >
                Today's Deals
              </a>
              <a
                href="/deals"
                style="padding:.9rem 2rem;background:transparent;color:var(--brand);text-decoration:none;border-radius:10px;font-size:1rem;font-weight:700;border:2px solid var(--brand);transition:background .2s;"
              >
                Browse All Deals
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>

  <style>
    .container { max-width: 1400px; margin: 0 auto; }
    .card-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: linear-gradient(135deg, #D4AF37 0%, #E8C547 100%);
      color: #1a1814;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 3px 10px;
      border-radius: 20px;
      line-height: 1.4;
      z-index: 2;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .blog-card-item { position: relative; }
    .blog-cards {
      grid-template-columns: repeat(3, 1fr) !important;
    }
    @media (max-width: 900px) {
      .blog-cards { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 600px) {
      .blog-cards { grid-template-columns: 1fr !important; }
    }
  </style>
</Layout>
