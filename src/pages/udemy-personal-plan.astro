                <h3 style={{ fontSize:"0.95rem",fontWeight:700,color:"var(--text)",margin:"0 0 0.5rem",display:"flex",gap:"0.5rem" }}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  {faq.q}
                </h3>
                <p style={{ fontSize:"0.85rem",color:"var(--muted)",lineHeight:1.7,margin:0 }}>{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        <div style={{ background:"var(--card)",border:"1px solid var(--border)",borderRadius:"12px",padding:"2rem",textAlign:"center",marginTop:"3rem" }}>
          <h2 style={{ fontSize:"1.3rem",fontWeight:800,color:"var(--text)",marginBottom:"0.5rem" }}>
            Ready to use the Udemy Personal Plan coupon?
          </h2>
          <p style={{ color:"var(--muted)",fontSize:"0.9rem",marginBottom:"1.5rem",maxWidth:"480px",margin:"0 auto 1.5rem",lineHeight:1.6 }}>
            Claim up to 40% off the Udemy Personal Plan and start learning today — or browse 100% off Udemy course coupons first.
          </p>
          <div style={{ display:"flex",gap:"0.75rem",justifyContent:"center",flexWrap:"wrap" }}>
            <a href={AFF} target="_blank" rel="noopener noreferrer" style={{ display:"inline-flex",alignItems:"center",gap:"0.5rem",padding:"0.75rem 1.75rem",background:"var(--brand)",color:"var(--bg)",textDecoration:"none",borderRadius:"8px",fontWeight:700,fontSize:"0.9rem" }}>
              Get Udemy Personal Plan Discount
            </a>
            <a href="/deals" style={{ display:"inline-flex",alignItems:"center",gap:"0.5rem",padding:"0.75rem 1.75rem",color:"var(--text)",textDecoration:"none",borderRadius:"8px",fontWeight:700,fontSize:"0.9rem",border:"2px solid var(--border)" }}>
              Browse Free Deals
            </a>
          </div>
        </div>

        </main>

        <aside class="pp-sidebar">
          <div class="pp-toc">
            <h4>On this page</h4>
            <ol>
              {[
                ["#coupon","Coupon code"],
                ["#price","Price by country"],
                ["#what-included","What's included"],
                ["#career","Career accelerators"],
                ["#google","Grow with Google"],
                ["#break-even","Break-even math"],
                ["#worth","Worth it?"],
                ["#vs-coursera","vs Coursera Plus"],
                ["#cancel","Cancel & refunds"],
                ["#signup","How to claim"],
                ["#faq","FAQ"],
              ].map(([h,l],i)=>(
                <li><a href={h}>{l}</a></li>
              ))}
            </ol>
          </div>
          <div class="pp-cta">
            <p>Up to 40% off the Udemy Personal Plan — coupon auto-applied.</p>
            <a href={AFF} target="_blank" rel="noopener noreferrer">Get Discount →</a>
          </div>
          <div class="pp-trust">
            <span>✓ Verified deal</span>
            <span>✓ Global</span>
            <span>✓ Monthly refresh</span>
          </div>
        </aside>
      </div>
    </article>
  </div>

  <style>
    .container { max-width:1200px; margin:0 auto; }
    .article-body { font-size:0.95rem; line-height:1.75; color:var(--muted); }
    .article-body p { margin-bottom:1rem; }
    .article-body p:last-child { margin-bottom:0; }
    .article-body ul,.article-body ol { padding-left:1.5rem; margin-bottom:1.25rem; }
    .article-body li { margin-bottom:0.5rem; }
    .article-body strong { color:var(--text); }
    .article-body a { color:var(--brand); text-decoration:underline; }
    .section-heading { font-size:clamp(1.2rem,2.5vw,1.5rem); font-weight:800; color:var(--text); margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border); }
    .table-wrapper { overflow-x:auto; margin:1.25rem 0; border-radius:10px; border:1px solid var(--border); }
    table { width:100%; border-collapse:collapse; font-size:0.875rem; }
    th { background:var(--card); color:var(--text); font-weight:700; text-align:left; padding:0.75rem 1rem; border-bottom:2px solid var(--border); white-space:nowrap; }
    td { padding:0.75rem 1rem; color:var(--muted); border-bottom:1px solid var(--border); vertical-align:top; }
    tr:last-child td { border-bottom:none; }
    tr:nth-child(even) td { background:rgba(255,255,255,0.02); }
    .steps-list { list-style:none; padding:0; margin:1.5rem 0; display:flex; flex-direction:column; gap:1rem; }
    .steps-list li { display:flex; gap:1rem; align-items:flex-start; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.1rem 1.25rem; }
    .steps-list strong { display:block; color:var(--text); margin-bottom:0.3rem; font-size:0.95rem; }
    .steps-list p { margin:0; font-size:0.875rem; color:var(--muted); line-height:1.6; }
    .callout { border-radius:10px; padding:1rem 1.25rem; font-size:0.875rem; line-height:1.65; margin:1.5rem 0; }
    .callout-warn { background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.25); color:var(--muted); }
    .callout-warn strong { color:var(--brand); }
    .pp-grid { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:2.5rem; max-width:1200px; margin:0 auto; align-items:start; }
    .pp-sidebar { position:sticky; top:88px; display:flex; flex-direction:column; gap:1rem; }
    .pp-toc { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1rem 1.1rem; }
    .pp-toc h4 { margin:0 0 0.6rem; font-size:0.9rem; font-weight:800; color:var(--text); }
    .pp-toc ol { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.3rem; }
    .pp-toc a { font-size:0.82rem; color:var(--brand); text-decoration:none; }
    .pp-cta { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1rem 1.1rem; text-align:center; }
    .pp-cta p { font-size:0.8rem; color:var(--muted); margin:0 0 0.75rem; line-height:1.5; }
    .pp-cta a { display:inline-block; background:var(--brand); color:var(--bg); text-decoration:none; font-weight:700; font-size:0.85rem; padding:0.6rem 1.2rem; border-radius:8px; }
    .pp-trust { display:flex; flex-direction:column; gap:0.35rem; font-size:0.75rem; color:var(--muted); }
    @media (max-width:960px) { .pp-grid { grid-template-columns:1fr; } .pp-sidebar { position:static; order:-1; } }
    @media (max-width:640px){ .container{padding:0 0.75rem;} .steps-list li{flex-direction:column;gap:0.6rem;} }
  </style>

</Layout>
