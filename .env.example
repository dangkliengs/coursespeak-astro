# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=dangkliengs
GITHUB_REPO=coursespeak-astro

# Feature flag (optional)
USE_GITHUB_API=true



# Impact API Configuration (for analytics)
IMPACT_API_USERNAME=your_impact_username_here
IMPACT_API_PASSWORD=your_impact_password_here

# Admin Password (for admin panel)
ADMIN_PASSWORD=your_admin_password_here
ADMIN_DEV_TOKEN=your_dev_token_here

# AdSense — manual ad units (hybrid with Auto Ads).
# Library is loaded once eagerly in Layout.astro — do NOT paste the
# <script async src="...adsbygoogle.js"> tag per unit.
# PUBLIC_ prefix exposes them to the client bundle.
PUBLIC_ADSENSE_CLIENT=ca-pub-8220442576502761
PUBLIC_ADSENSE_AD_SLOT=2951964915
# Per-format slots (recommended). In-feed / in-article fall back to display
# until their real slot ids are pasted here.
PUBLIC_ADSENSE_SLOT_DISPLAY=2951964915
PUBLIC_ADSENSE_SLOT_MULTIPLEX=7774760180
PUBLIC_ADSENSE_SLOT_INFEED=1297905186
PUBLIC_ADSENSE_SLOT_INARTICLE=1600982501
# In-feed layout key from the in-feed Get-code dialog (data-ad-layout-key)
PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=-5p+ce-n-65+pn
